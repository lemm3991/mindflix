---
// my-list.astro - Minha Lista / Favoritos
import Layout from '../layouts/Layout.astro';
import CourseCard from '../components/CourseCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { getAllCourses, getCourseSourceId, getActiveSource } from '../lib/catalog';

const courses = getAllCourses();
---

<Layout title="Minha Lista — Mindflix">
  <div class="container my-list-page">
    <header class="page-header">
      <h1 class="page-title">Minha Lista</h1>
      <p class="page-subtitle">Seus cursos favoritos e conteúdos salvos para estudar quando quiser.</p>
    </header>

    <div class="courses-grid" id="my-list-container">
      {courses.map(course => (
        <div 
          class="my-list-item" 
          data-course-id={course.id} 
          data-source={getCourseSourceId(course)}
          style="display: none;"
        >
          <CourseCard course={course} />
        </div>
      ))}
    </div>

    <div id="empty-list-state" style="display: none;">
      <EmptyState
        title="Sua lista está vazia"
        description="Explore o catálogo e clique no ícone de coração para adicionar cursos que deseja estudar à sua lista pessoal."
        actionText="Explorar Cursos"
        actionHref="/courses"
      />
    </div>
  </div>
</Layout>

<script>
  import { getFavoriteCourseIds } from '../lib/progress';
  import { getLocalUser } from '../lib/supabase';
  import { getActiveSource } from '../lib/catalog';

  function initMyList() {
    const user = getLocalUser();
    if (!user) {
      window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
      return;
    }

    const favIds = getFavoriteCourseIds();
    const activeSource = getActiveSource();
    const items = document.querySelectorAll<HTMLElement>('.my-list-item');
    const emptyState = document.getElementById('empty-list-state');

    let visibleCount = 0;
    items.forEach(item => {
      const id = item.getAttribute('data-course-id');
      const itemSource = item.getAttribute('data-source');
      const matchesFav = id && favIds.includes(id);
      const matchesSource = !activeSource || activeSource === 'all' || itemSource === activeSource;

      if (matchesFav && matchesSource) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    if (emptyState) {
      emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  document.addEventListener('astro:page-load', initMyList);
  window.addEventListener('mindflix:source-changed', () => {
    initMyList();
  });
  initMyList();
</script>

<style>
  .my-list-page {
    padding-top: 110px;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    perspective: 1200px;
  }

  .my-list-item {
    perspective: 1000px;
    height: 100%;
  }
</style>
