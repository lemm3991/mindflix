---
// index.astro - Mindflix Streaming Home com 4 Cards de Destaque por Fonte, Trilhas e Fileiras por Categoria
import Layout from '../layouts/Layout.astro';
import HeroCourse from '../components/HeroCourse.astro';
import CourseRow from '../components/CourseRow.astro';
import CourseCard from '../components/CourseCard.astro';
import TrilhasRow from '../components/TrilhasRow.astro';
import { getAllCourses, getCoursesByCategory, isComecePorAqui, isProjectCourse } from '../lib/catalog';
import { getCourseSourceId } from '../lib/sources';

const allCourses = getAllCourses();

// Course counts for the 4 featured source spotlight cards (excluding comece por aqui and projects)
const ailabCourses = allCourses.filter(c => !isComecePorAqui(c) && !isProjectCourse(c) && getCourseSourceId(c) === 'ailab');
const asimovCourses = allCourses.filter(c => !isComecePorAqui(c) && !isProjectCourse(c) && (getCourseSourceId(c) === 'asimov' || getCourseSourceId(c) === 'asimov-skills'));
const hashtagCourses = allCourses.filter(c => !isComecePorAqui(c) && !isProjectCourse(c) && (getCourseSourceId(c) === 'hashtag' || getCourseSourceId(c) === 'hashtag-soft-skills'));
const diversosCourses = allCourses.filter(c => !isComecePorAqui(c) && !isProjectCourse(c) && getCourseSourceId(c) === 'outros');

// Course slices by main categories (getCoursesByCategory already excludes comece por aqui and projects)
const iaCourses = getCoursesByCategory('ia');
const automacaoCourses = getCoursesByCategory('automacao-agentes');
const devCourses = getCoursesByCategory('programacao-dev');
const webCourses = getCoursesByCategory('web-vibe-coding');
const backendCourses = getCoursesByCategory('backend-infra');
const dataCourses = getCoursesByCategory('dados-datascience');
const pythonCourses = getCoursesByCategory('python');
const tradingCourses = getCoursesByCategory('trading');
const personalCourses = getCoursesByCategory('desenvolvimento-pessoal');

// Recommended path courses (Section 65: "Próximo da sua Trilha")
const nextInPathCourses = allCourses.filter(c => 
  !isComecePorAqui(c) && !isProjectCourse(c) &&
  (c.categories.includes('ia') || c.categories.includes('automacao-agentes') || c.categories.includes('web-vibe-coding'))
).slice(0, 8);
---

<Layout title="Mindflix — Biblioteca Pessoal de Cursos">
  <!-- Multi-featured Editorial Rotating Hero -->
  <HeroCourse />

  <!-- Compact Platform Channels Strip (AI LAB, Asimov, Hashtag, Diversos) -->
  <section class="source-spotlight-section">
    <div class="container">
      <div class="spotlight-header-compact">
        <div class="spotlight-title-group">
          <span class="spotlight-badge-compact">Plataformas</span>
          <h2 class="spotlight-title-compact">Explorar por Formação</h2>
        </div>
        <span class="spotlight-sub-compact">Acesse o catálogo completo de cada provedor</span>
      </div>

      <div class="source-spotlight-grid">
        
        <!-- 1. AI LAB -->
        <a href="/source/ailab" class="source-spotlight-card card-ailab">
          <div class="spotlight-card-glow"></div>
          <div class="source-brand-icon-wrap icon-ailab">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a4 4 0 0 1 4 4c0 1.95-1.4 3.58-3.25 3.93v2.14a2 2 0 0 1-1.5 1.93v2.14A4 4 0 1 1 12 2z"></path>
              <circle cx="12" cy="18" r="2"></circle>
              <path d="M6 8a6 6 0 0 1 12 0"></path>
            </svg>
          </div>
          <div class="spotlight-info">
            <div class="source-card-top-row">
              <span class="source-card-title">AI LAB</span>
              <span class="source-count-pill">{ailabCourses.length}</span>
            </div>
            <span class="source-card-tagline">Inteligência Artificial & Agentes</span>
          </div>
          <div class="source-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </a>

        <!-- 2. Asimov -->
        <a href="/source/asimov" class="source-spotlight-card card-asimov">
          <div class="spotlight-card-glow"></div>
          <div class="source-brand-icon-wrap icon-asimov">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <div class="spotlight-info">
            <div class="source-card-top-row">
              <span class="source-card-title">Asimov</span>
              <span class="source-count-pill">{asimovCourses.length}</span>
            </div>
            <span class="source-card-tagline">Python, Dados & Automações</span>
          </div>
          <div class="source-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </a>

        <!-- 3. Hashtag -->
        <a href="/source/hashtag" class="source-spotlight-card card-hashtag">
          <div class="spotlight-card-glow"></div>
          <div class="source-brand-icon-wrap icon-hashtag">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <div class="spotlight-info">
            <div class="source-card-top-row">
              <span class="source-card-title">Hashtag</span>
              <span class="source-count-pill">{hashtagCourses.length}</span>
            </div>
            <span class="source-card-tagline">Impressionadores & NoCode</span>
          </div>
          <div class="source-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </a>

        <!-- 4. Diversos -->
        <a href="/source/outros" class="source-spotlight-card card-diversos">
          <div class="spotlight-card-glow"></div>
          <div class="source-brand-icon-wrap icon-diversos">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <div class="spotlight-info">
            <div class="source-card-top-row">
              <span class="source-card-title">Diversos</span>
              <span class="source-count-pill">{diversosCourses.length}</span>
            </div>
            <span class="source-card-tagline">Especialidades & Alta Performance</span>
          </div>
          <div class="source-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Formações Oficiais & Trilhas de Aprendizado Asimov -->
  <TrilhasRow />

  <div class="container home-rows-container">
    <!-- Dynamic Priority Row: Continue Estudando (1-click resume) -->
    <div id="continue-studying-section" class="dynamic-row" style="display: none;">
      <div class="dynamic-row-header">
        <div class="title-with-badge">
          <h2 class="row-title">Continuar Estudando</h2>
          <span class="badge badge-cyan">Retomar em 1 Clique</span>
        </div>
        <span class="row-subtitle">Suas aulas recentes em andamento</span>
      </div>
      <div class="dynamic-grid" id="continue-studying-grid"></div>
    </div>

    <!-- Dynamic "Minha Lista" Row -->
    <div id="my-list-section" class="dynamic-row" style="display: none;">
      <div class="dynamic-row-header">
        <h2 class="row-title">Minha Lista</h2>
        <a href="/my-list" class="view-all-link">Ver lista completa →</a>
      </div>
      <div class="dynamic-grid" id="my-list-grid"></div>
    </div>

    <!-- Próximo da sua Trilha (Section 65) -->
    <CourseRow
      title="Próximo da sua Trilha — Especialização em IA & NoCode"
      courses={nextInPathCourses}
      viewAllHref="/courses?category=ia"
      eagerCount={4}
    />

    <!-- Categorized Streaming Carousels (All Categories) -->
    <CourseRow
      title="Inteligência Artificial & LLMs"
      courses={iaCourses}
      viewAllHref="/courses?category=ia"
      eagerCount={2}
    />

    <CourseRow
      title="Automação & Agentes Autônomos"
      courses={automacaoCourses}
      viewAllHref="/courses?category=automacao-agentes"
    />

    <CourseRow
      title="Web, Apps & Vibe Coding"
      courses={webCourses}
      viewAllHref="/courses?category=web-vibe-coding"
    />

    <CourseRow
      title="Programação & Desenvolvimento"
      courses={devCourses}
      viewAllHref="/courses?category=programacao-dev"
    />

    <CourseRow
      title="Backend, Bancos de Dados & Infraestrutura"
      courses={backendCourses}
      viewAllHref="/courses?category=backend-infra"
    />

    <CourseRow
      title="Dados & Data Science"
      courses={dataCourses}
      viewAllHref="/courses?category=dados-datascience"
    />

    {pythonCourses.length > 0 && (
      <CourseRow
        title="Ecossistema Python Aplicado"
        courses={pythonCourses}
        viewAllHref="/courses?category=python"
      />
    )}

    <CourseRow
      title="Trading & Mercado Financeiro"
      courses={tradingCourses}
      viewAllHref="/courses?category=trading"
    />

    <CourseRow
      title="Desenvolvimento Pessoal & Soft Skills"
      courses={personalCourses}
      viewAllHref="/courses?category=desenvolvimento-pessoal"
    />
  </div>
</Layout>

<script>
  import { getRecentCourseIds, getFavoriteCourseIds } from '../lib/progress';
  import { getActiveSource } from '../lib/sources';
  import { showToast } from '../lib/toast';

  const params = new URLSearchParams(window.location.search);
  if (params.get('denied') === '1') {
    showToast('A página Biblioteca é de acesso exclusivo para o administrador (Lemmg0800).', 'error');
    const newUrl = window.location.pathname;
    window.history.replaceState({}, '', newUrl);
  }

  function renderDynamicHomeGrids() {
    const recentIds = getRecentCourseIds();
    const favIds = getFavoriteCourseIds();
    const activeSource = getActiveSource();

    // Populate "Continue Estudando" (Direct 1-click watch link)
    const continueSection = document.getElementById('continue-studying-section');
    const continueGrid = document.getElementById('continue-studying-grid');

    if (continueSection && continueGrid) {
      continueGrid.innerHTML = '';
      const cardsToClone: HTMLElement[] = [];
      recentIds.forEach(id => {
        const card = document.querySelector(`.course-card-wrapper[data-course-id="${id}"]`);
        if (card) {
          const cardSource = card.closest('.card-item-wrapper')?.getAttribute('data-source') || '';
          if (activeSource === 'all' || !cardSource || cardSource === activeSource) {
            const cloned = card.cloneNode(true) as HTMLElement;
            cardsToClone.push(cloned);
          }
        }
      });

      if (cardsToClone.length > 0) {
        continueSection.style.display = 'block';
        cardsToClone.slice(0, 4).forEach(card => continueGrid.appendChild(card));
      } else {
        continueSection.style.display = 'none';
      }
    }

    // Populate "Minha Lista"
    const myListSection = document.getElementById('my-list-section');
    const myListGrid = document.getElementById('my-list-grid');

    if (myListSection && myListGrid) {
      myListGrid.innerHTML = '';
      const cardsToClone: HTMLElement[] = [];
      favIds.forEach(id => {
        const courseCard = document.querySelector(`.course-card-wrapper[data-course-id="${id}"]`);
        const trilhaCard = document.querySelector(`.trilha-card-wrapper[data-trilha-id="${id}"], .trilha-card[data-trilha-id="${id}"]`);
        const target = courseCard || trilhaCard;
        if (target) {
          const cardSource = target.getAttribute('data-source') || target.closest('[data-source]')?.getAttribute('data-source') || '';
          if (activeSource === 'all' || !cardSource || cardSource === activeSource) {
            const cloned = target.cloneNode(true) as HTMLElement;
            cardsToClone.push(cloned);
          }
        }
      });

      if (cardsToClone.length > 0) {
        myListSection.style.display = 'block';
        cardsToClone.slice(0, 4).forEach(card => myListGrid.appendChild(card));
      } else {
        myListSection.style.display = 'none';
      }

      if (!myListGrid.dataset.bound) {
        myListGrid.dataset.bound = 'true';
        myListGrid.addEventListener('click', async (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-action="favorite"], .card-fav-btn, .trilha-fav-btn');
          if (btn) {
            e.preventDefault();
            e.stopPropagation();
            const id = btn.getAttribute('data-fav-id') || btn.getAttribute('data-trilha-id');
            if (id) {
              const { toggleFavorite } = await import('../lib/progress');
              const { showToast } = await import('../lib/toast');
              const isFav = await toggleFavorite(id);
              showToast(isFav ? 'Adicionado à Minha Lista' : 'Removido da Minha Lista', isFav ? 'success' : 'info');
              renderDynamicHomeGrids();
            }
          }
        });
      }
    }
  }

  window.addEventListener('mindflix:source-changed', () => {
    renderDynamicHomeGrids();
  });
  window.addEventListener('mindflix:favorites-changed', () => {
    renderDynamicHomeGrids();
  });

  document.addEventListener('astro:page-load', renderDynamicHomeGrids);
  renderDynamicHomeGrids();
</script>

<style>
  /* Compact Source Platforms Strip Section */
  .source-spotlight-section {
    padding: 1.5rem 0 1rem;
    position: relative;
  }

  .spotlight-header-compact {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .spotlight-title-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .spotlight-badge-compact {
    font-size: 0.675rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.22);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
  }

  .spotlight-title-compact {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .spotlight-sub-compact {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .source-spotlight-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .source-spotlight-card {
    position: relative;
    background: rgba(15, 20, 30, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md, 10px);
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    overflow: hidden;
    transition: transform var(--motion-fast) ease, border-color var(--motion-fast) ease, box-shadow var(--motion-fast) ease;
  }

  .source-spotlight-card:hover {
    transform: translateY(-2px);
  }

  .spotlight-card-glow {
    position: absolute;
    top: 0;
    right: 0;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    filter: blur(35px);
    opacity: 0.12;
    pointer-events: none;
    transition: opacity var(--motion-fast) ease;
  }

  .source-spotlight-card:hover .spotlight-card-glow {
    opacity: 0.35;
  }

  /* Specific Card Themes */
  .card-ailab { border-color: rgba(0, 242, 254, 0.18); }
  .card-ailab .spotlight-card-glow { background: #00f2fe; }
  .card-ailab:hover {
    border-color: rgba(0, 242, 254, 0.45);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), 0 0 16px rgba(0, 242, 254, 0.2);
  }

  .card-asimov { border-color: rgba(99, 102, 241, 0.18); }
  .card-asimov .spotlight-card-glow { background: #6366f1; }
  .card-asimov:hover {
    border-color: rgba(99, 102, 241, 0.45);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), 0 0 16px rgba(99, 102, 241, 0.2);
  }

  .card-hashtag { border-color: rgba(236, 72, 153, 0.18); }
  .card-hashtag .spotlight-card-glow { background: #ec4899; }
  .card-hashtag:hover {
    border-color: rgba(236, 72, 153, 0.45);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), 0 0 16px rgba(236, 72, 153, 0.2);
  }

  .card-diversos { border-color: rgba(245, 158, 11, 0.18); }
  .card-diversos .spotlight-card-glow { background: #f59e0b; }
  .card-diversos:hover {
    border-color: rgba(245, 158, 11, 0.45);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), 0 0 16px rgba(245, 158, 11, 0.2);
  }

  .source-brand-icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-ailab { background: rgba(0, 242, 254, 0.12); color: #00f2fe; border: 1px solid rgba(0, 242, 254, 0.3); }
  .icon-asimov { background: rgba(99, 102, 241, 0.12); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.3); }
  .icon-hashtag { background: rgba(236, 72, 153, 0.12); color: #f472b6; border: 1px solid rgba(236, 72, 153, 0.3); }
  .icon-diversos { background: rgba(245, 158, 11, 0.12); color: #fcd34d; border: 1px solid rgba(245, 158, 11, 0.3); }

  .spotlight-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .source-card-top-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .source-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .source-count-pill {
    font-size: 0.675rem;
    font-weight: 700;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-pill);
    padding: 0.05rem 0.4rem;
  }

  .source-card-tagline {
    font-size: 0.725rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .source-arrow {
    color: var(--text-muted);
    opacity: 0.6;
    transition: transform var(--motion-fast) ease, opacity var(--motion-fast) ease, color var(--motion-fast) ease;
    flex-shrink: 0;
  }

  .source-spotlight-card:hover .source-arrow {
    transform: translateX(3px);
    opacity: 1;
    color: var(--accent-cyan);
  }

  /* Home Rows Container */
  .home-rows-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 5rem;
  }

  .dynamic-row {
    margin-bottom: 2.75rem;
  }

  .dynamic-row-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .title-with-badge {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .row-title {
    font-size: 1.45rem;
    font-weight: 700;
  }

  .row-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .dynamic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.15rem;
  }

  .view-all-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-cyan);
    transition: color var(--motion-fast) ease;
  }

  .view-all-link:hover {
    color: #38bdf8;
  }

  @media (max-width: 1024px) {
    .source-spotlight-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .source-spotlight-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
