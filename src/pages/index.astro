---
// index.astro - Mindflix Streaming Home with Continue Watching, Next in Path, Category Filtering & Hero Showcase
import Layout from '../layouts/Layout.astro';
import HeroCourse from '../components/HeroCourse.astro';
import CourseRow from '../components/CourseRow.astro';
import CourseCard from '../components/CourseCard.astro';
import { getAllCourses, getCategories, getCoursesByCategory, getFirstPlayableLesson, isPlayableVideoLesson } from '../lib/catalog';

const allCourses = getAllCourses();
const categories = getCategories();

// Eligible courses for hero showcase (must not be hidden/missing and must have real playable lesson videos)
const eligibleHeroCourses = allCourses.filter(c => {
  if (c.is_hidden || (c as any).missing) return false;
  const firstVideo = getFirstPlayableLesson(c);
  return Boolean(firstVideo && isPlayableVideoLesson(firstVideo));
});

// Build a rich hero list with representation from categories so filtering always finds hero slides
const heroCourseList: any[] = [];
const heroAddedIds = new Set<string>();

categories.forEach(cat => {
  const catCourses = getCoursesByCategory(cat.id).filter(c => !c.is_hidden && !(c as any).missing);
  if (catCourses.length > 0) {
    const pick = catCourses.find(c => c.is_featured) || catCourses[0];
    if (pick && !heroAddedIds.has(pick.id)) {
      heroCourseList.push(pick);
      heroAddedIds.add(pick.id);
    }
  }
});

eligibleHeroCourses.forEach(c => {
  if (heroCourseList.length < 12 && !heroAddedIds.has(c.id)) {
    heroCourseList.push(c);
    heroAddedIds.add(c.id);
  }
});

const featuredCourses = heroCourseList.length > 0 ? heroCourseList : allCourses.slice(0, 5);

// Course slices for all categories
const iaCourses = getCoursesByCategory('ia');
const automacaoCourses = getCoursesByCategory('automacao-agentes');
const devCourses = getCoursesByCategory('programacao-dev');
const webCourses = getCoursesByCategory('web-vibe-coding');
const backendCourses = getCoursesByCategory('backend-infra');
const dataCourses = getCoursesByCategory('dados-datascience');
const pythonCourses = getCoursesByCategory('python');
const tradingCourses = getCoursesByCategory('trading');
const personalCourses = getCoursesByCategory('desenvolvimento-pessoal');
const saudeCourses = getCoursesByCategory('saude-lifestyle');
const musicaCourses = getCoursesByCategory('musica');
const negociosCourses = getCoursesByCategory('negocios');

// Recommended path courses (Section 65: "Próximo da sua Trilha")
const nextInPathCourses = allCourses.filter(c => 
  c.categories.includes('ia') || c.categories.includes('automacao-agentes') || c.categories.includes('web-vibe-coding')
).slice(0, 8);
---

<Layout title="Mindflix — Biblioteca Pessoal de Cursos">
  <!-- Multi-featured Editorial Rotating Hero -->
  <HeroCourse featuredCourses={featuredCourses} />

  <div class="container home-rows-container">
    <!-- Dynamic Priority Row: Continue Estudando (1-click resume) -->
    <div id="continue-studying-section" class="dynamic-row" style="display: none;">
      <div class="dynamic-row-header">
        <div class="title-with-badge">
          <h2 class="row-title">Continuar Estudando</h2>
          <span class="badge badge-cyan">Retomar em 1 Clique</span>
        </div>
        <span class="row-subtitle">Suas aulas recentes em andamento</span>
      </div>
      <div class="dynamic-grid" id="continue-studying-grid"></div>
    </div>

    <!-- Dynamic "Minha Lista" Row -->
    <div id="my-list-section" class="dynamic-row" style="display: none;">
      <div class="dynamic-row-header">
        <h2 class="row-title">Minha Lista</h2>
        <a href="/my-list" class="view-all-link">Ver lista completa →</a>
      </div>
      <div class="dynamic-grid" id="my-list-grid"></div>
    </div>

    <!-- Próximo da sua Trilha (Section 65) -->
    <div id="next-in-path-row-wrapper" data-section="next-in-path">
      <CourseRow
        title="Próximo da sua Trilha — Especialização em IA & NoCode"
        courses={nextInPathCourses}
        viewAllHref="/category/ia"
      />
    </div>

    <!-- Categorized Streaming Carousels (Tagged with data-category-id for filtering) -->
    <CourseRow
      categoryId="ia"
      title="Inteligência Artificial & LLMs"
      courses={iaCourses}
      viewAllHref="/category/ia"
    />

    <CourseRow
      categoryId="automacao-agentes"
      title="Automação & Agentes Autônomos"
      courses={automacaoCourses}
      viewAllHref="/category/automacao-agentes"
    />

    <CourseRow
      categoryId="web-vibe-coding"
      title="Web, Apps & Vibe Coding"
      courses={webCourses}
      viewAllHref="/category/web-vibe-coding"
    />

    <CourseRow
      categoryId="programacao-dev"
      title="Programação & Desenvolvimento"
      courses={devCourses}
      viewAllHref="/category/programacao-dev"
    />

    <CourseRow
      categoryId="backend-infra"
      title="Backend, Bancos de Dados & Infraestrutura"
      courses={backendCourses}
      viewAllHref="/category/backend-infra"
    />

    <CourseRow
      categoryId="dados-datascience"
      title="Dados & Data Science"
      courses={dataCourses}
      viewAllHref="/category/dados-datascience"
    />

    <CourseRow
      categoryId="python"
      title="Ecossistema Python"
      courses={pythonCourses}
      viewAllHref="/category/python"
    />

    <CourseRow
      categoryId="trading"
      title="Trading & Mercado Financeiro"
      courses={tradingCourses}
      viewAllHref="/category/trading"
    />

    <CourseRow
      categoryId="desenvolvimento-pessoal"
      title="Desenvolvimento Pessoal & PNL"
      courses={personalCourses}
      viewAllHref="/category/desenvolvimento-pessoal"
    />

    <CourseRow
      categoryId="saude-lifestyle"
      title="Saúde, Fitness & Culinária"
      courses={saudeCourses}
      viewAllHref="/category/saude-lifestyle"
    />

    <CourseRow
      categoryId="musica"
      title="Música & Artes"
      courses={musicaCourses}
      viewAllHref="/category/musica"
    />

    <CourseRow
      categoryId="negocios"
      title="Negócios & Oportunidades"
      courses={negociosCourses}
      viewAllHref="/category/negocios"
    />
  </div>
</Layout>

<script>
  import { getRecentCourseIds, getFavoriteCourseIds, getUserPreferences } from '../lib/progress';
  import { showToast } from '../lib/toast';

  const params = new URLSearchParams(window.location.search);
  if (params.get('denied') === '1') {
    showToast('A página Biblioteca é de acesso exclusivo para o administrador (Lemmg0800).', 'error');
    const newUrl = window.location.pathname;
    window.history.replaceState({}, '', newUrl);
  }

  const recentIds = getRecentCourseIds();
  const favIds = getFavoriteCourseIds();

  // Populate "Continue Estudando" (Direct 1-click watch link)
  const continueSection = document.getElementById('continue-studying-section');
  const continueGrid = document.getElementById('continue-studying-grid');

  if (recentIds.length > 0 && continueSection && continueGrid) {
    const cardsToClone: HTMLElement[] = [];
    recentIds.slice(0, 4).forEach(id => {
      const card = document.querySelector(`.course-card-wrapper[data-course-id="${id}"]`);
      if (card) {
        const cloned = card.cloneNode(true) as HTMLElement;
        cardsToClone.push(cloned);
      }
    });

    if (cardsToClone.length > 0) {
      continueSection.style.display = 'block';
      cardsToClone.forEach(card => continueGrid.appendChild(card));
    }
  }

  // Populate "Minha Lista"
  const myListSection = document.getElementById('my-list-section');
  const myListGrid = document.getElementById('my-list-grid');

  if (favIds.length > 0 && myListSection && myListGrid) {
    const cardsToClone: HTMLElement[] = [];
    favIds.slice(0, 4).forEach(id => {
      const card = document.querySelector(`.course-card-wrapper[data-course-id="${id}"]`);
      if (card) {
        const cloned = card.cloneNode(true) as HTMLElement;
        cardsToClone.push(cloned);
      }
    });

    if (cardsToClone.length > 0) {
      myListSection.style.display = 'block';
      cardsToClone.forEach(card => myListGrid.appendChild(card));
    }
  }

  // APPLY USER CATEGORY FILTERING ON HOME
  function applyHomeCategoryFilters() {
    const prefs = getUserPreferences();
    const selected = prefs.selected_categories || [];
    const isFiltering = selected.length > 0;

    // 1. Filter Category Rows
    const catRows = document.querySelectorAll<HTMLElement>('[data-category-id]');
    catRows.forEach(row => {
      const catId = row.getAttribute('data-category-id');
      if (!isFiltering || (catId && selected.includes(catId))) {
        row.style.display = 'block';
      } else {
        row.style.display = 'none';
      }
    });

    // 2. Filter Hero Slides
    const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
    const videoItems = document.querySelectorAll<HTMLElement>('.hero-video-item');
    const dots = document.querySelectorAll<HTMLElement>('.indicator-dot');

    if (slides.length > 0 && isFiltering) {
      let firstVisibleIdx = -1;
      slides.forEach((slide, idx) => {
        const slideCats = (slide.getAttribute('data-categories') || '').split(',');
        const matches = slideCats.some(c => selected.includes(c));
        const dot = dots[idx];
        if (matches) {
          if (firstVisibleIdx === -1) firstVisibleIdx = idx;
          if (dot) dot.style.display = 'inline-block';
        } else {
          slide.classList.remove('active');
          if (videoItems[idx]) videoItems[idx].classList.remove('active');
          if (dot) {
            dot.classList.remove('active');
            dot.style.display = 'none';
          }
        }
      });

      if (firstVisibleIdx !== -1) {
        slides.forEach(s => s.classList.remove('active'));
        dots.forEach(d => d.classList.remove('active'));
        videoItems.forEach(v => v.classList.remove('active'));

        slides[firstVisibleIdx]?.classList.add('active');
        if (dots[firstVisibleIdx]) dots[firstVisibleIdx].classList.add('active');
        if (videoItems[firstVisibleIdx]) videoItems[firstVisibleIdx].classList.add('active');
      }
    } else if (slides.length > 0) {
      dots.forEach(d => d.style.display = 'inline-block');
    }

    // 3. Filter "Próximo da sua Trilha"
    const nextPathWrapper = document.getElementById('next-in-path-row-wrapper');
    if (nextPathWrapper) {
      const cards = nextPathWrapper.querySelectorAll<HTMLElement>('.course-card-wrapper');
      let visibleCount = 0;
      cards.forEach(card => {
        const cardCats = (card.getAttribute('data-categories') || '').split(',');
        if (!isFiltering || cardCats.some(c => selected.includes(c))) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });
      nextPathWrapper.style.display = (!isFiltering || visibleCount > 0) ? 'block' : 'none';
    }

    // 4. Filter Continue Studying & My List Grids
    filterGridByCategories(continueGrid, selected);
    filterGridByCategories(myListGrid, selected);
  }

  function filterGridByCategories(gridEl: HTMLElement | null, selected: string[]) {
    if (!gridEl) return;
    const cards = gridEl.querySelectorAll<HTMLElement>('.course-card-wrapper');
    let visibleCount = 0;
    cards.forEach(card => {
      const cardCats = (card.getAttribute('data-categories') || '').split(',');
      if (selected.length === 0 || cardCats.some(c => selected.includes(c))) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const parentRow = gridEl.closest<HTMLElement>('.dynamic-row');
    if (parentRow) {
      parentRow.style.display = visibleCount > 0 ? 'block' : 'none';
    }
  }

  // Apply immediately and listen for changes
  applyHomeCategoryFilters();
  window.addEventListener('mindflix:preferences-updated', applyHomeCategoryFilters);
</script>

<style>
  .home-rows-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 5rem;
  }

  .dynamic-row {
    margin-bottom: 2.75rem;
  }

  .dynamic-row-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .title-with-badge {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .row-title {
    font-size: 1.45rem;
    font-weight: 700;
  }

  .row-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .dynamic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .view-all-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-cyan);
    transition: color var(--motion-fast) ease;
  }

  .view-all-link:hover {
    color: #38bdf8;
  }
</style>
