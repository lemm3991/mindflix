---
// login.astro - Tela de Login Exclusiva para Contas Autorizadas
import Layout from '../layouts/Layout.astro';
---

<Layout title="Entrar — Mindflix" hideNavbar={true}>
  <div class="auth-page-container">
    <div class="auth-card">
      <div class="auth-brand">
        <a href="/login" class="brand-logo">
          <span class="logo-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </span>
          <span class="logo-text">MIND<span>FLIX</span></span>
        </a>
      </div>

      <h1 class="auth-title">Acesso Restrito</h1>
      <p class="auth-subtitle">Informe seu usuário e senha autorizados para acessar a biblioteca.</p>

      <form id="login-form" class="auth-form">
        <div class="form-group">
          <label for="username" class="form-label">Nome de Usuário</label>
          <input
            type="text"
            id="username"
            class="form-input"
            placeholder="Ex: Lemmg0800 ou Tamydoagro"
            autocomplete="username"
            required
          />
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Senha</label>
          <input
            type="password"
            id="password"
            class="form-input"
            placeholder="••••••••"
            autocomplete="current-password"
            required
          />
        </div>

        <div class="auth-error-msg" id="login-error-box" style="display: none;"></div>

        <button type="submit" class="btn btn-primary btn-submit" id="login-submit-btn">
          <span>Entrar na Plataforma</span>
        </button>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { loginWithCredentials } from '../lib/auth';

  const form = document.getElementById('login-form');
  const userInput = document.getElementById('username') as HTMLInputElement | null;
  const passInput = document.getElementById('password') as HTMLInputElement | null;
  const errorBox = document.getElementById('login-error-box');
  const submitBtn = document.getElementById('login-submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const loginVal = userInput?.value.trim() || '';
    const passVal = passInput?.value.trim() || '';

    if (!loginVal || !passVal) {
      if (errorBox) {
        errorBox.textContent = 'Por favor, informe o usuário e a senha.';
        errorBox.style.display = 'block';
      }
      return;
    }

    if (errorBox) {
      errorBox.style.display = 'none';
      errorBox.textContent = '';
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Verificando credenciais...</span>';
    }

    const result = await loginWithCredentials(loginVal, passVal);

    if (result.success && result.user) {
      const params = new URLSearchParams(window.location.search);
      const redirectTarget = params.get('redirect') || '/';
      window.location.href = redirectTarget;
    } else {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Entrar na Plataforma</span>';
      }
      if (errorBox) {
        errorBox.textContent = result.error || 'Nome de usuário ou senha incorretos.';
        errorBox.style.display = 'block';
      }
    }
  });
</script>

<style>
  .auth-page-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .auth-card {
    width: 100%;
    max-width: 420px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
  }

  .auth-brand {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .logo-icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--grad-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0b0d13;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ffffff;
  }

  .logo-text span {
    background: var(--grad-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .auth-title {
    font-size: 1.5rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.35rem;
  }

  .auth-subtitle {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .form-input {
    height: 44px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    padding: 0 1rem;
    font-size: 0.9375rem;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .form-input:focus {
    border-color: var(--accent-cyan);
  }

  .auth-error-msg {
    background: rgba(244, 63, 94, 0.15);
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #fda4af;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .btn-submit {
    height: 46px;
    margin-top: 0.5rem;
    font-weight: 600;
  }
</style>
