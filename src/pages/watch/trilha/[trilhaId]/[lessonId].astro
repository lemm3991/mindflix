---
// src/pages/watch/trilha/[trilhaId]/[lessonId].astro - Sala de Aula da Trilha de Formação
import Layout from '../../../../layouts/Layout.astro';
import VideoPlayer from '../../../../components/VideoPlayer.astro';
import TrilhaSidebar from '../../../../components/TrilhaSidebar.astro';
import ChallengeModal from '../../../../components/ChallengeModal.astro';
import FocusMode from '../../../../components/FocusMode.astro';
import LessonNotes from '../../../../components/LessonNotes.astro';
import { getTrilhaFullStructure, getFirstPlayableLessonInTrilha } from '../../../../lib/trilhas';
import { isPlayableVideoLesson } from '../../../../lib/catalog';

const { trilhaId, lessonId } = Astro.params;

if (!trilhaId) {
  return Astro.redirect('/courses');
}

const struct = getTrilhaFullStructure(trilhaId);
if (!struct || struct.allLessons.length === 0) {
  return Astro.redirect('/404');
}

const { trilha, coursesWithModules, allLessons } = struct;

// Find current lesson in trilha
let currentLessonItem = allLessons.find(item => item.lesson.id === lessonId);

if (!currentLessonItem) {
  const firstPlayable = getFirstPlayableLessonInTrilha(trilha.id);
  currentLessonItem = firstPlayable || allLessons[0];
}

const currentLesson = currentLessonItem.lesson;
const currentIdx = allLessons.findIndex(item => item.lesson.id === currentLesson.id);

const prevLessonItem = currentIdx > 0 ? allLessons[currentIdx - 1] : null;
const nextLessonItem = currentIdx < allLessons.length - 1 ? allLessons[currentIdx + 1] : null;

const prevLessonHref = prevLessonItem ? `/watch/trilha/${trilha.id}/${prevLessonItem.lesson.id}` : undefined;
const nextLessonHref = nextLessonItem ? `/watch/trilha/${trilha.id}/${nextLessonItem.lesson.id}` : undefined;
---

<Layout title={`${currentLesson.display_title} — Trilha: ${trilha.title}`} hideNavbar={false}>
  <!-- Standardized Focus Mode Component -->
  <FocusMode />

  <div class="watch-layout">
    <!-- Main Content Area: Video and Details -->
    <div class="watch-main-column">
      <div class="watch-video-section">
        <VideoPlayer
          courseId={currentLessonItem.courseId}
          lesson={currentLesson}
          prevLessonHref={prevLessonHref}
          nextLessonHref={nextLessonHref}
          nextLessonTitle={nextLessonItem?.lesson.display_title}
        />
      </div>

      <!-- Lesson Metadata and Materials -->
      <div class="lesson-details-section">
        <div class="lesson-header-row">
          <div class="lesson-info">
            <div class="trilha-context-breadcrumb">
              <span class="trilha-name-tag">Trilha: {trilha.title}</span>
              <span class="sep">›</span>
              <span class="course-name-tag">{currentLessonItem.courseType} {currentLessonItem.courseOrder}: {currentLessonItem.courseTitle}</span>
            </div>
            <h1 class="lesson-main-title">{currentLesson.display_title}</h1>
          </div>

          <div class="lesson-actions-group">
            <!-- Desafio da Aula Button -->
            <button
              type="button"
              class="btn btn-secondary btn-sm btn-challenge-trigger"
              data-challenge-mode="lesson"
              data-course-id={currentLessonItem.courseId}
              data-lesson-id={currentLesson.id}
              data-lesson-title={currentLesson.display_title}
              title="Iniciar teste interativo desta aula com IA"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
              <span>Desafio com IA</span>
            </button>
          </div>
        </div>

        <!-- Student Classroom Notes Area (Above Downloads Area) -->
        <LessonNotes
          lessonId={currentLesson.id}
          courseId={currentLessonItem.courseId}
          watchUrl={`/watch/trilha/${trilha.id}/${currentLesson.id}`}
          courseTitle={`${trilha.title} — ${currentLessonItem.courseTitle}`}
          lessonTitle={currentLesson.display_title}
        />

        <!-- Complementary Materials & Documents Section (Always visible by default) -->
        {(() => {
          const isDownloadableMat = (pathOrTitle: string) => {
            const ext = (pathOrTitle || '').split('.').pop()?.toLowerCase() || '';
            const excluded = ['mp4', 'mkv', 'webm', 'mov', 'avi', 'm4v', 'ts', 'md', 'markdown', 'json', 'jpg', 'jpeg', 'png', 'webp', 'ini'];
            return !excluded.includes(ext);
          };

          const getMatFilename = (relPath: string, title: string) => {
            if (relPath) {
              const fname = relPath.replace(/\\/g, '/').split('/').pop();
              if (fname && fname.includes('.')) return fname;
            }
            return title ? `${title.replace(/[^a-zA-Z0-9_\- ]/g, '')}.pdf` : 'material.pdf';
          };

          // 1. Materials explicitly attached to currentLesson
          const lessonMaterials = (currentLesson.materials || [])
            .filter((mat: any) => isDownloadableMat(mat.relative_path || mat.title))
            .map((mat: any) => ({
              id: mat.id || mat.relative_path,
              title: mat.title || 'Material Complementar',
              type: (mat.type || 'ARQUIVO').toUpperCase(),
              relative_path: mat.relative_path || '',
              filename: getMatFilename(mat.relative_path || '', mat.title || 'material'),
              url: mat.drive_file_id 
                ? `https://drive.google.com/uc?export=download&id=${mat.drive_file_id}` 
                : (mat.drive_url || `/api/video?path=${encodeURIComponent(mat.relative_path)}&download=1`),
              driveId: mat.drive_file_id
            }));

          // 2. Non-video lessons in all courses of the trilha
          const trilhaFiles = (allLessons || [])
            .filter((lItem: any) => !isPlayableVideoLesson(lItem.lesson) && lItem.lesson.id !== currentLesson.id && isDownloadableMat(lItem.lesson.relative_path || lItem.lesson.raw_title))
            .map((lItem: any) => {
              const les = lItem.lesson;
              const ext = (les.relative_path || '').split('.').pop()?.toUpperCase() || (les.type || 'FILE').toUpperCase();
              return {
                id: les.id,
                title: les.display_title || les.raw_title,
                type: ext,
                relative_path: les.relative_path || '',
                filename: getMatFilename(les.relative_path || '', les.display_title || les.raw_title || 'material'),
                url: les.drive_file_id 
                  ? `https://drive.google.com/uc?export=download&id=${les.drive_file_id}` 
                  : (les.drive_url || `/api/video?path=${encodeURIComponent(les.relative_path)}&download=1`),
                driveId: les.drive_file_id
              };
            });

          // Combine and deduplicate materials
          const seen = new Set<string>();
          const allMaterials = [...lessonMaterials, ...trilhaFiles].filter(item => {
            const key = item.url || item.id || item.title;
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          });

          return (
            <div class="materials-box" id="watch-materials-section">
              <div class="materials-header">
                <div class="materials-title-wrap">
                  <div class="materials-icon-circle">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7 10 12 15 17 10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                  </div>
                  <div>
                    <h3 class="materials-main-heading">Arquivos e Materiais para Download</h3>
                    <p class="materials-subtitle">Apostilas, códigos, PDFs e materiais de apoio desta trilha de formação</p>
                  </div>
                </div>

                {allMaterials.length > 0 && (
                  <span class="materials-count-pill">{allMaterials.length} {allMaterials.length === 1 ? 'arquivo' : 'arquivos'}</span>
                )}
              </div>

              {allMaterials.length > 0 ? (
                <div class="materials-grid">
                  {allMaterials.map((mat: any) => (
                    <div class="material-item-card">
                      <div class="material-card-left">
                        <span class={`type-badge type-badge-${mat.type.toLowerCase()}`}>{mat.type}</span>
                        <div class="material-meta">
                          <strong class="material-name">{mat.title}</strong>
                          {mat.relative_path && <span class="material-path">{mat.relative_path}</span>}
                        </div>
                      </div>
                      <a
                        href={mat.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary btn-sm material-download-btn"
                        download={mat.filename}
                        title={`Baixar ${mat.title}`}
                        aria-label={`Baixar ${mat.title}`}
                      >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="7 10 12 15 17 10"></polyline>
                          <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                      </a>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="materials-empty-state">
                  <div class="materials-empty-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                  </div>
                  <div class="materials-empty-info">
                    <p class="materials-empty-text">Nenhum arquivo ou documento adicional anexado para esta aula.</p>
                  </div>
                </div>
              )}
            </div>
          );
        })()}
      </div>
    </div>

    <!-- Trilha Playlist Sidebar (Collapsible Courses) -->
    <TrilhaSidebar
      trilha={trilha}
      coursesWithModules={coursesWithModules}
      currentLessonId={currentLesson.id}
      currentCourseId={currentLessonItem.courseId}
    />
  </div>

  <!-- AI Challenge Engine Modal -->
  <ChallengeModal />
</Layout>

<script>
  // Challenge Trigger Listeners
  document.querySelectorAll<HTMLButtonElement>('.btn-challenge-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = (btn.getAttribute('data-challenge-mode') || 'lesson') as 'lesson' | 'module';
      const cId = btn.getAttribute('data-course-id') || '';
      const lId = btn.getAttribute('data-lesson-id') || undefined;
      const lTitle = btn.getAttribute('data-lesson-title') || undefined;

      window.dispatchEvent(new CustomEvent('mindflix:open-challenge', {
        detail: {
          mode,
          courseId: cId,
          lessonId: lId,
          lessonTitle: lTitle
        }
      }));
    });
  });
</script>

<style>
  /* Focus Mode Backdrop (60% dark overlay) */
  .focus-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    pointer-events: none;
    z-index: 10;
    transition: opacity 0.35s ease;
  }

  :global(body.focus-mode-active) .focus-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* Floating Focus Bar */
  .focus-mode-bar {
    position: fixed;
    top: 1.25rem;
    left: 50%;
    transform: translate(-50%, -120%);
    opacity: 0;
    pointer-events: none;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 1rem;
    background: rgba(18, 22, 32, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-full);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
  }

  :global(body.focus-mode-active) .focus-mode-bar {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }

  .focus-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  .focus-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: pulse-dot 2s infinite ease-in-out;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .focus-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    padding-left: 0.75rem;
  }

  .focus-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .focus-action-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .focus-action-exit:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.4);
    color: #f87171;
  }

  .watch-layout {
    display: flex;
    padding-top: 72px;
    min-height: calc(100vh - 72px);
    position: relative;
    overflow-x: hidden;
    transition: padding-top 0.35s ease;
  }

  .watch-main-column {
    flex: 1;
    min-width: 0;
    padding: 1.5rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .watch-video-section {
    width: 100%;
    max-width: min(960px, calc((100vh - 220px) * 16 / 9));
    margin: 0 auto;
    position: relative;
    z-index: 20;
    transition: max-width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lesson-details-section {
    width: 100%;
    max-width: min(960px, calc((100vh - 220px) * 16 / 9));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    z-index: 20;
    transition: all 0.35s ease;
  }

  /* === MODO FOCO ATIVO === */
  :global(body.focus-mode-active) .watch-layout {
    padding-top: 4.5rem;
  }

  :global(body.focus-mode-active) .watch-main-column {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    align-items: center;
    padding: 0.5rem 1.5rem 5rem;
  }

  /* Centralizar o vídeo horizontalmente na tela e aumentar escala */
  :global(body.focus-mode-active) .watch-video-section {
    max-width: 1440px;
    width: 92vw;
    margin: 0 auto;
    box-shadow: 0 25px 75px -10px rgba(0, 0, 0, 0.95);
  }

  /* Detalhes da aula com opacidade reduzida no foco, restaurando ao hover */
  :global(body.focus-mode-active) .lesson-details-section {
    max-width: 1440px;
    width: 92vw;
    margin: 0 auto;
    opacity: 0.35;
  }

  :global(body.focus-mode-active) .lesson-details-section:hover {
    opacity: 1;
  }

  /* Recolher a playlist para a direita */
  :global(body.focus-mode-active) :global(.trilha-study-sidebar) {
    transform: translateX(100%);
    margin-right: -420px;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  /* Caso o aluno abra a playlist durante o modo foco */
  :global(body.focus-mode-active.focus-sidebar-open) :global(.trilha-study-sidebar) {
    transform: translateX(0);
    margin-right: 0;
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    position: fixed;
    top: 0;
    right: 0;
    height: 100vh;
    z-index: 50;
    box-shadow: -20px 0 50px rgba(0, 0, 0, 0.85);
  }

  .lesson-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .lesson-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .trilha-context-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-cyan);
    margin-bottom: 0.2rem;
  }

  .trilha-name-tag {
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .course-name-tag {
    color: var(--text-secondary);
  }

  .sep {
    color: var(--text-muted);
  }

  .lesson-main-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .lesson-actions-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  /* Materials */
  .materials-box {
    background: var(--bg-card, #121620);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-lg, 12px);
    padding: 1.25rem 1.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .materials-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .materials-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .materials-icon-circle {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan, #00f2fe);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(0, 242, 254, 0.25);
  }

  .materials-main-heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary, #f1f5f9);
    margin: 0;
    line-height: 1.25;
  }

  .materials-subtitle {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
    margin: 0.2rem 0 0;
  }

  .materials-count-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: var(--radius-full, 9999px);
    white-space: nowrap;
  }

  .materials-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .material-item-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.15rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md, 8px);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .material-item-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(0, 242, 254, 0.3);
    transform: translateY(-1px);
  }

  .material-card-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    flex: 1;
  }

  .type-badge {
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.25rem 0.5rem;
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan, #00f2fe);
    border: 1px solid rgba(0, 242, 254, 0.25);
    border-radius: 6px;
    letter-spacing: 0.5px;
    flex-shrink: 0;
  }

  .type-badge-pdf { background: rgba(239, 68, 68, 0.12); color: #f87171; border-color: rgba(239, 68, 68, 0.25); }
  .type-badge-docx, .type-badge-doc { background: rgba(59, 130, 246, 0.12); color: #60a5fa; border-color: rgba(59, 130, 246, 0.25); }
  .type-badge-zip, .type-badge-rar { background: rgba(234, 179, 8, 0.12); color: #facc15; border-color: rgba(234, 179, 8, 0.25); }
  .type-badge-py, .type-badge-ipynb { background: rgba(16, 185, 129, 0.12); color: #34d399; border-color: rgba(16, 185, 129, 0.25); }

  .material-meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .material-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary, #f1f5f9);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .material-path {
    font-size: 0.75rem;
    color: var(--text-muted, #94a3b8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .material-download-btn {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .materials-empty-state {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.15rem;
    background: rgba(255, 255, 255, 0.015);
    border: 1px dashed rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md, 8px);
  }

  .materials-empty-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted, #94a3b8);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .materials-empty-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .materials-empty-text {
    font-size: 0.84rem;
    color: var(--text-muted, #94a3b8);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .watch-layout {
      flex-direction: column;
      padding-top: 64px;
