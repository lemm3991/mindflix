---
// src/pages/watch/trilha/[trilhaId]/[lessonId].astro - Sala de Aula da Trilha de Formação
import Layout from '../../../../layouts/Layout.astro';
import VideoPlayer from '../../../../components/VideoPlayer.astro';
import TrilhaSidebar from '../../../../components/TrilhaSidebar.astro';
import ChallengeModal from '../../../../components/ChallengeModal.astro';
import { getTrilhaFullStructure, getFirstPlayableLessonInTrilha } from '../../../../lib/trilhas';

const { trilhaId, lessonId } = Astro.params;

if (!trilhaId) {
  return Astro.redirect('/courses');
}

const struct = getTrilhaFullStructure(trilhaId);
if (!struct || struct.allLessons.length === 0) {
  return Astro.redirect('/404');
}

const { trilha, coursesWithModules, allLessons } = struct;

// Find current lesson in trilha
let currentLessonItem = allLessons.find(item => item.lesson.id === lessonId);

if (!currentLessonItem) {
  const firstPlayable = getFirstPlayableLessonInTrilha(trilha.id);
  currentLessonItem = firstPlayable || allLessons[0];
}

const currentLesson = currentLessonItem.lesson;
const currentIdx = allLessons.findIndex(item => item.lesson.id === currentLesson.id);

const prevLessonItem = currentIdx > 0 ? allLessons[currentIdx - 1] : null;
const nextLessonItem = currentIdx < allLessons.length - 1 ? allLessons[currentIdx + 1] : null;

const prevLessonHref = prevLessonItem ? `/watch/trilha/${trilha.id}/${prevLessonItem.lesson.id}` : undefined;
const nextLessonHref = nextLessonItem ? `/watch/trilha/${trilha.id}/${nextLessonItem.lesson.id}` : undefined;
---

<Layout title={`${currentLesson.display_title} — Trilha: ${trilha.title}`} hideNavbar={false}>
  <!-- Background Overlay for Focus Mode (60% dark) -->
  <div class="focus-backdrop" id="focus-backdrop" aria-hidden="true"></div>

  <!-- Focus Mode Floating Bar -->
  <div class="focus-mode-bar" id="focus-mode-bar">
    <div class="focus-pill">
      <span class="focus-pulse-dot"></span>
      <span>Modo Foco Zen</span>
    </div>
    <div class="focus-actions">
      <button type="button" class="focus-action-btn" id="btn-focus-toggle-sidebar" title="Alternar Playlist de Cursos">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span>Playlist da Trilha</span>
      </button>
      <button type="button" class="focus-action-btn focus-action-exit" id="btn-exit-focus" title="Sair do Modo Foco (ESC)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <span>Sair do Foco (ESC)</span>
      </button>
    </div>
  </div>

  <div class="watch-layout">
    <!-- Main Content Area: Video and Details -->
    <div class="watch-main-column">
      <div class="watch-video-section">
        <VideoPlayer
          courseId={currentLessonItem.courseId}
          lesson={currentLesson}
          prevLessonHref={prevLessonHref}
          nextLessonHref={nextLessonHref}
          nextLessonTitle={nextLessonItem?.lesson.display_title}
        />
      </div>

      <!-- Lesson Metadata and Materials -->
      <div class="lesson-details-section">
        <div class="lesson-header-row">
          <div class="lesson-info">
            <div class="trilha-context-breadcrumb">
              <span class="trilha-name-tag">Trilha: {trilha.title}</span>
              <span class="sep">›</span>
              <span class="course-name-tag">{currentLessonItem.courseType} {currentLessonItem.courseOrder}: {currentLessonItem.courseTitle}</span>
            </div>
            <h1 class="lesson-main-title">{currentLesson.display_title}</h1>
          </div>

          <div class="lesson-actions-group">
            <!-- Desafio da Aula Button -->
            <button
              type="button"
              class="btn btn-secondary btn-sm btn-challenge-trigger"
              data-challenge-mode="lesson"
              data-course-id={currentLessonItem.courseId}
              data-lesson-id={currentLesson.id}
              data-lesson-title={currentLesson.display_title}
              title="Iniciar teste interativo desta aula com IA"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
              <span>Desafio com IA</span>
            </button>
          </div>
        </div>

        <!-- Materials (if any) -->
        {(() => {
          const validMaterials = (currentLesson.materials || []).filter((mat: any) => {
            const t = (mat.title || '').toLowerCase();
            const p = (mat.relative_path || '').toLowerCase();
            return !t.includes('artigo') && !t.includes('transcri') && !t.includes('transcript') && !t.includes('article') &&
                   !p.includes('artigo') && !p.includes('transcri') && !p.includes('transcript') && !p.includes('article');
          });

          return validMaterials.length > 0 ? (
            <div class="materials-box">
              <h3 class="materials-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span>Materiais Complementares</span>
              </h3>

              <div class="materials-grid">
                {validMaterials.map((mat: any) => (
                  <div class="material-item-card">
                    <div class="material-icon-badge">
                      <span class="type-badge">{mat.type.toUpperCase()}</span>
                    </div>
                    <div class="material-meta">
                      <strong class="material-name">{mat.title}</strong>
                      <span class="material-path">{mat.relative_path}</span>
                    </div>
                    <a
                      href={mat.drive_file_id ? `https://drive.google.com/uc?export=download&id=${mat.drive_file_id}` : mat.drive_url || `/api/video?path=${encodeURIComponent(mat.relative_path)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-secondary btn-sm"
                      download
                    >
                      Baixar / Visualizar
                    </a>
                  </div>
                ))}
              </div>
            </div>
          ) : null;
        })()}
      </div>
    </div>

    <!-- Trilha Playlist Sidebar (Collapsible Courses) -->
    <TrilhaSidebar
      trilha={trilha}
      coursesWithModules={coursesWithModules}
      currentLessonId={currentLesson.id}
      currentCourseId={currentLessonItem.courseId}
    />
  </div>

  <!-- AI Challenge Engine Modal -->
  <ChallengeModal />
</Layout>

<script>
  // Challenge Trigger Listeners
  document.querySelectorAll<HTMLButtonElement>('.btn-challenge-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = (btn.getAttribute('data-challenge-mode') || 'lesson') as 'lesson' | 'module';
      const cId = btn.getAttribute('data-course-id') || '';
      const lId = btn.getAttribute('data-lesson-id') || undefined;
      const lTitle = btn.getAttribute('data-lesson-title') || undefined;

      window.dispatchEvent(new CustomEvent('mindflix:open-challenge', {
        detail: {
          mode,
          courseId: cId,
          lessonId: lId,
          lessonTitle: lTitle
        }
      }));
    });
  });

  // Focus Mode Controls
  const backdrop = document.getElementById('focus-backdrop');
  const btnExitFocus = document.getElementById('btn-exit-focus');
  const btnToggleSidebar = document.getElementById('btn-focus-toggle-sidebar');
  const btnPlayerFocus = document.getElementById('btn-focus-mode');

  const exitFocusMode = () => {
    document.body.classList.remove('focus-mode-active');
    document.body.classList.remove('focus-sidebar-open');
    btnPlayerFocus?.classList.remove('active');
  };

  backdrop?.addEventListener('click', exitFocusMode);
  btnExitFocus?.addEventListener('click', exitFocusMode);

  btnToggleSidebar?.addEventListener('click', () => {
    document.body.classList.toggle('focus-sidebar-open');
  });
</script>

<style>
  /* Focus Mode Backdrop (60% dark overlay) */
  .focus-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    pointer-events: none;
    z-index: 10;
    transition: opacity 0.35s ease;
  }

  :global(body.focus-mode-active) .focus-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* Floating Focus Bar */
  .focus-mode-bar {
    position: fixed;
    top: 1.25rem;
    left: 50%;
    transform: translate(-50%, -120%);
    opacity: 0;
    pointer-events: none;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 1rem;
    background: rgba(18, 22, 32, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-full);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
  }

  :global(body.focus-mode-active) .focus-mode-bar {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }

  .focus-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  .focus-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: pulse-dot 2s infinite ease-in-out;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .focus-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    padding-left: 0.75rem;
  }

  .focus-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .focus-action-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .focus-action-exit:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.4);
    color: #f87171;
  }

  .watch-layout {
    display: flex;
    padding-top: 72px;
    min-height: calc(100vh - 72px);
    position: relative;
    overflow-x: hidden;
    transition: padding-top 0.35s ease;
  }

  .watch-main-column {
    flex: 1;
    min-width: 0;
    padding: 1.5rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .watch-video-section {
    width: 100%;
    max-width: min(960px, calc((100vh - 220px) * 16 / 9));
    margin: 0 auto;
    position: relative;
    z-index: 20;
    transition: max-width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lesson-details-section {
    width: 100%;
    max-width: min(960px, calc((100vh - 220px) * 16 / 9));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    z-index: 20;
    transition: all 0.35s ease;
  }

  /* === MODO FOCO ATIVO === */
  :global(body.focus-mode-active) .watch-layout {
    padding-top: 4.5rem;
  }

  :global(body.focus-mode-active) .watch-main-column {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    align-items: center;
    padding: 0.5rem 1.5rem 5rem;
  }

  /* Centralizar o vídeo horizontalmente na tela e aumentar escala */
  :global(body.focus-mode-active) .watch-video-section {
    max-width: 1440px;
    width: 92vw;
    margin: 0 auto;
    box-shadow: 0 25px 75px -10px rgba(0, 0, 0, 0.95);
  }

  /* Detalhes da aula com opacidade reduzida no foco, restaurando ao hover */
  :global(body.focus-mode-active) .lesson-details-section {
    max-width: 1440px;
    width: 92vw;
    margin: 0 auto;
    opacity: 0.35;
  }

  :global(body.focus-mode-active) .lesson-details-section:hover {
    opacity: 1;
  }

  /* Recolher a playlist para a direita */
  :global(body.focus-mode-active) :global(.trilha-study-sidebar) {
    transform: translateX(100%);
    margin-right: -420px;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  /* Caso o aluno abra a playlist durante o modo foco */
  :global(body.focus-mode-active.focus-sidebar-open) :global(.trilha-study-sidebar) {
    transform: translateX(0);
    margin-right: 0;
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    position: fixed;
    top: 0;
    right: 0;
    height: 100vh;
    z-index: 50;
    box-shadow: -20px 0 50px rgba(0, 0, 0, 0.85);
  }

  .lesson-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .lesson-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .trilha-context-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-cyan);
    margin-bottom: 0.2rem;
  }

  .trilha-name-tag {
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .course-name-tag {
    color: var(--text-secondary);
  }

  .sep {
    color: var(--text-muted);
  }

  .lesson-main-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .lesson-actions-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  /* Materials */
  .materials-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .materials-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .materials-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .material-item-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .material-icon-badge .type-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.4rem;
    background: rgba(0, 242, 254, 0.1);
    color: var(--accent-cyan);
    border-radius: 4px;
  }

  .material-meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .material-name {
    font-size: 0.875rem;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .material-path {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 1024px) {
    .watch-layout {
      flex-direction: column;
    }
    .watch-main-column {
      padding: 1rem;
    }
  }
</style>
