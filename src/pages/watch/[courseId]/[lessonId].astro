---
// watch/[courseId]/[lessonId].astro - Player e Tela de Estudo
import Layout from '../../../layouts/Layout.astro';
import VideoPlayer from '../../../components/VideoPlayer.astro';
import CourseSidebar from '../../../components/CourseSidebar.astro';
import ChallengeModal from '../../../components/ChallengeModal.astro';
import FocusMode from '../../../components/FocusMode.astro';
import { getCourseById, getFirstPlayableLesson, isPlayableVideoLesson } from '../../../lib/catalog';
import { getCourseSourceId } from '../../../lib/sources';

const { courseId, lessonId } = Astro.params;
const course = courseId ? getCourseById(courseId) : undefined;
const currentCourseSource = course ? getCourseSourceId(course) : 'all';

if (!course) {
  return Astro.redirect('/404');
}

// Find module and lesson
let currentLesson;
let currentModule;
let allLessonsInCourse: any[] = [];

for (const mod of course.modules) {
  for (const les of mod.lessons) {
    allLessonsInCourse.push({ ...les, moduleId: mod.id });
    if (les.id === lessonId) {
      currentLesson = les;
      currentModule = mod;
    }
  }
}

if (!currentLesson) {
  // If lesson not found in course, fallback to first playable lesson or first lesson
  const firstPlayable = getFirstPlayableLesson(course);
  if (firstPlayable) {
    currentLesson = firstPlayable;
    currentModule = course.modules.find(m => m.lessons.some(l => l.id === firstPlayable.id)) || course.modules[0];
  } else if (allLessonsInCourse.length > 0) {
    currentLesson = allLessonsInCourse[0];
    currentModule = course.modules[0];
  } else {
    return Astro.redirect('/courses');
  }
}

const currentIdx = allLessonsInCourse.findIndex(l => l.id === currentLesson.id);
const prevLesson = currentIdx > 0 ? allLessonsInCourse[currentIdx - 1] : null;
const nextLesson = currentIdx < allLessonsInCourse.length - 1 ? allLessonsInCourse[currentIdx + 1] : null;

const prevLessonHref = prevLesson ? `/watch/${course.id}/${prevLesson.id}` : undefined;
const nextLessonHref = nextLesson ? `/watch/${course.id}/${nextLesson.id}` : undefined;

// Check if current lesson is the last lesson of its module
const isLastLessonInModule = Boolean(
  currentModule?.lessons &&
  currentModule.lessons.length > 0 &&
  currentModule.lessons[currentModule.lessons.length - 1].id === currentLesson.id
);
---

<Layout title={`${currentLesson.display_title} — ${course.display_title}`} hideNavbar={false}>
  <script is:inline define:vars={{ currentCourseSource }}>
    window.__CURRENT_VIDEO_SOURCE__ = currentCourseSource;
  </script>
  <!-- Standardized Focus Mode Component -->
  <FocusMode />

  <div class="watch-layout">
    <!-- Main Content Area: Video and Details -->
    <div class="watch-main-column">
      <div class="watch-video-section">
        <VideoPlayer
          courseId={course.id}
          lesson={currentLesson}
          prevLessonHref={prevLessonHref}
          nextLessonHref={nextLessonHref}
          nextLessonTitle={nextLesson?.display_title}
        />
      </div>

      <!-- Lesson Metadata and Materials -->
      <div class="lesson-details-section">
        <div class="lesson-header-row">
          <div class="lesson-info">
            <span class="lesson-module-tag">
              Módulo {currentModule?.order_index}: {currentModule?.display_title}
            </span>
            <h1 class="lesson-main-title">{currentLesson.display_title}</h1>
          </div>

          <div class="lesson-actions-group">
            <!-- Desafio da Aula Button (Always Present) -->
            <button
              type="button"
              class="btn btn-secondary btn-sm btn-challenge-trigger"
              data-challenge-mode="lesson"
              data-course-id={course.id}
              data-lesson-id={currentLesson.id}
              data-lesson-title={currentLesson.display_title}
              title="Iniciar teste interativo desta aula com IA"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
              <span>Desafio da Aula</span>
            </button>

            <!-- Desafio do Módulo Button (Present on Last Lesson of Module) -->
            {isLastLessonInModule && (
              <button
                type="button"
                class="btn btn-primary btn-sm btn-challenge-trigger btn-challenge-module"
                data-challenge-mode="module"
                data-course-id={course.id}
                data-module-id={currentModule?.id}
                data-module-title={currentModule?.display_title}
                title="Iniciar avaliação completa de todas as aulas deste módulo com IA"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                  <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                  <path d="M4 22h16"></path>
                  <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                  <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                  <path d="M18 2H6v7a6 6 0 0 0 12 0V2z"></path>
                </svg>
                <span>Desafio do Módulo</span>
              </button>
            )}

            <button type="button" class="btn btn-secondary btn-sm" id="btn-watch-grade-modal" data-course-id={course.id}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
              <span>Grade Completa</span>
            </button>
          </div>
        </div>

        <!-- Complementary Materials & Documents Section (Always visible by default) -->
        {(() => {
          // 1. Materials explicitly attached to currentLesson
          const lessonMaterials = (currentLesson.materials || []).map((mat: any) => ({
            id: mat.id || mat.relative_path,
            title: mat.title || 'Material Complementar',
            type: (mat.type || 'ARQUIVO').toUpperCase(),
            relative_path: mat.relative_path || '',
            url: mat.drive_file_id 
              ? `https://drive.google.com/uc?export=download&id=${mat.drive_file_id}` 
              : (mat.drive_url || `/api/video?path=${encodeURIComponent(mat.relative_path)}`),
            driveId: mat.drive_file_id
          }));

          // 2. Non-video lessons in the current module (e.g. PDFs, docs, zips, spreadsheets)
          const moduleFiles = (currentModule?.lessons || [])
            .filter((les: any) => !isPlayableVideoLesson(les) && les.id !== currentLesson.id)
            .map((les: any) => {
              const ext = (les.relative_path || '').split('.').pop()?.toUpperCase() || (les.type || 'FILE').toUpperCase();
              return {
                id: les.id,
                title: les.display_title || les.raw_title,
                type: ext,
                relative_path: les.relative_path || '',
                url: les.drive_file_id 
                  ? `https://drive.google.com/uc?export=download&id=${les.drive_file_id}` 
                  : (les.drive_url || `/api/video?path=${encodeURIComponent(les.relative_path)}`),
                driveId: les.drive_file_id
              };
            });

          // 3. Non-video lessons in other modules of the course if moduleFiles is empty
          const otherCourseFiles = moduleFiles.length === 0 ? (course.modules || [])
            .flatMap((mod: any) => mod.lessons || [])
            .filter((les: any) => !isPlayableVideoLesson(les) && les.id !== currentLesson.id)
            .map((les: any) => {
              const ext = (les.relative_path || '').split('.').pop()?.toUpperCase() || (les.type || 'FILE').toUpperCase();
              return {
                id: les.id,
                title: les.display_title || les.raw_title,
                type: ext,
                relative_path: les.relative_path || '',
                url: les.drive_file_id 
                  ? `https://drive.google.com/uc?export=download&id=${les.drive_file_id}` 
                  : (les.drive_url || `/api/video?path=${encodeURIComponent(les.relative_path)}`),
                driveId: les.drive_file_id
              };
            }) : [];

          // Combine and deduplicate materials
          const seen = new Set<string>();
          const allMaterials = [...lessonMaterials, ...moduleFiles, ...otherCourseFiles].filter(item => {
            const key = item.url || item.id || item.title;
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          });

          const driveFolderUrl = (course as any).drive_folder_url || ((course as any).drive_folder_id ? `https://drive.google.com/drive/folders/${(course as any).drive_folder_id}` : null);

          return (
            <div class="materials-box" id="watch-materials-section">
              <div class="materials-header">
                <div class="materials-title-wrap">
                  <div class="materials-icon-circle">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7 10 12 15 17 10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                  </div>
                  <div>
                    <h3 class="materials-main-heading">Arquivos e Materiais para Download</h3>
                    <p class="materials-subtitle">Apostilas, códigos, PDFs e materiais de apoio deste curso</p>
                  </div>
                </div>

                {allMaterials.length > 0 && (
                  <span class="materials-count-pill">{allMaterials.length} {allMaterials.length === 1 ? 'arquivo' : 'arquivos'}</span>
                )}
              </div>

              {allMaterials.length > 0 ? (
                <div class="materials-grid">
                  {allMaterials.map((mat: any) => (
                    <div class="material-item-card">
                      <div class="material-card-left">
                        <span class={`type-badge type-badge-${mat.type.toLowerCase()}`}>{mat.type}</span>
                        <div class="material-meta">
                          <strong class="material-name">{mat.title}</strong>
                          {mat.relative_path && <span class="material-path">{mat.relative_path}</span>}
                        </div>
                      </div>
                      <a
                        href={mat.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary btn-sm material-download-btn"
                        download
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="7 10 12 15 17 10"></polyline>
                          <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <span>Baixar / Visualizar</span>
                      </a>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="materials-empty-state">
                  <div class="materials-empty-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                  </div>
                  <div class="materials-empty-info">
                    <p class="materials-empty-text">Nenhum arquivo ou documento adicional anexado para esta aula.</p>
                    {driveFolderUrl && (
                      <a
                        href={driveFolderUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary btn-sm materials-drive-btn"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span>Acessar Pasta do Curso no Google Drive</span>
                      </a>
                    )}
                  </div>
                </div>
              )}
            </div>
          );
        })()}
      </div>
    </div>

    <!-- Course Syllabus Sidebar -->
    <CourseSidebar
      course={course}
      currentLessonId={currentLesson.id}
    />
  </div>

  <!-- AI Challenge Engine Modal -->
  <ChallengeModal />
</Layout>

<script>
  const gradeBtn = document.getElementById('btn-watch-grade-modal');
  if (gradeBtn) {
    gradeBtn.addEventListener('click', () => {
      const courseId = gradeBtn.getAttribute('data-course-id');
      if (courseId && (window as any).openCourseModal) {
        (window as any).openCourseModal(courseId);
      }
    });
  }

  // Challenge Trigger Listeners
  document.querySelectorAll<HTMLButtonElement>('.btn-challenge-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = (btn.getAttribute('data-challenge-mode') || 'lesson') as 'lesson' | 'module';
      const cId = btn.getAttribute('data-course-id') || '';
      const lId = btn.getAttribute('data-lesson-id') || undefined;
      const mId = btn.getAttribute('data-module-id') || undefined;
      const lTitle = btn.getAttribute('data-lesson-title') || undefined;
      const mTitle = btn.getAttribute('data-module-title') || undefined;

      window.dispatchEvent(new CustomEvent('mindflix:open-challenge', {
        detail: {
          mode,
          courseId: cId,
          lessonId: lId,
          moduleId: mId,
          lessonTitle: lTitle,
          moduleTitle: mTitle
        }
      }));
    });
  });
</script>

<style>
  .lesson-actions-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .btn-challenge-module {
    background: linear-gradient(135deg, #8b5cf6 0%, #a855f7 100%) !important;
    color: #ffffff !important;
    box-shadow: 0 4px 16px rgba(168, 85, 247, 0.35) !important;
    border: none !important;
  }

  .btn-challenge-module:hover {
    box-shadow: 0 6px 24px rgba(168, 85, 247, 0.55) !important;
    transform: translateY(-1px) !important;
  }
  /* Focus Mode Backdrop (60% dark overlay) */
  .focus-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    pointer-events: none;
    z-index: 10;
    transition: opacity 0.35s ease;
  }

  :global(body.focus-mode-active) .focus-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* Floating Focus Bar */
  .focus-mode-bar {
    position: fixed;
    top: 1.25rem;
    left: 50%;
    transform: translate(-50%, -120%);
    opacity: 0;
    pointer-events: none;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 1rem;
    background: rgba(18, 22, 32, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-full);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
  }

  :global(body.focus-mode-active) .focus-mode-bar {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }

  .focus-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  .focus-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: pulse-dot 2s infinite ease-in-out;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .focus-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    padding-left: 0.75rem;
  }

  .focus-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .focus-action-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .focus-action-exit:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.4);
    color: #f87171;
  }

  .watch-layout {
    display: flex;
    padding-top: 72px;
    min-height: calc(100vh - 72px);
    position: relative;
    overflow-x: hidden;
    transition: padding-top 0.35s ease;
  }

  .watch-main-column {
    flex: 1;
    min-width: 0;
    padding: 1.5rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .watch-video-section {
    width: 100%;
    max-width: min(960px, calc((100vh - 220px) * 16 / 9));
    margin: 0 auto;
    position: relative;
    z-index: 20;
    transition: max-width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lesson-details-section {
    width: 100%;
    max-width: min(960px, calc((100vh - 220px) * 16 / 9));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    z-index: 20;
    transition: all 0.35s ease;
  }

  /* === MODO FOCO ATIVO === */
  :global(body.focus-mode-active) .watch-layout {
    padding-top: 4.5rem;
  }

  :global(body.focus-mode-active) .watch-main-column {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    align-items: center;
    padding: 0.5rem 1.5rem 5rem;
  }

  /* Centralizar o vídeo horizontalmente na tela e aumentar levemente a escala do vídeo */
  :global(body.focus-mode-active) .watch-video-section {
    max-width: 1440px;
    width: 92vw;
    margin: 0 auto;
    box-shadow: 0 25px 75px -10px rgba(0, 0, 0, 0.95);
  }

  /* Detalhes da aula com opacidade reduzida no foco, restaurando ao hover */
  :global(body.focus-mode-active) .lesson-details-section {
    max-width: 1440px;
    width: 92vw;
    margin: 0 auto;
    opacity: 0.35;
  }

  :global(body.focus-mode-active) .lesson-details-section:hover {
    opacity: 1;
  }

  /* Recolher a playlist para a direita */
  :global(body.focus-mode-active) :global(.course-study-sidebar) {
    transform: translateX(100%);
    margin-right: -420px;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  /* Caso o aluno abra a playlist durante o modo foco */
  :global(body.focus-mode-active.focus-sidebar-open) :global(.course-study-sidebar) {
    transform: translateX(0);
    margin-right: 0;
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    position: fixed;
    top: 0;
    right: 0;
    height: 100vh;
    z-index: 50;
    box-shadow: -20px 0 50px rgba(0, 0, 0, 0.85);
  }

  .lesson-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .lesson-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .lesson-module-tag {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-cyan);
  }

  .lesson-main-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .materials-box {
    background: var(--bg-card, #121620);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-lg, 12px);
    padding: 1.25rem 1.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .materials-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .materials-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .materials-icon-circle {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan, #00f2fe);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(0, 242, 254, 0.25);
  }

  .materials-main-heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary, #f1f5f9);
    margin: 0;
    line-height: 1.25;
  }

  .materials-subtitle {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
    margin: 0.2rem 0 0;
  }

  .materials-count-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: var(--radius-full, 9999px);
    white-space: nowrap;
  }

  .materials-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .material-item-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.15rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md, 8px);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .material-item-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(0, 242, 254, 0.3);
    transform: translateY(-1px);
  }

  .material-card-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    flex: 1;
  }

  .type-badge {
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.25rem 0.5rem;
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan, #00f2fe);
    border: 1px solid rgba(0, 242, 254, 0.25);
    border-radius: 6px;
    letter-spacing: 0.5px;
