---
// watch/[courseId]/[lessonId].astro - Player e Tela de Estudo
import Layout from '../../../layouts/Layout.astro';
import VideoPlayer from '../../../components/VideoPlayer.astro';
import CourseSidebar from '../../../components/CourseSidebar.astro';
import { getCourseById } from '../../../lib/catalog';

const { courseId, lessonId } = Astro.params;
const course = courseId ? getCourseById(courseId) : undefined;

if (!course) {
  return Astro.redirect('/404');
}

// Find module and lesson
let currentLesson;
let currentModule;
let allLessonsInCourse: any[] = [];

for (const mod of course.modules) {
  for (const les of mod.lessons) {
    allLessonsInCourse.push({ ...les, moduleId: mod.id });
    if (les.id === lessonId) {
      currentLesson = les;
      currentModule = mod;
    }
  }
}

if (!currentLesson) {
  // If lesson not found in course, fallback to first lesson or course details
  if (allLessonsInCourse.length > 0) {
    currentLesson = allLessonsInCourse[0];
    currentModule = course.modules[0];
  } else {
    return Astro.redirect('/courses');
  }
}

const currentIdx = allLessonsInCourse.findIndex(l => l.id === currentLesson.id);
const prevLesson = currentIdx > 0 ? allLessonsInCourse[currentIdx - 1] : null;
const nextLesson = currentIdx < allLessonsInCourse.length - 1 ? allLessonsInCourse[currentIdx + 1] : null;

const prevLessonHref = prevLesson ? `/watch/${course.id}/${prevLesson.id}` : undefined;
const nextLessonHref = nextLesson ? `/watch/${course.id}/${nextLesson.id}` : undefined;
---

<Layout title={`${currentLesson.display_title} — ${course.display_title}`} hideNavbar={false}>
  <!-- Background Overlay for Focus Mode (60% dark) -->
  <div class="focus-backdrop" id="focus-backdrop" aria-hidden="true"></div>

  <!-- Focus Mode Floating Bar -->
  <div class="focus-mode-bar" id="focus-mode-bar">
    <div class="focus-pill">
      <span class="focus-pulse-dot"></span>
      <span>Modo Foco Zen</span>
    </div>
    <div class="focus-actions">
      <button type="button" class="focus-action-btn" id="btn-focus-toggle-sidebar" title="Alternar Playlist de Aulas">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span>Playlist</span>
      </button>
      <button type="button" class="focus-action-btn focus-action-exit" id="btn-exit-focus" title="Sair do Modo Foco (ESC)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <span>Sair do Foco (ESC)</span>
      </button>
    </div>
  </div>

  <div class="watch-layout">
    <!-- Main Content Area: Video and Details -->
    <div class="watch-main-column">
      <div class="watch-video-section">
        <VideoPlayer
          courseId={course.id}
          lesson={currentLesson}
          prevLessonHref={prevLessonHref}
          nextLessonHref={nextLessonHref}
          nextLessonTitle={nextLesson?.display_title}
        />
      </div>

      <!-- Lesson Metadata and Materials -->
      <div class="lesson-details-section">
        <div class="lesson-header-row">
          <div class="lesson-info">
            <span class="lesson-module-tag">
              Módulo {currentModule?.order_index}: {currentModule?.display_title}
            </span>
            <h1 class="lesson-main-title">{currentLesson.display_title}</h1>
          </div>

          <button type="button" class="btn btn-secondary btn-sm" id="btn-watch-grade-modal" data-course-id={course.id}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
            <span>Grade Completa</span>
          </button>
        </div>

        <!-- Complementary Materials & Documents (Excluding articles and transcripts) -->
        {(() => {
          const validMaterials = (currentLesson.materials || []).filter((mat: any) => {
            const t = (mat.title || '').toLowerCase();
            const p = (mat.relative_path || '').toLowerCase();
            return !t.includes('artigo') && !t.includes('transcri') && !t.includes('transcript') && !t.includes('article') &&
                   !p.includes('artigo') && !p.includes('transcri') && !p.includes('transcript') && !p.includes('article');
          });

          return validMaterials.length > 0 ? (
            <div class="materials-box">
              <h3 class="materials-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span>Materiais Complementares</span>
              </h3>

              <div class="materials-grid">
                {validMaterials.map((mat: any) => (
                  <div class="material-item-card">
                    <div class="material-icon-badge">
                      <span class="type-badge">{mat.type.toUpperCase()}</span>
                    </div>
                    <div class="material-meta">
                      <strong class="material-name">{mat.title}</strong>
                      <span class="material-path">{mat.relative_path}</span>
                    </div>
                    <a
                      href={`/api/video?path=${encodeURIComponent(mat.relative_path)}`}
                      target="_blank"
                      class="btn btn-secondary btn-sm"
                      download
                    >
                      Baixar / Visualizar
                    </a>
                  </div>
                ))}
              </div>
            </div>
          ) : null;
        })()}
      </div>
    </div>

    <!-- Course Syllabus Sidebar -->
    <CourseSidebar
      course={course}
      currentLessonId={currentLesson.id}
    />
  </div>
</Layout>

<script>
  const gradeBtn = document.getElementById('btn-watch-grade-modal');
  if (gradeBtn) {
    gradeBtn.addEventListener('click', () => {
      const courseId = gradeBtn.getAttribute('data-course-id');
      if (courseId && (window as any).openCourseModal) {
        (window as any).openCourseModal(courseId);
      }
    });
  }

  // Focus Mode Controls
  const backdrop = document.getElementById('focus-backdrop');
  const btnExitFocus = document.getElementById('btn-exit-focus');
  const btnToggleSidebar = document.getElementById('btn-focus-toggle-sidebar');
  const btnPlayerFocus = document.getElementById('btn-focus-mode');

  const exitFocusMode = () => {
    document.body.classList.remove('focus-mode-active');
    document.body.classList.remove('focus-sidebar-open');
    btnPlayerFocus?.classList.remove('active');
  };

  backdrop?.addEventListener('click', exitFocusMode);
  btnExitFocus?.addEventListener('click', exitFocusMode);

  btnToggleSidebar?.addEventListener('click', () => {
    document.body.classList.toggle('focus-sidebar-open');
  });
</script>

<style>
  /* Focus Mode Backdrop (60% dark overlay) */
  .focus-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    pointer-events: none;
    z-index: 10;
    transition: opacity 0.35s ease;
  }

  :global(body.focus-mode-active) .focus-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* Floating Focus Bar */
  .focus-mode-bar {
    position: fixed;
    top: 1.25rem;
    left: 50%;
    transform: translate(-50%, -120%);
    opacity: 0;
    pointer-events: none;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 1rem;
    background: rgba(18, 22, 32, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-full);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
  }

  :global(body.focus-mode-active) .focus-mode-bar {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }

  .focus-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  .focus-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: pulse-dot 2s infinite ease-in-out;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .focus-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    padding-left: 0.75rem;
  }

  .focus-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .focus-action-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .focus-action-exit:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.4);
    color: #f87171;
  }

  .watch-layout {
    display: flex;
    padding-top: 72px;
    min-height: calc(100vh - 72px);
    position: relative;
    overflow-x: hidden;
    transition: padding-top 0.35s ease;
  }

  .watch-main-column {
    flex: 1;
    min-width: 0;
    padding: 1.5rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .watch-video-section {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 20;
    transition: max-width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lesson-details-section {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    z-index: 20;
    transition: all 0.35s ease;
  }

  /* === MODO FOCO ATIVO === */
  :global(body.focus-mode-active) .watch-layout {
    padding-top: 4.5rem;
  }

  :global(body.focus-mode-active) .watch-main-column {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    align-items: center;
    padding: 0.5rem 2rem 5rem;
  }

  /* Centralizar o vídeo horizontalmente na tela com largura expandida */
  :global(body.focus-mode-active) .watch-video-section {
    max-width: 1240px;
    margin: 0 auto;
    box-shadow: 0 25px 70px -15px rgba(0, 0, 0, 0.95);
  }

  /* Detalhes da aula com opacidade reduzida no foco, restaurando ao hover */
  :global(body.focus-mode-active) .lesson-details-section {
    max-width: 1240px;
    margin: 0 auto;
    opacity: 0.4;
  }

  :global(body.focus-mode-active) .lesson-details-section:hover {
    opacity: 1;
  }

  /* Recolher a playlist para a direita */
  :global(body.focus-mode-active) :global(.course-study-sidebar) {
    transform: translateX(100%);
    margin-right: -380px;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  /* Caso o aluno abra a playlist durante o modo foco */
  :global(body.focus-mode-active.focus-sidebar-open) :global(.course-study-sidebar) {
    transform: translateX(0);
    margin-right: 0;
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    position: fixed;
    top: 0;
    right: 0;
    height: 100vh;
    z-index: 50;
    box-shadow: -20px 0 50px rgba(0, 0, 0, 0.85);
  }

  .lesson-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .lesson-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .lesson-module-tag {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-cyan);
  }

  .lesson-main-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .materials-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .materials-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .materials-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .material-item-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .material-icon-badge .type-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.4rem;
    background: rgba(0, 242, 254, 0.1);
    color: var(--accent-cyan);
    border-radius: 4px;
  }

  .material-meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .material-name {
    font-size: 0.875rem;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .material-path {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 1024px) {
    .watch-layout {
      flex-direction: column;
    }
    .watch-main-column {
      padding: 1rem;
    }
  }
</style>
