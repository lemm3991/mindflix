---
// src/pages/security-monitor.astro - Security Operations Center (SOC) & Real-Time IPS Dashboard
import Layout from '../layouts/Layout.astro';
import {
  getSecurityStats,
  getBannedIps,
  getWhitelist,
  getAttackLogs,
  getSecuritySettings
} from '../lib/server/security-monitor';

// SSR initial data load
const initialStats = getSecurityStats();
const initialBans = getBannedIps();
const initialWhitelist = getWhitelist();
const initialLogs = getAttackLogs(50);
const initialSettings = getSecuritySettings();
---

<Layout
  title="Monitor de Segurança & IPS • Mindflix SOC"
  description="Painel do Centro de Operações de Segurança (SOC) com telemetria em tempo real, detecção de ameaças e sistema de bloqueio automático de IPs."
>
  <div class="soc-container">
    <!-- Header Section with DEFCON Alert & Quick Controls -->
    <header class="soc-header">
      <div class="header-left">
        <div class="soc-brand">
          <div class="radar-pulse">
            <span class="pulse-ring"></span>
            <span class="radar-core"></span>
          </div>
          <div>
            <div class="soc-title-row">
              <h1 class="soc-title">SECURITY OPERATIONS CENTER</h1>
              <span class="soc-version-badge">IPS v2.4 • REALTIME</span>
            </div>
            <p class="soc-subtitle">Monitoramento contínuo de tráfego, detecção preditiva de invasão e escudo automático de mitigação</p>
          </div>
        </div>
      </div>

      <div class="header-right">
        <!-- DEFCON Status Card -->
        <div class="defcon-card" id="defcon-card" data-level={initialStats.defconLevel}>
          <div class="defcon-label">STATUS DE DEFESA</div>
          <div class="defcon-indicator">
            <span class="defcon-badge" id="defcon-badge">DEFCON {initialStats.defconLevel}</span>
            <span class="defcon-text" id="defcon-health-text">{initialStats.systemHealth}</span>
          </div>
        </div>

        <div class="header-actions">
          <button type="button" class="soc-btn secondary-btn" id="btn-refresh-telemetry" title="Atualizar dados agora">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M23 4v6h-6"></path>
              <path d="M1 20v-6h6"></path>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
            <span>Atualizar</span>
          </button>

          <button type="button" class="soc-btn danger-btn" id="btn-clear-logs" title="Limpar histórico de logs">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            <span>Limpar Logs</span>
          </button>

          <label class="toggle-switch-label" title="Atualização contínua a cada 3 segundos">
            <input type="checkbox" id="auto-refresh-toggle" checked />
            <span class="toggle-slider"></span>
            <span class="toggle-text">Live Feed</span>
          </label>
        </div>
      </div>
    </header>

    <!-- Top Telemetry KPI Cards -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Requisições Analisadas</span>
          <div class="kpi-icon icon-blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          </div>
        </div>
        <div class="kpi-value" id="kpi-total-requests">{initialStats.totalRequests.toLocaleString('pt-BR')}</div>
        <div class="kpi-subtext"><span class="badge-tag live-tag">WAF ATIVO</span> Inspecionando 100% dos pacotes HTTP/S</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Ataques Neutralizados</span>
          <div class="kpi-icon icon-red">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
        </div>
        <div class="kpi-value text-red" id="kpi-attacks-blocked">{initialStats.attacksBlocked.toLocaleString('pt-BR')}</div>
        <div class="kpi-subtext">
          <span class="sub-highlight" id="kpi-attacks-detected">{initialStats.attacksDetected}</span> ameaças detectadas no total
        </div>
      </div>

      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">IPs Bloqueados no Momento</span>
          <div class="kpi-icon icon-amber">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
          </div>
        </div>
        <div class="kpi-value text-amber" id="kpi-active-bans">{initialStats.activeBansCount}</div>
        <div class="kpi-subtext">Auto-Ban acionado por pontuação de risco acumulada</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Eficácia do IPS</span>
          <div class="kpi-icon icon-emerald">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
        </div>
        <div class="kpi-value text-emerald" id="kpi-mitigation-rate">100%</div>
        <div class="kpi-subtext">Latência média de inspeção &lt; 0.4ms</div>
      </div>
    </div>

    <!-- Main SOC Grid: Control Deck (Left) + Attack Stream & Bans (Right) -->
    <div class="soc-main-grid">
      <!-- LEFT COLUMN: Simulator, Quick Ban, Settings, Whitelist -->
      <div class="soc-sidebar-column">
        <!-- 1. Interactive Attack Simulator -->
        <div class="soc-panel simulator-panel">
          <div class="panel-header">
            <div class="panel-title-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <h2 class="panel-title">Simulador de Ataques Interativo</h2>
            </div>
            <span class="panel-badge">AUDITORIA AO VIVO</span>
          </div>
          <p class="panel-desc">
            Dispare payloads de teste contra os filtros de inspeção para validar a resposta do IPS e o acionamento do auto-bloqueio de IPs.
          </p>

          <div class="simulator-actions-grid">
            <button type="button" class="sim-btn sim-sqli" data-attack-type="SQL_INJECTION">
              <span class="sim-btn-icon">💉</span>
              <div class="sim-btn-texts">
                <strong>SQL Injection</strong>
                <small>UNION SELECT & Bypass</small>
              </div>
            </button>

            <button type="button" class="sim-btn sim-xss" data-attack-type="XSS">
              <span class="sim-btn-icon">⚡</span>
              <div class="sim-btn-texts">
                <strong>Cross-Site Scripting</strong>
                <small>XSS & Cookie Stealer</small>
              </div>
            </button>

            <button type="button" class="sim-btn sim-traversal" data-attack-type="PATH_TRAVERSAL">
              <span class="sim-btn-icon">📁</span>
              <div class="sim-btn-texts">
                <strong>Path Traversal / LFI</strong>
                <small>Acesso a /.env e /passwd</small>
              </div>
            </button>

            <button type="button" class="sim-btn sim-scanner" data-attack-type="MALICIOUS_SCANNER">
              <span class="sim-btn-icon">🤖</span>
              <div class="sim-btn-texts">
                <strong>Bot Scanner</strong>
                <small>wp-login / phpmyadmin</small>
              </div>
            </button>

            <button type="button" class="sim-btn sim-agent" data-attack-type="BAD_USER_AGENT">
              <span class="sim-btn-icon">🕵️</span>
              <div class="sim-btn-texts">
                <strong>Bad User-Agent</strong>
                <small>sqlmap / nikto signature</small>
              </div>
            </button>

            <button type="button" class="sim-btn sim-burst" data-attack-type="RATE_ABUSE">
              <span class="sim-btn-icon">🌊</span>
              <div class="sim-btn-texts">
                <strong>Request Burst</strong>
                <small>Explosão volumétrica DoS</small>
              </div>
            </button>
          </div>

          <div class="custom-sim-box">
            <div class="input-row">
              <input type="text" id="sim-custom-ip" class="soc-input" placeholder="IP Alvo da Simulação (vazio = aleatório)" />
              <button type="button" class="soc-btn primary-btn" id="btn-run-custom-sim">Executar</button>
            </div>
          </div>
        </div>

        <!-- 2. Manual IP Ban Form -->
        <div class="soc-panel">
          <div class="panel-header">
            <div class="panel-title-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-red">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
              </svg>
              <h2 class="panel-title">Bloqueio Manual de IP</h2>
            </div>
          </div>

          <form id="form-manual-ban" class="soc-form">
            <div class="form-group">
              <label for="ban-ip-input">Endereço IP</label>
              <input type="text" id="ban-ip-input" class="soc-input" placeholder="ex: 185.220.101.5" required />
            </div>

            <div class="form-group">
              <label for="ban-reason-input">Motivo do Bloqueio</label>
              <input type="text" id="ban-reason-input" class="soc-input" placeholder="ex: Tentativa suspeita de varredura" />
            </div>

            <div class="form-row">
              <div class="form-group flex-1">
                <label for="ban-duration-select">Duração</label>
                <select id="ban-duration-select" class="soc-select">
                  <option value="15">15 minutos</option>
                  <option value="60" selected>1 hora</option>
                  <option value="1440">24 horas</option>
                  <option value="10080">7 dias</option>
                  <option value="0">Permanente</option>
                </select>
              </div>
              <button type="submit" class="soc-btn danger-solid-btn align-end">Bloquear IP</button>
            </div>
          </form>
        </div>

        <!-- 3. Whitelist Manager -->
        <div class="soc-panel">
          <div class="panel-header">
            <div class="panel-title-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <h2 class="panel-title">Whitelist de IPs Confiáveis</h2>
            </div>
          </div>

          <form id="form-add-whitelist" class="soc-form inline-form">
            <input type="text" id="wl-ip-input" class="soc-input" placeholder="Adicionar IP confiável..." required />
            <button type="submit" class="soc-btn success-btn">Adicionar</button>
          </form>

          <div class="whitelist-list" id="whitelist-container">
            {initialWhitelist.map(item => (
              <div class="whitelist-item" data-ip={item.ip}>
                <div class="wl-item-left">
                  <span class="wl-dot"></span>
                  <strong class="wl-ip">{item.ip}</strong>
                  <span class="wl-note">{item.note || 'Confiável'}</span>
                </div>
                {item.ip !== '127.0.0.1' && item.ip !== '::1' && item.ip !== 'localhost' && (
                  <button type="button" class="btn-remove-wl" data-ip={item.ip} title="Remover da whitelist">
                    &times;
                  </button>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- 4. IPS Settings Card -->
        <div class="soc-panel">
          <div class="panel-header">
            <div class="panel-title-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-indigo">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
              <h2 class="panel-title">Parâmetros do IPS / Firewall</h2>
            </div>
          </div>

          <form id="form-ips-settings" class="soc-form">
            <div class="setting-toggle-row">
              <div>
                <strong>Auto-Bloqueio Ativo</strong>
                <small>Banir IPs automaticamente ao atingir limite</small>
              </div>
              <input type="checkbox" id="setting-auto-ban" checked={initialSettings.autoBanEnabled} />
            </div>

            <div class="form-group">
              <label for="setting-threshold">Limiar de Pontuação para Auto-Ban (pts)</label>
              <input type="number" id="setting-threshold" class="soc-input" value={initialSettings.autoBanThreshold} min="20" max="500" step="10" />
            </div>

            <div class="form-group">
              <label for="setting-duration">Duração do Ban Automático (minutos)</label>
              <input type="number" id="setting-duration" class="soc-input" value={initialSettings.banDurationMinutes} min="5" max="10080" step="5" />
            </div>

            <div class="form-group">
              <label for="setting-sensitivity">Sensibilidade da Heurística</label>
              <select id="setting-sensitivity" class="soc-select">
                <option value="LOW" selected={initialSettings.sensitivity === 'LOW'}>Baixa (Menos falsos positivos)</option>
                <option value="NORMAL" selected={initialSettings.sensitivity === 'NORMAL'}>Normal (Equilíbrio recomendado)</option>
                <option value="AGGRESSIVE" selected={initialSettings.sensitivity === 'AGGRESSIVE'}>Agressiva (Bloqueio estrito)</option>
              </select>
            </div>

            <button type="submit" class="soc-btn primary-btn full-width">Salvar Configurações</button>
          </form>
        </div>
      </div>

      <!-- RIGHT COLUMN: Active Bans Table & Live Threat Stream -->
      <div class="soc-content-column">
        <!-- 1. Active Banned IPs Section -->
        <div class="soc-panel">
          <div class="panel-header">
            <div class="panel-title-wrap">
              <span class="active-pulse-dot"></span>
              <h2 class="panel-title">IPs Bloqueados em Execução (<span id="bans-count-badge">{initialBans.length}</span>)</h2>
            </div>
            <span class="panel-badge-red">ESCUDO 403 ATIVO</span>
          </div>

          <div class="table-responsive">
            <table class="soc-table" id="table-banned-ips">
              <thead>
                <tr>
                  <th>IP de Origem</th>
                  <th>Protocolo</th>
                  <th>Motivo / Vetor</th>
                  <th>Ameaça</th>
                  <th>Expiração</th>
                  <th style="text-align: right;">Ação</th>
                </tr>
              </thead>
              <tbody id="banned-ips-tbody">
                {initialBans.length === 0 ? (
                  <tr class="empty-row">
                    <td colspan="6">Nenhum IP bloqueado no momento. Sistema operando de forma limpa.</td>
                  </tr>
                ) : (
                  initialBans.map(ban => {
                    const timeLeft = ban.expiresAt
                      ? Math.max(1, Math.ceil((ban.expiresAt - Date.now()) / 60000)) + ' min'
                      : 'Permanente';
                    return (
                      <tr data-ip={ban.ip}>
                        <td>
                          <span class="ip-tag font-mono">{ban.ip}</span>
                        </td>
                        <td>
                          <span class="incident-id font-mono">{ban.incidentId}</span>
                        </td>
                        <td>
                          <span class="ban-reason" title={ban.reason}>{ban.reason}</span>
                        </td>
                        <td>
                          <span class="threat-score-pill">{ban.totalThreatScore} pts</span>
                        </td>
                        <td>
                          <span class="time-left-tag">{timeLeft}</span>
                        </td>
                        <td style="text-align: right;">
                          <button type="button" class="btn-unban-ip" data-ip={ban.ip} title="Desbloquear este IP imediatamente">
                            Desbloquear
                          </button>
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Live Attack Log Terminal / Stream -->
        <div class="soc-panel flex-1">
          <div class="panel-header">
            <div class="panel-title-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan">
                <polyline points="4 17 10 11 4 5"></polyline>
                <line x1="12" y1="19" x2="20" y2="19"></line>
              </svg>
              <h2 class="panel-title">Feed de Ameaças em Tempo Real</h2>
            </div>

            <!-- Filters -->
            <div class="log-filter-controls">
              <select id="filter-severity" class="soc-select-sm">
                <option value="ALL">Severidade: Todas</option>
                <option value="CRITICAL">Crítica</option>
                <option value="HIGH">Alta</option>
                <option value="MEDIUM">Média</option>
                <option value="LOW">Baixa</option>
              </select>

              <select id="filter-attack-type" class="soc-select-sm">
                <option value="ALL">Tipo: Todos</option>
                <option value="SQL_INJECTION">SQL Injection</option>
                <option value="XSS">XSS</option>
                <option value="PATH_TRAVERSAL">Path Traversal</option>
                <option value="MALICIOUS_SCANNER">Malicious Scanner</option>
                <option value="BAD_USER_AGENT">Bad User-Agent</option>
                <option value="RATE_ABUSE">Rate Abuse</option>
              </select>
            </div>
          </div>

          <div class="logs-stream-container" id="logs-stream-container">
            {initialLogs.length === 0 ? (
              <div class="empty-logs-placeholder" id="empty-logs-msg">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <p>Nenhuma anomalia ou ataque registrado recentemente.</p>
                <small>Use o simulador ao lado para testar a detecção.</small>
              </div>
            ) : (
              initialLogs.map(log => {
                const timeStr = new Date(log.timestamp).toLocaleTimeString('pt-BR');
                return (
                  <div class={`log-event-row sev-${log.severity.toLowerCase()}`} data-id={log.id}>
                    <div class="log-event-header">
                      <div class="log-header-left">
                        <span class={`sev-badge sev-badge-${log.severity.toLowerCase()}`}>{log.severity}</span>
                        <span class="attack-type-tag">{log.attackType}</span>
                        <span class="log-ip font-mono">{log.ip}</span>
                        <span class="log-path font-mono">{log.method} {log.path}</span>
                      </div>
                      <div class="log-header-right">
                        <span class="action-tag action-{log.actionTaken.toLowerCase()}">{log.actionTaken}</span>
                        <span class="log-time font-mono">{timeStr}</span>
                      </div>
                    </div>
                    <div class="log-event-body">
                      <p class="log-details">{log.details}</p>
                      {log.payloadSnippet && (
                        <div class="payload-box font-mono">
                          <span class="payload-label">PAYLOAD:</span>
                          <span class="payload-text">{log.payloadSnippet}</span>
                        </div>
                      )}
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let autoRefreshInterval: any = null;

  async function fetchTelemetryData() {
    try {
      const sev = (document.getElementById('filter-severity') as HTMLSelectElement)?.value || 'ALL';
      const type = (document.getElementById('filter-attack-type') as HTMLSelectElement)?.value || 'ALL';

      const res = await fetch(`/api/security/stats?severity=${encodeURIComponent(sev)}&type=${encodeURIComponent(type)}`);
      if (!res.ok) return;
      const data = await res.json();
      if (!data.success) return;

      renderStats(data.stats);
      renderBans(data.bans);
      renderWhitelist(data.whitelist);
      renderLogs(data.logs);
      if (data.settings) renderSettings(data.settings);
    } catch (err) {
      console.error('Erro ao atualizar telemetria:', err);
    }
  }

  function renderStats(stats: any) {
    const totalReq = document.getElementById('kpi-total-requests');
    const atkBlocked = document.getElementById('kpi-attacks-blocked');
    const atkDetected = document.getElementById('kpi-attacks-detected');
    const activeBans = document.getElementById('kpi-active-bans');
    const defconCard = document.getElementById('defcon-card');
    const defconBadge = document.getElementById('defcon-badge');
    const defconHealth = document.getElementById('defcon-health-text');

    if (totalReq) totalReq.textContent = stats.totalRequests.toLocaleString('pt-BR');
    if (atkBlocked) atkBlocked.textContent = stats.attacksBlocked.toLocaleString('pt-BR');
    if (atkDetected) atkDetected.textContent = stats.attacksDetected.toString();
    if (activeBans) activeBans.textContent = stats.activeBansCount.toString();

    if (defconCard) defconCard.setAttribute('data-level', stats.defconLevel.toString());
    if (defconBadge) defconBadge.textContent = `DEFCON ${stats.defconLevel}`;
    if (defconHealth) defconHealth.textContent = stats.systemHealth;
  }

  function renderBans(bans: any[]) {
    const tbody = document.getElementById('banned-ips-tbody');
    const badge = document.getElementById('bans-count-badge');
    if (badge) badge.textContent = bans.length.toString();

    if (!tbody) return;
    if (bans.length === 0) {
      tbody.innerHTML = `<tr class="empty-row"><td colspan="6">Nenhum IP bloqueado no momento. Sistema operando de forma limpa.</td></tr>`;
      return;
    }

    const now = Date.now();
    tbody.innerHTML = bans.map(ban => {
      const timeLeft = ban.expiresAt
        ? Math.max(1, Math.ceil((ban.expiresAt - now) / 60000)) + ' min'
        : 'Permanente';

      return `
        <tr data-ip="${ban.ip}">
          <td><span class="ip-tag font-mono">${ban.ip}</span></td>
          <td><span class="incident-id font-mono">${ban.incidentId}</span></td>
          <td><span class="ban-reason" title="${ban.reason}">${ban.reason}</span></td>
          <td><span class="threat-score-pill">${ban.totalThreatScore} pts</span></td>
          <td><span class="time-left-tag">${timeLeft}</span></td>
          <td style="text-align: right;">
            <button type="button" class="btn-unban-ip" data-ip="${ban.ip}" title="Desbloquear este IP imediatamente">
              Desbloquear
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

  function renderWhitelist(whitelist: any[]) {
    const container = document.getElementById('whitelist-container');
    if (!container) return;

    container.innerHTML = whitelist.map(item => {
      const isCore = ['127.0.0.1', '::1', 'localhost', '0.0.0.0'].includes(item.ip);
      return `
        <div class="whitelist-item" data-ip="${item.ip}">
          <div class="wl-item-left">
            <span class="wl-dot"></span>
            <strong class="wl-ip">${item.ip}</strong>
            <span class="wl-note">${item.note || 'Confiável'}</span>
          </div>
          ${!isCore ? `<button type="button" class="btn-remove-wl" data-ip="${item.ip}" title="Remover da whitelist">&times;</button>` : ''}
        </div>
      `;
    }).join('');
  }

  function renderLogs(logs: any[]) {
    const container = document.getElementById('logs-stream-container');
    if (!container) return;

    if (logs.length === 0) {
      container.innerHTML = `
        <div class="empty-logs-placeholder" id="empty-logs-msg">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <p>Nenhuma anomalia ou ataque registrado recentemente.</p>
          <small>Use o simulador ao lado para testar a detecção.</small>
        </div>
      `;
      return;
    }

    container.innerHTML = logs.map(log => {
      const timeStr = new Date(log.timestamp).toLocaleTimeString('pt-BR');
      return `
        <div class="log-event-row sev-${log.severity.toLowerCase()}" data-id="${log.id}">
          <div class="log-event-header">
            <div class="log-header-left">
              <span class="sev-badge sev-badge-${log.severity.toLowerCase()}">${log.severity}</span>
              <span class="attack-type-tag">${log.attackType}</span>
              <span class="log-ip font-mono">${log.ip}</span>
              <span class="log-path font-mono">${log.method} ${log.path}</span>
            </div>
            <div class="log-header-right">
              <span class="action-tag action-${log.actionTaken.toLowerCase()}">${log.actionTaken}</span>
              <span class="log-time font-mono">${timeStr}</span>
            </div>
          </div>
          <div class="log-event-body">
            <p class="log-details">${log.details}</p>
            ${log.payloadSnippet ? `
              <div class="payload-box font-mono">
                <span class="payload-label">PAYLOAD:</span>
                <span class="payload-text">${escapeHtml(log.payloadSnippet)}</span>
              </div>
            ` : ''}
          </div>
        </div>
      `;
    }).join('');
  }

  function renderSettings(settings: any) {
    const autoBanCheck = document.getElementById('setting-auto-ban') as HTMLInputElement;
    const thresholdInput = document.getElementById('setting-threshold') as HTMLInputElement;
    const durationInput = document.getElementById('setting-duration') as HTMLInputElement;
    const sensSelect = document.getElementById('setting-sensitivity') as HTMLSelectElement;

    if (autoBanCheck) autoBanCheck.checked = Boolean(settings.autoBanEnabled);
    if (thresholdInput && document.activeElement !== thresholdInput) thresholdInput.value = settings.autoBanThreshold;
    if (durationInput && document.activeElement !== durationInput) durationInput.value = settings.banDurationMinutes;
    if (sensSelect && document.activeElement !== sensSelect) sensSelect.value = settings.sensitivity;
  }

  function escapeHtml(str: string) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function initSecurityMonitor() {
    // 1. Setup Auto-Refresh
    const toggle = document.getElementById('auto-refresh-toggle') as HTMLInputElement;
    function updateAutoRefresh() {
      if (autoRefreshInterval) clearInterval(autoRefreshInterval);
      if (toggle?.checked) {
        autoRefreshInterval = setInterval(fetchTelemetryData, 3000);
      }
    }
    toggle?.addEventListener('change', updateAutoRefresh);
    updateAutoRefresh();

    // 2. Refresh Button
    document.getElementById('btn-refresh-telemetry')?.addEventListener('click', () => {
      fetchTelemetryData();
    });

    // 3. Clear Logs Button
    document.getElementById('btn-clear-logs')?.addEventListener('click', async () => {
      if (!confirm('Deseja realmente limpar todo o histórico de logs de ataque?')) return;
      try {
        const res = await fetch('/api/security/clear-logs', { method: 'POST' });
        if (res.ok) {
          fetchTelemetryData();
        }
      } catch (e) {}
    });

    // 4. Filters Change
    document.getElementById('filter-severity')?.addEventListener('change', fetchTelemetryData);
    document.getElementById('filter-attack-type')?.addEventListener('change', fetchTelemetryData);

    // 5. Unban IP handler (delegated)
    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const unbanBtn = target.closest<HTMLButtonElement>('.btn-unban-ip');
      if (unbanBtn) {
        const ip = unbanBtn.getAttribute('data-ip');
        if (!ip) return;
        unbanBtn.disabled = true;
        unbanBtn.textContent = '...';
        try {
          const res = await fetch('/api/security/ban', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ip })
          });
          if (res.ok) {
            fetchTelemetryData();
          }
        } catch (err) {
          unbanBtn.disabled = false;
          unbanBtn.textContent = 'Desbloquear';
        }
        return;
      }

      // Remove Whitelist IP handler
      const removeWlBtn = target.closest<HTMLButtonElement>('.btn-remove-wl');
      if (removeWlBtn) {
        const ip = removeWlBtn.getAttribute('data-ip');
        if (!ip) return;
        try {
          const res = await fetch('/api/security/whitelist', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ip })
          });
          if (res.ok) {
            fetchTelemetryData();
          }
        } catch (err) {}
        return;
      }
    });

    // 6. Simulator Quick Attack Buttons
    const simBtns = document.querySelectorAll<HTMLButtonElement>('.sim-btn');
    simBtns.forEach(btn => {
      btn.addEventListener('click', async () => {
        const attackType = btn.getAttribute('data-attack-type');
        const customIp = (document.getElementById('sim-custom-ip') as HTMLInputElement)?.value.trim() || undefined;

        btn.classList.add('btn-firing');
        try {
          const res = await fetch('/api/security/simulate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attackType, ip: customIp })
          });
          if (res.ok) {
            await fetchTelemetryData();
          }
        } finally {
          setTimeout(() => btn.classList.remove('btn-firing'), 400);
        }
      });
    });

    // Custom Sim Run
    document.getElementById('btn-run-custom-sim')?.addEventListener('click', async () => {
      const customIp = (document.getElementById('sim-custom-ip') as HTMLInputElement)?.value.trim() || undefined;
      const res = await fetch('/api/security/simulate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attackType: 'SQL_INJECTION', ip: customIp })
      });
      if (res.ok) {
        fetchTelemetryData();
      }
    });

    // 7. Manual Ban Form
    document.getElementById('form-manual-ban')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const ip = (document.getElementById('ban-ip-input') as HTMLInputElement)?.value.trim();
      const reason = (document.getElementById('ban-reason-input') as HTMLInputElement)?.value.trim();
      const durationMinutes = Number((document.getElementById('ban-duration-select') as HTMLSelectElement)?.value) || 60;

      if (!ip) return;
      try {
        const res = await fetch('/api/security/ban', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ip, reason, durationMinutes })
        });
        const data = await res.json();
        if (data.success) {
          (document.getElementById('ban-ip-input') as HTMLInputElement).value = '';
          (document.getElementById('ban-reason-input') as HTMLInputElement).value = '';
          fetchTelemetryData();
        } else {
          alert(data.error || 'Erro ao bloquear IP');
        }
      } catch (err) {}
    });

    // 8. Whitelist Form
    document.getElementById('form-add-whitelist')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const ip = (document.getElementById('wl-ip-input') as HTMLInputElement)?.value.trim();
      if (!ip) return;
      try {
        const res = await fetch('/api/security/whitelist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ip, note: 'Manual Whitelist' })
        });
        const data = await res.json();
        if (data.success) {
          (document.getElementById('wl-ip-input') as HTMLInputElement).value = '';
          fetchTelemetryData();
        } else {
          alert(data.error || 'Erro ao adicionar IP');
        }
      } catch (err) {}
    });

    // 9. IPS Settings Form
    document.getElementById('form-ips-settings')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const autoBanEnabled = (document.getElementById('setting-auto-ban') as HTMLInputElement)?.checked;
      const autoBanThreshold = Number((document.getElementById('setting-threshold') as HTMLInputElement)?.value) || 100;
      const banDurationMinutes = Number((document.getElementById('setting-duration') as HTMLInputElement)?.value) || 60;
      const sensitivity = (document.getElementById('setting-sensitivity') as HTMLSelectElement)?.value || 'NORMAL';

      try {
        const res = await fetch('/api/security/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            autoBanEnabled,
            autoBanThreshold,
            banDurationMinutes,
            sensitivity
          })
        });
        const data = await res.json();
        if (data.success) {
          alert('Configurações do IPS atualizadas com sucesso!');
        }
      } catch (err) {}
    });
  }

  document.addEventListener('astro:page-load', initSecurityMonitor);
  initSecurityMonitor();
</script>

