---
// category/[id].astro - Cursos por Categoria
import Layout from '../../layouts/Layout.astro';
import CourseCard from '../../components/CourseCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCategoryById, getCoursesByCategory } from '../../lib/catalog';

const { id } = Astro.params;
const category = id ? getCategoryById(id) : undefined;

if (!category) {
  return Astro.redirect('/404');
}

const courses = getCoursesByCategory(category.id);
---

<Layout title={`${category.name} — Mindflix`}>
  <div class="container category-page">
    <div class="breadcrumb">
      <a href="/categories">Categorias</a>
      <span>/</span>
      <span class="active">{category.name}</span>
    </div>

    <header class="category-header">
      <div class="cat-title-row">
        <h1 class="cat-title">{category.name}</h1>
        <span class="badge badge-cyan">{courses.length} cursos</span>
      </div>
      <p class="cat-desc">{category.description}</p>
    </header>

    {courses.length > 0 ? (
      <div class="courses-grid">
        {courses.map(course => (
          <CourseCard course={course} />
        ))}
      </div>
    ) : (
      <EmptyState
        title="Nenhum curso nesta categoria"
        description="Esta categoria ainda não possui cursos catalogados."
        actionText="Ver Todas as Categorias"
        actionHref="/categories"
      />
    )}
  </div>
</Layout>

<style>
  .category-page {
    padding-top: 110px;
    padding-bottom: 5rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a:hover {
    color: var(--accent-cyan);
  }

  .breadcrumb .active {
    color: var(--text-secondary);
  }

  .category-header {
    margin-bottom: 2.5rem;
  }

  .cat-title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .cat-title {
    font-size: 2.25rem;
    font-weight: 800;
  }

  .cat-desc {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 720px;
    line-height: 1.6;
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
    perspective: 1200px;
  }
</style>
