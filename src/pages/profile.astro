---
// profile.astro - Perfil do Usuário, Estatísticas de Aprendizado e Painel Interativo de Atividade
import Layout from '../layouts/Layout.astro';
import { getAllCourses } from '../lib/catalog';

const allCourses = getAllCourses();
// Lightweight lookup map for client-side lesson/course info
const courseMap: Record<string, { title: string; cover: string; provider: string; lessons: Record<string, string> }> = {};
for (const course of allCourses) {
  const lessonNames: Record<string, string> = {};
  for (const mod of course.modules || []) {
    for (const les of mod.lessons || []) {
      lessonNames[les.id] = les.display_title || les.title;
    }
  }
  courseMap[course.id] = {
    title: course.display_title || course.title,
    cover: course.cover_image || '',
    provider: course.provider || '',
    lessons: lessonNames
  };
}
---

<Layout title="Meu Perfil — Mindflix">
  <div class="container profile-page">
    
    <!-- Profile Header Card -->
    <div class="profile-header-card">
      <div class="profile-identity">
        <div class="profile-avatar-large">
          <span id="profile-avatar-initials">ED</span>
        </div>
        <div class="profile-info">
          <div class="profile-name-row">
            <h1 class="profile-name" id="profile-name">Eduardo</h1>
            <span class="badge badge-cyan">Membro Mindflix</span>
          </div>
          <p class="profile-email" id="profile-email">usuario@mindflix.local</p>
        </div>
      </div>

      <div class="profile-quick-actions">
        <a href="/settings" class="btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          <span>Preferências</span>
        </a>
        <button type="button" class="btn btn-ghost" id="btn-logout">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Sair</span>
        </button>
      </div>
    </div>

    <!-- Overall Statistics Grid -->
    <div class="stats-section">
      <h2 class="section-title">Estatísticas Gerais</h2>
      <div class="stats-grid">
        <div class="stat-box">
          <span class="stat-icon-wrapper accent-cyan-glow">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </span>
          <div class="stat-meta">
            <span class="stat-desc">Cursos Iniciados</span>
            <strong class="stat-number" id="stat-courses-started">0</strong>
          </div>
        </div>

        <div class="stat-box">
          <span class="stat-icon-wrapper accent-emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </span>
          <div class="stat-meta">
            <span class="stat-desc">Aulas Concluídas</span>
            <strong class="stat-number" id="stat-lessons-completed">0</strong>
          </div>
        </div>

        <div class="stat-box">
          <span class="stat-icon-wrapper accent-purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </span>
          <div class="stat-meta">
            <span class="stat-desc">Tempo Total Estudado</span>
            <strong class="stat-number" id="stat-time-studied">0h 00m</strong>
          </div>
        </div>

        <div class="stat-box">
          <span class="stat-icon-wrapper accent-rose">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </span>
          <div class="stat-meta">
            <span class="stat-desc">Cursos Favoritados</span>
            <strong class="stat-number" id="stat-favorites-count">0</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Real Activity Hub & Interactive Chart -->
    <div class="activity-chart-card">
      
      <!-- Card Top Bar: Header, Badges & Controls -->
      <div class="chart-header">
        <div class="chart-title-group">
          <div class="title-with-pill">
            <h3 class="chart-title">Ritmo & Atividade de Estudos</h3>
            <span class="live-pulse-badge">
              <span class="pulse-dot"></span>
              Tempo Real
            </span>
          </div>
          <span class="chart-subtitle" id="chart-subtitle-summary">Acompanhe sua consistência e evolução diária.</span>
        </div>

        <!-- Period selector & Goal settings -->
        <div class="chart-controls-group">
          <div class="period-toggle-group">
            <button type="button" class="period-btn active" data-period="7">7 Dias</button>
            <button type="button" class="period-btn" data-period="30">30 Dias</button>
          </div>
          <div class="chart-total-badge">
            <span class="badge-time-value" id="chart-period-total-time">0h 00m</span>
            <span class="badge-sub" id="chart-period-label">nos últimos 7 dias</span>
          </div>
        </div>
      </div>

      <!-- Quick Metrics Strip: Streak, Daily Average, Goal Target -->
      <div class="metrics-strip">
        <div class="metric-chip">
          <span class="metric-icon">🔥</span>
          <div class="metric-data">
            <span class="metric-label">Sequência Atual</span>
            <strong class="metric-val" id="streak-count">0 dias</strong>
          </div>
        </div>

        <div class="metric-chip">
          <span class="metric-icon">⚡</span>
          <div class="metric-data">
            <span class="metric-label">Média Diária</span>
            <strong class="metric-val" id="daily-avg-time">0 min</strong>
          </div>
        </div>

        <div class="metric-chip goal-chip">
          <span class="metric-icon">🎯</span>
          <div class="metric-data">
            <span class="metric-label">Meta Diária</span>
            <div class="goal-selector-inline">
              <select id="goal-target-select" title="Selecione sua meta de estudo diária">
                <option value="15">15 min</option>
                <option value="30" selected>30 min</option>
                <option value="45">45 min</option>
                <option value="60">1h 00m</option>
                <option value="90">1h 30m</option>
              </select>
            </div>
          </div>
        </div>

        <div class="metric-chip">
          <span class="metric-icon">🌟</span>
          <div class="metric-data">
            <span class="metric-label">Metas Atingidas</span>
            <strong class="metric-val" id="goals-reached-count">0 / 7</strong>
          </div>
        </div>
      </div>

      <!-- Chart Visual Container with Guidelines and Capsules -->
      <div class="chart-visual-wrapper">
        <div class="chart-grid-lines">
          <div class="grid-line"><span class="grid-label" id="grid-label-top">1h</span></div>
          <div class="grid-line"><span class="grid-label" id="grid-label-mid">30m</span></div>
          <div class="grid-line grid-base"><span class="grid-label">0m</span></div>
        </div>

        <div class="weekly-bars-container" id="weekly-bars-container">
          <!-- Populated dynamically with glassmorphic pillars -->
        </div>
      </div>

      <!-- Selected Day Drilldown & Recent Activity Panel -->
      <div class="day-detail-section" id="day-detail-section">
        <div class="detail-header">
          <div class="detail-title-group">
            <h4 class="detail-title" id="selected-day-title">Atividades de Hoje</h4>
            <span class="detail-subtitle" id="selected-day-subtitle">Selecione um dia no gráfico para ver as aulas assistidas</span>
          </div>
          <div class="detail-summary-badge" id="selected-day-time-badge">
            0 min de estudo
          </div>
        </div>

        <div class="detail-content-box" id="selected-day-content">
          <!-- Rendered dynamically -->
        </div>
      </div>

    </div>

  </div>

  <!-- Embedded Catalog lookup for client JS -->
  <script id="mindflix-courses-data" type="application/json" set:html={JSON.stringify(courseMap)}></script>
</Layout>

<script>
  import { getAllLocalProgress, getFavoriteCourseIds, getRecentCourseIds, syncProgressFromSupabase } from '../lib/progress';
  import { getLocalUser } from '../lib/supabase';
  import { logoutUser } from '../lib/auth';

  // Read embedded course map
  let courseLookup: Record<string, { title: string; cover: string; provider: string; lessons: Record<string, string> }> = {};
  try {
    const raw = document.getElementById('mindflix-courses-data')?.textContent;
    if (raw) courseLookup = JSON.parse(raw);
  } catch (e) {}

  // State
  let selectedPeriodDays = 7;
  let dailyGoalMinutes = 30;
  let selectedDayIndex = 6; // default to today (last item in period)

  // Load user
  const user = getLocalUser();
  if (!user) {
    window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
  } else {
    const nameEl = document.getElementById('profile-name');
    const emailEl = document.getElementById('profile-email');
    const avatarInitials = document.getElementById('profile-avatar-initials');

    const displayName = user.full_name || user.email.split('@')[0];
    if (nameEl) nameEl.textContent = displayName;
    if (emailEl) emailEl.textContent = user.email;
    if (avatarInitials) avatarInitials.textContent = displayName.substring(0, 2).toUpperCase();
  }

  // Load saved goal from localStorage
  const savedGoal = localStorage.getItem('mindflix_daily_goal_minutes');
  if (savedGoal) {
    dailyGoalMinutes = parseInt(savedGoal, 10) || 30;
    const select = document.getElementById('goal-target-select') as HTMLSelectElement;
    if (select) select.value = String(dailyGoalMinutes);
  }

  // Goal select change
  document.getElementById('goal-target-select')?.addEventListener('change', (e) => {
    const target = e.target as HTMLSelectElement;
    dailyGoalMinutes = parseInt(target.value, 10) || 30;
    localStorage.setItem('mindflix_daily_goal_minutes', String(dailyGoalMinutes));
    renderActivityChart();
  });

  // Period toggle buttons
  document.querySelectorAll<HTMLButtonElement>('.period-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedPeriodDays = parseInt(btn.getAttribute('data-period') || '7', 10);
      selectedDayIndex = selectedPeriodDays - 1; // reset selection to today
      renderActivityChart();
    });
  });

  // Calculate Streak
  function calculateCurrentStreak(allProgress: Record<string, any>): number {
    const daysWithStudy = new Set<string>();
    Object.values(allProgress).forEach((item: any) => {
      if (item.last_watched_at && (item.position_seconds > 0 || item.completed)) {
        try {
          const d = new Date(item.last_watched_at);
          const y = d.getFullYear();
          const m = String(d.getMonth() + 1).padStart(2, '0');
          const day = String(d.getDate()).padStart(2, '0');
          daysWithStudy.add(`${y}-${m}-${day}`);
        } catch (e) {}
      }
    });

    let streak = 0;
    const now = new Date();
    
    // Check from today or yesterday
    const todayStr = getIsoDate(now);
    const yest = new Date(now);
    yest.setDate(yest.getDate() - 1);
    const yestStr = getIsoDate(yest);

    let checkDate = new Date(now);
    if (!daysWithStudy.has(todayStr)) {
      if (daysWithStudy.has(yestStr)) {
        checkDate = yest;
      } else {
        return 0; // No streak
      }
    }

    while (true) {
      const dateStr = getIsoDate(checkDate);
      if (daysWithStudy.has(dateStr)) {
        streak++;
        checkDate.setDate(checkDate.getDate() - 1);
      } else {
        break;
      }
    }

    return streak;
  }

  function getIsoDate(d: Date): string {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function formatDuration(seconds: number): string {
    const hrs = Math.floor(seconds / 3600);
    const mins = Math.floor((seconds % 3600) / 60);
    if (hrs > 0) return `${hrs}h ${String(mins).padStart(2, '0')}m`;
    return `${mins} min`;
  }

  function renderProfileStatsAndActivity() {
    const allProgress = getAllLocalProgress();
    const recentIds = getRecentCourseIds();
    const favIds = getFavoriteCourseIds();

    const lessons = Object.values(allProgress);
    const completedLessons = lessons.filter(l => l.completed);
    const totalSeconds = lessons.reduce((acc, curr) => acc + (curr.position_seconds || 0), 0);

    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);

    const elStarted = document.getElementById('stat-courses-started');
    const elCompleted = document.getElementById('stat-lessons-completed');
    const elTime = document.getElementById('stat-time-studied');
    const elFavs = document.getElementById('stat-favorites-count');

    if (elStarted) elStarted.textContent = recentIds.length.toString();
    if (elCompleted) elCompleted.textContent = completedLessons.length.toString();
    if (elTime) elTime.textContent = `${hours}h ${String(minutes).padStart(2, '0')}m`;
    if (elFavs) elFavs.textContent = favIds.length.toString();

    // Calculate streak
    const streak = calculateCurrentStreak(allProgress);
    const streakEl = document.getElementById('streak-count');
    if (streakEl) {
      streakEl.textContent = streak > 0 ? `${streak} dia${streak > 1 ? 's' : ''} 🔥` : '0 dias';
    }

    renderActivityChart();
  }

  function renderActivityChart() {
    const allProgress = getAllLocalProgress();
    const lessons = Object.values(allProgress);
    const container = document.getElementById('weekly-bars-container');
    const summarySub = document.getElementById('chart-subtitle-summary');
    const totalTimeEl = document.getElementById('chart-period-total-time');
    const periodLabelEl = document.getElementById('chart-period-label');
    const dailyAvgEl = document.getElementById('daily-avg-time');
    const goalsReachedEl = document.getElementById('goals-reached-count');
    const gridLabelTop = document.getElementById('grid-label-top');
    const gridLabelMid = document.getElementById('grid-label-mid');

    if (!container) return;

    const dayNames = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
    const fullDayNames = ['Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado'];
    const now = new Date();
    const days: {
      index: number;
      dateStr: string;
      label: string;
      fullDayName: string;
      formattedDate: string;
      totalSeconds: number;
      lessonsCount: number;
      lessonsList: any[];
      isToday: boolean;
      goalReached: boolean;
    }[] = [];

    // Build days array for period
    for (let i = selectedPeriodDays - 1; i >= 0; i--) {
      const d = new Date(now);
      d.setDate(d.getDate() - i);

      const dateStr = getIsoDate(d);
      const day = String(d.getDate()).padStart(2, '0');
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const formattedDate = `${day}/${month}`;
      const label = dayNames[d.getDay()];
      const fullDayName = fullDayNames[d.getDay()];

      days.push({
        index: days.length,
        dateStr,
        label,
        fullDayName,
        formattedDate,
        totalSeconds: 0,
        lessonsCount: 0,
        lessonsList: [],
        isToday: i === 0,
        goalReached: false
      });
    }

    // Accumulate lessons per calendar day
    lessons.forEach((item) => {
      if (!item.last_watched_at) return;
      try {
        const watchedDate = new Date(item.last_watched_at);
        const watchedDateStr = getIsoDate(watchedDate);

        const dayObj = days.find(d => d.dateStr === watchedDateStr);
        if (dayObj) {
          const duration = item.duration_seconds || 3600;
          const watchedSecs = Math.min(item.position_seconds || 0, duration);
          dayObj.totalSeconds += watchedSecs;
          dayObj.lessonsCount += 1;
          dayObj.lessonsList.push(item);
        }
      } catch (e) {}
    });

    const goalSeconds = dailyGoalMinutes * 60;
    let goalsMetCount = 0;
    days.forEach(d => {
      if (d.totalSeconds >= goalSeconds && d.totalSeconds > 0) {
        d.goalReached = true;
        goalsMetCount++;
      }
    });

    const grandTotalSeconds = days.reduce((sum, d) => sum + d.totalSeconds, 0);
    const activeDaysCount = days.filter(d => d.totalSeconds > 0).length;
    const avgSeconds = activeDaysCount > 0 ? Math.round(grandTotalSeconds / activeDaysCount) : 0;

    if (totalTimeEl) totalTimeEl.textContent = formatDuration(grandTotalSeconds);
    if (periodLabelEl) periodLabelEl.textContent = `nos últimos ${selectedPeriodDays} dias`;
    if (dailyAvgEl) dailyAvgEl.textContent = avgSeconds > 0 ? formatDuration(avgSeconds) : '0 min';
    if (goalsReachedEl) goalsReachedEl.textContent = `${goalsMetCount} / ${selectedPeriodDays}`;

    if (summarySub) {
      if (grandTotalSeconds > 0) {
        summarySub.textContent = `Histórico real: ${formatDuration(grandTotalSeconds)} de estudos e ${goalsMetCount} meta(s) batida(s) no período.`;
      } else {
        summarySub.textContent = 'Sem atividade recente. Escolha uma aula para iniciar sua sequência!';
      }
    }

    // Dynamic grid axis labels
    const maxDaySeconds = Math.max(...days.map(d => d.totalSeconds), goalSeconds, 3600);
    if (gridLabelTop) gridLabelTop.textContent = formatDuration(maxDaySeconds);
    if (gridLabelMid) gridLabelMid.textContent = formatDuration(Math.round(maxDaySeconds / 2));

    // Ensure selectedDayIndex is within range
    if (selectedDayIndex >= days.length) {
      selectedDayIndex = days.length - 1;
    }

    // Render pillars
    container.innerHTML = days.map((day) => {
      let heightPercent = 0;
      if (day.totalSeconds > 0) {
        heightPercent = Math.max(8, Math.min(100, Math.round((day.totalSeconds / maxDaySeconds) * 100)));
      }

      const isSelected = day.index === selectedDayIndex;
      const timeFormatted = day.totalSeconds > 0 ? formatDuration(day.totalSeconds) : 'Sem atividade';
      const tooltipText = `${day.label} (${day.formattedDate}) • ${timeFormatted}${day.lessonsCount > 0 ? ` • ${day.lessonsCount} aula(s)` : ''}`;

      return `
        <div class="day-pillar-col ${day.isToday ? 'is-today' : ''} ${isSelected ? 'is-selected' : ''} ${day.goalReached ? 'goal-met' : ''}" 
             data-day-index="${day.index}" 
             title="${tooltipText}">
          
          <div class="pillar-slot-track">
            ${day.goalReached ? '<span class="pillar-goal-star" title="Meta atingida! ✨">✨</span>' : ''}
            
            <div class="pillar-fill-bar" style="height: ${heightPercent}%;">
              <span class="pillar-hover-tooltip">
                <strong class="tooltip-time">${timeFormatted}</strong>
                <span class="tooltip-meta">${day.lessonsCount > 0 ? `${day.lessonsCount} aula(s)` : 'Sem aulas'}</span>
                ${day.goalReached ? '<span class="tooltip-badge">🎯 Meta Atingida</span>' : ''}
              </span>
            </div>
          </div>

          <div class="pillar-labels">
            <span class="pillar-day-name">${day.isToday ? 'Hoje' : day.label}</span>
            <span class="pillar-day-date">${day.formattedDate}</span>
          </div>
        </div>
      `;
    }).join('');

    // Attach click listener to pillars
    container.querySelectorAll<HTMLElement>('.day-pillar-col').forEach(col => {
      col.addEventListener('click', () => {
        const idx = parseInt(col.getAttribute('data-day-index') || '0', 10);
        selectedDayIndex = idx;
        
        container.querySelectorAll('.day-pillar-col').forEach(c => c.classList.remove('is-selected'));
        col.classList.add('is-selected');

        renderSelectedDayDetail(days[idx]);
      });
    });

    // Render selected day detail
    renderSelectedDayDetail(days[selectedDayIndex] || days[days.length - 1]);
  }

  function renderSelectedDayDetail(dayObj: any) {
    if (!dayObj) return;

    const titleEl = document.getElementById('selected-day-title');
    const subtitleEl = document.getElementById('selected-day-subtitle');
    const timeBadgeEl = document.getElementById('selected-day-time-badge');
    const contentBox = document.getElementById('selected-day-content');

    if (!contentBox) return;

    const dayTitle = dayObj.isToday ? 'Hoje' : `${dayObj.fullDayName}, ${dayObj.formattedDate}`;
    if (titleEl) titleEl.textContent = `Sessões de Estudo: ${dayTitle}`;

    if (timeBadgeEl) {
      if (dayObj.totalSeconds > 0) {
        timeBadgeEl.className = 'detail-summary-badge active';
        timeBadgeEl.innerHTML = `<span>⚡ ${formatDuration(dayObj.totalSeconds)}</span> • <span>${dayObj.lessonsCount} aula(s)</span>`;
      } else {
        timeBadgeEl.className = 'detail-summary-badge';
        timeBadgeEl.textContent = '0 min de estudo';
      }
    }

    if (subtitleEl) {
      if (dayObj.totalSeconds > 0) {
        subtitleEl.textContent = dayObj.goalReached 
          ? 'Parabéns! Você bateu sua meta diária de estudos nesta data! 🚀' 
          : 'Aulas assistidas e tempo contabilizado nesta data:';
      } else {
        subtitleEl.textContent = 'Nenhuma aula assistida nesta data.';
      }
    }

    if (dayObj.lessonsList && dayObj.lessonsList.length > 0) {
      contentBox.innerHTML = `
        <div class="day-lessons-list">
          ${dayObj.lessonsList.map((item: any) => {
            const courseInfo = courseLookup[item.course_id] || { title: 'Curso Mindflix', cover: '', provider: 'Mindflix', lessons: {} };
            const lessonTitle = courseInfo.lessons[item.lesson_id] || `Aula #${item.lesson_id}`;
            const watchSeconds = item.position_seconds || 0;
            const durSeconds = item.duration_seconds || 3600;
            const pct = Math.min(100, Math.round((watchSeconds / durSeconds) * 100));

            return `
              <div class="day-lesson-card">
                <div class="lesson-card-left">
                  <div class="lesson-course-badge">${courseInfo.provider || 'Curso'}</div>
                  <div class="lesson-titles">
                    <h5 class="lesson-name">${lessonTitle}</h5>
                    <span class="lesson-course-name">${courseInfo.title}</span>
                  </div>
                </div>

                <div class="lesson-card-right">
                  <div class="lesson-progress-meta">
                    <div class="lesson-progress-bar">
                      <div class="lesson-progress-fill" style="width: ${pct}%;"></div>
                    </div>
                    <span class="lesson-time-spent">${formatDuration(watchSeconds)} (${pct}%)</span>
                  </div>
                  <a href="/watch/${item.course_id}/${item.lesson_id}" class="btn-continue-lesson">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    <span>${pct >= 90 ? 'Reassistir' : 'Continuar'}</span>
                  </a>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;
    } else {
      // Empty state for selected day with Quick Resume or Explore action
      const recentIds = getRecentCourseIds();
      const recentCourseId = recentIds[0];
      const recentCourse = recentCourseId ? courseLookup[recentCourseId] : null;

      contentBox.innerHTML = `
        <div class="empty-day-state">
          <div class="empty-state-visual">
            <span class="empty-icon">☕</span>
          </div>
          <div class="empty-state-info">
            <h5 class="empty-state-title">Nenhum estudo registrado neste dia</h5>
            <p class="empty-state-desc">
              ${recentCourse 
                ? `Que tal continuar seu aprendizado em <strong>${recentCourse.title}</strong>?`
                : 'Mantenha sua mente afiada assistindo a uma nova aula do catálogo!'}
            </p>
          </div>
          <div class="empty-state-actions">
            ${recentCourse 
              ? `<a href="/courses" class="btn btn-primary btn-sm">Continuar de onde parou</a>`
              : `<a href="/courses" class="btn btn-primary btn-sm">Explorar Cursos</a>`
            }
          </div>
        </div>
      `;
    }
  }

  // Initial render
  renderProfileStatsAndActivity();

  // Sync latest progress from Supabase if configured
  syncProgressFromSupabase().then(() => {
    renderProfileStatsAndActivity();
  });

  // Logout button
  document.getElementById('btn-logout')?.addEventListener('click', async () => {
    await logoutUser();
  });
</script>

