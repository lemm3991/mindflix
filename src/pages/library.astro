    box-shadow: 0 4px 12px rgba(var(--accent-primary-rgb, 0, 242, 254), 0.15);
  }

  .tab-section {
    display: none;
  }

  .tab-section.active {
    display: block;
  }

  .admin-section {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .section-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .toolbar-search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.85rem;
    flex: 1;
    min-width: 260px;
    max-width: 440px;
  }

  .toolbar-search input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-size: 0.875rem;
    width: 100%;
  }

  .courses-table-container {
    max-height: 600px;
    overflow-y: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  .admin-table th {
    padding: 0.85rem 1rem;
    background: rgba(11, 14, 20, 0.8);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    z-index: 2;
  }

  .admin-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .admin-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .cat-icon-chip {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: rgba(var(--accent-primary-rgb, 0, 242, 254), 0.1);
    border: 1px solid rgba(var(--accent-primary-rgb, 0, 242, 254), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--accent-cyan);
  }

  .cat-slug-badge {
    font-family: monospace;
    font-size: 0.78125rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-xs);
    color: var(--text-muted);
  }

  .cell-desc {
    max-width: 320px;
  }

  .cat-desc-text {
    font-size: 0.8125rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .action-buttons-group {
