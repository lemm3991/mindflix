---
// library.astro - Painel de Administração da Biblioteca & Categorias Mindflix
import Layout from '../layouts/Layout.astro';
import { getAllCourses, getCategories, getAllProviders } from '../lib/catalog';
import fs from 'node:fs';
import path from 'node:path';

const courses = getAllCourses();
const categories = getCategories();
const providers = getAllProviders();

const catCourseCounts = categories.map(cat => {
  const count = courses.filter(c => (c.categories || []).includes(cat.id)).length;
  return { ...cat, courseCount: count };
});

let summary = {
  last_scan_at: new Date().toISOString(),
  courses_root: "..",
  total_courses: courses.length,
  total_modules: courses.reduce((acc, c) => acc + c.modules_count, 0),
  total_lessons: courses.reduce((acc, c) => acc + c.lessons_count, 0),
  missing_courses: 0,
  new_courses: 0
};

const summaryPath = path.resolve(process.cwd(), 'src', 'data', 'catalog_summary.json');
if (fs.existsSync(summaryPath)) {
  try {
    summary = { ...summary, ...JSON.parse(fs.readFileSync(summaryPath, 'utf-8')) };
  } catch {}
}

const formattedLastScan = new Date(summary.last_scan_at).toLocaleString('pt-BR', {
  dateStyle: 'medium',
  timeStyle: 'short'
});
---

<Layout title="Administração da Biblioteca & Categorias — Mindflix">
  <script is:inline>
    (function() {
      try {
        var userStr = localStorage.getItem('mindflix_user');
        if (!userStr) {
          window.location.href = '/login?redirect=/library';
          return;
        }
        var user = JSON.parse(userStr);
        var name = (user.full_name || user.email || user.username || '').toLowerCase();
        var isLemmg = name.includes('lemmg0800');
        if (!isLemmg) {
          document.documentElement.classList.add('admin-forbidden');
          window.location.href = '/?denied=1';
        }
      } catch (e) {
        window.location.href = '/';
      }
    })();
  </script>
  <style is:inline>
    html.admin-forbidden body {
      display: none !important;
    }
  </style>

  <div class="container library-admin-page">
    <header class="page-header">
      <div class="header-content">
        <h1 class="page-title">Administração do Acervo</h1>
        <p class="page-subtitle">Gerencie o scanner inteligente, administre o acervo de cursos e realize o CRUD completo das categorias do sistema.</p>
      </div>

      <div class="header-actions">
        <button type="button" class="btn btn-secondary" id="btn-dry-run-scan">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>Escanear (Dry Run)</span>
        </button>

        <button type="button" class="btn btn-primary" id="btn-apply-scan">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
          </svg>
          <span>Atualizar Biblioteca</span>
        </button>

        <a href="/api/library/backup" download="mindflix-catalog-backup.json" class="btn btn-ghost" title="Exportar Backup de Metadados">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Backup</span>
        </a>
      </div>
    </header>

    <!-- Stats Dashboard Grid -->
    <div class="admin-stats-grid">
      <div class="admin-stat-card">
        <span class="stat-label">Pasta Raiz (COURSES_ROOT)</span>
        <strong class="stat-val mono" title={summary.courses_root}>{summary.courses_root}</strong>
        <span class="stat-hint">Definida dinamicamente via ambiente</span>
      </div>

      <div class="admin-stat-card">
        <span class="stat-label">Última Varredura</span>
        <strong class="stat-val">{formattedLastScan}</strong>
        <span class="stat-hint">Sincronizado com catálogo local</span>
      </div>

      <div class="admin-stat-card">
        <span class="stat-label">Acervo Total</span>
        <strong class="stat-val accent-cyan">{summary.total_courses} Cursos</strong>
        <span class="stat-hint">{summary.total_modules} módulos catalogados</span>
      </div>

      <div class="admin-stat-card">
        <span class="stat-label">Categorias Ativas</span>
        <strong class="stat-val accent-emerald">{categories.length} Categorias</strong>
        <span class="stat-hint">Gerenciáveis via CRUD em tempo real</span>
      </div>
    </div>

    <!-- Media Server Configuration Card -->
    <div class="media-provider-config-card">
      <div class="card-header-row">
        <div class="card-header-info">
          <h3 class="card-title">🌐 Fonte de Reprodução dos Vídeos</h3>
          <p class="card-desc">Todos os vídeos são reproduzidos exclusivamente via Servidor Local de Streaming (Cloudflare Tunnel).</p>
        </div>
        <div class="server-status-pill" id="server-status-pill">
          <span class="pulse-dot-indicator" id="status-dot"></span>
          <span id="status-text">Testando Conexão...</span>
        </div>
      </div>

      <div class="provider-controls-row">
        <div class="form-group flex-2">
          <label for="input-media-server-url">URL do Servidor de Streaming (HTTP / Cloudflare Tunnel)</label>
          <div class="input-with-btn">
            <input
              type="url"
              id="input-media-server-url"
              class="form-input mono"
              placeholder="https://semester-lover-legs-metal.trycloudflare.com"
            />
            <button type="button" class="btn btn-secondary btn-sm" id="btn-save-server-url">
              <span>Testar e Salvar</span>
            </button>
          </div>
        </div>

        <div class="form-group flex-1">
          <label for="select-media-mode">Modo de Operação</label>
          <select id="select-media-mode" class="form-select" disabled>
            <option value="server" selected>🟢 Apenas Servidor Local / Cloudflare</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="admin-nav-tabs">
      <button type="button" class="tab-btn active" id="tab-btn-courses" data-tab="courses">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span>Cursos Catalogados ({courses.length})</span>
      </button>

      <button type="button" class="tab-btn" id="tab-btn-categories" data-tab="categories">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
        </svg>
        <span>Gerenciar Categorias ({categories.length})</span>
      </button>
    </div>

    <!-- Section 1: Courses Management Table -->
    <section class="admin-section tab-section active" id="section-courses">
      <div class="section-toolbar">
        <div class="toolbar-search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="filter-course-input" placeholder="Filtrar cursos por título, fornecedor ou pasta..." />
        </div>

        <div class="toolbar-filter">
          <select id="filter-provider-select" class="form-select">
            <option value="">Todos os Fornecedores</option>
            {providers.map(p => (
              <option value={p}>{p}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="courses-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Curso</th>
              <th>Fornecedor</th>
              <th>Módulos / Aulas</th>
              <th>Duração</th>
              <th>Categorias</th>
              <th>Status</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="admin-courses-tbody">
            {courses.map(course => (
              <tr class="course-row-item" data-id={course.id} data-provider={course.provider} data-title={course.display_title.toLowerCase()} data-raw={course.raw_title.toLowerCase()}>
                <td class="cell-title">
                  <div class="course-meta-box">
                    <strong class="course-display-name">{course.display_title}</strong>
                    <span class="course-raw-path" title={course.relative_path}>{course.relative_path}</span>
                  </div>
                </td>
                <td>
                  <span class="badge badge-provider">{course.provider}</span>
                </td>
                <td>
                  <span>{course.modules_count} mods • {course.lessons_count} aulas</span>
                </td>
                <td>
                  <span class="text-muted">{course.total_duration_formatted || 'Calculado'}</span>
                </td>
                <td>
                  <div class="cats-tags-cell">
                    {course.categories.map(cat => (
                      <span class="mini-chip">{cat}</span>
                    ))}
                  </div>
                </td>
                <td>
                  {course.is_hidden ? (
                    <span class="badge badge-warning">Oculto</span>
                  ) : (
                    <span class="badge badge-success">Ativo</span>
                  )}
                </td>
                <td>
                  <button
                    type="button"
                    class="btn btn-secondary btn-sm btn-edit-course"
                    data-course={JSON.stringify({
                      id: course.id,
                      display_title: course.display_title,
                      description: course.description,
                      provider: course.provider,
                      categories: course.categories,
                      tags: course.tags,
                      is_hidden: course.is_hidden,
                      is_featured: course.is_featured
                    })}
                  >
                    Editar
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Categories Management CRUD -->
    <section class="admin-section tab-section" id="section-categories">
      <div class="section-toolbar">
        <div class="toolbar-search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="filter-cat-input" placeholder="Filtrar categorias por nome, ID ou descrição..." />
        </div>

        <button type="button" class="btn btn-primary" id="btn-create-category">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Nova Categoria</span>
        </button>
      </div>

      <div class="courses-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Ícone</th>
              <th>Nome da Categoria</th>
              <th>ID (Slug)</th>
              <th>Descrição</th>
              <th>Cursos Vinculados</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="admin-categories-tbody">
            {catCourseCounts.map(cat => (
              <tr class="cat-row-item" data-id={cat.id} data-name={cat.name.toLowerCase()} data-desc={(cat.description || '').toLowerCase()}>
                <td class="cell-icon">
                  <div class="cat-icon-chip">
                    <span>{cat.icon || 'folder'}</span>
                  </div>
                </td>
                <td class="cell-title">
                  <strong class="cat-display-name">{cat.name}</strong>
                </td>
                <td>
                  <code class="cat-slug-badge">{cat.id}</code>
                </td>
                <td class="cell-desc">
                  <span class="cat-desc-text">{cat.description || 'Sem descrição cadastrada'}</span>
                </td>
                <td>
                  <span class="badge badge-provider">{cat.courseCount} cursos</span>
                </td>
                <td>
                  <div class="action-buttons-group">
                    <button
                      type="button"
                      class="btn btn-secondary btn-sm btn-edit-category"
                      data-category={JSON.stringify(cat)}
                    >
                      Editar
                    </button>
                    <button
                      type="button"
                      class="btn btn-danger btn-sm btn-delete-category"
                      data-id={cat.id}
                      data-name={cat.name}
                      data-count={cat.courseCount}
                    >
                      Excluir
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Modal: Dry Run Report -->
    <div id="dryrun-modal" class="admin-modal-backdrop" style="display: none;">
      <div class="admin-modal-dialog">
        <div class="modal-header">
          <h2 class="modal-title" id="dryrun-modal-title">Relatório de Varredura (Dry Run)</h2>
          <button type="button" class="btn-close-modal" id="btn-close-dryrun">×</button>
        </div>
        <div class="modal-body">
          <pre id="dryrun-output" class="dryrun-code">Executando varredura na pasta raiz...</pre>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="btn-cancel-dryrun">Fechar</button>
          <button type="button" class="btn btn-primary" id="btn-confirm-apply">Aplicar Alterações no Catálogo</button>
        </div>
      </div>
    </div>

    <!-- Modal: Course Metadata Editor -->
    <div id="edit-modal" class="admin-modal-backdrop" style="display: none;">
      <div class="admin-modal-dialog modal-dialog-lg">
        <div class="modal-header">
          <h2 class="modal-title">Editar Metadados do Curso</h2>
          <button type="button" class="btn-close-modal" id="btn-close-edit">×</button>
        </div>
        <form id="edit-course-form" class="modal-body form-grid">
          <input type="hidden" id="edit-course-id" />

          <div class="form-group full-width">
            <label for="edit-display-title">Título de Exibição</label>
            <input type="text" id="edit-display-title" class="form-input" required />
            <span class="field-hint">O nome que aparecerá na Home, cards e player (não altera os arquivos no HD).</span>
          </div>

          <div class="form-group">
            <label for="edit-provider">Fornecedor / Produtor</label>
            <input type="text" id="edit-provider" class="form-input" required />
          </div>

          <div class="form-group">
            <label for="edit-tags">Tags (separadas por vírgula)</label>
            <input type="text" id="edit-tags" class="form-input" />
          </div>

          <div class="form-group full-width">
            <label for="edit-description">Descrição do Curso</label>
            <textarea id="edit-description" class="form-textarea" rows="3"></textarea>
          </div>

          <div class="form-group full-width">
            <label>Categorias</label>
            <div class="categories-checkbox-grid">
              {categories.map(cat => (
                <label class="cat-checkbox-item">
                  <input type="checkbox" name="edit-cat" value={cat.id} />
                  <span>{cat.name}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="form-group full-width checkbox-row">
            <label class="switch-label">
              <input type="checkbox" id="edit-is-hidden" />
              <span>Ocultar curso da biblioteca pública</span>
            </label>
            <label class="switch-label">
              <input type="checkbox" id="edit-is-featured" />
              <span>Destaque no Hero da Home</span>
            </label>
          </div>
        </form>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="btn-cancel-edit">Cancelar</button>
          <button type="button" class="btn btn-primary" id="btn-save-course-meta">Salvar Metadados</button>
        </div>
      </div>
    </div>

    <!-- Modal: Category CRUD Editor -->
    <div id="cat-modal" class="admin-modal-backdrop" style="display: none;">
      <div class="admin-modal-dialog">
        <div class="modal-header">
          <h2 class="modal-title" id="cat-modal-title">Nova Categoria</h2>
          <button type="button" class="btn-close-modal" id="btn-close-cat-modal">×</button>
        </div>
        <form id="cat-form" class="modal-body form-grid">
          <input type="hidden" id="cat-form-action" value="create" />
          <input type="hidden" id="cat-form-original-id" />

          <div class="form-group full-width">
            <label for="cat-form-name">Nome da Categoria</label>
            <input type="text" id="cat-form-name" class="form-input" placeholder="Ex: Engenharia de Prompts" required />
          </div>

          <div class="form-group full-width">
            <label for="cat-form-id">ID / Slug de Identificação</label>
            <input type="text" id="cat-form-id" class="form-input" placeholder="Ex: engenharia-prompts (gerado automaticamente)" />
            <span class="field-hint">Usado como identificador único nas URLs e rotas.</span>
          </div>

          <div class="form-group full-width">
            <label for="cat-form-icon">Ícone da Categoria</label>
            <select id="cat-form-icon" class="form-input form-select">
              <option value="sparkles">✨ sparkles — Inteligência Artificial</option>
              <option value="cpu">⚡ cpu — Automação & Agentes</option>
              <option value="terminal">💻 terminal — Programação & Dev</option>
              <option value="layers">📐 layers — Web & Vibe Coding</option>
              <option value="database">🗄️ database — Backend & Infra</option>
              <option value="bar-chart-2">📊 bar-chart-2 — Dados & Science</option>
              <option value="trending-up">📈 trending-up — Trading & Mercado</option>
              <option value="smile">🧘 smile — Desenvolvimento Pessoal</option>
              <option value="code">⌨️ code — Algoritmos</option>
              <option value="brain">🧠 brain — Machine Learning</option>
              <option value="palette">🎨 palette — Design & UX</option>
              <option value="book-open">📚 book-open — Estudos & Teoria</option>
              <option value="video">🎥 video — Audiovisual</option>
              <option value="zap">⚡ zap — Performance</option>
              <option value="folder">📁 folder — Padrão</option>
            </select>
          </div>

          <div class="form-group full-width">
            <label for="cat-form-desc">Descrição Detalhada</label>
            <textarea id="cat-form-desc" class="form-textarea" rows="3" placeholder="Resumo prático sobre o conteúdo contido nesta categoria..."></textarea>
          </div>
        </form>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="btn-cancel-cat-modal">Cancelar</button>
          <button type="button" class="btn btn-primary" id="btn-save-category">Salvar Categoria</button>
        </div>
      </div>
    </div>

    <!-- Modal: Category Delete Confirmation -->
    <div id="delete-cat-modal" class="admin-modal-backdrop" style="display: none;">
      <div class="admin-modal-dialog">
        <div class="modal-header">
          <h2 class="modal-title text-danger">Excluir Categoria</h2>
          <button type="button" class="btn-close-modal" id="btn-close-delete-cat">×</button>
        </div>
        <div class="modal-body">
          <p>Tem certeza de que deseja remover a categoria <strong id="delete-cat-name-display" class="accent-cyan"></strong> (<code id="delete-cat-id-display"></code>)?</p>
          <p class="field-hint text-warning mt-2" id="delete-cat-warning-text">Esta ação removerá a categoria das listagens e filtros do sistema.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="btn-cancel-delete-cat">Cancelar</button>
          <button type="button" class="btn btn-danger" id="btn-confirm-delete-cat">Sim, Excluir Categoria</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { showToast } from '../lib/toast';
  import {
    getMediaMode,
    setMediaMode,
    getMediaServerUrl,
    setMediaServerUrl,
    checkServerHealth
  } from '../lib/mediaProvider';
  import {
    getLocalCourseOverrides,
    saveLocalCourseOverride,
    getLocalCategoryOverrides,
    saveLocalCategoryOverrides,
    syncOverridesFromServer
  } from '../lib/clientOverrides';

  function applyOverridesToDOM(overrides: Record<string, any>) {
    if (!overrides || typeof overrides !== 'object') return;
    const courseRows = document.querySelectorAll<HTMLElement>('.course-row-item');
    const catCountMap: Record<string, number> = {};

    courseRows.forEach(row => {
      const id = row.getAttribute('data-id');
      if (!id) return;
      const ov = overrides[id];
      const editBtn = row.querySelector<HTMLButtonElement>('.btn-edit-course');
      let currentCourseData = editBtn ? JSON.parse(editBtn.getAttribute('data-course') || '{}') : null;

      if (ov && currentCourseData) {
        currentCourseData = { ...currentCourseData, ...ov };
        if (editBtn) editBtn.setAttribute('data-course', JSON.stringify(currentCourseData));

        if (ov.display_title) {
          const titleEl = row.querySelector('.course-display-name');
          if (titleEl) titleEl.textContent = ov.display_title;
          row.setAttribute('data-title', ov.display_title.toLowerCase());
        }

        if (ov.provider) {
          const provBadge = row.querySelector('.badge-provider');
          if (provBadge) provBadge.textContent = ov.provider;
          row.setAttribute('data-provider', ov.provider);
        }

        if (Array.isArray(ov.categories)) {
          const tagsCell = row.querySelector('.cats-tags-cell');
          if (tagsCell) {
            tagsCell.innerHTML = ov.categories.map((c: string) => `<span class="mini-chip">${c}</span>`).join('');
          }
        }

        if (ov.is_hidden !== undefined) {
          const statusBadge = row.querySelector('.badge-warning, .badge-success');
          if (statusBadge) {
            statusBadge.className = ov.is_hidden ? 'badge badge-warning' : 'badge badge-success';
            statusBadge.textContent = ov.is_hidden ? 'Oculto' : 'Ativo';
          }
        }
      }

      // Count categories
      const effectiveCats = currentCourseData?.categories || [];
      effectiveCats.forEach((catId: string) => {
        catCountMap[catId] = (catCountMap[catId] || 0) + 1;
      });
    });

    // Update category table rows
    document.querySelectorAll<HTMLElement>('.cat-row-item').forEach(catRow => {
      const catId = catRow.getAttribute('data-id');
      if (!catId) return;
      const count = catCountMap[catId] || 0;
      const badge = catRow.querySelector('.badge-provider');
      if (badge) badge.textContent = `${count} cursos`;
      const delBtn = catRow.querySelector('.btn-delete-category');
      if (delBtn) delBtn.setAttribute('data-count', String(count));
    });
  }

  function initLibraryAdmin() {
    const pageContainer = document.querySelector('.library-admin-page');
    if (!pageContainer) return;

    // Apply cached overrides immediately to the DOM
    const initialCourseOverrides = getLocalCourseOverrides();
    applyOverridesToDOM(initialCourseOverrides);

    // Sync in background with Netlify Blobs / server
    syncOverridesFromServer().then(({ courses }) => {
      applyOverridesToDOM(courses);
    });

    const mediaServerUrlInput = document.getElementById('input-media-server-url') as HTMLInputElement | null;
    const mediaModeSelect = document.getElementById('select-media-mode') as HTMLSelectElement | null;
    const btnSaveServerUrl = document.getElementById('btn-save-server-url');
    const statusDot = document.getElementById('status-dot');
    const statusText = document.getElementById('status-text');

    if (mediaServerUrlInput) mediaServerUrlInput.value = getMediaServerUrl();
    if (mediaModeSelect) mediaModeSelect.value = getMediaMode();

    async function updateServerStatusUI() {
      if (!statusText || !statusDot) return;
      statusText.textContent = 'Testando Conexão...';
      statusDot.className = 'pulse-dot-indicator pulse-testing';

      const url = mediaServerUrlInput?.value || getMediaServerUrl();
      const isOnline = await checkServerHealth(url);

      if (isOnline) {
        statusText.textContent = 'Servidor Online 🟢';
        statusDot.className = 'pulse-dot-indicator pulse-online';
      } else {
        statusText.textContent = 'Servidor Offline 🔴';
        statusDot.className = 'pulse-dot-indicator pulse-offline';
      }
    }

    updateServerStatusUI();

    btnSaveServerUrl?.addEventListener('click', async () => {
      const val = mediaServerUrlInput?.value?.trim() || '';
      if (val) {
        setMediaServerUrl(val);
        showToast('URL do Servidor salva!', 'success', 2000);
        await updateServerStatusUI();
      }
    });

    mediaModeSelect?.addEventListener('change', () => {
      const mode = mediaModeSelect.value as any;
      setMediaMode(mode);
      showToast(`Modo alterado para: ${mediaModeSelect.options[mediaModeSelect.selectedIndex].text}`, 'info', 2000);
      updateServerStatusUI();
    });

    // Navigation Tabs Logic
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const tabSections = document.querySelectorAll<HTMLElement>('.tab-section');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        tabBtns.forEach(b => b.classList.remove('active'));
        tabSections.forEach(s => s.classList.remove('active'));

        btn.classList.add('active');
        const targetSec = document.getElementById(`section-${targetTab}`);
        if (targetSec) targetSec.classList.add('active');
      });
    });

    const btnDryRun = document.getElementById('btn-dry-run-scan') as HTMLButtonElement | null;
    const btnApply = document.getElementById('btn-apply-scan') as HTMLButtonElement | null;
    const dryRunModal = document.getElementById('dryrun-modal');
    const dryRunModalTitle = document.getElementById('dryrun-modal-title');
    const dryRunOutput = document.getElementById('dryrun-output');
    const btnCloseDryRun = document.getElementById('btn-close-dryrun');
    const btnCancelDryRun = document.getElementById('btn-cancel-dryrun');
    const btnConfirmApply = document.getElementById('btn-confirm-apply');

    // Edit Course Modal Elements
    const editModal = document.getElementById('edit-modal');
    const btnCloseEdit = document.getElementById('btn-close-edit');
    const btnCancelEdit = document.getElementById('btn-cancel-edit');
    const btnSaveEdit = document.getElementById('btn-save-course-meta');
    const editId = document.getElementById('edit-course-id') as HTMLInputElement | null;
    const editTitle = document.getElementById('edit-display-title') as HTMLInputElement | null;
    const editProvider = document.getElementById('edit-provider') as HTMLInputElement | null;
    const editTags = document.getElementById('edit-tags') as HTMLInputElement | null;
    const editDesc = document.getElementById('edit-description') as HTMLTextAreaElement | null;
    const editHidden = document.getElementById('edit-is-hidden') as HTMLInputElement | null;
    const editFeatured = document.getElementById('edit-is-featured') as HTMLInputElement | null;

    // Filter Course Table
    const filterInput = document.getElementById('filter-course-input') as HTMLInputElement | null;
    const filterProvider = document.getElementById('filter-provider-select') as HTMLSelectElement | null;
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.course-row-item'));

    function filterTable() {
      const q = (filterInput?.value || '').toLowerCase().trim();
      const p = filterProvider?.value || '';

      rows.forEach(r => {
        const title = r.getAttribute('data-title') || '';
        const raw = r.getAttribute('data-raw') || '';
        const provider = r.getAttribute('data-provider') || '';

        const matchesQ = !q || title.includes(q) || raw.includes(q) || provider.toLowerCase().includes(q);
        const matchesP = !p || provider === p;

        r.style.display = matchesQ && matchesP ? '' : 'none';
      });
    }

    filterInput?.addEventListener('input', filterTable);
    filterProvider?.addEventListener('change', filterTable);

    // Filter Category Table
    const filterCatInput = document.getElementById('filter-cat-input') as HTMLInputElement | null;
    const catRows = Array.from(document.querySelectorAll<HTMLElement>('.cat-row-item'));

    function filterCategoryTable() {
      const q = (filterCatInput?.value || '').toLowerCase().trim();
      catRows.forEach(r => {
        const name = r.getAttribute('data-name') || '';
        const id = r.getAttribute('data-id') || '';
        const desc = r.getAttribute('data-desc') || '';

        const matches = !q || name.includes(q) || id.includes(q) || desc.includes(q);
        r.style.display = matches ? '' : 'none';
      });
    }

    filterCatInput?.addEventListener('input', filterCategoryTable);

    // Trigger Dry Run / Apply Scan
    async function triggerScan(dryRun = true) {
      const activeBtn = dryRun ? btnDryRun : btnApply;
      const originalHtml = activeBtn ? activeBtn.innerHTML : '';

      if (activeBtn) {
        activeBtn.disabled = true;
        activeBtn.innerHTML = `
          <svg class="spin-animation" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
            <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
          </svg>
          <span>${dryRun ? 'Escaneando...' : 'Atualizando...'}</span>
        `;
      }

      if (dryRunModal && dryRunOutput) {
        dryRunModal.style.display = 'flex';
        if (dryRunModalTitle) {
          dryRunModalTitle.textContent = dryRun ? 'Relatório de Varredura (Dry Run)' : 'Atualização da Biblioteca & Catálogo';
        }
        if (btnConfirmApply) {
          btnConfirmApply.style.display = dryRun ? 'inline-flex' : 'none';
        }
        dryRunOutput.textContent = '⏳ Executando varredura na biblioteca...\n\nProcessando diretórios, verificando arquivos locais e Google Drive...\nPor favor, aguarde.';
      }

      try {
        const res = await fetch('/api/library/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dry_run: dryRun })
        });
        const data = await res.json().catch(() => ({ error: 'Resposta não pôde ser interpretada como JSON.' }));

        if (!res.ok || (data && data.success === false)) {
          const errMsg = data?.error || data?.stderr || 'Erro ao processar a varredura.';
          if (dryRunOutput) {
            dryRunOutput.textContent = `❌ ${errMsg}\n\n${data?.output || ''}`;
          }
          showToast(errMsg, 'error', 4000);
          return;
        }

        if (dryRunOutput) {
          dryRunOutput.textContent = data.output || (data.summary ? JSON.stringify(data.summary, null, 2) : 'Varredura concluída com sucesso.');
        }

        if (!dryRun) {
          if (!data.is_cloud) {
            showToast('Biblioteca atualizada com sucesso!', 'success');
            setTimeout(() => window.location.reload(), 2000);
          } else {
            showToast('Instruções de sincronização exibidas no relatório.', 'info', 4000);
          }
        } else {
          showToast('Varredura (Dry Run) finalizada!', 'info', 2000);
        }
      } catch (err: any) {
        const errMsg = `Erro ao executar varredura: ${err?.message || err}`;
        if (dryRunOutput) dryRunOutput.textContent = `❌ ${errMsg}`;
        showToast(errMsg, 'error', 4000);
      } finally {
        if (activeBtn) {
          activeBtn.disabled = false;
          activeBtn.innerHTML = originalHtml;
        }
      }
    }

    btnDryRun?.addEventListener('click', () => triggerScan(true));
    btnApply?.addEventListener('click', () => {
      triggerScan(false);
    });

    btnConfirmApply?.addEventListener('click', () => {
      triggerScan(false);
    });

    btnCloseDryRun?.addEventListener('click', () => dryRunModal && (dryRunModal.style.display = 'none'));
    btnCancelDryRun?.addEventListener('click', () => dryRunModal && (dryRunModal.style.display = 'none'));
    dryRunModal?.addEventListener('click', (e) => {
      if (e.target === dryRunModal) dryRunModal.style.display = 'none';
    });

    // Edit Course Modal Logic
    document.querySelectorAll<HTMLButtonElement>('.btn-edit-course').forEach(btn => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-course');
        if (!raw || !editModal) return;
        const c = JSON.parse(raw);

        if (editId) editId.value = c.id;
        if (editTitle) editTitle.value = c.display_title;
        if (editProvider) editProvider.value = c.provider;
        if (editTags) editTags.value = (c.tags || []).join(', ');
        if (editDesc) editDesc.value = c.description;
        if (editHidden) editHidden.checked = Boolean(c.is_hidden);
        if (editFeatured) editFeatured.checked = Boolean(c.is_featured);

        // Checkboxes
        const catCheckboxes = document.querySelectorAll<HTMLInputElement>('input[name="edit-cat"]');
        catCheckboxes.forEach(cb => {
          cb.checked = (c.categories || []).includes(cb.value);
        });

        editModal.style.display = 'flex';
      });
    });

    btnCloseEdit?.addEventListener('click', () => editModal && (editModal.style.display = 'none'));
    btnCancelEdit?.addEventListener('click', () => editModal && (editModal.style.display = 'none'));
    editModal?.addEventListener('click', (e) => {
      if (e.target === editModal) editModal.style.display = 'none';
    });

    btnSaveEdit?.addEventListener('click', async () => {
      const courseId = editId?.value;
      if (!courseId) return;

      const selectedCats = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="edit-cat"]:checked')).map(cb => cb.value);
      const tagsArr = (editTags?.value || '').split(',').map(t => t.trim()).filter(Boolean);

      const patch = {
        display_title: editTitle?.value || '',
        provider: editProvider?.value || '',
        description: editDesc?.value || '',
        categories: selectedCats,
        tags: tagsArr,
        is_hidden: editHidden?.checked,
        is_featured: editFeatured?.checked
      };

      // 1. Immediately persist to client storage
      saveLocalCourseOverride(courseId, patch);

      // 2. Immediately update DOM in-place
      const currentOverrides = getLocalCourseOverrides();
      applyOverridesToDOM(currentOverrides);

      try {
        btnSaveEdit.textContent = 'Salvando...';
        const res = await fetch('/api/library/update-course', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            courseId,
            ...patch
          })
        });

        const data = await res.json();
        if (data.success) {
          showToast('Metadados e categorias salvos com sucesso!', 'success');
          if (editModal) editModal.style.display = 'none';
          setTimeout(() => window.location.reload(), 800);
        } else {
          showToast(data.error || 'Erro ao salvar metadados no servidor', 'warning');
        }
      } catch (err: any) {
        showToast('Salvo em cache local!', 'info');
        if (editModal) editModal.style.display = 'none';
      } finally {
        btnSaveEdit.textContent = 'Salvar Metadados';
      }
    });

    // Category CRUD Logic
    const catModal = document.getElementById('cat-modal');
    const catModalTitle = document.getElementById('cat-modal-title');
    const btnCloseCatModal = document.getElementById('btn-close-cat-modal');
    const btnCancelCatModal = document.getElementById('btn-cancel-cat-modal');
    const btnCreateCat = document.getElementById('btn-create-category');
    const btnSaveCat = document.getElementById('btn-save-category');

    const catFormAction = document.getElementById('cat-form-action') as HTMLInputElement | null;
    const catFormOriginalId = document.getElementById('cat-form-original-id') as HTMLInputElement | null;
    const catFormName = document.getElementById('cat-form-name') as HTMLInputElement | null;
    const catFormId = document.getElementById('cat-form-id') as HTMLInputElement | null;
    const catFormIcon = document.getElementById('cat-form-icon') as HTMLSelectElement | null;
    const catFormDesc = document.getElementById('cat-form-desc') as HTMLTextAreaElement | null;

    // Delete Category Modal Elements
    const deleteCatModal = document.getElementById('delete-cat-modal');
    const btnCloseDeleteCat = document.getElementById('btn-close-delete-cat');
    const btnCancelDeleteCat = document.getElementById('btn-cancel-delete-cat');
    const btnConfirmDeleteCat = document.getElementById('btn-confirm-delete-cat');
    const deleteCatNameDisplay = document.getElementById('delete-cat-name-display');
    const deleteCatIdDisplay = document.getElementById('delete-cat-id-display');
    const deleteCatWarningText = document.getElementById('delete-cat-warning-text');
    let categoryToDeleteId: string | null = null;

    // Open Create Category Modal
    btnCreateCat?.addEventListener('click', () => {
      if (!catModal) return;
      if (catModalTitle) catModalTitle.textContent = 'Nova Categoria';
      if (catFormAction) catFormAction.value = 'create';
      if (catFormOriginalId) catFormOriginalId.value = '';
      if (catFormName) catFormName.value = '';
      if (catFormId) {
        catFormId.value = '';
        catFormId.readOnly = false;
      }
      if (catFormIcon) catFormIcon.value = 'sparkles';
      if (catFormDesc) catFormDesc.value = '';

      catModal.style.display = 'flex';
    });

    // Open Edit Category Modal
    document.querySelectorAll<HTMLButtonElement>('.btn-edit-category').forEach(btn => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-category');
        if (!raw || !catModal) return;
        const cat = JSON.parse(raw);

        if (catModalTitle) catModalTitle.textContent = 'Editar Categoria';
        if (catFormAction) catFormAction.value = 'update';
        if (catFormOriginalId) catFormOriginalId.value = cat.id;
        if (catFormName) catFormName.value = cat.name;
        if (catFormId) {
          catFormId.value = cat.id;
          catFormId.readOnly = true;
        }
        if (catFormIcon) catFormIcon.value = cat.icon || 'folder';
        if (catFormDesc) catFormDesc.value = cat.description || '';

        catModal.style.display = 'flex';
      });
    });

    // Auto slug generator on Category Name input (only when creating)
    catFormName?.addEventListener('input', () => {
      if (catFormAction?.value === 'create' && catFormId) {
        const slug = catFormName.value
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9 -]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-');
        catFormId.value = slug;
      }
    });

    btnCloseCatModal?.addEventListener('click', () => catModal && (catModal.style.display = 'none'));
    btnCancelCatModal?.addEventListener('click', () => catModal && (catModal.style.display = 'none'));
    catModal?.addEventListener('click', (e) => {
      if (e.target === catModal) catModal.style.display = 'none';
    });

    // Save Category (Create or Update)
    btnSaveCat?.addEventListener('click', async () => {
      const action = catFormAction?.value || 'create';
      const name = catFormName?.value?.trim();
      const id = catFormId?.value?.trim() || catFormOriginalId?.value;
      const icon = catFormIcon?.value;
      const description = catFormDesc?.value?.trim();

      if (!name) {
        showToast('O nome da categoria é obrigatório.', 'error');
        return;
      }

      try {
        btnSaveCat.textContent = 'Salvando...';
        const res = await fetch('/api/library/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action,
            id,
            name,
            icon,
            description
          })
        });

        const data = await res.json();
        if (data.success) {
          showToast(action === 'create' ? 'Categoria criada com sucesso!' : 'Categoria atualizada!', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Erro ao salvar categoria.', 'error');
        }
      } catch (err: any) {
        showToast(err?.message || 'Erro de conexão.', 'error');
      } finally {
        btnSaveCat.textContent = 'Salvar Categoria';
      }
    });

    // Open Delete Category Modal
    document.querySelectorAll<HTMLButtonElement>('.btn-delete-category').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        const count = parseInt(btn.getAttribute('data-count') || '0', 10);
        if (!id || !deleteCatModal) return;

        categoryToDeleteId = id;
        if (deleteCatNameDisplay) deleteCatNameDisplay.textContent = name || id;
        if (deleteCatIdDisplay) deleteCatIdDisplay.textContent = id;
        if (deleteCatWarningText) {
          deleteCatWarningText.textContent = count > 0 
            ? `Atenção: Há ${count} curso(s) vinculado(s) a esta categoria. A exclusão removerá o filtro da categoria.`
            : 'Esta categoria não possui nenhum curso vinculado no momento.';
        }

        deleteCatModal.style.display = 'flex';
      });
    });

    btnCloseDeleteCat?.addEventListener('click', () => deleteCatModal && (deleteCatModal.style.display = 'none'));
    btnCancelDeleteCat?.addEventListener('click', () => deleteCatModal && (deleteCatModal.style.display = 'none'));
    deleteCatModal?.addEventListener('click', (e) => {
      if (e.target === deleteCatModal) deleteCatModal.style.display = 'none';
    });

    // Confirm Delete Category
    btnConfirmDeleteCat?.addEventListener('click', async () => {
      if (!categoryToDeleteId) return;

      try {
        btnConfirmDeleteCat.textContent = 'Excluindo...';
        const res = await fetch('/api/library/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'delete',
            id: categoryToDeleteId
          })
        });

        const data = await res.json();
        if (data.success) {
          showToast('Categoria removida com sucesso!', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Erro ao excluir categoria.', 'error');
        }
      } catch (err: any) {
        showToast(err?.message || 'Erro de conexão.', 'error');
      } finally {
        btnConfirmDeleteCat.textContent = 'Sim, Excluir Categoria';
      }
    });
  }

  document.addEventListener('astro:page-load', initLibraryAdmin);
  initLibraryAdmin();
</script>

<style>
