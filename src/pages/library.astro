    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .header-content {
    max-width: 680px;
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

