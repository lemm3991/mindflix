---
// settings.astro - Painel de Preferências, Temas de Cores e Segurança
import Layout from '../layouts/Layout.astro';
import { THEME_PRESETS } from '../lib/theme';
import { BACKGROUND_PRESETS } from '../lib/backgrounds';
---

<Layout title="Preferências — Mindflix">
  <div class="container settings-page">
    <header class="page-header">
      <h1 class="page-title">Configurações & Preferências</h1>
      <p class="page-subtitle">Personalize a sua experiência de estudo, ambiente visual de fundo, tema de cores, reprodução de vídeo e segurança da conta.</p>
    </header>

    <div class="settings-sections-wrapper">
      <!-- Ambient Background Selection -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span>Ambiente Visual de Estudo (Background)</span>
        </h2>
        <p class="section-description">
          Escolha o estilo visual interativo do fundo da plataforma para otimizar sua imersão, foco e conforto visual durante as horas de estudo.
        </p>

        <div class="bg-style-grid" id="bg-style-grid">
          {BACKGROUND_PRESETS.map((b) => (
            <button
              type="button"
              class="bg-style-card"
              data-bg-id={b.id}
              aria-label={`Selecionar ambiente de fundo ${b.name}`}
            >
              <div class="theme-check-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="bg-style-preview" style={`background: ${b.previewGradient}; border-color: rgba(255,255,255,0.12);`}>
                <div class="bg-style-badge">{b.category}</div>
                <div class="bg-style-glow-dot" style={`background: ${b.accentColor}; box-shadow: 0 0 16px ${b.accentColor};`}></div>
              </div>
              <div class="bg-style-info">
                <div class="bg-style-name-row">
                  <span class="bg-style-name">{b.name}</span>
                  <span class="bg-style-tagline">{b.tagline}</span>
                </div>
                <p class="bg-style-desc">{b.description}</p>
              </div>
            </button>
          ))}
        </div>
      </section>

      <!-- Theme Palette Selection -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
          </svg>
          <span>Tema de Cores da Interface</span>
        </h2>
        <p class="section-description">
          Escolha uma das 8 paletas pré-definidas para personalizar os botões, destaques, bordas, orbes de brilho e as linhas animadas do fundo.
        </p>

        <div class="theme-grid" id="theme-grid">
          {THEME_PRESETS.map((t) => (
            <button 
              type="button" 
              class="theme-card" 
              data-theme-id={t.id}
              aria-label={`Selecionar tema ${t.name}`}
            >
              <div class="theme-check-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="theme-preview-box">
                <div class="theme-gradient-preview" style={`background: linear-gradient(135deg, ${t.primary} 0%, ${t.secondary} 100%);`}></div>
                <div class="theme-swatch-center">
                  <span class="theme-color-pill" style={`background: ${t.primary}; box-shadow: 0 0 10px ${t.primary};`}></span>
                  <span class="theme-color-pill" style={`background: ${t.secondary}; box-shadow: 0 0 8px ${t.secondary};`}></span>
                </div>
              </div>
              <div class="theme-info">
                <span class="theme-name">{t.name}</span>
                <span class="theme-colors-sub">{t.primary} • {t.secondary}</span>
              </div>
            </button>
          ))}
        </div>
      </section>

      <!-- Playback Preferences -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="10 8 16 12 10 16 10 8"></polygon>
          </svg>
          <span>Preferências de Reprodução</span>
        </h2>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Autoplay da Próxima Aula</span>
            <span class="setting-hint">Ao terminar o vídeo da aula atual, abre e reproduz a próxima aula automaticamente.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-autoplay" checked />
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Retomar Aulas Automaticamente</span>
            <span class="setting-hint">Ao abrir uma aula já iniciada, salta direto para o último segundo salvo sem perguntar.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-auto-resume" checked />
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Velocidade Padrão de Reprodução</span>
            <span class="setting-hint">Define a velocidade inicial com que todos os vídeos da plataforma serão reproduzidos para a sua conta.</span>
          </div>
          <div class="setting-control" style="width: 130px;">
            <select id="pref-playback-speed" class="form-input" style="padding: 0.35rem 0.65rem; font-size: 0.85rem; font-weight: 600;">
              <option value="0.75">0.75x</option>
              <option value="1" selected>1.0x (Normal)</option>
              <option value="1.25">1.25x</option>
              <option value="1.5">1.5x</option>
              <option value="1.75">1.75x</option>
              <option value="2">2.0x</option>
            </select>
          </div>
        </div>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Prévia Automática nos Cards</span>
            <span class="setting-hint">Permite reproduzir prévia de introdução ao passar o mouse sobre o card.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-auto-preview" />
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </section>

      <!-- Visual Preferences -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
          </svg>
          <span>Preferências Visuais & Efeitos</span>
        </h2>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Efeito Parallax</span>
            <span class="setting-hint">Camadas de profundidade discretas ao movimentar o mouse e rolar a página.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-parallax" />
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Background Interativo</span>
            <span class="setting-hint">Orbes de iluminação dinâmica e malha tecnológica no fundo da página.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-interactive-bg" checked />
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Reduzir Animações</span>
            <span class="setting-hint">Desativa transições e movimentos para maior sobriedade ou acessibilidade.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-reduce-motion" />
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </section>

      <!-- Account Security & Change Password -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Segurança & Alteração de Senha</span>
        </h2>

        <form id="change-password-form" class="change-pass-form">
          <div class="setting-row">
            <div class="setting-text">
              <span class="setting-name">Nova Senha</span>
              <span class="setting-hint">Digite a sua nova senha de acesso à plataforma (mínimo 6 caracteres).</span>
            </div>
            <div class="setting-control" style="width: 280px;">
              <input
                type="password"
                id="new-password"
                class="form-input"
                placeholder="••••••••"
                minlength="6"
                required
              />
            </div>
          </div>

          <div class="setting-row">
            <div class="setting-text">
              <span class="setting-name">Confirmar Nova Senha</span>
              <span class="setting-hint">Digite novamente a nova senha para confirmação.</span>
            </div>
            <div class="setting-control" style="width: 280px;">
              <input
                type="password"
                id="confirm-password"
                class="form-input"
                placeholder="••••••••"
                minlength="6"
                required
              />
            </div>
          </div>

          <div class="pass-btn-row">
            <button type="submit" class="btn btn-primary" id="btn-save-pass">
              <span>Atualizar Senha</span>
            </button>
          </div>
        </form>
      </section>

      <!-- AI & RAG Preferences -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.5h-2v-2h2zm0-4h-2V7h2z"></path>
          </svg>
          <span>Inteligência Artificial & Busca no Acervo</span>
        </h2>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Chave da API Google Gemini (Opcional)</span>
            <span class="setting-hint">Habilita síntese contextual em linguagem natural das transcrições do acervo.</span>
          </div>
          <div class="setting-control" style="width: 280px;">
            <input
              type="password"
              id="pref-gemini-key"
              class="form-input"
              placeholder="AIzaSy... (Opcional)"
              autocomplete="off"
            />
          </div>
        </div>
      </section>

      <!-- Advanced Cyber Security / IPS Center -->
      <section class="settings-card admin-only-section" id="sec-monitor-card" style="display: none;">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00f2fe" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>Monitor de Ataques & Prevenção de Intrusão (IPS)</span>
        </h2>
        <p class="section-description">
          Acesse o Centro de Operações de Segurança (SOC) para visualizar telemetria de ataques em tempo real, gerenciar regras de auto-bloqueio de IPs maliciosos e auditar incidentes.
        </p>

        <div class="setting-row" style="margin-top: 1rem;">
          <div class="setting-text">
            <span class="setting-name">Centro de Operações de Segurança (SOC)</span>
            <span class="setting-hint">Painel em tempo real com DEFCON, simulador de ataques e gerenciador de bans.</span>
          </div>
          <div class="setting-control">
            <a href="/security-monitor" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <span>Abrir Monitor de Segurança</span>
            </a>
          </div>
        </div>
      </section>

      <div class="save-status-box" id="save-status-box" style="display: none;">
        <span>Preferências salvas e sincronizadas com sucesso!</span>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getUserPreferences, saveUserPreferences, syncPreferencesFromSupabase } from '../lib/progress';
  import { applyTheme } from '../lib/theme';
  import { applyBackgroundStyle } from '../lib/backgrounds';
  import { getLocalUser } from '../lib/supabase';
  import { updateUserPassword } from '../lib/auth';
  import { showToast } from '../lib/toast';

  const user = getLocalUser();
  if (!user) {
    window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
  } else {
    const name = user.full_name || user.email || '';
    const isLemmg = name.toLowerCase().includes('lemmg0800');
    const secCard = document.getElementById('sec-monitor-card');
    if (secCard && isLemmg) {
      secCard.style.display = 'block';
    }
  }

  let activeThemeId = getUserPreferences().theme_id || 'cyan-indigo';
  let activeBgId = getUserPreferences().background_style || 'waves';

  const autoplay = document.getElementById('pref-autoplay') as HTMLInputElement | null;
  const autoResume = document.getElementById('pref-auto-resume') as HTMLInputElement | null;
  const autoPreview = document.getElementById('pref-auto-preview') as HTMLInputElement | null;
  const playbackSpeed = document.getElementById('pref-playback-speed') as HTMLSelectElement | null;
  const parallax = document.getElementById('pref-parallax') as HTMLInputElement | null;
  const interactiveBg = document.getElementById('pref-interactive-bg') as HTMLInputElement | null;
  const reduceMotion = document.getElementById('pref-reduce-motion') as HTMLInputElement | null;
  const geminiKey = document.getElementById('pref-gemini-key') as HTMLInputElement | null;
  const statusBox = document.getElementById('save-status-box');

  function updateThemeCardsUI() {
    const cards = document.querySelectorAll<HTMLElement>('.theme-card');
    cards.forEach(card => {
      const themeId = card.getAttribute('data-theme-id');
      if (themeId === activeThemeId) {
        card.classList.add('active');
      } else {
        card.classList.remove('active');
      }
    });
  }

  function updateBgCardsUI() {
    const cards = document.querySelectorAll<HTMLElement>('.bg-style-card');
    cards.forEach(card => {
      const bgId = card.getAttribute('data-bg-id');
      if (bgId === activeBgId) {
        card.classList.add('active');
      } else {
        card.classList.remove('active');
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.bg-style-card').forEach(card => {
    card.addEventListener('click', async () => {
      const bgId = card.getAttribute('data-bg-id');
      if (!bgId) return;

      activeBgId = bgId;
      applyBackgroundStyle(bgId);
      updateBgCardsUI();
      await handleUpdate();
    });
  });

  document.querySelectorAll<HTMLElement>('.theme-card').forEach(card => {
    card.addEventListener('click', async () => {
      const themeId = card.getAttribute('data-theme-id');
      if (!themeId) return;

      activeThemeId = themeId;
      applyTheme(themeId);
      updateThemeCardsUI();
      await handleUpdate();
    });
  });

  function loadFormValues() {
    const prefs = getUserPreferences();
    activeThemeId = prefs.theme_id || 'cyan-indigo';
    activeBgId = prefs.background_style || 'waves';
    applyTheme(activeThemeId);
    applyBackgroundStyle(activeBgId);
    updateThemeCardsUI();
    updateBgCardsUI();

    if (autoplay) autoplay.checked = prefs.autoplay_next;
    if (autoResume) autoResume.checked = prefs.auto_resume;
    if (autoPreview) autoPreview.checked = prefs.auto_preview;
    if (playbackSpeed) playbackSpeed.value = String(prefs.playback_speed || 1.0);
    if (parallax) parallax.checked = prefs.parallax_enabled;
    if (interactiveBg) interactiveBg.checked = prefs.interactive_bg_enabled;
    if (reduceMotion) reduceMotion.checked = prefs.reduce_motion;
    if (geminiKey) geminiKey.value = prefs.gemini_api_key || '';
  }

  // Sync latest preferences from Supabase if configured
  syncPreferencesFromSupabase().then(() => {
    loadFormValues();
  });

  loadFormValues();

  const showSaved = () => {
    if (statusBox) {
      statusBox.style.display = 'block';
      setTimeout(() => { statusBox.style.display = 'none'; }, 2500);
    }
  };

  const handleUpdate = async () => {
    await saveUserPreferences({
      autoplay_next: autoplay?.checked ?? true,
      auto_resume: autoResume?.checked ?? true,
      auto_preview: autoPreview?.checked ?? false,
      playback_speed: playbackSpeed ? parseFloat(playbackSpeed.value) || 1.0 : 1.0,
      parallax_enabled: parallax?.checked ?? false,
      interactive_bg_enabled: interactiveBg?.checked ?? true,
      reduce_motion: reduceMotion?.checked ?? false,
      theme_id: activeThemeId,
      background_style: activeBgId,
      gemini_api_key: geminiKey?.value.trim() || ''
    });
    showSaved();
  };

  autoplay?.addEventListener('change', handleUpdate);
  autoResume?.addEventListener('change', handleUpdate);
  autoPreview?.addEventListener('change', handleUpdate);
  playbackSpeed?.addEventListener('change', handleUpdate);
  parallax?.addEventListener('change', handleUpdate);
  interactiveBg?.addEventListener('change', handleUpdate);
  reduceMotion?.addEventListener('change', handleUpdate);
  geminiKey?.addEventListener('change', handleUpdate);

  // Password change form
  const passForm = document.getElementById('change-password-form');
  const newPassInput = document.getElementById('new-password') as HTMLInputElement | null;
  const confirmPassInput = document.getElementById('confirm-password') as HTMLInputElement | null;
  const savePassBtn = document.getElementById('btn-save-pass') as HTMLButtonElement | null;

  passForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const newPass = newPassInput?.value.trim() || '';
    const confirmPass = confirmPassInput?.value.trim() || '';

    if (newPass.length < 6) {
      showToast('A nova senha deve ter pelo menos 6 caracteres.', 'error');
      return;
    }

    if (newPass !== confirmPass) {
      showToast('As senhas digitadas não coincidem.', 'error');
      return;
    }

    if (savePassBtn) {
      savePassBtn.disabled = true;
      savePassBtn.innerHTML = '<span>Salvando no servidor...</span>';
    }

    const { changeUserPassword } = await import('../lib/auth');
    const result = await changeUserPassword(newPass);

    if (savePassBtn) {
      savePassBtn.disabled = false;
      savePassBtn.innerHTML = '<span>Atualizar Senha</span>';
    }

    if (result.success) {
      showToast('Senha alterada com sucesso no servidor!', 'success');
      if (newPassInput) newPassInput.value = '';
      if (confirmPassInput) confirmPassInput.value = '';
    } else {
      showToast(result.error || 'Falha ao atualizar a senha.', 'error');
    }
  });
</script>

<style>
  .settings-page {
    padding-top: 110px;
    padding-bottom: 5rem;
    max-width: 880px;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
  }

  .settings-sections-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .settings-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .card-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-primary);
  }

  .section-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  /* Ambient Background Selection Grid */
  .bg-style-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .bg-style-card {
    appearance: none !important;
    -webkit-appearance: none !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    background: #121620 !important;
    background-color: #121620 !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: var(--radius-md) !important;
    padding: 0.85rem !important;
    cursor: pointer !important;
    text-align: left !important;
    position: relative !important;
    color: #ffffff !important;
    outline: none !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
    transition: transform var(--motion-fast) var(--ease-out),
                border-color var(--motion-normal) var(--ease-out),
                box-shadow var(--motion-normal) var(--ease-out),
                background-color var(--motion-normal) var(--ease-out) !important;
  }

  .bg-style-card:hover {
    border-color: rgba(var(--accent-primary-rgb), 0.45) !important;
    transform: translateY(-3px) !important;
    background: #181e2b !important;
    background-color: #181e2b !important;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5), 0 0 14px rgba(var(--accent-primary-rgb), 0.15) !important;
  }

  .bg-style-card.active {
    border-color: var(--accent-cyan) !important;
    box-shadow: 0 0 0 1px var(--accent-cyan), 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 18px rgba(var(--accent-primary-rgb), 0.2) !important;
    background: #182030 !important;
    background-color: #182030 !important;
  }

  .bg-style-preview {
    width: 100%;
    height: 72px;
    border-radius: var(--radius-sm);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 0.75rem;
  }

  .bg-style-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.5rem;
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(4px);
  }

  .bg-style-glow-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }

  .bg-style-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .bg-style-name-row {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .bg-style-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
  }

  .bg-style-tagline {
    font-size: 0.75rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .bg-style-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
