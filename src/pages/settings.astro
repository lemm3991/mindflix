---
// settings.astro - Painel de Preferências, Temas de Cores, Filtro de Categorias e Segurança
import Layout from '../layouts/Layout.astro';
import { THEME_PRESETS } from '../lib/theme';
import { getCategories, getAllCourses } from '../lib/catalog';
import { BACKGROUND_PRESETS } from '../lib/backgrounds';

const categories = getCategories();
const allCourses = getAllCourses();

// Calculate course count per category
const categoryCounts: Record<string, number> = {};
categories.forEach(cat => {
  categoryCounts[cat.id] = allCourses.filter(c => c.categories?.includes(cat.id)).length;
});
