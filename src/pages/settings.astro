---
// settings.astro - Painel de Preferências, Temas de Cores e Segurança
import Layout from '../layouts/Layout.astro';
---

<Layout title="Preferências — Mindflix">
  <div class="container settings-page">
    <header class="page-header">
      <h1 class="page-title">Configurações & Preferências</h1>
      <p class="page-subtitle">Personalize a sua experiência de estudo, tema de cores, reprodução de vídeo, interface visual e segurança da conta.</p>
    </header>

    <div class="settings-sections-wrapper">
      <!-- Theme Palette Selection -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
          </svg>
          <span>Tema de Cores da Interface</span>
        </h2>
        <p class="section-description">
          Escolha uma das 8 paletas pré-definidas para personalizar os botões, destaques, bordas, orbes de brilho e as linhas animadas do fundo.
        </p>

        <div class="theme-grid" id="theme-grid">
          <!-- Populated dynamically via JS -->
        </div>
      </section>

      <!-- Playback Preferences -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="10 8 16 12 10 16 10 8"></polygon>
          </svg>
          <span>Preferências de Reprodução</span>
        </h2>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Velocidade Padrão do Player</span>
            <span class="setting-hint">Define a velocidade com que todos os vídeos serão abertos inicialmente.</span>
          </div>
          <div class="setting-control">
            <select id="pref-speed" class="form-select">
              <option value="0.75">0.75x</option>
              <option value="1.0" selected>1.0x (Normal)</option>
              <option value="1.25">1.25x</option>
              <option value="1.5">1.5x</option>
              <option value="1.75">1.75x</option>
              <option value="2.0">2.0x</option>
            </select>
          </div>
        </div>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Autoplay da Próxima Aula</span>
            <span class="setting-hint">Ao terminar o vídeo da aula atual, abre e reproduz a próxima aula automaticamente.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-autoplay" checked />
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Retomar Aulas Automaticamente</span>
            <span class="setting-hint">Ao abrir uma aula já iniciada, salta direto para o último segundo salvo sem perguntar.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-auto-resume" checked />
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Prévia Automática nos Cards</span>
            <span class="setting-hint">Permite reproduzir prévia de introdução ao passar o mouse sobre o card.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-auto-preview" />
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </section>

      <!-- Visual Preferences -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
          </svg>
          <span>Preferências Visuais & Efeitos</span>
        </h2>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Efeito Parallax</span>
            <span class="setting-hint">Camadas de profundidade discretas ao movimentar o mouse e rolar a página.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-parallax" checked />
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Background Interativo</span>
            <span class="setting-hint">Orbes de iluminação dinâmica e malha tecnológica no fundo da página.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-interactive-bg" checked />
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Reduzir Animações</span>
            <span class="setting-hint">Desativa transições e movimentos para maior sobriedade ou acessibilidade.</span>
          </div>
          <div class="setting-control">
            <label class="switch">
              <input type="checkbox" id="pref-reduce-motion" />
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </section>

      <!-- Account Security & Change Password -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Segurança & Alteração de Senha</span>
        </h2>

        <form id="change-password-form" class="change-pass-form">
          <div class="setting-row">
            <div class="setting-text">
              <span class="setting-name">Nova Senha</span>
              <span class="setting-hint">Digite a sua nova senha de acesso à plataforma (mínimo 6 caracteres).</span>
            </div>
            <div class="setting-control" style="width: 280px;">
              <input
                type="password"
                id="new-password"
                class="form-input"
                placeholder="••••••••"
                minlength="6"
                required
              />
            </div>
          </div>

          <div class="setting-row">
            <div class="setting-text">
              <span class="setting-name">Confirmar Nova Senha</span>
              <span class="setting-hint">Digite novamente a nova senha para confirmação.</span>
            </div>
            <div class="setting-control" style="width: 280px;">
              <input
                type="password"
                id="confirm-password"
                class="form-input"
                placeholder="••••••••"
                minlength="6"
                required
              />
            </div>
          </div>

          <div class="pass-btn-row">
            <button type="submit" class="btn btn-primary" id="btn-save-pass">
              <span>Atualizar Senha</span>
            </button>
          </div>
        </form>
      </section>

      <!-- AI & RAG Preferences -->
      <section class="settings-card">
        <h2 class="card-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.5h-2v-2h2zm0-4h-2V7h2z"></path>
          </svg>
          <span>Inteligência Artificial & Busca no Acervo</span>
        </h2>

        <div class="setting-row">
          <div class="setting-text">
            <span class="setting-name">Chave da API Google Gemini (Opcional)</span>
            <span class="setting-hint">Habilita síntese contextual em linguagem natural das transcrições do acervo.</span>
          </div>
          <div class="setting-control" style="width: 280px;">
            <input
              type="password"
              id="pref-gemini-key"
              class="form-input"
              placeholder="AIzaSy... (Opcional)"
              autocomplete="off"
            />
          </div>
        </div>
      </section>

      <div class="save-status-box" id="save-status-box" style="display: none;">
        <span>Preferências salvas e sincronizadas com sucesso!</span>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getUserPreferences, saveUserPreferences, syncPreferencesFromSupabase } from '../lib/progress';
  import { THEME_PRESETS, applyTheme, getThemePreset } from '../lib/theme';
  import { getLocalUser } from '../lib/supabase';
  import { updateUserPassword } from '../lib/auth';
  import { showToast } from '../lib/toast';

  const user = getLocalUser();
  if (!user) {
    window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
  }

  let activeThemeId = getUserPreferences().theme_id || 'cyan-indigo';

  const speed = document.getElementById('pref-speed') as HTMLSelectElement | null;
  const autoplay = document.getElementById('pref-autoplay') as HTMLInputElement | null;
  const autoResume = document.getElementById('pref-auto-resume') as HTMLInputElement | null;
  const autoPreview = document.getElementById('pref-auto-preview') as HTMLInputElement | null;
  const parallax = document.getElementById('pref-parallax') as HTMLInputElement | null;
  const interactiveBg = document.getElementById('pref-interactive-bg') as HTMLInputElement | null;
  const reduceMotion = document.getElementById('pref-reduce-motion') as HTMLInputElement | null;
  const geminiKey = document.getElementById('pref-gemini-key') as HTMLInputElement | null;
  const statusBox = document.getElementById('save-status-box');
  const themeGrid = document.getElementById('theme-grid');

  function renderThemeGrid() {
    if (!themeGrid) return;

    themeGrid.innerHTML = THEME_PRESETS.map(t => {
      const isActive = t.id === activeThemeId;
      return `
        <button 
          type="button" 
          class="theme-card ${isActive ? 'active' : ''}" 
          data-theme-id="${t.id}"
          aria-label="Selecionar tema ${t.name}"
        >
          <div class="theme-check-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="theme-preview-box">
            <div class="theme-gradient-preview" style="background: linear-gradient(135deg, ${t.primary} 0%, ${t.secondary} 100%);"></div>
            <div class="theme-swatch-center">
              <span class="theme-color-pill" style="background: ${t.primary}; box-shadow: 0 0 10px ${t.primary};"></span>
              <span class="theme-color-pill" style="background: ${t.secondary}; box-shadow: 0 0 8px ${t.secondary};"></span>
            </div>
          </div>
          <div class="theme-info">
            <span class="theme-name">${t.name}</span>
            <span class="theme-colors-sub">${t.primary} &bull; ${t.secondary}</span>
          </div>
        </button>
      `;
    }).join('');

    themeGrid.querySelectorAll('.theme-card').forEach(card => {
      card.addEventListener('click', async () => {
        const themeId = card.getAttribute('data-theme-id');
        if (!themeId) return;

        activeThemeId = themeId;
        applyTheme(themeId);
        renderThemeGrid();
        await handleUpdate();
      });
    });
  }

  function loadFormValues() {
    const prefs = getUserPreferences();
    activeThemeId = prefs.theme_id || 'cyan-indigo';
    applyTheme(activeThemeId);
    renderThemeGrid();

    if (speed) speed.value = prefs.playback_speed.toString();
    if (autoplay) autoplay.checked = prefs.autoplay_next;
    if (autoResume) autoResume.checked = prefs.auto_resume;
    if (autoPreview) autoPreview.checked = prefs.auto_preview;
    if (parallax) parallax.checked = prefs.parallax_enabled;
    if (interactiveBg) interactiveBg.checked = prefs.interactive_bg_enabled;
    if (reduceMotion) reduceMotion.checked = prefs.reduce_motion;
    if (geminiKey) geminiKey.value = prefs.gemini_api_key || '';
  }

  // Sync latest preferences from Supabase if configured
  syncPreferencesFromSupabase().then(() => {
    loadFormValues();
  });

  loadFormValues();

  const showSaved = () => {
    if (statusBox) {
      statusBox.style.display = 'block';
      setTimeout(() => { statusBox.style.display = 'none'; }, 2500);
    }
  };

  const handleUpdate = async () => {
    await saveUserPreferences({
      playback_speed: parseFloat(speed?.value || '1.0'),
      autoplay_next: autoplay?.checked ?? true,
      auto_resume: autoResume?.checked ?? true,
      auto_preview: autoPreview?.checked ?? false,
      parallax_enabled: parallax?.checked ?? true,
      interactive_bg_enabled: interactiveBg?.checked ?? true,
      reduce_motion: reduceMotion?.checked ?? false,
      theme_id: activeThemeId,
      gemini_api_key: geminiKey?.value.trim() || ''
    });
    showSaved();
  };

  speed?.addEventListener('change', handleUpdate);
  autoplay?.addEventListener('change', handleUpdate);
  autoResume?.addEventListener('change', handleUpdate);
  autoPreview?.addEventListener('change', handleUpdate);
  parallax?.addEventListener('change', handleUpdate);
  interactiveBg?.addEventListener('change', handleUpdate);
  reduceMotion?.addEventListener('change', handleUpdate);
  geminiKey?.addEventListener('change', handleUpdate);

  // Password change form
  const passForm = document.getElementById('change-password-form');
  const newPassInput = document.getElementById('new-password') as HTMLInputElement | null;
  const confirmPassInput = document.getElementById('confirm-password') as HTMLInputElement | null;

  passForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const newPass = newPassInput?.value.trim() || '';
    const confirmPass = confirmPassInput?.value.trim() || '';

    if (newPass.length < 6) {
      showToast('A nova senha deve ter pelo menos 6 caracteres.', 'error');
      return;
    }

    if (newPass !== confirmPass) {
      showToast('As senhas digitadas não coincidem.', 'error');
      return;
    }

    const currentLoggedUser = getLocalUser();
    if (!currentLoggedUser) return;

    const username = currentLoggedUser.full_name || currentLoggedUser.email.split('@')[0];
    const success = updateUserPassword(username, newPass);

    if (success) {
      showToast('Senha alterada com sucesso! Utilize a nova senha no próximo acesso.', 'success');
      if (newPassInput) newPassInput.value = '';
      if (confirmPassInput) confirmPassInput.value = '';
    } else {
      showToast('Falha ao atualizar a senha.', 'error');
    }
  });
</script>

<style>
  .settings-page {
    padding-top: 110px;
    padding-bottom: 5rem;
    max-width: 880px;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
  }

  .settings-sections-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .settings-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .card-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-primary);
  }

  .section-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  /* Premium Theme Swatch Grid */
  .theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 1.15rem;
  }

  .theme-card {
    appearance: none;
    -webkit-appearance: none;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: rgba(18, 22, 32, 0.85) !important;
    border: 1px solid var(--border-medium) !important;
    border-radius: var(--radius-md);
    padding: 0.75rem;
    cursor: pointer;
    text-align: left;
    position: relative;
    color: #ffffff !important;
    outline: none;
    box-sizing: border-box;
    overflow: hidden;
    transition: transform var(--motion-fast) var(--ease-out),
                border-color var(--motion-normal) var(--ease-out),
                box-shadow var(--motion-normal) var(--ease-out),
                background-color var(--motion-normal) var(--ease-out);
  }

  .theme-card:hover {
    border-color: rgba(var(--accent-primary-rgb), 0.55) !important;
    transform: translateY(-3px);
    background: rgba(26, 32, 48, 0.95) !important;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.55), 0 0 16px rgba(var(--accent-primary-rgb), 0.18);
  }

  .theme-card.active {
    border-color: var(--accent-cyan) !important;
    box-shadow: 0 0 0 2px rgba(var(--accent-primary-rgb), 0.35), 0 10px 28px rgba(0, 0, 0, 0.65), 0 0 22px rgba(var(--accent-primary-rgb), 0.25) !important;
    background: rgba(24, 32, 50, 0.95) !important;
  }

  .theme-preview-box {
    width: 100%;
    height: 52px;
    border-radius: var(--radius-sm);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 0.65rem;
  }

  .theme-gradient-preview {
    position: absolute;
    inset: 0;
    opacity: 0.9;
  }

  .theme-swatch-center {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .theme-color-pill {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid rgba(0, 0, 0, 0.5);
  }

  .theme-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    width: 100%;
    padding: 0 0.15rem;
  }

  .theme-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: #ffffff !important;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .theme-colors-sub {
    font-size: 0.725rem;
    color: var(--text-secondary) !important;
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .theme-check-badge {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent-cyan);
    color: #07090e;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.5);
    transition: all var(--motion-fast) var(--ease-spring);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    z-index: 5;
  }

  .theme-card.active .theme-check-badge {
    opacity: 1;
    transform: scale(1);
  }

  .setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-subtle);
    gap: 2rem;
  }

  .setting-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .setting-row:first-of-type {
    padding-top: 0;
  }

  .setting-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .setting-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .setting-hint {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .form-select, .form-input {
    height: 42px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    padding: 0 1rem;
    font-size: 0.9375rem;
    outline: none;
    width: 100%;
  }

  .form-select:focus, .form-input:focus {
    border-color: var(--accent-cyan);
  }

  /* Switch Component */
  .switch {
    position: relative;
    display: inline-block;
    width: 48px;
    height: 26px;
  }

  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.1);
    transition: .3s;
    border-radius: 26px;
    border: 1px solid var(--border-subtle);
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: var(--text-secondary);
    transition: .3s;
    border-radius: 50%;
  }

  input:checked + .slider {
    background: var(--accent-cyan);
  }

  input:checked + .slider:before {
    transform: translateX(22px);
    background-color: #07090e;
  }

  .change-pass-form {
    display: flex;
    flex-direction: column;
  }

  .pass-btn-row {
    margin-top: 1.5rem;
    display: flex;
    justify-content: flex-end;
  }

  .save-status-box {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: rgba(16, 185, 129, 0.9);
    color: #ffffff;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    z-index: var(--z-toast);
    backdrop-filter: blur(10px);
  }
</style>
