---
// CourseRow.astro - Smooth horizontal carousel with drag momentum, edge fades and contextual arrows
import type { Course } from '../types/catalog';
import { getCourseSourceId } from '../lib/sources';
import CourseCard from './CourseCard.astro';

interface Props {
  title: string;
  courses: Course[];
  viewAllHref?: string;
  icon?: string;
  categoryId?: string;
  eagerCount?: number;
  limit?: number;
}

const { title, courses, viewAllHref, icon, categoryId, eagerCount = 0, limit = 16 } = Astro.props;
const displayCourses = limit > 0 ? courses.slice(0, limit) : courses;
const rowId = `row-${title.toLowerCase().replace(/[^\w]/g, '-')}`;
---

{courses.length > 0 && (
  <section class="course-row-section" data-row-id={rowId} data-category-id={categoryId}>
    <div class="row-header">
      <div class="title-group">
        <h2 class="row-title">{title}</h2>
        <span class="course-count">({courses.length})</span>
      </div>
      
      <div class="row-controls">
        {viewAllHref && (
          <a href={viewAllHref} class="view-all-link">
            <span>Ver todos</span>
            <svg class="view-all-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        )}
        <div class="nav-arrows">
          <button class="arrow-btn arrow-prev" data-target={rowId} aria-label="Rolar para esquerda" style="opacity: 0; pointer-events: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="arrow-btn arrow-next" data-target={rowId} aria-label="Rolar para direita">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="row-carousel-container">
      <div class="row-track" id={rowId}>
        {displayCourses.map((course, idx) => (
          <div class="card-item-wrapper" data-source={getCourseSourceId(course)}>
            <CourseCard 
              course={course} 
              loading={idx < eagerCount ? 'eager' : 'lazy'}
              fetchpriority={idx < eagerCount && idx < 2 ? 'high' : 'auto'}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  import { getActiveSource } from '../lib/sources';

  function initRows() {
    const currentSource = getActiveSource();

    document.querySelectorAll<HTMLElement>('.course-row-section').forEach(row => {
      const track = row.querySelector<HTMLElement>('.row-track');
      const prevBtn = row.querySelector<HTMLButtonElement>('.arrow-prev');
      const nextBtn = row.querySelector<HTMLButtonElement>('.arrow-next');
      const countEl = row.querySelector<HTMLElement>('.course-count');
      const cardWrappers = row.querySelectorAll<HTMLElement>('.card-item-wrapper');

      // Filter by active study source
      let visibleCount = 0;
      cardWrappers.forEach(card => {
        const itemSource = card.getAttribute('data-source') || 'outros';
        if (currentSource === 'all' || itemSource === currentSource) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = `(${visibleCount})`;

      if (visibleCount === 0) {
        row.style.display = 'none';
      } else {
        row.style.display = 'block';
      }

      if (!track) return;
      track.scrollLeft = 0;

      // Update arrow visibility
      const updateArrows = () => {
        const scrollLeft = track.scrollLeft;
        const maxScroll = track.scrollWidth - track.clientWidth - 5;

        if (prevBtn) {
          if (scrollLeft > 20) {
            prevBtn.style.opacity = '1';
            prevBtn.style.pointerEvents = 'auto';
          } else {
            prevBtn.style.opacity = '0';
            prevBtn.style.pointerEvents = 'none';
          }
        }

        if (nextBtn) {
          if (scrollLeft < maxScroll && maxScroll > 0) {
            nextBtn.style.opacity = '1';
            nextBtn.style.pointerEvents = 'auto';
          } else {
            nextBtn.style.opacity = '0';
            nextBtn.style.pointerEvents = 'none';
          }
        }
      };

      track.addEventListener('scroll', updateArrows, { passive: true });
      updateArrows();

      // Smooth button scroll
      if (prevBtn && !prevBtn.dataset.bound) {
        prevBtn.dataset.bound = 'true';
        prevBtn.addEventListener('click', () => {
          track.scrollBy({ left: -track.clientWidth * 0.75, behavior: 'smooth' });
        });
      }

      if (nextBtn && !nextBtn.dataset.bound) {
        nextBtn.dataset.bound = 'true';
        nextBtn.addEventListener('click', () => {
          track.scrollBy({ left: track.clientWidth * 0.75, behavior: 'smooth' });
        });
      }

      // Mouse Drag-to-Scroll
      let isDown = false;
      let startX = 0;
      let scrollLeftStart = 0;
      let hasMoved = false;

      if (!track.dataset.dragBound) {
        track.dataset.dragBound = 'true';

        track.addEventListener('mousedown', (e) => {
          if ((e.target as HTMLElement).closest('button, a')) return;
          isDown = true;
          hasMoved = false;
          track.classList.add('dragging');
          startX = e.pageX - track.offsetLeft;
          scrollLeftStart = track.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
          if (!isDown) return;
          isDown = false;
          track.classList.remove('dragging');
        });

        track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - track.offsetLeft;
          const walk = (x - startX) * 1.5;
          track.scrollLeft = scrollLeftStart - walk;
          if (Math.abs(walk) > 5) hasMoved = true;
        });

        track.addEventListener('click', (e) => {
          if (hasMoved) {
            e.preventDefault();
            e.stopPropagation();
          }
        }, true);
      }
    });
  }

  // Listen to source switch events
  window.addEventListener('mindflix:source-changed', () => {
    initRows();
  });

  document.addEventListener('astro:page-load', initRows);
  initRows();
</script>

<style>
  .course-row-section {
    margin-bottom: 2.75rem;
    position: relative;
  }

  .row-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
    padding: 0 0.5rem;
  }

  .title-group {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .row-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .course-count {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .row-controls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .view-all-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    transition: all var(--motion-fast) var(--ease-out);
  }

  .view-all-arrow {
    transition: transform var(--motion-fast) var(--ease-spring);
  }

  .view-all-link:hover .view-all-arrow {
    transform: translateX(4px);
  }

  .view-all-link:hover {
    color: #38bdf8;
  }

  .nav-arrows {
    display: flex;
    gap: 0.4rem;
  }

  .arrow-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--motion-fast) var(--ease-out);
  }

  .arrow-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
    border-color: var(--border-highlight);
    transform: scale(1.08);
  }

  .row-carousel-container {
    position: relative;
    margin: 0 -0.5rem;
    padding: 0.5rem;
    perspective: 1200px;
  }

  .row-track {
    display: flex;
    gap: 1.35rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 0.75rem 0.5rem 1.25rem 0.5rem;
    margin-top: -0.5rem;
    scrollbar-width: none; /* Hide default scrollbar for cleaner look */
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .row-track::-webkit-scrollbar {
    display: none;
  }

  .row-track.dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    user-select: none;
  }

  .card-item-wrapper {
    flex: 0 0 280px;
    min-width: 280px;
    perspective: 1000px;
  }

  @media (max-width: 768px) {
    .card-item-wrapper {
      flex: 0 0 245px;
      min-width: 245px;
    }
    .row-title {
      font-size: 1.15rem;
    }
  }
</style>
