---
// CourseRow.astro - Smooth horizontal streaming carousel with uniform 16:9 cards, edge fades & "Ver todos"
import type { Course } from '../types/catalog';
import { getCourseSourceId } from '../lib/sources';
import CourseCard from './CourseCard.astro';

interface Props {
  title: string;
  courses: Course[];
  viewAllHref?: string;
  icon?: string;
  categoryId?: string;
  eagerCount?: number;
  limit?: number;
}

const { title, courses, viewAllHref, icon, categoryId, eagerCount = 0, limit = 16 } = Astro.props;
const displayCourses = limit > 0 ? courses.slice(0, limit) : courses;
const rowId = `row-${title.toLowerCase().replace(/[^\w]/g, '-')}`;
---

{courses.length > 0 && (
  <section class="course-row-section" data-row-id={rowId} data-category-id={categoryId}>
    <div class="row-header">
      <div class="title-group">
        <h2 class="row-title">{title}</h2>
        <span class="course-count-badge">{courses.length}</span>
      </div>
      
      <div class="row-controls">
        {viewAllHref && (
          <a href={viewAllHref} class="view-all-pill" aria-label={`Ver todos os cursos de ${title}`}>
            <span>Ver todos</span>
            <svg class="view-all-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        )}
        <div class="nav-arrows">
          <button class="arrow-btn arrow-prev" data-target={rowId} aria-label="Rolar para esquerda" style="opacity: 0; pointer-events: none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="arrow-btn arrow-next" data-target={rowId} aria-label="Rolar para direita">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="row-carousel-container">
      <div class="row-track" id={rowId}>
        {displayCourses.map((course, idx) => (
          <div class="card-item-wrapper" data-source={getCourseSourceId(course)}>
            <CourseCard 
              course={course} 
              loading={idx < eagerCount ? 'eager' : 'lazy'}
              fetchpriority={idx < eagerCount && idx < 2 ? 'high' : 'auto'}
            />
          </div>
        ))}

        {viewAllHref && (
          <div class="card-item-wrapper card-see-all-wrapper">
            <a href={viewAllHref} class="card-see-all" aria-label={`Explorar catálogo de ${title}`}>
              <div class="see-all-frame">
                <div class="see-all-circle">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </div>
                <span class="see-all-title">Ver todos</span>
                <span class="see-all-subtitle">+{courses.length} cursos</span>
              </div>
              <div class="see-all-caption">
                <span class="see-all-caption-text">Explorar categoria completa</span>
              </div>
            </a>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<script>
  import { getActiveSource } from '../lib/sources';

  function initRows() {
    const currentSource = getActiveSource();

    document.querySelectorAll<HTMLElement>('.course-row-section').forEach(row => {
      const track = row.querySelector<HTMLElement>('.row-track');
      const prevBtn = row.querySelector<HTMLButtonElement>('.arrow-prev');
      const nextBtn = row.querySelector<HTMLButtonElement>('.arrow-next');
      const countEl = row.querySelector<HTMLElement>('.course-count-badge');
      const cardWrappers = row.querySelectorAll<HTMLElement>('.card-item-wrapper:not(.card-see-all-wrapper)');

      // Filter by active study source
      let visibleCount = 0;
      cardWrappers.forEach(card => {
        const itemSource = card.getAttribute('data-source') || 'outros';
        if (currentSource === 'all' || itemSource === currentSource) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = String(visibleCount);

      if (visibleCount === 0) {
        row.style.display = 'none';
      } else {
        row.style.display = 'block';
      }

      if (!track) return;
      track.scrollLeft = 0;

      // Update arrow visibility
      const updateArrows = () => {
        const scrollLeft = track.scrollLeft;
        const maxScroll = track.scrollWidth - track.clientWidth - 5;

        if (prevBtn) {
          if (scrollLeft > 20) {
            prevBtn.style.opacity = '1';
            prevBtn.style.pointerEvents = 'auto';
          } else {
            prevBtn.style.opacity = '0';
            prevBtn.style.pointerEvents = 'none';
          }
        }

        if (nextBtn) {
          if (scrollLeft < maxScroll && maxScroll > 0) {
            nextBtn.style.opacity = '1';
            nextBtn.style.pointerEvents = 'auto';
          } else {
            nextBtn.style.opacity = '0';
            nextBtn.style.pointerEvents = 'none';
          }
        }
      };

      track.addEventListener('scroll', updateArrows, { passive: true });
      updateArrows();

      // Smooth button scroll (by ~80% of track width)
      if (prevBtn && !prevBtn.dataset.bound) {
        prevBtn.dataset.bound = 'true';
        prevBtn.addEventListener('click', () => {
          track.scrollBy({ left: -track.clientWidth * 0.75, behavior: 'smooth' });
        });
      }

      if (nextBtn && !nextBtn.dataset.bound) {
        nextBtn.dataset.bound = 'true';
        nextBtn.addEventListener('click', () => {
          track.scrollBy({ left: track.clientWidth * 0.75, behavior: 'smooth' });
        });
      }

      // Mouse Drag-to-Scroll
      let isDown = false;
      let startX = 0;
      let scrollLeftStart = 0;
      let hasMoved = false;

      if (!track.dataset.dragBound) {
        track.dataset.dragBound = 'true';

        track.addEventListener('mousedown', (e) => {
          if ((e.target as HTMLElement).closest('button, a')) return;
          isDown = true;
          hasMoved = false;
          track.classList.add('dragging');
          startX = e.pageX - track.offsetLeft;
          scrollLeftStart = track.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
          if (!isDown) return;
          isDown = false;
          track.classList.remove('dragging');
        });

        track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - track.offsetLeft;
          const walk = (x - startX) * 1.5;
          track.scrollLeft = scrollLeftStart - walk;
          if (Math.abs(walk) > 5) hasMoved = true;
        });

        track.addEventListener('click', (e) => {
          if (hasMoved) {
            e.preventDefault();
            e.stopPropagation();
          }
        }, true);
      }
    });
  }

  // Listen to source switch events
  window.addEventListener('mindflix:source-changed', initRows);
  document.addEventListener('astro:page-load', initRows);
  initRows();
</script>

<style>
  .course-row-section {
    margin-bottom: 2.25rem;
    position: relative;
  }

  .row-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    padding: 0 0.25rem;
  }

  .title-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .row-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .course-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--text-muted, #94a3b8);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-pill, 9999px);
    padding: 0.15rem 0.55rem;
  }

  .row-controls {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .view-all-pill {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--accent-cyan, #00f2fe);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.22);
    border-radius: var(--radius-pill, 9999px);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .view-all-arrow {
    transition: transform 0.2s ease;
  }

  .view-all-pill:hover {
    background: rgba(0, 242, 254, 0.16);
    border-color: rgba(0, 242, 254, 0.45);
    color: #ffffff;
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.25);
  }

  .view-all-pill:hover .view-all-arrow {
    transform: translateX(3px);
  }

  .nav-arrows {
    display: flex;
    gap: 0.35rem;
  }

  .arrow-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-secondary, #cbd5e1);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .arrow-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
    transform: scale(1.06);
  }

  .row-carousel-container {
    position: relative;
    margin: 0 -0.5rem;
    padding: 0 0.5rem;
  }

  .row-track {
    display: flex;
    gap: 1.15rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 0.5rem 0.25rem 0.75rem 0.25rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .row-track::-webkit-scrollbar {
    display: none;
  }

  .row-track.dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    user-select: none;
  }

  .card-item-wrapper {
    flex: 0 0 245px;
    min-width: 245px;
  }

  /* "Ver todos" End Card */
  .card-see-all-wrapper {
    flex: 0 0 200px;
    min-width: 200px;
  }

  .card-see-all {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    height: 100%;
    outline: none;
  }

  .see-all-frame {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md, 10px);
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed rgba(255, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    transition: all 0.25s ease;
  }

  .see-all-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(0, 242, 254, 0.1);
    color: var(--accent-cyan, #00f2fe);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .see-all-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffffff;
  }

  .see-all-subtitle {
    font-size: 0.7rem;
    color: var(--text-muted, #94a3b8);
  }

  .see-all-caption {
    margin-top: 0.65rem;
    padding: 0 0.15rem;
  }

  .see-all-caption-text {
    font-size: 0.775rem;
    color: var(--accent-cyan, #00f2fe);
    font-weight: 600;
    display: block;
    height: 2.5rem;
  }

  .card-see-all:hover .see-all-frame {
    background: rgba(0, 242, 254, 0.06);
    border-color: rgba(0, 242, 254, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4);
  }

  .card-see-all:hover .see-all-circle {
    background: var(--accent-cyan, #00f2fe);
    color: #0b0d13;
    transform: scale(1.1);
  }

  @media (max-width: 768px) {
    .card-item-wrapper {
      flex: 0 0 200px;
      min-width: 200px;
    }
    .card-see-all-wrapper {
      flex: 0 0 160px;
      min-width: 160px;
    }
    .row-title {
      font-size: 1.1rem;
    }
    .row-header {
      margin-bottom: 0.65rem;
    }
  }
</style>
