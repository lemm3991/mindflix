---
// CourseDetailModal.astro - Glassmorphism Course Detail Modal with Blurred Backdrop & Curriculum Grade
import { getAllCourses } from '../lib/catalog';

const courses = getAllCourses();
---

<!-- Course Catalog Data Payload for Client Script -->
<script type="application/json" id="mindflix-courses-json" set:html={JSON.stringify(courses)}></script>

<!-- Global Course Detail Glassmorphism Modal -->
<div id="course-detail-modal-backdrop" class="course-modal-backdrop" style="display: none;" aria-hidden="true">
  <div class="course-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-course-title">
    
    <!-- Top Close Button (Desktop & Mobile) -->
    <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Fechar modal">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Scrollable Modal Content -->
    <div class="modal-scroll-body" id="modal-scroll-body">
      
      <!-- Hero Header Section -->
      <div class="modal-hero" id="modal-hero">
        <div class="modal-hero-cover-wrap" id="modal-hero-cover-wrap">
          <img id="modal-cover-img" class="modal-cover-img" src="" alt="" style="display: none;" />
          <div class="modal-cover-gradient" id="modal-cover-gradient"></div>
          <div class="modal-cover-overlay"></div>
        </div>

        <div class="modal-hero-content">
          <div class="modal-badges-row">
            <span class="provider-pill" id="modal-provider">Provider</span>
            <span class="badge badge-cyan" id="modal-modules-count">0 Módulos</span>
            <span class="badge" id="modal-lessons-count">0 Aulas</span>
            <button type="button" class="modal-fav-btn" id="modal-fav-btn" aria-label="Favoritar">
              <svg class="heart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
          </div>

          <h2 class="modal-course-title" id="modal-course-title">Título do Curso</h2>
          
          <p class="modal-course-desc" id="modal-course-desc">Descrição completa do curso...</p>

          <div class="modal-tags-row" id="modal-tags-row"></div>

          <!-- Progress Bar Section -->
          <div class="modal-progress-card" id="modal-progress-card" style="display: none;">
            <div class="modal-progress-info">
              <span class="progress-label">Seu Progresso:</span>
              <strong class="progress-pct" id="modal-progress-pct">0% concluído</strong>
            </div>
            <div class="modal-progress-track">
              <div class="modal-progress-fill" id="modal-progress-fill" style="width: 0%;"></div>
            </div>
          </div>

          <!-- CTA Watch Row -->
          <div class="modal-cta-row">
            <a href="#" class="btn btn-primary modal-play-btn" id="modal-play-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span id="modal-play-btn-text">Assistir Agora</span>
            </a>
            <span class="modal-next-lesson-hint" id="modal-next-lesson-hint"></span>
          </div>
        </div>
      </div>

      <!-- Curriculum / Grade de Aulas Section -->
      <div class="modal-curriculum-section">
        <div class="curriculum-header">
          <div class="curriculum-title-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
            <h3>Grade Completa de Aulas</h3>
          </div>
          <span class="curriculum-meta" id="modal-curriculum-meta">Aulas estruturadas passo a passo</span>
        </div>

        <!-- Modules List Accordion Container -->
        <div class="modal-modules-accordion" id="modal-modules-list"></div>
      </div>

    </div>
  </div>
</div>

<style>
  /* --- Backdrop with background blur --- */
  .course-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(4, 6, 11, 0.78);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .course-modal-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* --- Glassmorphism Dialog --- */
  .course-modal-dialog {
    position: relative;
    width: 100%;
    max-width: 880px;
    max-height: 88vh;
    background: rgba(15, 20, 30, 0.88);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xl);
    box-shadow: 0 32px 64px -12px rgba(0, 0, 0, 0.85),
                0 0 40px rgba(0, 242, 254, 0.12),
                inset 0 1px 1px rgba(255, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.95) translateY(10px);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .course-modal-backdrop.active .course-modal-dialog {
    transform: scale(1) translateY(0);
  }

  /* --- Close Button --- */
  .modal-close-btn {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 20;
    backdrop-filter: blur(8px);
    transition: all var(--motion-fast) var(--ease-out);
  }

  .modal-close-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    transform: scale(1.08);
  }

  /* --- Scrollable Body --- */
  .modal-scroll-body {
    overflow-y: auto;
    overflow-x: hidden;
    max-height: 88vh;
    padding-bottom: 2.5rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .modal-scroll-body::-webkit-scrollbar {
    width: 6px;
  }

  .modal-scroll-body::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }

  /* --- Hero Header Section --- */
  .modal-hero {
    position: relative;
    padding: 2.25rem 2.25rem 1.75rem 2.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .modal-hero-cover-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .modal-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
    filter: blur(4px);
    transform: scale(1.05);
  }

  .modal-cover-gradient {
    position: absolute;
    inset: 0;
    opacity: 0.45;
  }

  .modal-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13, 17, 26, 0.4) 0%, rgba(13, 17, 26, 0.96) 100%);
  }

  .modal-hero-content {
    position: relative;
    z-index: 2;
  }

  .modal-badges-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .modal-fav-btn {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-muted);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-left: auto;
    transition: all var(--motion-fast) var(--ease-spring);
  }

  .modal-fav-btn:hover {
    color: var(--text-primary);
    transform: scale(1.12);
  }

  .modal-fav-btn.active {
    color: var(--accent-rose);
    border-color: rgba(244, 63, 94, 0.4);
    background: rgba(244, 63, 94, 0.15);
  }

  .modal-course-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
    margin-bottom: 0.75rem;
    letter-spacing: -0.015em;
  }

  .modal-course-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 720px;
  }

  .modal-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }

  :global(.modal-tag-pill) {
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  /* Progress Card */
  .modal-progress-card {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.15rem;
    margin-bottom: 1.5rem;
    max-width: 480px;
  }

  .modal-progress-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8125rem;
    margin-bottom: 0.5rem;
  }

  .progress-label {
    color: var(--text-secondary);
  }

  .progress-pct {
    color: var(--accent-cyan);
    font-weight: 700;
  }

  .modal-progress-track {
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .modal-progress-fill {
    height: 100%;
    background: var(--grad-primary);
    border-radius: var(--radius-full);
    transition: width 0.4s ease;
  }

  /* CTA Row */
  .modal-cta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .modal-play-btn {
    padding: 0.75rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: 700;
    gap: 0.6rem;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 20px rgba(0, 242, 254, 0.3);
  }

  .modal-next-lesson-hint {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* --- Curriculum Section --- */
  .modal-curriculum-section {
    padding: 1.75rem 2.25rem 0 2.25rem;
  }

  .curriculum-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .curriculum-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent-cyan);
  }

  .curriculum-title-wrap h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .curriculum-meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* --- Modules Accordion --- */
  .modal-modules-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.modal-module-card) {
    background: rgba(18, 24, 38, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--motion-fast);
  }

  :global(.modal-module-card.open) {
    border-color: rgba(0, 242, 254, 0.25);
    background: rgba(22, 29, 46, 0.75);
  }

  :global(.modal-module-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    cursor: pointer;
    user-select: none;
    gap: 0.75rem;
  }

  :global(.modal-module-header:hover) {
    background: rgba(255, 255, 255, 0.03);
  }

  :global(.modal-module-title-group) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  :global(.modal-module-num) {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: rgba(0, 242, 254, 0.1);
    color: var(--accent-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.modal-module-title) {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  :global(.modal-module-right) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  :global(.modal-module-count) {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  :global(.modal-module-arrow) {
    color: var(--text-muted);
    transition: transform var(--motion-normal) var(--ease-spring);
  }

  :global(.modal-module-card.open .modal-module-arrow) {
    transform: rotate(180deg);
    color: var(--accent-cyan);
  }

  :global(.modal-lessons-list) {
    display: none;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.5rem 0.75rem;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global(.modal-module-card.open .modal-lessons-list) {
    display: flex;
  }

  :global(.modal-lesson-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: all var(--motion-fast);
  }

  :global(.modal-lesson-item:hover) {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
    transform: translateX(4px);
  }

  :global(.modal-lesson-item.completed) {
    color: var(--text-muted);
  }

  :global(.modal-lesson-left) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: 1;
    min-width: 0;
  }

  :global(.modal-lesson-icon) {
    color: var(--accent-cyan);
    flex-shrink: 0;
  }

  :global(.modal-lesson-item.completed .modal-lesson-icon) {
    color: var(--accent-emerald);
  }

  :global(.modal-lesson-title) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.modal-lesson-right) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  :global(.modal-lesson-duration) {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  :global(.modal-lesson-play-icon) {
    opacity: 0;
    color: var(--accent-cyan);
    transition: opacity var(--motion-fast);
  }

  :global(.modal-lesson-item:hover .modal-lesson-play-icon) {
    opacity: 1;
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .course-modal-backdrop {
      padding: 0.75rem;
    }
    .course-modal-dialog {
      max-height: 92vh;
      border-radius: var(--radius-lg);
    }
    .modal-hero {
      padding: 1.5rem 1.25rem 1.25rem 1.25rem;
    }
    .modal-course-title {
      font-size: 1.35rem;
    }
    .modal-curriculum-section {
      padding: 1.25rem 1.25rem 0 1.25rem;
    }
  }
</style>

<script>
  import { getCourseCompletionStats, getNextLessonToWatch, isCourseFavorite, toggleFavorite } from '../lib/progress';
  import { showToast } from '../lib/toast';

  function getLoadedCourses(): any[] {
    try {
      const payload = document.getElementById('mindflix-courses-json');
      if (payload && payload.textContent) {
        return JSON.parse(payload.textContent);
      }
    } catch {}
    return [];
  }

  let allCourses = getLoadedCourses();
  const backdrop = document.getElementById('course-detail-modal-backdrop');
  const closeBtn = document.getElementById('modal-close-btn');
  const favBtn = document.getElementById('modal-fav-btn');
  const playBtn = document.getElementById('modal-play-btn') as HTMLAnchorElement;
  const playBtnText = document.getElementById('modal-play-btn-text');
  const nextLessonHint = document.getElementById('modal-next-lesson-hint');

  const titleEl = document.getElementById('modal-course-title');
  const descEl = document.getElementById('modal-course-desc');
  const providerEl = document.getElementById('modal-provider');
  const modulesCountEl = document.getElementById('modal-modules-count');
  const lessonsCountEl = document.getElementById('modal-lessons-count');
  const tagsRow = document.getElementById('modal-tags-row');
  const coverImg = document.getElementById('modal-cover-img') as HTMLImageElement;
  const coverGrad = document.getElementById('modal-cover-gradient');
  const modulesList = document.getElementById('modal-modules-list');

  const progressCard = document.getElementById('modal-progress-card');
  const progressPct = document.getElementById('modal-progress-pct');
  const progressFill = document.getElementById('modal-progress-fill');

  let activeCourseId: string | null = null;

  // Hues for deterministic gradient
  const hues = [
    'linear-gradient(135deg, #0f2027, #203a43, #2c5364)',
    'linear-gradient(135deg, #1f1c2c, #4a475a)',
    'linear-gradient(135deg, #141e30, #243b55)',
    'linear-gradient(135deg, #0f0c29, #302b63, #24243e)',
    'linear-gradient(135deg, #16222f, #1a365d)',
    'linear-gradient(135deg, #1a1c29, #2d3748)',
    'linear-gradient(135deg, #1e1b4b, #312e81)',
    'linear-gradient(135deg, #064e3b, #047857)',
    'linear-gradient(135deg, #4a0e2e, #831843)'
  ];

  function openModal(courseId: string) {
    if (!allCourses || allCourses.length === 0) {
      allCourses = getLoadedCourses();
    }
    const course = allCourses.find(c => c.id === courseId || c.slug === courseId);
    if (!course || !backdrop) return;

    activeCourseId = course.id;

    // 1. Populate basic info
    if (titleEl) titleEl.textContent = course.display_title;
    if (descEl) descEl.textContent = course.description;
    if (providerEl) providerEl.textContent = course.provider;
    if (modulesCountEl) modulesCountEl.textContent = `${course.modules_count} ${course.modules_count === 1 ? 'Módulo' : 'Módulos'}`;
    if (lessonsCountEl) lessonsCountEl.textContent = `${course.lessons_count} ${course.lessons_count === 1 ? 'Aula' : 'Aulas'}`;

    // 2. Cover / Gradient
    if (course.cover_image && coverImg) {
      coverImg.src = course.cover_image;
      coverImg.style.display = 'block';
      if (coverGrad) coverGrad.style.display = 'none';
    } else {
      if (coverImg) coverImg.style.display = 'none';
      if (coverGrad) {
        let hash = 0;
        for (let i = 0; i < course.id.length; i++) hash = course.id.charCodeAt(i) + ((hash << 5) - hash);
        const gradient = hues[Math.abs(hash) % hues.length];
        coverGrad.style.background = gradient;
        coverGrad.style.display = 'block';
      }
    }

    // 3. Tags
    if (tagsRow) {
      tagsRow.innerHTML = '';
      course.tags.forEach(t => {
        const span = document.createElement('span');
        span.className = 'modal-tag-pill';
        span.textContent = `#${t}`;
        tagsRow.appendChild(span);
      });
    }

    // 4. Progress Stats & Smart Resume Calculation
    const stats = getCourseCompletionStats(course.id, course.lessons_count);
    if (stats.percentage > 0) {
      if (progressCard) progressCard.style.display = 'block';
      if (progressPct) progressPct.textContent = `${stats.percentage}% concluído (${stats.completedCount}/${course.lessons_count} aulas)`;
      if (progressFill) progressFill.style.width = `${stats.percentage}%`;
    } else {
      if (progressCard) progressCard.style.display = 'none';
    }

    // Smart Next/Resume Lesson
    const nextWatch = getNextLessonToWatch(course);
    if (playBtn) {
      playBtn.href = nextWatch.watchUrl;
    }
    if (playBtnText) {
      playBtnText.textContent = nextWatch.label;
    }
    if (nextLessonHint) {
      if (nextWatch.isResume && nextWatch.lesson) {
        nextLessonHint.textContent = `Próximo: ${nextWatch.lesson.display_title}`;
      } else {
        nextLessonHint.textContent = '';
      }
    }

    // 5. Favorite button state
    if (favBtn) {
      const isFav = isCourseFavorite(course.id);
      if (isFav) {
        favBtn.classList.add('active');
        favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
      } else {
        favBtn.classList.remove('active');
        favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'none');
      }
    }

    // 6. Populate Curriculum Modules & Lessons
    if (modulesList) {
      modulesList.innerHTML = '';
      const allLocalProg = JSON.parse(localStorage.getItem('mindflix_progress') || '{}');

      course.modules.forEach((mod, modIdx) => {
        const modCard = document.createElement('div');
        modCard.className = `modal-module-card ${modIdx === 0 ? 'open' : ''}`;

        const completedLessonsInMod = mod.lessons.filter(l => allLocalProg[l.id]?.completed).length;

        modCard.innerHTML = `
          <div class="modal-module-header">
            <div class="modal-module-title-group">
              <span class="modal-module-num">${modIdx + 1}</span>
              <h4 class="modal-module-title">${mod.display_title}</h4>
            </div>
            <div class="modal-module-right">
              <span class="modal-module-count">${completedLessonsInMod > 0 ? `${completedLessonsInMod}/` : ''}${mod.lessons.length} aulas</span>
              <svg class="modal-module-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>
          <div class="modal-lessons-list">
            ${mod.lessons.map(lesson => {
              const isCompleted = Boolean(allLocalProg[lesson.id]?.completed);
              const lessonUrl = `/watch/${course.id}/${lesson.id}`;
              return `
                <a href="${lessonUrl}" class="modal-lesson-item ${isCompleted ? 'completed' : ''}">
                  <div class="modal-lesson-left">
                    <svg class="modal-lesson-icon" width="16" height="16" viewBox="0 0 24 24" fill="${isCompleted ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2">
                      ${isCompleted 
                        ? '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>'
                        : '<polygon points="5 3 19 12 5 21 5 3"></polygon>'
                      }
                    </svg>
                    <span class="modal-lesson-title">${lesson.display_title}</span>
                  </div>
                  <div class="modal-lesson-right">
                    ${lesson.duration_formatted ? `<span class="modal-lesson-duration">${lesson.duration_formatted}</span>` : ''}
                    <svg class="modal-lesson-play-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </div>
                </a>
              `;
            }).join('')}
          </div>
        `;

        // Toggle module accordion
        const header = modCard.querySelector('.modal-module-header');
        header?.addEventListener('click', () => {
          modCard.classList.toggle('open');
        });

        modulesList.appendChild(modCard);
      });
    }

    // 7. Open modal and lock scroll
    backdrop.style.display = 'flex';
    requestAnimationFrame(() => {
      backdrop.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
  }

  function closeModal() {
    if (!backdrop) return;
    backdrop.classList.remove('active');
    setTimeout(() => {
      backdrop.style.display = 'none';
      document.body.style.overflow = '';
      activeCourseId = null;
    }, 250);
  }

  // Global listener and function
  (window as any).openCourseModal = openModal;
  (window as any).closeCourseModal = closeModal;

  document.addEventListener('open-course-modal', (e: any) => {
    if (e.detail?.courseId) openModal(e.detail.courseId);
  });

  // Event handlers for closing
  closeBtn?.addEventListener('click', closeModal);

  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && backdrop?.classList.contains('active')) {
      closeModal();
    }
  });

  // Favorite button handler
  favBtn?.addEventListener('click', async (e) => {
    e.preventDefault();
    if (!activeCourseId) return;
    const isFav = await toggleFavorite(activeCourseId);
    if (isFav) {
      favBtn.classList.add('active');
      favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
      showToast('Curso adicionado à Minha Lista', 'success');
    } else {
      favBtn.classList.remove('active');
      favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'none');
      showToast('Curso removido da Minha Lista', 'info');
    }

    // Also update any favorite button on the page for this course
    const pageCardFav = document.querySelector(`[data-fav-id="${activeCourseId}"]`);
    if (pageCardFav) {
      if (isFav) {
        pageCardFav.classList.add('active');
        pageCardFav.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
      } else {
        pageCardFav.classList.remove('active');
        pageCardFav.querySelector('.heart-icon')?.setAttribute('fill', 'none');
      }
    }
  });
</script>
