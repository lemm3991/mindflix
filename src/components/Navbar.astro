---
// Navbar.astro - Premium progressive glass navbar with Command Palette trigger & Study Sources Switcher
import { STUDY_SOURCES } from '../lib/sources';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Cursos', href: '/courses' },
  { label: 'Minha Lista', href: '/my-list' },
  { label: 'Minhas Anotações', href: '/anotacoes' },
  { label: 'Biblioteca', href: '/library', adminOnly: true },
  { label: 'Segurança & IPS', href: '/security-monitor', adminOnly: true },
];
---

<header class="navbar" id="main-navbar" transition:persist="main-navbar">
  <div class="container nav-content">
    <div class="nav-left">
      <a href="/" class="brand-logo" aria-label="Mindflix Home">
        <span class="logo-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </span>
        <span class="logo-text">MIND<span>FLIX</span></span>
      </a>

      <nav class="nav-links" aria-label="Menu Principal">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`nav-link ${currentPath === item.href ? 'active' : ''} ${item.adminOnly ? 'admin-only-link' : ''}`}
            data-admin-only={item.adminOnly ? 'true' : 'false'}
            style={item.adminOnly ? 'display: none;' : ''}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Center: Collapsed Study Source Selector -->
    <div class="source-switcher-wrapper">
      <div class="source-dropdown-group" id="header-source-dropdown-group">
        <button
          type="button"
          class="single-source-btn"
          id="single-source-btn"
          role="button"
          aria-haspopup="true"
          aria-expanded="false"
          title="Clique para selecionar a Fonte de Estudo"
        >
          <span class="source-pill-dot dot-all" id="single-source-dot"></span>
          <span class="source-pill-label" id="single-source-label">Todas</span>
          <svg class="source-dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Collapsed Dropdown Menu -->
        <div class="source-dropdown-menu single-source-menu" id="header-source-dropdown-menu" role="menu">
          <button type="button" class="dropdown-item active" data-subsource="all" role="menuitem">
            <div class="dropdown-item-left">
              <span class="dropdown-dot dot-all"></span>
              <div class="dropdown-texts">
                <span class="dropdown-item-title">Todas</span>
                <span class="dropdown-item-desc">Todas as fontes de estudo</span>
              </div>
            </div>
            <svg class="dropdown-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>

          <button type="button" class="dropdown-item" data-subsource="ailab" role="menuitem">
            <div class="dropdown-item-left">
              <span class="dropdown-dot" style="background-color: #00f2fe; box-shadow: 0 0 8px #00f2fe80;"></span>
              <div class="dropdown-texts">
                <span class="dropdown-item-title">AI LAB</span>
                <span class="dropdown-item-desc">Inteligência Artificial & Agentes</span>
              </div>
            </div>
            <svg class="dropdown-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>

          <button type="button" class="dropdown-item" data-subsource="asimov" role="menuitem">
            <div class="dropdown-item-left">
              <span class="dropdown-dot" style="background-color: #6366f1; box-shadow: 0 0 8px #6366f180;"></span>
              <div class="dropdown-texts">
                <span class="dropdown-item-title">Asimov</span>
                <span class="dropdown-item-desc">Cursos, Projetos & Trilhas</span>
              </div>
            </div>
            <svg class="dropdown-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>

          <button type="button" class="dropdown-item sub-dropdown-item" data-subsource="asimov-skills" role="menuitem">
            <div class="dropdown-item-left">
              <span class="dropdown-dot" style="background-color: #818cf8; box-shadow: 0 0 8px #818cf880;"></span>
              <div class="dropdown-texts">
                <span class="dropdown-item-title">Asimov Skills</span>
                <span class="dropdown-item-desc">Soft Skills & Produtividade</span>
              </div>
            </div>
            <svg class="dropdown-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>

          <button type="button" class="dropdown-item" data-subsource="hashtag" role="menuitem">
            <div class="dropdown-item-left">
              <span class="dropdown-dot" style="background-color: #ec4899; box-shadow: 0 0 8px #ec489980;"></span>
              <div class="dropdown-texts">
                <span class="dropdown-item-title">Hashtag</span>
                <span class="dropdown-item-desc">Impressionador: IA, Claude, Lovable</span>
              </div>
            </div>
            <svg class="dropdown-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>

          <button type="button" class="dropdown-item sub-dropdown-item" data-subsource="hashtag-soft-skills" role="menuitem">
            <div class="dropdown-item-left">
              <span class="dropdown-dot" style="background-color: #f43f5e; box-shadow: 0 0 8px #f43f5e80;"></span>
              <div class="dropdown-texts">
                <span class="dropdown-item-title">Hashtag Soft Skills</span>
                <span class="dropdown-item-desc">Liderança & Alta Performance</span>
              </div>
            </div>
            <svg class="dropdown-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>

          <button type="button" class="dropdown-item" data-subsource="sctec" role="menuitem">
            <div class="dropdown-item-left">
              <span class="dropdown-dot" style="background-color: #10b981; box-shadow: 0 0 8px #10b98180;"></span>
              <div class="dropdown-texts">
                <span class="dropdown-item-title">SCTEC</span>
                <span class="dropdown-item-desc">Carreira Tech & Formações</span>
              </div>
            </div>
            <svg class="dropdown-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>

          <button type="button" class="dropdown-item" data-subsource="outros" role="menuitem">
            <div class="dropdown-item-left">
              <span class="dropdown-dot" style="background-color: #f59e0b; box-shadow: 0 0 8px #f59e0b80;"></span>
              <div class="dropdown-texts">
                <span class="dropdown-item-title">Diversos</span>
                <span class="dropdown-item-desc">Cursos complementares</span>
              </div>
            </div>
            <svg class="dropdown-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="nav-right">
      <!-- Command Palette Trigger Button -->
      <button type="button" class="cmd-trigger-btn" id="open-search-modal-btn" aria-label="Abrir busca (Ctrl+K)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="cmd-trigger-text">Buscar cursos...</span>
        <div class="cmd-badges">
          <kbd class="cmd-kbd">Ctrl</kbd>
          <kbd class="cmd-kbd">K</kbd>
        </div>
      </button>

      <!-- Profile Avatar Button -->
      <div class="user-menu-container" id="user-menu-container">
        <button
          type="button"
          class="user-avatar-btn"
          id="user-avatar-btn"
          aria-label="Menu do Usuário"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <div class="avatar-circle">
            <span id="user-initials">TA</span>
          </div>
        </button>

        <!-- User Dropdown Menu -->
        <div class="user-dropdown-menu" id="user-dropdown-menu" role="menu">
          <div class="user-dropdown-header">
            <span class="dropdown-user-name" id="dropdown-user-name">Minha Conta</span>
            <span class="dropdown-user-email" id="dropdown-user-email">usuario@mindflix</span>
          </div>
          <div class="dropdown-divider"></div>
          <a href="/profile" class="user-dropdown-item" role="menuitem">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>Meu Perfil</span>
          </a>
          <a href="/settings" class="user-dropdown-item" role="menuitem">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span>Preferências</span>
          </a>
          <div class="dropdown-divider"></div>
          <a href="/api/auth/logout" class="user-dropdown-item dropdown-logout-btn" id="header-logout-btn" role="menuitem">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Sair da Conta</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Mobile Hamburger Toggle Button (Mobile only) -->
    <button
      type="button"
      class="mobile-menu-toggle"
      id="mobile-menu-toggle-btn"
      aria-label="Abrir Menu de Navegação"
      aria-expanded="false"
    >
      <svg class="icon-hamburger" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Overlay & Content -->
  <div class="mobile-drawer-overlay" id="mobile-drawer-overlay"></div>
  <aside class="mobile-drawer" id="mobile-drawer" aria-label="Menu Mobile">
    <div class="drawer-header">
      <a href="/profile" class="drawer-user-info">
        <div class="avatar-circle">
          <span id="mobile-user-initials">ED</span>
        </div>
        <div class="drawer-user-meta">
          <span class="drawer-user-name" id="mobile-user-name">Minha Conta</span>
          <span class="drawer-user-sub">Ver Perfil →</span>
        </div>
      </a>
      <button type="button" class="drawer-close-btn" id="mobile-drawer-close-btn" aria-label="Fechar Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="drawer-body">
      <!-- Search Action -->
      <button type="button" class="drawer-search-btn" id="mobile-drawer-search-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Buscar cursos...</span>
      </button>

      <!-- Source Switcher Section -->
      <div class="drawer-section">
        <span class="drawer-section-title">Fonte de Estudo</span>
        <div class="drawer-source-grid">
          <button type="button" class="drawer-source-item active" data-subsource="all">
            <span class="dropdown-dot dot-all"></span>
            <span>Todas</span>
          </button>
          <button type="button" class="drawer-source-item" data-subsource="ailab">
            <span class="dropdown-dot" style="background-color: #00f2fe;"></span>
            <span>AI LAB</span>
          </button>
          <button type="button" class="drawer-source-item" data-subsource="asimov">
            <span class="dropdown-dot" style="background-color: #6366f1;"></span>
            <span>Asimov</span>
          </button>
          <button type="button" class="drawer-source-item" data-subsource="asimov-skills">
            <span class="dropdown-dot" style="background-color: #818cf8;"></span>
            <span>Asimov Skills</span>
          </button>
          <button type="button" class="drawer-source-item" data-subsource="hashtag">
            <span class="dropdown-dot" style="background-color: #ec4899;"></span>
            <span>Hashtag</span>
          </button>
          <button type="button" class="drawer-source-item" data-subsource="hashtag-soft-skills">
            <span class="dropdown-dot" style="background-color: #f43f5e;"></span>
            <span>Hashtag Soft</span>
          </button>
          <button type="button" class="drawer-source-item" data-subsource="sctec">
            <span class="dropdown-dot" style="background-color: #10b981;"></span>
            <span>SCTEC</span>
          </button>
          <button type="button" class="drawer-source-item" data-subsource="outros">
            <span class="dropdown-dot" style="background-color: #f59e0b;"></span>
            <span>Diversos</span>
          </button>
        </div>
      </div>

      <!-- Navigation Links Section -->
      <div class="drawer-section">
        <span class="drawer-section-title">Navegação</span>
        <nav class="drawer-nav-links">
          {navItems.map(item => (
            <a
              href={item.href}
              class={`drawer-nav-link ${currentPath === item.href ? 'active' : ''}`}
              data-admin-only={item.adminOnly ? 'true' : 'false'}
              style={item.adminOnly ? 'display: none;' : ''}
            >
              <span>{item.label}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          ))}
                </nav>
      </div>

      <!-- Mobile Drawer Logout -->
      <div class="drawer-section drawer-logout-section">
        <a href="/api/auth/logout" class="drawer-logout-btn" id="mobile-logout-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Sair da Conta</span>
        </a>
      </div>
    </div>
  </aside>
</header>

<script>
  import { getActiveSource, setActiveSource } from '../lib/sources';
  import { logoutUser } from '../lib/auth';

  const SOURCES_META: Record<string, { label: string; color: string; isAll?: boolean }> = {
    'all': { label: 'Todas', color: 'var(--grad-primary)', isAll: true },
    'ailab': { label: 'AI LAB', color: '#00f2fe' },
    'asimov': { label: 'Asimov', color: '#6366f1' },
    'asimov-skills': { label: 'Asimov Skills', color: '#818cf8' },
    'hashtag': { label: 'Hashtag', color: '#ec4899' },
    'hashtag-soft-skills': { label: 'Hashtag Soft Skills', color: '#f43f5e' },
    'sctec': { label: 'SCTEC', color: '#10b981' },
    'outros': { label: 'Diversos', color: '#f59e0b' }
  };

  function updateActiveSourceUI(forcedSource?: string) {
    const isWatch = window.location.pathname.startsWith('/watch');
    const videoSrc = (window as any).__CURRENT_VIDEO_SOURCE__;
    const currentSource = forcedSource || (isWatch && videoSrc ? videoSrc : getActiveSource());

    const meta = SOURCES_META[currentSource] || SOURCES_META['all'];
    const labelEl = document.getElementById('single-source-label');
    const dotEl = document.getElementById('single-source-dot');
    const btnEl = document.getElementById('single-source-btn');

    if (labelEl) {
      labelEl.textContent = meta.label;
    }

    if (dotEl) {
      if (meta.isAll) {
        dotEl.classList.add('dot-all');
        dotEl.style.backgroundColor = '';
        dotEl.style.boxShadow = '';
      } else {
        dotEl.classList.remove('dot-all');
        dotEl.style.backgroundColor = meta.color;
        dotEl.style.boxShadow = `0 0 8px ${meta.color}80`;
      }
    }

    if (btnEl) {
      btnEl.setAttribute('data-active-source', currentSource);
    }

    // Update active checkmarks in dropdown items (desktop & mobile)
    const dropdownItems = document.querySelectorAll<HTMLButtonElement>('.dropdown-item, .drawer-source-item');
    dropdownItems.forEach(item => {
      const sub = item.getAttribute('data-subsource');
      if (sub === currentSource) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });
  }

  function closeMobileDrawer() {
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('mobile-drawer-overlay');
    const toggle = document.getElementById('mobile-menu-toggle-btn');
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  function openMobileDrawer() {
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('mobile-drawer-overlay');
    const toggle = document.getElementById('mobile-menu-toggle-btn');
    drawer?.classList.add('open');
    overlay?.classList.add('open');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function initNavbar() {
    const currentPath = window.location.pathname;

    const links = document.querySelectorAll<HTMLAnchorElement>('.nav-link, .drawer-nav-link');
    links.forEach(link => {
      const href = link.getAttribute('href');
      if (href === currentPath || (href && href !== '/' && currentPath.startsWith(href))) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });

    updateActiveSourceUI();

    try {
      const user = localStorage.getItem('mindflix_user');
      if (user) {
        const data = JSON.parse(user);
        const name = data.full_name || data.email || '';
        const isLemmg = name.toLowerCase().includes('lemmg0800');

        const adminLinks = document.querySelectorAll('[data-admin-only="true"]');
        adminLinks.forEach(link => {
          (link as HTMLElement).style.display = isLemmg ? (link.classList.contains('drawer-nav-link') ? 'flex' : 'inline-block') : 'none';
        });

        const initials = name.substring(0, 2).toUpperCase();
        const el = document.getElementById('user-initials');
        if (el) el.textContent = initials;

        const mobileInitials = document.getElementById('mobile-user-initials');
        if (mobileInitials) mobileInitials.textContent = initials;

        const mobileName = document.getElementById('mobile-user-name');
        if (mobileName) mobileName.textContent = data.full_name || 'Minha Conta';
      }
    } catch (err) {}
  }

  window.addEventListener('scroll', () => {
    const navbar = document.getElementById('main-navbar');
    if (window.scrollY > 25) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  }, { passive: true });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const group = document.getElementById('header-source-dropdown-group');
    const singleBtn = target.closest<HTMLButtonElement>('#single-source-btn');

    // User Avatar button toggle
    const userMenuContainer = document.getElementById('user-menu-container');
    const userAvatarBtn = target.closest<HTMLButtonElement>('#user-avatar-btn');
    if (userAvatarBtn && userMenuContainer) {
      e.preventDefault();
      e.stopPropagation();
      const isOpen = userMenuContainer.classList.contains('open');
      if (isOpen) {
        userMenuContainer.classList.remove('open');
        userAvatarBtn.setAttribute('aria-expanded', 'false');
      } else {
        userMenuContainer.classList.add('open');
        userAvatarBtn.setAttribute('aria-expanded', 'true');
      }
      return;
    }

    // Logout button click (Header dropdown or Mobile Drawer)
    if (target.closest('#header-logout-btn') || target.closest('#mobile-logout-btn')) {
      e.preventDefault();
      logoutUser();
      return;
    }

    // Close user dropdown if clicking outside
    if (userMenuContainer && !userMenuContainer.contains(target)) {
      userMenuContainer.classList.remove('open');
      document.getElementById('user-avatar-btn')?.setAttribute('aria-expanded', 'false');
    }

    // Mobile menu toggle button
    if (target.closest('#mobile-menu-toggle-btn')) {
      e.preventDefault();
      e.stopPropagation();
      const drawer = document.getElementById('mobile-drawer');
      if (drawer?.classList.contains('open')) {
        closeMobileDrawer();
      } else {
        openMobileDrawer();
      }
      return;
    }

    // Close mobile drawer buttons
    if (target.closest('#mobile-drawer-close-btn') || target.closest('#mobile-drawer-overlay')) {
      closeMobileDrawer();
      return;
    }

    // Mobile drawer search button
    if (target.closest('#mobile-drawer-search-btn')) {
      e.preventDefault();
      closeMobileDrawer();
      if (typeof (window as any).openSearchModal === 'function') {
        (window as any).openSearchModal('all', '');
      } else {
        window.dispatchEvent(new CustomEvent('mindflix:open-search', { detail: { type: 'all' } }));
      }
      return;
    }

    // 1. Click on single collapsed button toggle
    if (singleBtn && group) {
      e.preventDefault();
      e.stopPropagation();
      const isOpen = group.classList.contains('open');
      if (isOpen) {
        group.classList.remove('open');
        singleBtn.setAttribute('aria-expanded', 'false');
      } else {
        group.classList.add('open');
        singleBtn.setAttribute('aria-expanded', 'true');
      }
      return;
    }

    // 2. Click on dropdown item or mobile drawer source item
    const dropdownItem = target.closest<HTMLButtonElement>('.dropdown-item, .drawer-source-item');
    if (dropdownItem) {
      e.preventDefault();
      e.stopPropagation();
      const subsource = dropdownItem.getAttribute('data-subsource') || 'all';

      group?.classList.remove('open');
      document.getElementById('single-source-btn')?.setAttribute('aria-expanded', 'false');
      closeMobileDrawer();

      setActiveSource(subsource);
      updateActiveSourceUI(subsource);

      if (window.location.pathname.startsWith('/source/') || window.location.pathname === '/' || window.location.pathname === '/courses') {
        if (subsource === 'all') {
          window.location.href = '/courses';
        } else {
          window.location.href = `/source/${subsource}`;
        }
      }
      return;
    }

    // Close dropdown when clicking outside
    if (group?.classList.contains('open')) {
      group.classList.remove('open');
      document.getElementById('single-source-btn')?.setAttribute('aria-expanded', 'false');
    }

    if (target && target.closest('#open-search-modal-btn')) {
      e.preventDefault();
      if (typeof (window as any).openSearchModal === 'function') {
        (window as any).openSearchModal('all', '');
      } else {
        window.dispatchEvent(new CustomEvent('mindflix:open-search', { detail: { type: 'all' } }));
      }
    }
  });

  // Check logged user and control admin-only menu visibility
  try {
    const user = localStorage.getItem('mindflix_user');
    if (user) {
      const data = JSON.parse(user);
      if ((data.email && data.email.toLowerCase().includes('tamydoagro')) || data.id === 'user-tamydoagro') {
        if (data.full_name !== 'Tamires') {
          data.full_name = 'Tamires';
          localStorage.setItem('mindflix_user', JSON.stringify(data));
        }
      }
      const name = data.full_name || data.email || '';
      const isLemmg = name.toLowerCase().includes('lemmg0800');

      const adminLinks = document.querySelectorAll('[data-admin-only="true"]');
      adminLinks.forEach(link => {
        (link as HTMLElement).style.display = isLemmg ? 'inline-block' : 'none';
      });

      const el = document.getElementById('user-initials');
      if (el) el.textContent = name.substring(0, 2).toUpperCase();
    }
  } catch (err) {}

  window.addEventListener('mindflix:source-changed', (e: any) => {
    if (e?.detail?.sourceId) {
      updateActiveSourceUI(e.detail.sourceId);
    }
  });

  document.addEventListener('astro:page-load', initNavbar);
  initNavbar();
</script>

