---
// CourseSidebar.astro
import type { Course } from '../types/catalog';
import PlaylistSidebar from './PlaylistSidebar.astro';

interface Props {
  course: Course;
  currentLessonId: string;
}

const { course, currentLessonId } = Astro.props;
---

<PlaylistSidebar
  type="course"
  course={course}
  currentLessonId={currentLessonId}
/>
