---
// WelcomeNoticeModal.astro - First-login notice regarding category filtering in preferences
---

<div class="welcome-modal-overlay" id="welcome-notice-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="welcome-modal-title">
  <div class="welcome-modal-card">
    <div class="welcome-modal-header">
      <div class="welcome-badge-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
      </div>
      <button type="button" class="welcome-close-btn" id="welcome-notice-close" aria-label="Fechar aviso">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="welcome-modal-body">
      <span class="welcome-tag">Novo Recurso</span>
      <h2 class="welcome-title" id="welcome-modal-title">Personalize seu Feed de Cursos!</h2>
      <p class="welcome-text">
        Agora você pode escolher exatamente quais tópicos deseja acompanhar no seu perfil e na tela inicial!
        Nas <strong>Preferências</strong>, selecione apenas as suas categorias favoritas (como Saúde, IA, Programação, etc.) e o catálogo filtrará automaticamente os cards para você.
      </p>
    </div>

    <div class="welcome-modal-footer">
      <button type="button" class="btn btn-primary btn-welcome-primary" id="btn-welcome-configure">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="22 3 2 10 11 13 14 22 22 3"></polygon>
        </svg>
        <span>Configurar Categorias Agora</span>
      </button>
      <button type="button" class="btn btn-secondary btn-welcome-ghost" id="btn-welcome-dismiss">
        <span>Entendido</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { getLocalUser } from '../lib/supabase';
  import { getUserPreferences, saveUserPreferences } from '../lib/progress';

  function checkFirstTimeNotice() {
    const path = window.location.pathname;
    if (path === '/login' || path === '/register') return;

    const user = getLocalUser();
    if (!user) return;

    const prefs = getUserPreferences();
    if (!prefs.first_login_notice_seen) {
      const modal = document.getElementById('welcome-notice-modal');
      if (modal) {
        setTimeout(() => {
          modal.style.display = 'flex';
          modal.classList.add('visible');
        }, 600);
      }
    }
  }

  const dismissModal = async (redirectTarget?: string) => {
    const modal = document.getElementById('welcome-notice-modal');
    if (modal) {
      modal.classList.remove('visible');
      setTimeout(() => {
        modal.style.display = 'none';
      }, 300);
    }
    await saveUserPreferences({ first_login_notice_seen: true });
    if (redirectTarget) {
      window.location.href = redirectTarget;
    }
  };

  document.getElementById('btn-welcome-configure')?.addEventListener('click', () => {
    dismissModal('/settings?openCategories=1');
  });

  document.getElementById('btn-welcome-dismiss')?.addEventListener('click', () => {
    dismissModal();
  });

  document.getElementById('welcome-notice-close')?.addEventListener('click', () => {
    dismissModal();
  });

  document.addEventListener('DOMContentLoaded', checkFirstTimeNotice);
  // Also trigger check immediately if DOM is already ready
  if (document.readyState !== 'loading') {
    checkFirstTimeNotice();
  }
</script>

<style>
  .welcome-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-modal);
    background: rgba(4, 6, 12, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .welcome-modal-overlay.visible {
    opacity: 1;
  }

  .welcome-modal-card {
    width: 100%;
    max-width: 480px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.65), 0 0 32px rgba(var(--accent-primary-rgb), 0.15);
    transform: scale(0.92);
    transition: transform 0.35s var(--ease-spring);
    position: relative;
    overflow: hidden;
  }

  .welcome-modal-overlay.visible .welcome-modal-card {
    transform: scale(1);
  }

  .welcome-modal-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--grad-primary);
  }

  .welcome-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .welcome-badge-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(var(--accent-primary-rgb), 0.15);
    border: 1px solid rgba(var(--accent-primary-rgb), 0.3);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .welcome-close-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 50%;
    transition: all var(--motion-fast) ease;
  }

  .welcome-close-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  .welcome-tag {
    display: inline-block;
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
    background: rgba(var(--accent-primary-rgb), 0.12);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }

  .welcome-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.25;
    margin-bottom: 0.85rem;
  }

  .welcome-text {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.85rem;
  }

  .welcome-modal-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .btn-welcome-primary {
    width: 100%;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    font-size: 0.95rem;
  }

  .btn-welcome-ghost {
    width: 100%;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
  }
</style>
