---
// LessonItem.astro - Individual lesson item with clear status, active glow and materials
import type { Lesson } from '../types/catalog';

interface Props {
  courseId: string;
  lesson: Lesson;
  isCurrent?: boolean;
}

const { courseId, lesson, isCurrent = false } = Astro.props;
const watchHref = `/watch/${courseId}/${lesson.id}`;
---

<div
  class={`lesson-item ${isCurrent ? 'current-lesson' : ''}`}
  data-lesson-id={lesson.id}
  data-course-id={courseId}
>
  <a href={watchHref} class="lesson-link">
    <div class="lesson-status-icon" data-status-icon-for={lesson.id}>
      <svg class="icon-playing" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style={isCurrent ? '' : 'display: none;'}>
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <svg class="icon-unwatched" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={!isCurrent ? '' : 'display: none;'}>
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <svg class="icon-completed" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>

    <div class="lesson-info">
      <span class="lesson-index">{String(lesson.order_index).padStart(2, '0')}</span>
      <span class="lesson-title">{lesson.display_title}</span>
    </div>

    <div class="lesson-meta">
      <span class="completed-badge" style="display: none;" title="Aula Concluída">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Concluída</span>
      </span>

      {(() => {
        const validMats = (lesson.materials || []).filter((m: any) => {
          const t = (m.title || '').toLowerCase();
          const p = (m.relative_path || '').toLowerCase();
          return !t.includes('artigo') && !t.includes('transcri') && !t.includes('transcript') && !t.includes('article') &&
                 !p.includes('artigo') && !p.includes('transcri') && !p.includes('transcript') && !p.includes('article');
        });
        return validMats.length > 0 ? (
          <span class="materials-badge" title={`${validMats.length} material(is) complementar(es)`}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <span>{validMats.length}</span>
          </span>
        ) : null;
      })()}
      <span class="lesson-duration">{lesson.duration_formatted}</span>
    </div>
  </a>
</div>

<script>
  import { getAllLocalProgress } from '../lib/progress';

  function updateLessonItems() {
    const allProgress = getAllLocalProgress();

    document.querySelectorAll<HTMLElement>('.lesson-item').forEach(item => {
      const lessonId = item.getAttribute('data-lesson-id');
      if (!lessonId) return;

      const progress = allProgress[lessonId];
      const isCurrent = item.classList.contains('current-lesson');
      const unwatchedIcon = item.querySelector<HTMLElement>('.icon-unwatched');
      const completedIcon = item.querySelector<HTMLElement>('.icon-completed');
      const playingIcon = item.querySelector<HTMLElement>('.icon-playing');
      const completedBadge = item.querySelector<HTMLElement>('.completed-badge');

      if (progress && progress.completed) {
        item.classList.add('completed');
        item.classList.remove('in-progress');

        if (completedIcon) completedIcon.style.display = 'block';
        if (unwatchedIcon) unwatchedIcon.style.display = 'none';
        if (playingIcon) playingIcon.style.display = isCurrent ? 'none' : 'none';
        if (completedBadge) completedBadge.style.display = 'inline-flex';
      } else if (progress && progress.percentage > 0) {
        item.classList.add('in-progress');
        item.classList.remove('completed');

        if (completedIcon) completedIcon.style.display = 'none';
        if (completedBadge) completedBadge.style.display = 'none';
        if (isCurrent) {
          if (playingIcon) playingIcon.style.display = 'block';
          if (unwatchedIcon) unwatchedIcon.style.display = 'none';
        } else {
          if (playingIcon) playingIcon.style.display = 'none';
          if (unwatchedIcon) unwatchedIcon.style.display = 'block';
        }
      } else {
        item.classList.remove('completed', 'in-progress');
        if (completedIcon) completedIcon.style.display = 'none';
        if (completedBadge) completedBadge.style.display = 'none';
        if (isCurrent) {
          if (playingIcon) playingIcon.style.display = 'block';
          if (unwatchedIcon) unwatchedIcon.style.display = 'none';
        } else {
          if (playingIcon) playingIcon.style.display = 'none';
          if (unwatchedIcon) unwatchedIcon.style.display = 'block';
        }
      }
    });
  }

  updateLessonItems();
  window.addEventListener('mindflix:progress-updated', updateLessonItems);
  window.addEventListener('storage', updateLessonItems);
</script>

<style>
  .lesson-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background-color var(--motion-fast) var(--ease-out), border-color var(--motion-fast) var(--ease-out);
    position: relative;
  }

  .lesson-item:last-child {
    border-bottom: none;
  }

  .lesson-item:hover {
    background-color: rgba(255, 255, 255, 0.04);
  }

  .lesson-item.current-lesson {
    background: rgba(0, 242, 254, 0.08);
    border-left: 3px solid var(--accent-cyan);
  }

  .lesson-item.completed {
    background: rgba(16, 185, 129, 0.04);
  }

  .lesson-item.completed.current-lesson {
    background: rgba(16, 185, 129, 0.1);
    border-left: 3px solid var(--accent-emerald);
  }

  .lesson-link {
    display: flex;
    align-items: center;
    padding: 0.6rem 1rem;
    gap: 0.75rem;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .lesson-status-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: all var(--motion-fast) var(--ease-out);
  }

  .current-lesson .lesson-status-icon {
    background: var(--accent-cyan);
    border-color: var(--accent-cyan);
    color: #07090e;
    box-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
  }

  .lesson-item.completed .lesson-status-icon {
    background: rgba(16, 185, 129, 0.2);
    border-color: rgba(16, 185, 129, 0.5);
    color: var(--accent-emerald);
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.25);
  }

  .lesson-item.completed.current-lesson .lesson-status-icon {
    background: var(--accent-emerald);
    border-color: var(--accent-emerald);
    color: #07090e;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.6);
  }

  .lesson-item:hover .lesson-status-icon {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .lesson-info {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex: 1;
    min-width: 0;
  }

  .lesson-index {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .current-lesson .lesson-index {
    color: var(--accent-cyan);
  }

  .lesson-item.completed .lesson-index {
    color: var(--accent-emerald);
  }

  .lesson-title {
    font-size: 0.8125rem;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .current-lesson .lesson-title {
    color: #ffffff;
    font-weight: 600;
  }

  .lesson-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .completed-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--accent-emerald);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-full);
  }

  .materials-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-xs);
  }

  .lesson-duration {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
