---
// LessonItem.astro - Item de aula individual com seletor check interativo e tooltip
import type { Lesson } from '../types/catalog';

interface Props {
  courseId: string;
  lesson: Lesson;
  isCurrent?: boolean;
  watchHref?: string;
}

const { courseId, lesson, isCurrent = false, watchHref } = Astro.props;
const targetHref = watchHref || `/watch/${courseId}/${lesson.id}`;
---

<div
  class={`lesson-item ${isCurrent ? 'current-lesson' : ''}`}
  data-lesson-id={lesson.id}
  data-course-id={courseId}
>
  <!-- Seletor Check Interativo (Clique altera estado de conclusão) -->
  <button
    type="button"
    class="lesson-check-selector"
    data-lesson-id={lesson.id}
    data-course-id={courseId}
    title="Marcar como concluída"
    aria-label="Marcar como concluída"
  >
    <svg class="check-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </button>

  <!-- Demais áreas da faixa para navegação -->
  <a href={targetHref} class="lesson-link" title={lesson.display_title}>
    <div class="lesson-info">
      <span class="lesson-index">{String(lesson.order_index).padStart(2, '0')}</span>
      <span class="lesson-title" title={lesson.display_title}>{lesson.display_title}</span>
    </div>

    <div class="lesson-meta">
      {isCurrent && (
        <span class="playing-badge" title="Aula em reprodução">
          <span class="pulse-dot"></span>
          <span>Assistindo</span>
        </span>
      )}

      {(() => {
        const validMats = (lesson.materials || []).filter((m: any) => {
          const t = (m.title || '').toLowerCase();
          const p = (m.relative_path || '').toLowerCase();
          return !t.includes('artigo') && !t.includes('transcri') && !t.includes('transcript') && !t.includes('article') &&
                 !p.includes('artigo') && !p.includes('transcri') && !p.includes('transcript') && !p.includes('article');
        });
        return validMats.length > 0 ? (
          <span class="materials-badge" title={`${validMats.length} material(is) complementar(es)`}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <span>{validMats.length}</span>
          </span>
        ) : null;
      })()}
      <span class="lesson-duration">{lesson.duration_formatted}</span>
    </div>
  </a>
</div>

<script>
  import { getAllLocalProgress, saveLessonProgress, getRealDurationForLesson } from '../lib/progress';
  import { showToast } from '../lib/toast';

  function updateLessonItems() {
    const allProgress = getAllLocalProgress();

    document.querySelectorAll<HTMLElement>('.lesson-item').forEach(item => {
      const lessonId = item.getAttribute('data-lesson-id');
      if (!lessonId) return;

      const realDur = getRealDurationForLesson(lessonId);
      if (realDur && realDur.duration_formatted) {
        const durSpan = item.querySelector<HTMLElement>('.lesson-duration');
        if (durSpan) durSpan.textContent = realDur.duration_formatted;
      }

      const progress = allProgress[lessonId];
      const checkBtn = item.querySelector<HTMLButtonElement>('.lesson-check-selector');

      if (progress && progress.completed) {
        item.classList.add('completed');
        checkBtn?.classList.add('checked');
        if (checkBtn) checkBtn.title = 'Marcar como não concluída';
      } else {
        item.classList.remove('completed');
        checkBtn?.classList.remove('checked');
        if (checkBtn) checkBtn.title = 'Marcar como concluída';
      }
    });
  }

  // Delegated click handlers for lesson check selectors
  document.querySelectorAll<HTMLButtonElement>('.lesson-check-selector').forEach(btn => {
    if (btn.dataset.checkInit === 'true') return;
    btn.dataset.checkInit = 'true';

    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const lessonId = btn.getAttribute('data-lesson-id');
      const courseId = btn.getAttribute('data-course-id');
      if (!lessonId || !courseId) return;

      const allProgress = getAllLocalProgress();
      const isCurrentlyCompleted = Boolean(allProgress[lessonId]?.completed);
      const newStatus = !isCurrentlyCompleted;

      await saveLessonProgress(courseId, lessonId, newStatus ? 600 : 0, 600, newStatus);
      
      window.dispatchEvent(new CustomEvent('mindflix:progress-updated', {
        detail: { courseId, lessonId, completed: newStatus }
      }));

      showToast(newStatus ? 'Aula marcada como concluída!' : 'Aula desmarcada', 'success', 2000);
    });
  });

  updateLessonItems();
  window.addEventListener('mindflix:progress-updated', updateLessonItems);
  window.addEventListener('mindflix-duration-updated', updateLessonItems);
  window.addEventListener('storage', updateLessonItems);
</script>

<style>
  .lesson-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background-color var(--motion-fast) var(--ease-out), border-color var(--motion-fast) var(--ease-out);
    position: relative;
    display: flex;
    align-items: center;
  }

  .lesson-item:last-child {
    border-bottom: none;
  }

  .lesson-item:hover {
    background-color: rgba(255, 255, 255, 0.04);
  }

  .lesson-item.current-lesson {
    background: rgba(0, 242, 254, 0.08);
    border-left: 3px solid var(--accent-cyan);
  }

  .lesson-item.completed {
    background: rgba(16, 185, 129, 0.04);
  }

  .lesson-item.completed.current-lesson {
    background: rgba(16, 185, 129, 0.1);
    border-left: 3px solid var(--accent-emerald);
  }

  /* Seletor Check Interativo */
  .lesson-check-selector {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1.5px solid var(--border-subtle, rgba(255, 255, 255, 0.2));
    display: flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    cursor: pointer;
    z-index: 5;
    transition: all 0.2s ease;
    padding: 0;
  }

  .lesson-check-selector:hover {
    border-color: var(--accent-cyan, #00f2fe);
    background: rgba(0, 242, 254, 0.15);
    color: var(--accent-cyan, #00f2fe);
    transform: translateY(-50%) scale(1.1);
  }

  .lesson-check-selector.checked,
  .lesson-item.completed .lesson-check-selector {
    background: #10b981;
    border-color: #10b981;
    color: #ffffff;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
  }

  .lesson-link {
    display: flex;
    align-items: center;
    padding: 0.65rem 1rem 0.65rem 2.6rem;
    gap: 0.75rem;
    color: var(--text-secondary);
    text-decoration: none;
    width: 100%;
    min-width: 0;
  }

  .lesson-info {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex: 1;
    min-width: 0;
  }

  .lesson-index {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .current-lesson .lesson-index {
    color: var(--accent-cyan);
  }

  .lesson-item.completed .lesson-index {
    color: var(--accent-emerald);
  }

  .lesson-title {
    font-size: 0.8125rem;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    min-width: 0;
  }

  .current-lesson .lesson-title {
    color: #ffffff;
    font-weight: 600;
  }

  .lesson-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .playing-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--accent-cyan, #00f2fe);
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.25);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-full, 9999px);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-cyan, #00f2fe);
    box-shadow: 0 0 6px var(--accent-cyan, #00f2fe);
  }

  .materials-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-xs);
  }

  .lesson-duration {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
