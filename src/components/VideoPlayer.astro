---
// VideoPlayer.astro - Advanced Video Player with Theater/Focus modes, Keyboard Shortcuts, Speed Popover, and Next Lesson Countdown
import type { Lesson } from '../types/catalog';
import { getLessonDriveId, isDriveLesson, getDrivePreviewUrl } from '../lib/drive';

interface Props {
  courseId: string;
  lesson: Lesson;
  nextLessonHref?: string;
  nextLessonTitle?: string;
  prevLessonHref?: string;
}

const { courseId, lesson, nextLessonHref, nextLessonTitle = 'Próxima Aula', prevLessonHref } = Astro.props;

const driveId = getLessonDriveId(lesson);
const videoStreamUrl = `/api/video?path=${encodeURIComponent(lesson.relative_path || '')}`;
const drivePreviewUrl = driveId ? getDrivePreviewUrl(driveId) : videoStreamUrl;
const isDrive = true; // All videos hosted on Google Drive

const ext = (lesson.relative_path || '').split('.').pop()?.toLowerCase() || '';
const isPdf = lesson.type === 'pdf' || ext === 'pdf';
const isDoc = ['docx', 'pptx', 'xlsx', 'txt', 'md', 'html'].includes(ext);
const isVideo = !isPdf && !isDoc;
---

<div
  class="video-player-component"
  id="player-wrapper"
  data-course-id={courseId}
  data-lesson-id={lesson.id}
  data-next-href={nextLessonHref || ''}
  data-next-title={nextLessonTitle}
  data-is-drive={isDrive ? 'true' : 'false'}
>
  <!-- Next Lesson Countdown Overlay (Shown on Video End) -->
  <div class="next-lesson-overlay" id="next-lesson-overlay" style="display: none;">
    <div class="next-overlay-card">
      <span class="next-badge">Próxima Aula</span>
      <h3 class="next-title" id="next-overlay-title">{nextLessonTitle}</h3>
      <p class="next-countdown-text" id="next-countdown-text">Iniciando em <span id="countdown-secs">8</span>s...</p>
      
      <div class="next-overlay-actions">
        {nextLessonHref && (
          <a href={nextLessonHref} class="btn btn-primary btn-sm" id="btn-play-next-now">
            <span>Assistir Agora</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </a>
        )}
        <button type="button" class="btn btn-ghost btn-sm" id="btn-cancel-next">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- Discreet Save Indicator (✓ Salvo) -->
  <div class="save-status-pill" id="save-status-pill" style="display: none;">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span>Progresso salvo</span>
  </div>

  <!-- Main Video Viewport (Supports Google Drive & Local Video Stream & PDFs/Docs) -->
  <div class="video-viewport" id="video-viewport">
    {isVideo ? (
      <div class="drive-video-wrapper">
        <iframe
          id="drive-video-iframe"
          class="drive-player-frame"
          src={drivePreviewUrl}
          allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
          allowfullscreen
          title={lesson.display_title}
        ></iframe>
        <!-- Blocker to prevent clicking Google Drive's native pop-out button in the top right -->
        <div class="drive-popout-blocker" title=""></div>
      </div>
    ) : isPdf ? (
      <div class="doc-player-wrapper">
        <iframe
          id="pdf-viewer-frame"
          class="doc-player-frame"
          src={videoStreamUrl}
          title={lesson.display_title}
        ></iframe>
      </div>
    ) : (
      <div class="doc-download-card">
        <div class="doc-icon-box">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>
        <h3 class="doc-card-title">{lesson.display_title}</h3>
        <p class="doc-card-desc">Material de apoio e documento complementar da aula.</p>
        <div class="doc-card-actions">
          <a href={videoStreamUrl} download class="btn btn-primary btn-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Baixar Arquivo ({ext.toUpperCase()})</span>
          </a>
          <a href={videoStreamUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Abrir no Navegador</a>
        </div>
      </div>
    )}

    <!-- Graceful Media Error State -->
    <div id="video-error-overlay" class="video-error-overlay" style="display: none;">
      <div class="video-error-card">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="error-icon">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <h3 class="video-error-title">Vídeo Indisponível</h3>
        <p class="video-error-desc" id="video-error-desc">Este arquivo de mídia está disponível apenas na biblioteca local ou ainda em processo de sincronização com o Google Drive.</p>
        <div class="video-error-actions">
          <button type="button" class="btn btn-secondary btn-sm" id="btn-retry-video">Tentar Novamente</button>
          <a href="/courses" class="btn btn-primary btn-sm">Voltar aos Cursos</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Classroom Action Bar (Lesson Navigation, Focus Mode & Mark Completed) -->
  <div class="classroom-nav-bar">
    <div class="nav-left">
      {prevLessonHref ? (
        <a href={prevLessonHref} class="btn-nav-lesson" title="Aula Anterior (Shift + P)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="btn-label-desktop">Anterior</span>
        </a>
      ) : (
        <button class="btn-nav-lesson disabled" disabled>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="btn-label-desktop">Anterior</span>
        </button>
      )}

      {nextLessonHref ? (
        <a href={nextLessonHref} class="btn-nav-lesson" id="manual-next-link" title="Próxima Aula (Shift + N)">
          <span class="btn-label-desktop">Próxima</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      ) : (
        <button class="btn-nav-lesson disabled" disabled>
          <span class="btn-label-desktop">Próxima</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      )}
    </div>

    <div class="nav-right">
      <button type="button" class="btn btn-ghost btn-sm btn-mode" id="btn-focus-mode" title="Modo Foco Zen (C)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M3 9V5a2 2 0 0 1 2-2h4M15 3h4a2 2 0 0 1 2 2v4M21 15v4a2 2 0 0 1-2 2h-4M9 21H5a2 2 0 0 1-2-2v-4"></path>
        </svg>
        <span class="btn-label-desktop">Foco</span>
      </button>

      <!-- Mark as completed toggle button -->
      <button type="button" class="btn btn-secondary btn-complete-toggle" id="btn-toggle-complete">
        <svg class="check-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span id="complete-btn-text">Concluir</span>
      </button>
    </div>
  </div>
</div>

<script>
  import {
    getLessonProgress,
    saveLessonProgress,
    getUserPreferences,
    saveUserPreferences
  } from '../lib/progress';
  import { showToast } from '../lib/toast';

  const wrapper = document.getElementById('player-wrapper');
  const video = document.getElementById('main-video-player') as HTMLVideoElement | null;
  const overlay = document.getElementById('next-lesson-overlay');
  const countdownSecs = document.getElementById('countdown-secs');
  const countdownText = document.getElementById('next-countdown-text');
  const btnCancelNext = document.getElementById('btn-cancel-next');
  const savePill = document.getElementById('save-status-pill');
  const btnComplete = document.getElementById('btn-toggle-complete');
  const completeText = document.getElementById('complete-btn-text');
  const btnTheater = document.getElementById('btn-theater-mode');
  const btnFocus = document.getElementById('btn-focus-mode');
  const btnPip = document.getElementById('btn-pip-mode');
  const errorOverlay = document.getElementById('video-error-overlay');
  const retryBtn = document.getElementById('btn-retry-video');

  const courseId = wrapper?.getAttribute('data-course-id') || '';
  const lessonId = wrapper?.getAttribute('data-lesson-id') || '';
  const nextHref = wrapper?.getAttribute('data-next-href') || '';

  if (courseId && lessonId) {
    const prefs = getUserPreferences();
    const isDrive = wrapper?.getAttribute('data-is-drive') === 'true';

    // Mark completed toggle (Shared across Video and Drive)
    const saved = getLessonProgress(lessonId);
    const updateCompleteUI = (isComplete: boolean) => {
      if (!btnComplete || !completeText) return;
      if (isComplete) {
        btnComplete.classList.add('btn-completed');
        completeText.textContent = 'Concluída ✓';
      } else {
        btnComplete.classList.remove('btn-completed');
        completeText.textContent = 'Concluir';
      }
    };

    if (saved?.completed) updateCompleteUI(true);

    btnComplete?.addEventListener('click', async () => {
      const isComplete = !btnComplete.classList.contains('btn-completed');
      const currentPos = video ? video.currentTime : (isComplete ? 600 : 0);
      const totalDur = video && video.duration ? video.duration : 600;
      await saveLessonProgress(courseId, lessonId, currentPos, totalDur, isComplete);
      updateCompleteUI(isComplete);
      window.dispatchEvent(new CustomEvent('mindflix:progress-updated', { detail: { courseId, lessonId, completed: isComplete } }));
      showToast(isComplete ? 'Aula marcada como concluída!' : 'Aula reaberta', 'success');
    });

    // Clicking "Próxima" marks the current lesson as completed before navigating to next video
    const manualNextBtn = document.getElementById('manual-next-link');
    manualNextBtn?.addEventListener('click', async (e) => {
      e.preventDefault();
      const currentPos = video && !isNaN(video.currentTime) ? video.currentTime : 600;
      const totalDur = video && !isNaN(video.duration) ? video.duration : 600;
      await saveLessonProgress(courseId, lessonId, currentPos, totalDur, true);
      window.dispatchEvent(new CustomEvent('mindflix:progress-updated', { detail: { courseId, lessonId, completed: true } }));
      const href = manualNextBtn.getAttribute('href');
      if (href) window.location.href = href;
    });
    btnFocus?.addEventListener('click', () => {
      const isActive = document.body.classList.toggle('focus-mode-active');
      if (!isActive) {
        document.body.classList.remove('focus-sidebar-open');
      }
      btnFocus.classList.toggle('active', isActive);
      showToast(isActive ? 'Modo Foco Zen ativado. Pressione C ou ESC para sair.' : 'Modo Foco desativado', 'info', 3000);
    });

    // Next lesson countdown cancel
    btnCancelNext?.addEventListener('click', () => {
      if (overlay) overlay.style.display = 'none';
    });

    // Fullscreen Toggle (Shared for ALL video types)
    const btnFullscreen = document.getElementById('btn-fullscreen-toggle');
    btnFullscreen?.addEventListener('click', () => {
      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      } else {
        if (wrapper?.requestFullscreen) {
          wrapper.requestFullscreen().catch(() => {});
        } else if ((wrapper as any)?.webkitRequestFullscreen) {
          (wrapper as any).webkitRequestFullscreen();
        }
      }
    });

    // Picture-in-Picture Mode (Native + Floating Mini Player Fallback)
    const togglePiP = async () => {
      if (video && document.pictureInPictureEnabled && typeof video.requestPictureInPicture === 'function') {
        try {
          if (document.pictureInPictureElement) {
            await document.exitPictureInPicture();
            if (btnPip) btnPip.classList.remove('active');
            showToast('Saindo do Picture-in-Picture', 'info', 1500);
            return;
          } else {
            await video.requestPictureInPicture();
            if (btnPip) btnPip.classList.add('active');
            showToast('Picture-in-Picture ativado', 'success', 1500);
            return;
          }
        } catch (e) {
          console.warn('Native PiP failed, switching to Floating Mini Player:', e);
        }
      }

      if (wrapper) {
        const isFloating = wrapper.classList.toggle('pip-floating-mini-player');
        if (btnPip) btnPip.classList.toggle('active', isFloating);

        if (isFloating) {
          showToast('Mini Player flutuante ativado', 'success', 2500);
        } else {
          showToast('Mini Player desativado', 'info', 1500);
        }
      }
    };

    btnPip?.addEventListener('click', togglePiP);

    // Native HTML5 Video Specific Controls
    if (video) {
      // Remove native controls so MindFlix custom UI is used
      video.removeAttribute('controls');

      const mainPlayBtn = document.getElementById('btn-main-play');
      const iconPlay = mainPlayBtn?.querySelector<HTMLElement>('.icon-play');
      const iconPause = mainPlayBtn?.querySelector<HTMLElement>('.icon-pause');
      const rewindBtn = document.getElementById('btn-rewind-10');
      const forwardBtn = document.getElementById('btn-forward-10');
      const timeCurrent = document.getElementById('time-current');
      const timeDuration = document.getElementById('time-duration');
      const timelineTrack = document.getElementById('timeline-track');
      const timelineFill = document.getElementById('timeline-fill');
      const timelineThumb = document.getElementById('timeline-thumb');

      const formatTime = (secs: number) => {
        if (isNaN(secs) || secs < 0) return '0:00';
        const m = Math.floor(secs / 60);
        const s = Math.floor(secs % 60);
        return `${m}:${String(s).padStart(2, '0')}`;
      };

      const updatePlayStateUI = () => {
        if (video.paused) {
          if (iconPlay) iconPlay.style.display = 'block';
          if (iconPause) iconPause.style.display = 'none';
        } else {
          if (iconPlay) iconPlay.style.display = 'none';
          if (iconPause) iconPause.style.display = 'block';
        }
      };

      video.addEventListener('play', updatePlayStateUI);
      video.addEventListener('pause', updatePlayStateUI);

      mainPlayBtn?.addEventListener('click', () => {
        if (video.paused) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });

      rewindBtn?.addEventListener('click', () => {
        video.currentTime = Math.max(0, video.currentTime - 10);
      });

      forwardBtn?.addEventListener('click', () => {
        video.currentTime = Math.min(video.duration, video.currentTime + 10);
      });

      // Time & Scrubber updates
      video.addEventListener('timeupdate', () => {
        if (timeCurrent) timeCurrent.textContent = formatTime(video.currentTime);
        if (video.duration && !isNaN(video.duration)) {
          if (timeDuration) timeDuration.textContent = formatTime(video.duration);
          const pct = Math.min(100, (video.currentTime / video.duration) * 100);
          if (timelineFill) timelineFill.style.width = `${pct}%`;
          if (timelineThumb) timelineThumb.style.left = `${pct}%`;
        }
      });

      video.addEventListener('loadedmetadata', () => {
        if (video.duration && !isNaN(video.duration) && timeDuration) {
          timeDuration.textContent = formatTime(video.duration);
        }
      });

      if (timelineTrack) {
        let isSeeking = false;
        const seek = (e: MouseEvent) => {
          if (!video.duration || isNaN(video.duration)) return;
          const rect = timelineTrack.getBoundingClientRect();
          const pos = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
          video.currentTime = pos * video.duration;
        };

        timelineTrack.addEventListener('mousedown', (e) => {
          isSeeking = true;
          seek(e);
        });

        window.addEventListener('mousemove', (e) => {
          if (isSeeking) seek(e);
        });

        window.addEventListener('mouseup', () => {
          isSeeking = false;
        });
      }

      // Handle video load error gracefully
      video.addEventListener('error', () => {
        if (errorOverlay) errorOverlay.style.display = 'flex';
      });

      retryBtn?.addEventListener('click', () => {
        if (errorOverlay) errorOverlay.style.display = 'none';
        video.load();
        video.play().catch(() => {});
      });

      // Resume position check (respects prefs.auto_resume)
      if (prefs.auto_resume !== false && saved && saved.position_seconds > 5 && !saved.completed) {
        const setResumeTime = () => {
          if (!isNaN(video.duration) && saved.position_seconds < video.duration - 2) {
            video.currentTime = saved.position_seconds;
          }
        };
        video.addEventListener('loadedmetadata', setResumeTime, { once: true });
        if (video.readyState >= 1) setResumeTime();

        const mins = Math.floor(saved.position_seconds / 60);
        const secs = Math.floor(saved.position_seconds % 60);
        showToast(`Continuando de ${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`, 'info', 3000);
      }

      // Throttled progress saving with discreet save pill
      let lastSave = 0;
      const triggerSave = (manual = false) => {
        if (!video.duration || isNaN(video.duration)) return;
        saveLessonProgress(courseId, lessonId, video.currentTime, video.duration, manual);
        lastSave = Date.now();
        window.dispatchEvent(new CustomEvent('mindflix:progress-updated', { detail: { courseId, lessonId } }));

        // Show save pill
        if (savePill) {
          savePill.style.display = 'flex';
          setTimeout(() => { savePill.style.display = 'none'; }, 1500);
        }
      };

      video.addEventListener('seeked', () => triggerSave());

      // Unload safety: save exact position on page exit/navigate
      const handleUnload = () => {
        if (video && !isNaN(video.currentTime) && video.duration) {
          saveLessonProgress(courseId, lessonId, video.currentTime, video.duration, video.currentTime / video.duration >= 0.85);
        }
      };
      window.addEventListener('beforeunload', handleUnload);
      window.addEventListener('pagehide', handleUnload);

      video.addEventListener('timeupdate', () => {
        const now = Date.now();
        if (now - lastSave > 8000) triggerSave();

        if (video.duration && video.currentTime / video.duration >= 0.85) {
          if (!btnComplete?.classList.contains('btn-completed')) {
            triggerSave(true);
            updateCompleteUI(true);
          }
        }
      });

      video.addEventListener('pause', () => triggerSave());

      // Next lesson countdown logic (respects prefs.autoplay_next)
      let countdownInterval: any;
      video.addEventListener('ended', () => {
        triggerSave(true);
        updateCompleteUI(true);

        const currentPrefs = getUserPreferences();
        if (currentPrefs.autoplay_next !== false && nextHref && overlay) {
          overlay.style.display = 'flex';
          let count = 6;
          if (countdownSecs) countdownSecs.textContent = count.toString();

          clearInterval(countdownInterval);
          countdownInterval = setInterval(() => {
            count--;
            if (countdownSecs) countdownSecs.textContent = count.toString();
            if (count <= 0) {
              clearInterval(countdownInterval);
              window.location.href = nextHref;
            }
          }, 1000);
        }
      });

      video.addEventListener('leavepictureinpicture', () => {
        if (btnPip) btnPip.classList.remove('active');
      });

      // Keyboard Shortcuts for video
      window.addEventListener('keydown', (e) => {
        const target = e.target as HTMLElement;
        if (['INPUT', 'TEXTAREA', 'SELECT'].includes(target?.tagName) || target?.isContentEditable) return;
        if (document.getElementById('cmd-palette-backdrop')?.style.display === 'flex') return;

        if (e.key === ' ' || e.key === 'k' || e.key === 'K') {
          e.preventDefault();
          video.paused ? video.play() : video.pause();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          video.currentTime = Math.max(0, video.currentTime - 5);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          video.currentTime = Math.min(video.duration, video.currentTime + 5);
        } else if (e.key === 'j' || e.key === 'J') {
          e.preventDefault();
          video.currentTime = Math.max(0, video.currentTime - 10);
        } else if (e.key === 'l' || e.key === 'L') {
          e.preventDefault();
          video.currentTime = Math.min(video.duration, video.currentTime + 10);
        } else if (e.key === 'm' || e.key === 'M') {
          e.preventDefault();
          video.muted = !video.muted;
          showToast(video.muted ? 'Áudio mutado' : 'Áudio ativado', 'info', 1500);
        } else if (e.key === 'f' || e.key === 'F') {
          e.preventDefault();
          if (document.fullscreenElement) {
            document.exitFullscreen();
          } else {
            video.requestFullscreen().catch(() => {});
          }
        }
      });
    }

    // Common shortcuts (Theater & Focus)
    window.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes(target?.tagName) || target?.isContentEditable) return;
      if (document.getElementById('cmd-palette-backdrop')?.style.display === 'flex') return;

      if (e.key === 't' || e.key === 'T') {
        e.preventDefault();
        btnTheater?.click();
      } else if (e.key === 'c' || e.key === 'C') {
        e.preventDefault();
        btnFocus?.click();
      } else if (e.key === 'Escape' && document.body.classList.contains('focus-mode-active')) {
        e.preventDefault();
        btnFocus?.click();
      }
    });
  }
</script>

<style>
  .video-player-component {
    position: relative;
    width: 100%;
    background: #000000;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.65);
  }

  .video-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - 220px);
    background: #000000;
  }

  .drive-video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000000;
    overflow: hidden;
  }

  .drive-player-frame {
    position: absolute;
    top: -48px;
    left: -2px;
    width: calc(100% + 4px);
    height: calc(100% + 48px);
    border: none;
    background: #000000;
    display: block;
  }

  .drive-popout-blocker {
    position: absolute;
    top: 0;
    right: 0;
    width: 60px;
    height: 54px;
    z-index: 10;
    background: transparent;
    cursor: default;
    pointer-events: auto;
  }

  .video-error-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 13, 20, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    z-index: 10;
  }

  .video-error-card {
    max-width: 440px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .video-error-card .error-icon {
    color: #ef4444;
  }

  .video-error-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

