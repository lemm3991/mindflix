---
// VideoPlayer.astro - Advanced Video Player with Theater/Focus modes, Keyboard Shortcuts, Speed Popover, and Next Lesson Countdown
import type { Lesson } from '../types/catalog';
import { buildServerStreamUrl } from '../lib/mediaProvider';

interface Props {
  courseId: string;
  lesson: Lesson;
  nextLessonHref?: string;
  nextLessonTitle?: string;
  prevLessonHref?: string;
}

const { courseId, lesson, nextLessonHref, nextLessonTitle = 'Próxima Aula', prevLessonHref } = Astro.props;

const videoStreamUrl = buildServerStreamUrl(lesson.relative_path || '');

const ext = (lesson.relative_path || '').split('.').pop()?.toLowerCase() || '';
const isPdf = lesson.type === 'pdf' || ext === 'pdf';
const isDoc = ['docx', 'pptx', 'xlsx', 'txt', 'md', 'html'].includes(ext);
const isVideo = !isPdf && !isDoc;
---

<div
  class="video-player-component"
  id="player-wrapper"
  data-course-id={courseId}
  data-lesson-id={lesson.id}
  data-next-href={nextLessonHref || ''}
  data-next-title={nextLessonTitle}
  data-relative-path={lesson.relative_path || ''}
>
  <!-- Next Lesson Countdown Overlay (Shown on Video End) -->
  <div class="next-lesson-overlay" id="next-lesson-overlay" style="display: none;">
    <div class="next-overlay-card">
      <span class="next-badge">Próxima Aula</span>
      <h3 class="next-title" id="next-overlay-title">{nextLessonTitle}</h3>
      <p class="next-countdown-text" id="next-countdown-text">Iniciando em <span id="countdown-secs">8</span>s...</p>
      
      <div class="next-overlay-actions">
        {nextLessonHref && (
          <a href={nextLessonHref} class="btn btn-primary btn-sm" id="btn-play-next-now">
            <span>Assistir Agora</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </a>
        )}
        <button type="button" class="btn btn-ghost btn-sm" id="btn-cancel-next">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- Discreet Save Indicator (✓ Salvo) -->
  <div class="save-status-pill" id="save-status-pill" style="display: none;">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span>Progresso salvo</span>
  </div>

  <!-- Main Video Viewport (Streaming Server & PDFs/Docs) -->
  <div class="video-viewport" id="video-viewport">
    {isVideo ? (
      <div class="drive-video-wrapper">
        <video
          id="main-video-player"
          class="html5-video"
          src={videoStreamUrl}
          data-src={videoStreamUrl}
          controls
          autoplay
          playsinline
          webkit-playsinline
          controlsList="nodownload"
          title={lesson.display_title}
        ></video>
      </div>
    ) : isPdf ? (
      <div class="doc-player-wrapper">
        <iframe
          id="pdf-viewer-frame"
          class="doc-player-frame"
          src={videoStreamUrl}
          title={lesson.display_title}
        ></iframe>
      </div>
    ) : (
      <div class="doc-download-card">
        <div class="doc-icon-box">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>
        <h3 class="doc-card-title">{lesson.display_title}</h3>
        <p class="doc-card-desc">Material de apoio e documento complementar da aula.</p>
        <div class="doc-card-actions">
          <a href={videoStreamUrl} download class="btn btn-primary btn-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Baixar Arquivo ({ext.toUpperCase()})</span>
          </a>
          <a href={videoStreamUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Abrir no Navegador</a>
        </div>
      </div>
    )}

    <!-- Graceful Media Error State -->
    <div id="video-error-overlay" class="video-error-overlay" style="display: none;">
      <div class="video-error-card">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="error-icon">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <h3 class="video-error-title">Servidor Indisponível</h3>
        <p class="video-error-desc" id="video-error-desc">Não foi possível carregar o vídeo do servidor de streaming. Verifique se o servidor está ativo.</p>
        <div class="video-error-actions">
          <button type="button" class="btn btn-secondary btn-sm" id="btn-retry-video">Tentar Novamente</button>
          <button type="button" class="btn btn-primary btn-sm" id="btn-error-config-server">Configurar Servidor</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Classroom Action Bar (Lesson Navigation, Focus Mode & Mark Completed) -->
  <div class="classroom-nav-bar">
    <div class="nav-left">
      {prevLessonHref ? (
        <a href={prevLessonHref} class="btn-nav-lesson" title="Aula Anterior (Shift + P)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="btn-label-desktop">Anterior</span>
        </a>
      ) : (
        <button class="btn-nav-lesson disabled" disabled>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="btn-label-desktop">Anterior</span>
        </button>
      )}

      {nextLessonHref ? (
        <a href={nextLessonHref} class="btn-nav-lesson" id="manual-next-link" title="Próxima Aula (Shift + N)">
          <span class="btn-label-desktop">Próxima</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      ) : (
        <button class="btn-nav-lesson disabled" disabled>
          <span class="btn-label-desktop">Próxima</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      )}
    </div>

    <!-- Media Server Status & Config (Row 2 on mobile, inline on desktop) -->
    <div class="nav-middle">
      <div class="media-source-select-wrap" title="Servidor de Streaming dos Vídeos">
        <button type="button" class="btn btn-ghost btn-sm btn-server-status-pill" id="btn-config-server" title="Servidor de Streaming (Clique para ver ou alterar a URL)">
          <span class="pulse-dot-indicator pulse-testing" id="player-server-dot"></span>
          <span class="server-label" id="player-server-label">Servidor</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="server-cfg-icon">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="nav-right">
      <button type="button" class="btn btn-ghost btn-sm btn-mode" id="btn-focus-mode" title="Modo Foco Zen (C)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M3 9V5a2 2 0 0 1 2-2h4M15 3h4a2 2 0 0 1 2 2v4M21 15v4a2 2 0 0 1-2 2h-4M9 21H5a2 2 0 0 1-2-2v-4"></path>
        </svg>
        <span class="btn-label-desktop">Foco</span>
      </button>

      <!-- Mark as completed toggle button -->
      <button type="button" class="btn btn-secondary btn-complete-toggle" id="btn-toggle-complete">
        <svg class="check-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span id="complete-btn-text">Concluir</span>
      </button>
    </div>
  </div>
</div>

<script>
  import {
    getLessonProgress,
    saveLessonProgress,
    getUserPreferences,
    saveUserPreferences
  } from '../lib/progress';
  import {
    buildServerStreamUrl,
    getMediaServerUrl,
    setMediaServerUrl,
    checkServerHealth
  } from '../lib/mediaProvider';
  import { showToast } from '../lib/toast';

  const wrapper = document.getElementById('player-wrapper');
  const overlay = document.getElementById('next-lesson-overlay');
  const countdownSecs = document.getElementById('countdown-secs');
  const countdownText = document.getElementById('next-countdown-text');
  const btnCancelNext = document.getElementById('btn-cancel-next');
  const btnPlayNextNow = document.getElementById('btn-play-next-now');
  const savePill = document.getElementById('save-status-pill');
  const btnComplete = document.getElementById('btn-toggle-complete');
  const completeText = document.getElementById('complete-btn-text');
  const btnFocus = document.getElementById('btn-focus-mode');
  const btnPip = document.getElementById('btn-pip-mode');
  const errorOverlay = document.getElementById('video-error-overlay');
  const retryBtn = document.getElementById('btn-retry-video');
  const btnErrorConfigServer = document.getElementById('btn-error-config-server');
  const serverDot = document.getElementById('player-server-dot');
  const serverLabel = document.getElementById('player-server-label');

  const courseId = wrapper?.getAttribute('data-course-id') || '';
  const lessonId = wrapper?.getAttribute('data-lesson-id') || '';
  const nextHref = wrapper?.getAttribute('data-next-href') || '';
  const relPath = wrapper?.getAttribute('data-relative-path') || '';

  if (courseId && lessonId) {
    const prefs = getUserPreferences();

    async function promptConfigServer() {
      const currentUrl = getMediaServerUrl();
      const newUrl = prompt('URL do Servidor de Streaming (Cloudflare Tunnel ou IP Local):', currentUrl);
      if (newUrl !== null && newUrl.trim() !== '') {
        setMediaServerUrl(newUrl.trim());
        showToast('Testando conexão com o servidor...', 'info', 2000);
        await updateServerStatusUI();
        initPlayerSource(true);
      }
    }

    const btnConfigServer = document.getElementById('btn-config-server');
    btnConfigServer?.addEventListener('click', promptConfigServer);
    btnErrorConfigServer?.addEventListener('click', promptConfigServer);

    async function updateServerStatusUI() {
      const url = getMediaServerUrl();
      if (serverDot) serverDot.className = 'pulse-dot-indicator pulse-testing';
      if (serverLabel) serverLabel.textContent = 'Verificando...';

      const isOnline = await checkServerHealth(url);
      if (isOnline) {
        if (serverDot) serverDot.className = 'pulse-dot-indicator pulse-online';
        if (serverLabel) serverLabel.textContent = 'Servidor Online 🟢';
      } else {
        if (serverDot) serverDot.className = 'pulse-dot-indicator pulse-offline';
        if (serverLabel) serverLabel.textContent = 'Servidor Offline 🔴';
      }
      return isOnline;
    }

    let countdownInterval: any = null;

    // Attach complete playback and progression hooks to streaming server HTML5 video
    function setupHtml5Video(vid: HTMLVideoElement) {
      if ((vid as any).__mindflix_setup_done) return;
      (vid as any).__mindflix_setup_done = true;

      // 1. Resume saved position if available
      const saved = getLessonProgress(lessonId);
      if (prefs.auto_resume !== false && saved && saved.position_seconds > 5 && !saved.completed) {
        const setResumeTime = () => {
          if (!isNaN(vid.duration) && saved.position_seconds < vid.duration - 2) {
            vid.currentTime = saved.position_seconds;
          }
        };
        vid.addEventListener('loadedmetadata', setResumeTime, { once: true });
        if (vid.readyState >= 1) setResumeTime();

        const mins = Math.floor(saved.position_seconds / 60);
        const secs = Math.floor(saved.position_seconds % 60);
        showToast(`Continuando de ${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`, 'info', 2500);
      }

      // 2. Throttled progress save
      let lastSave = 0;
      const saveCurrentProgress = (completed = false) => {
        if (!vid.duration || isNaN(vid.duration)) return;
        saveLessonProgress(courseId, lessonId, vid.currentTime, vid.duration, completed);
        lastSave = Date.now();
        window.dispatchEvent(new CustomEvent('mindflix:progress-updated', {
          detail: { courseId, lessonId, completed }
        }));
        if (savePill) {
          savePill.style.display = 'flex';
          setTimeout(() => { if (savePill) savePill.style.display = 'none'; }, 1500);
        }
      };

      vid.addEventListener('seeked', () => saveCurrentProgress(false));
      vid.addEventListener('pause', () => {
        if (!hasCompleted) saveCurrentProgress(false);
      });

      // Unload safety: save exact position on page exit/navigate
      const handleUnload = () => {
        if (vid && !isNaN(vid.currentTime) && vid.duration) {
          saveLessonProgress(courseId, lessonId, vid.currentTime, vid.duration, hasCompleted || vid.currentTime / vid.duration >= 0.85);
        }
      };
      window.addEventListener('beforeunload', handleUnload);
      window.addEventListener('pagehide', handleUnload);

      // 3. Automatically mark as completed and advance to the next video when video reaches the end
      let hasCompleted = false;

      const triggerCompletionAndNext = async () => {
        if (hasCompleted) return;
        hasCompleted = true;

        const dur = (vid.duration && !isNaN(vid.duration) && vid.duration > 0) ? vid.duration : 600;
        await saveLessonProgress(courseId, lessonId, dur, dur, true);
        updateCompleteUI(true);
        window.dispatchEvent(new CustomEvent('mindflix:progress-updated', {
          detail: { courseId, lessonId, completed: true }
        }));

        if (nextHref) {
          showToast('Aula concluída! Passando para a próxima...', 'success', 3000);

          if (overlay) {
            overlay.style.display = 'flex';
            let count = 3;
            if (countdownSecs) countdownSecs.textContent = count.toString();
            if (countdownText) countdownText.innerHTML = `Iniciando em <span id="countdown-secs">${count}</span>s...`;

            clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
              count--;
              const curSecs = document.getElementById('countdown-secs');
              if (curSecs) curSecs.textContent = count.toString();
              if (count <= 0) {
                clearInterval(countdownInterval);
                window.location.href = nextHref;
              }
            }, 1000);
          } else {
            setTimeout(() => {
              window.location.href = nextHref;
            }, 1000);
          }
        } else {
          showToast('Parabéns! Você concluiu a última aula!', 'success', 4000);
        }
      };

      // Native ended event
      vid.addEventListener('ended', () => {
        triggerCompletionAndNext();
      });

      // Timeupdate: periodic save and near-end fallback safeguard
      vid.addEventListener('timeupdate', () => {
        const now = Date.now();
        if (now - lastSave > 8000) {
          saveCurrentProgress(false);
        }

        // Auto trigger completion when video is within 0.3s of the end
        if (vid.duration && vid.duration > 2 && vid.currentTime >= vid.duration - 0.3) {
          triggerCompletionAndNext();
        }
      });
    }

    async function initPlayerSource(forceReload = false) {
      if (!relPath) return;
      const serverStreamUrl = buildServerStreamUrl(relPath);
      let vid = document.getElementById('main-video-player') as HTMLVideoElement | null;

      if (!vid) {
        const viewport = document.getElementById('video-viewport');
        const wrapperDiv = viewport?.querySelector('.drive-video-wrapper') as HTMLElement | null;
        if (wrapperDiv) {
          wrapperDiv.innerHTML = `
            <video
              id="main-video-player"
              class="html5-video"
              src="${serverStreamUrl}"
              data-src="${serverStreamUrl}"
              controls
              autoplay
              playsinline
              webkit-playsinline
              controlsList="nodownload"
              title="${lessonId}"
            ></video>
          `;
          vid = wrapperDiv.querySelector('#main-video-player') as HTMLVideoElement | null;
        }
      }

      if (vid) {
        if (forceReload || vid.getAttribute('data-src') !== serverStreamUrl) {
          vid.setAttribute('data-src', serverStreamUrl);
          vid.src = serverStreamUrl;
          vid.load();
        }

        setupHtml5Video(vid);

        vid.addEventListener('error', () => {
          if (errorOverlay) errorOverlay.style.display = 'flex';
        });

        vid.addEventListener('canplay', () => {
          if (errorOverlay) errorOverlay.style.display = 'none';
        });
      }

      updateServerStatusUI();
    }

    retryBtn?.addEventListener('click', () => {
      if (errorOverlay) errorOverlay.style.display = 'none';
      initPlayerSource(true);
    });

    initPlayerSource();
    window.addEventListener('mindflix:media-server-url-changed', () => initPlayerSource(true));

    // Mark completed toggle (Shared across Video and Drive)
    const saved = getLessonProgress(lessonId);
    const updateCompleteUI = (isComplete: boolean) => {
      if (!btnComplete || !completeText) return;
      if (isComplete) {
        btnComplete.classList.add('btn-completed');
        completeText.textContent = 'Concluída ✓';
      } else {
        btnComplete.classList.remove('btn-completed');
        completeText.textContent = 'Concluir';
      }
    };

    if (saved?.completed) updateCompleteUI(true);

    btnComplete?.addEventListener('click', async () => {
      const curVid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      const isComplete = !btnComplete.classList.contains('btn-completed');
      const currentPos = curVid ? curVid.currentTime : (isComplete ? 600 : 0);
      const totalDur = curVid && curVid.duration ? curVid.duration : 600;
      await saveLessonProgress(courseId, lessonId, currentPos, totalDur, isComplete);
      updateCompleteUI(isComplete);
      window.dispatchEvent(new CustomEvent('mindflix:progress-updated', { detail: { courseId, lessonId, completed: isComplete } }));
      showToast(isComplete ? 'Aula marcada como concluída!' : 'Aula reaberta', 'success');
    });

    // Clicking "Próxima" marks the current lesson as completed before navigating to next video
    const manualNextBtn = document.getElementById('manual-next-link');
    manualNextBtn?.addEventListener('click', async (e) => {
      e.preventDefault();
      const curVid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      const currentPos = curVid && !isNaN(curVid.currentTime) ? curVid.currentTime : 600;
      const totalDur = curVid && !isNaN(curVid.duration) ? curVid.duration : 600;
      await saveLessonProgress(courseId, lessonId, currentPos, totalDur, true);
      updateCompleteUI(true);
      window.dispatchEvent(new CustomEvent('mindflix:progress-updated', { detail: { courseId, lessonId, completed: true } }));
      const href = manualNextBtn.getAttribute('href');
      if (href) window.location.href = href;
    });

    // Next lesson countdown overlay actions
    btnCancelNext?.addEventListener('click', () => {
      clearInterval(countdownInterval);
      if (overlay) overlay.style.display = 'none';
      showToast('Avanço automático cancelado', 'info', 2000);
    });

    btnPlayNextNow?.addEventListener('click', () => {
      clearInterval(countdownInterval);
    });

    // Fullscreen Toggle
    const btnFullscreen = document.getElementById('btn-fullscreen-toggle');
    btnFullscreen?.addEventListener('click', () => {
      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      } else {
        if (wrapper?.requestFullscreen) {
          wrapper.requestFullscreen().catch(() => {});
        } else if ((wrapper as any)?.webkitRequestFullscreen) {
          (wrapper as any).webkitRequestFullscreen();
        }
      }
    });

    // Picture-in-Picture Mode
    const togglePiP = async () => {
      const vid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      if (vid && document.pictureInPictureEnabled && typeof vid.requestPictureInPicture === 'function') {
        try {
          if (document.pictureInPictureElement) {
            await document.exitPictureInPicture();
            if (btnPip) btnPip.classList.remove('active');
            showToast('Saindo do Picture-in-Picture', 'info', 1500);
            return;
          } else {
            await vid.requestPictureInPicture();
            if (btnPip) btnPip.classList.add('active');
            showToast('Picture-in-Picture ativado', 'success', 1500);
            return;
          }
        } catch (e) {
          console.warn('Native PiP failed, switching to Floating Mini Player:', e);
        }
      }

      if (wrapper) {
        const isFloating = wrapper.classList.toggle('pip-floating-mini-player');
        if (btnPip) btnPip.classList.toggle('active', isFloating);

        if (isFloating) {
          showToast('Mini Player flutuante ativado', 'success', 2500);
        } else {
          showToast('Mini Player desativado', 'info', 1500);
        }
      }
    };

    btnPip?.addEventListener('click', togglePiP);

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes(target?.tagName) || target?.isContentEditable) return;
      if (document.getElementById('cmd-palette-backdrop')?.style.display === 'flex') return;

      const vid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      if (vid) {
        if (e.key === ' ' || e.key === 'k' || e.key === 'K') {
          e.preventDefault();
          vid.paused ? vid.play().catch(() => {}) : vid.pause();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          vid.currentTime = Math.max(0, vid.currentTime - 5);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          vid.currentTime = Math.min(vid.duration || 0, vid.currentTime + 5);
        } else if (e.key === 'j' || e.key === 'J') {
          e.preventDefault();
          vid.currentTime = Math.max(0, vid.currentTime - 10);
        } else if (e.key === 'l' || e.key === 'L') {
          e.preventDefault();
          vid.currentTime = Math.min(vid.duration || 0, vid.currentTime + 10);
        } else if (e.key === 'm' || e.key === 'M') {
          e.preventDefault();
          vid.muted = !vid.muted;
          showToast(vid.muted ? 'Áudio mutado' : 'Áudio ativado', 'info', 1500);
        } else if (e.key === 'f' || e.key === 'F') {
          e.preventDefault();
          if (document.fullscreenElement) {
            document.exitFullscreen().catch(() => {});
          } else {
            vid.requestFullscreen().catch(() => {});
          }
        }
      }

      if (e.key === 'c' || e.key === 'C') {
        e.preventDefault();
        btnFocus?.click();
      } else if (e.key === 'Escape' && document.body.classList.contains('focus-mode-active')) {
