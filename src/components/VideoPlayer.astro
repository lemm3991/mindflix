---
// VideoPlayer.astro - Cinema Video Player with Custom Controls, Keyboard Shortcuts, Speed Popover, and Next Lesson Auto-Advance
import type { Lesson } from '../types/catalog';
import { buildServerStreamUrl } from '../lib/mediaProvider';

interface Props {
  courseId: string;
  lesson: Lesson;
  nextLessonHref?: string;
  nextLessonTitle?: string;
  prevLessonHref?: string;
  courseTitle?: string;
  moduleTitle?: string;
  trilhaId?: string;
  trilhaTitle?: string;
  watchUrl?: string;
}

const {
  courseId,
  lesson,
  nextLessonHref,
  nextLessonTitle = 'Próxima Aula',
  prevLessonHref,
  courseTitle = '',
  moduleTitle = '',
  trilhaId = '',
  trilhaTitle = '',
  watchUrl = ''
} = Astro.props;

const relPath = lesson.relative_path || '';
const ext = (relPath || '').split('.').pop()?.toLowerCase() || '';
const isPdf = lesson.type === 'pdf' || ext === 'pdf';
const isDoc = ['docx', 'pptx', 'xlsx', 'txt', 'md', 'html'].includes(ext);
const isVideo = !isPdf && !isDoc;

const videoStreamUrl = isVideo ? buildServerStreamUrl(relPath) : '';
---

<div
  class="video-player-component"
  id="player-wrapper"
  data-course-id={courseId}
  data-lesson-id={lesson.id}
  data-next-href={nextLessonHref || ''}
  data-next-title={nextLessonTitle}
  data-relative-path={relPath}
  data-course-title={courseTitle}
  data-lesson-title={lesson.display_title}
  data-module-title={moduleTitle}
  data-trilha-id={trilhaId}
  data-trilha-title={trilhaTitle}
  data-watch-url={watchUrl}
>
  <!-- Next Lesson Countdown Overlay (Shown on Video End) -->
  <div class="next-lesson-overlay" id="next-lesson-overlay" style="display: none;">
    <div class="next-overlay-card">
      <span class="next-badge">Próxima Aula</span>
      <h3 class="next-title" id="next-overlay-title">{nextLessonTitle}</h3>
      <p class="next-countdown-text" id="next-countdown-text">Iniciando em <span id="countdown-secs">3</span>s...</p>
      
      <div class="next-overlay-actions">
        {nextLessonHref && (
          <a href={nextLessonHref} class="btn btn-primary btn-sm" id="btn-play-next-now">
            <span>Assistir Agora</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </a>
        )}
        <button type="button" class="btn btn-ghost btn-sm" id="btn-cancel-next">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- Discreet Save Indicator (✓ Salvo) -->
  <div class="save-status-pill" id="save-status-pill" style="display: none;">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span>Progresso salvo</span>
  </div>

  <!-- Main Video Viewport (Streaming Server & PDFs/Docs) -->
  <div class="video-viewport" id="video-viewport">
    {isVideo ? (
      <div class="cinema-player-container controls-visible" id="cinema-container">
        <!-- HTML5 Video Element -->
        <video
          id="main-video-player"
          class="html5-video"
          src={videoStreamUrl}
          data-src={videoStreamUrl}
          playsinline
          webkit-playsinline
          preload="metadata"
          title={lesson.display_title}
        ></video>

        <!-- Center Buffering Spinner -->
        <div class="cinema-buffer-spinner" id="player-spinner" style="display: none;">
          <div class="spinner-ring"></div>
        </div>

        <!-- Center Play/Pause Feedback Ripple -->
        <div class="center-play-feedback" id="play-feedback" style="display: none;">
          <svg class="icon-center-play" width="44" height="44" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <svg class="icon-center-pause" width="44" height="44" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
        </div>

        <!-- Double-Click Skip Visual Feedback Ripples -->
        <div class="ripple-skip ripple-left" id="ripple-left">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 19 2 12 11 5 11 19"></polygon>
            <polygon points="22 19 13 12 22 5 22 19"></polygon>
          </svg>
          <span>10s</span>
        </div>
        <div class="ripple-skip ripple-right" id="ripple-right">
          <span>10s</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="13 19 22 12 13 5 13 19"></polygon>
            <polygon points="2 19 11 12 2 5 2 19"></polygon>
          </svg>
        </div>

        <!-- Top Info Header Overlay -->
        <div class="cinema-top-overlay" id="cinema-top-bar">
          <div class="top-title-group">
            <span class="top-course-title">{courseTitle || 'MindFlix'}</span>
            <span class="top-sep">›</span>
            <span class="top-lesson-title">{lesson.display_title}</span>
          </div>
          <div class="top-badge-group">
            <span class="server-badge-pill" title="Vídeo servido diretamente pelo Servidor de Streaming MindFlix">
              <span class="badge-dot"></span>
              <span>Servidor HD</span>
            </span>
          </div>
        </div>

        <!-- Bottom Controls Bar Overlay -->
        <div class="cinema-bottom-overlay" id="cinema-bottom-bar">
          <!-- Timeline / Scrubber Bar -->
          <div class="cinema-scrubber-wrapper" id="player-scrubber-container">
            <div class="scrubber-track">
              <div class="scrubber-buffer" id="player-buffered-bar"></div>
              <div class="scrubber-progress" id="player-progress-bar">
                <div class="scrubber-thumb"></div>
              </div>
            </div>
            <div class="scrubber-tooltip" id="player-hover-tooltip" style="display: none;">00:00</div>
          </div>

          <!-- Controls Row -->
          <div class="cinema-controls-row">
            <!-- Left Controls: Play, Skip, Volume, Time -->
            <div class="controls-left">
              <button type="button" class="ctrl-btn" id="ctrl-btn-play" title="Reproduzir / Pausar (Espaço)">
                <svg class="ctrl-icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <svg class="ctrl-icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
                  <rect x="6" y="4" width="4" height="16"></rect>
                  <rect x="14" y="4" width="4" height="16"></rect>
                </svg>
              </button>

              <button type="button" class="ctrl-btn" id="ctrl-btn-backward" title="Voltar 10s (← ou J)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                  <path d="M3 3v5h5"></path>
                </svg>
                <span class="skip-sub">10</span>
              </button>

              <button type="button" class="ctrl-btn" id="ctrl-btn-forward" title="Avançar 10s (→ ou L)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 12a9 9 0 1 1-9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                  <path d="M21 3v5h-5"></path>
                </svg>
                <span class="skip-sub">10</span>
              </button>

              <!-- Volume Control -->
              <div class="ctrl-volume-group" id="ctrl-volume-container">
                <button type="button" class="ctrl-btn" id="ctrl-btn-volume" title="Mutar / Desmutar (M)">
                  <svg class="icon-vol-high" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                  </svg>
                  <svg class="icon-vol-mute" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <line x1="23" y1="9" x2="17" y2="15"></line>
                    <line x1="17" y1="9" x2="23" y2="15"></line>
                  </svg>
                </button>
                <div class="ctrl-volume-slider-wrapper">
                  <input type="range" class="ctrl-volume-slider" id="ctrl-volume-slider" min="0" max="1" step="0.05" value="1" title="Volume" />
                </div>
              </div>

              <!-- Time Display -->
              <div class="ctrl-time-display">
                <span id="player-current-time">00:00</span>
                <span class="time-sep">/</span>
                <span id="player-duration">00:00</span>
              </div>
            </div>

            <!-- Right Controls: Speed, PiP, Focus, Fullscreen -->
            <div class="controls-right">
              <!-- Playback Speed Popover -->
              <div class="speed-popover-container" id="player-speed-container">
                <button type="button" class="ctrl-btn ctrl-btn-speed" id="btn-player-speed" title="Velocidade do vídeo">
                  <span id="player-speed-label">1.0x</span>
                </button>
                <div class="speed-menu" id="player-speed-menu" style="display: none;">
                  <button type="button" class="speed-option" data-speed="0.5">0.5x</button>
                  <button type="button" class="speed-option" data-speed="0.75">0.75x</button>
                  <button type="button" class="speed-option active" data-speed="1">1.0x</button>
                  <button type="button" class="speed-option" data-speed="1.25">1.25x</button>
                  <button type="button" class="speed-option" data-speed="1.5">1.5x</button>
                  <button type="button" class="speed-option" data-speed="1.75">1.75x</button>
                  <button type="button" class="speed-option" data-speed="2">2.0x</button>
                </div>
              </div>

              <!-- PiP Mode -->
              <button type="button" class="ctrl-btn" id="btn-pip-mode" title="Picture-in-Picture (P)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                  <rect x="12" y="9" width="8" height="6" rx="1" fill="currentColor"></rect>
                </svg>
              </button>

              <!-- Focus Mode Toggle -->
              <button type="button" class="ctrl-btn" id="btn-focus-mode" title="Modo Foco Zen (C)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M3 9V5a2 2 0 0 1 2-2h4M15 3h4a2 2 0 0 1 2 2v4M21 15v4a2 2 0 0 1-2 2h-4M9 21H5a2 2 0 0 1-2-2v-4"></path>
                </svg>
              </button>

              <!-- Fullscreen Toggle -->
              <button type="button" class="ctrl-btn" id="btn-fullscreen-toggle" title="Tela Cheia (F)">
                <svg class="icon-enter-fullscreen" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
                </svg>
                <svg class="icon-exit-fullscreen" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                  <path d="M4 14h6m0 0v6m0-6L3 21m17-7h-6m0 0v6m0-6l7 7M10 4v6m0 0H4m6 0L3 3m10 7V4m0 6h6m-6 0l7-7"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    ) : isPdf ? (
      <div class="doc-player-wrapper">
        <iframe
          id="pdf-viewer-frame"
          class="doc-player-frame"
          src={videoStreamUrl}
          title={lesson.display_title}
        ></iframe>
      </div>
    ) : (
      <div class="doc-download-card">
        <div class="doc-icon-box">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>
        <h3 class="doc-card-title">{lesson.display_title}</h3>
        <p class="doc-card-desc">Material de apoio e documento complementar da aula.</p>
        <div class="doc-card-actions">
          <a href={videoStreamUrl} download class="btn btn-primary btn-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Baixar Arquivo ({ext.toUpperCase()})</span>
          </a>
          <a href={videoStreamUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Abrir no Navegador</a>
        </div>
      </div>
    )}

    <!-- Graceful Media Error State -->
    <div id="video-error-overlay" class="video-error-overlay" style="display: none;">
      <div class="video-error-card">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="error-icon">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <h3 class="video-error-title">Servidor Indisponível</h3>
        <p class="video-error-desc" id="video-error-desc">Não foi possível carregar a aula do servidor de streaming. Verifique se o servidor está ativo.</p>
        <div class="video-error-actions">
          <button type="button" class="btn btn-primary btn-sm" id="btn-retry-video">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path>
            </svg>
            <span>Reconectar ao Servidor</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Classroom Action Bar (Lesson Navigation & Mark Completed) -->
  <div class="classroom-nav-bar">
    <div class="nav-left">
      {prevLessonHref ? (
        <a href={prevLessonHref} class="btn-nav-lesson" title="Aula Anterior (Shift + P)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="btn-label-desktop">Anterior</span>
        </a>
      ) : (
        <button class="btn-nav-lesson disabled" disabled>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="btn-label-desktop">Anterior</span>
        </button>
      )}

      {nextLessonHref ? (
        <a href={nextLessonHref} class="btn-nav-lesson" id="manual-next-link" title="Próxima Aula (Shift + N)">
          <span class="btn-label-desktop">Próxima</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      ) : (
        <button class="btn-nav-lesson disabled" disabled>
          <span class="btn-label-desktop">Próxima</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      )}
    </div>

    <div class="nav-right">
      <!-- Mark as completed toggle button -->
      <button type="button" class="btn btn-secondary btn-complete-toggle" id="btn-toggle-complete">
        <svg class="check-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span id="complete-btn-text">Concluir</span>
      </button>
    </div>
  </div>
</div>

<script>
  import {
    getLessonProgress,
    saveLessonProgress,
    getUserPreferences,
    saveLastWatchedLesson,
    saveUserPreferences
  } from '../lib/progress';
  import {
    buildServerStreamUrl,
    getMediaServerUrl,
    syncMediaServerUrlWithCloud
  } from '../lib/mediaProvider';
  import { showToast } from '../lib/toast';

  const wrapper = document.getElementById('player-wrapper');
  const cinemaContainer = document.getElementById('cinema-container');
  const overlay = document.getElementById('next-lesson-overlay');
  const countdownSecs = document.getElementById('countdown-secs');
  const countdownText = document.getElementById('next-countdown-text');
  const btnCancelNext = document.getElementById('btn-cancel-next');
  const btnPlayNextNow = document.getElementById('btn-play-next-now');
  const savePill = document.getElementById('save-status-pill');
  const btnComplete = document.getElementById('btn-toggle-complete');
  const completeText = document.getElementById('complete-btn-text');
  const btnFocus = document.getElementById('btn-focus-mode');
  const btnPip = document.getElementById('btn-pip-mode');
  const errorOverlay = document.getElementById('video-error-overlay');
  const retryBtn = document.getElementById('btn-retry-video');
  const speedContainer = document.getElementById('player-speed-container');
  const btnSpeed = document.getElementById('btn-player-speed');
  const speedLabel = document.getElementById('player-speed-label');
  const speedMenu = document.getElementById('player-speed-menu');
  const btnFullscreen = document.getElementById('btn-fullscreen-toggle');
  const btnPlay = document.getElementById('ctrl-btn-play');
  const iconPlay = btnPlay?.querySelector('.ctrl-icon-play') as HTMLElement | null;
  const iconPause = btnPlay?.querySelector('.ctrl-icon-pause') as HTMLElement | null;
  const btnBackward = document.getElementById('ctrl-btn-backward');
  const btnForward = document.getElementById('ctrl-btn-forward');
  const btnVolume = document.getElementById('ctrl-btn-volume');
  const volHigh = btnVolume?.querySelector('.icon-vol-high') as HTMLElement | null;
  const volMute = btnVolume?.querySelector('.icon-vol-mute') as HTMLElement | null;
  const volumeSlider = document.getElementById('ctrl-volume-slider') as HTMLInputElement | null;
  const currentTimeEl = document.getElementById('player-current-time');
  const durationEl = document.getElementById('player-duration');
  const scrubberContainer = document.getElementById('player-scrubber-container');
  const progressBar = document.getElementById('player-progress-bar');
  const bufferedBar = document.getElementById('player-buffered-bar');
  const hoverTooltip = document.getElementById('player-hover-tooltip');
  const spinner = document.getElementById('player-spinner');
  const playFeedback = document.getElementById('play-feedback');
  const rippleLeft = document.getElementById('ripple-left');
  const rippleRight = document.getElementById('ripple-right');

  const courseId = wrapper?.getAttribute('data-course-id') || '';
  const lessonId = wrapper?.getAttribute('data-lesson-id') || '';
  const nextHref = wrapper?.getAttribute('data-next-href') || '';
  const relPath = wrapper?.getAttribute('data-relative-path') || '';
  const courseTitle = wrapper?.getAttribute('data-course-title') || '';
  const lessonTitle = wrapper?.getAttribute('data-lesson-title') || '';
  const moduleTitle = wrapper?.getAttribute('data-module-title') || '';
  const trilhaId = wrapper?.getAttribute('data-trilha-id') || '';
  const trilhaTitle = wrapper?.getAttribute('data-trilha-title') || '';
  const explicitWatchUrl = wrapper?.getAttribute('data-watch-url') || '';
  const currentWatchUrl = explicitWatchUrl || (trilhaId ? `/watch/trilha/${trilhaId}/${lessonId}` : `/watch/${courseId}/${lessonId}`);

  function formatTime(seconds: number): string {
    if (isNaN(seconds) || seconds < 0) return '00:00';
    const hrs = Math.floor(seconds / 3600);
    const mins = Math.floor((seconds % 3600) / 60);
    const secs = Math.floor(seconds % 60);
    if (hrs > 0) {
      return `${hrs}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }
    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  if (courseId && lessonId) {
    saveLastWatchedLesson({
      courseId,
      courseTitle: courseTitle || 'Curso',
      lessonId,
      lessonTitle: lessonTitle || 'Aula',
      moduleTitle: moduleTitle || undefined,
      trilhaId: trilhaId || undefined,
      trilhaTitle: trilhaTitle || undefined,
      watchUrl: currentWatchUrl
    });

    const prefs = getUserPreferences();
    let currentSpeed = prefs.playback_speed || 1.0;
    let countdownInterval: any = null;
    let hideControlsTimeout: any = null;
    let retriedWithSync = false;

    function applyPlaybackSpeed(speed: number) {
      currentSpeed = speed;
      const vid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      if (vid) vid.playbackRate = speed;
      if (speedLabel) speedLabel.textContent = `${speed}x`;
      if (speedMenu) {
        speedMenu.querySelectorAll<HTMLButtonElement>('.speed-option').forEach(opt => {
          const optSpeed = parseFloat(opt.getAttribute('data-speed') || '1');
          opt.classList.toggle('active', Math.abs(optSpeed - speed) < 0.01);
        });
      }
      saveUserPreferences({ playback_speed: speed });
    }

    function showControls() {
      if (!cinemaContainer) return;
      cinemaContainer.classList.add('controls-visible');
      cinemaContainer.classList.remove('hide-cursor');
      clearTimeout(hideControlsTimeout);
      const vid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      if (vid && !vid.paused) {
        hideControlsTimeout = setTimeout(() => {
          if (!vid.paused && !speedMenu?.style.display.includes('block')) {
            cinemaContainer.classList.remove('controls-visible');
            cinemaContainer.classList.add('hide-cursor');
          }
        }, 2500);
      }
    }

    function triggerPlayFeedback(isPlay: boolean) {
      if (!playFeedback) return;
      const iconP = playFeedback.querySelector('.icon-center-play') as HTMLElement | null;
      const iconPauseCenter = playFeedback.querySelector('.icon-center-pause') as HTMLElement | null;
      if (iconP) iconP.style.display = isPlay ? 'block' : 'none';
      if (iconPauseCenter) iconPauseCenter.style.display = isPlay ? 'none' : 'block';
      playFeedback.style.display = 'flex';
      playFeedback.classList.remove('animate-ripple');
      void playFeedback.offsetWidth; // trigger reflow
      playFeedback.classList.add('animate-ripple');
      setTimeout(() => {
        if (playFeedback) playFeedback.style.display = 'none';
      }, 550);
    }

    function triggerSkipRipple(isForward: boolean) {
      const el = isForward ? rippleRight : rippleLeft;
      if (!el) return;
      el.classList.remove('animate-skip');
      void el.offsetWidth;
      el.classList.add('animate-skip');
      setTimeout(() => {
        el.classList.remove('animate-skip');
      }, 550);
    }

    function updatePlayPauseUI(isPaused: boolean) {
      if (iconPlay) iconPlay.style.display = isPaused ? 'block' : 'none';
      if (iconPause) iconPause.style.display = isPaused ? 'none' : 'block';
    }

    function updateVolumeUI(vol: number, isMuted: boolean) {
      if (volMute) volMute.style.display = (isMuted || vol === 0) ? 'block' : 'none';
      if (volHigh) volHigh.style.display = (isMuted || vol === 0) ? 'none' : 'block';
      if (volumeSlider) volumeSlider.value = isMuted ? '0' : String(vol);
    }

    function setupHtml5Video(vid: HTMLVideoElement) {
      if ((vid as any).__mindflix_setup_done) return;
      (vid as any).__mindflix_setup_done = true;

      vid.playbackRate = currentSpeed;
      applyPlaybackSpeed(currentSpeed);

      vid.addEventListener('play', () => {
        updatePlayPauseUI(false);
        showControls();
      });

      vid.addEventListener('pause', () => {
        updatePlayPauseUI(true);
        showControls();
      });

      vid.addEventListener('waiting', () => {
        if (spinner) spinner.style.display = 'flex';
      });

      vid.addEventListener('canplay', () => {
        if (spinner) spinner.style.display = 'none';
        if (errorOverlay) errorOverlay.style.display = 'none';
      });

      vid.addEventListener('volumechange', () => {
        updateVolumeUI(vid.volume, vid.muted);
      });

      // 1. Resume saved position or URL timestamp parameter (?t=X)
      const urlParams = new URLSearchParams(window.location.search);
      const urlTimeParam = urlParams.get('t') || urlParams.get('time');
      const targetTimeFromUrl = urlTimeParam ? parseFloat(urlTimeParam) : null;

      if (targetTimeFromUrl !== null && !isNaN(targetTimeFromUrl) && targetTimeFromUrl >= 0) {
        const setUrlTime = () => {
          if (!isNaN(vid.duration) && targetTimeFromUrl <= vid.duration) {
            vid.currentTime = targetTimeFromUrl;
          } else if (targetTimeFromUrl > 0) {
            vid.currentTime = targetTimeFromUrl;
          }
        };
        vid.addEventListener('loadedmetadata', setUrlTime, { once: true });
        if (vid.readyState >= 1) setUrlTime();
        showToast(`Iniciando no tempo: ${formatTime(targetTimeFromUrl)}`, 'info', 2500);
      } else {
        const saved = getLessonProgress(lessonId);
        if (prefs.auto_resume !== false && saved && saved.position_seconds > 5 && !saved.completed) {
          const setResumeTime = () => {
            if (!isNaN(vid.duration) && saved.position_seconds < vid.duration - 2) {
              vid.currentTime = saved.position_seconds;
            }
          };
          vid.addEventListener('loadedmetadata', setResumeTime, { once: true });
          if (vid.readyState >= 1) setResumeTime();
          showToast(`Continuando de ${formatTime(saved.position_seconds)}`, 'info', 2500);
        }
      }

      // 2. Throttled progress save
      let lastSave = 0;
      const saveCurrentProgress = (completed = false) => {
        if (!vid.duration || isNaN(vid.duration)) return;
        saveLessonProgress(courseId, lessonId, vid.currentTime, vid.duration, completed);
        saveLastWatchedLesson({
          courseId,
          courseTitle: courseTitle || 'Curso',
          lessonId,
          lessonTitle: lessonTitle || 'Aula',
          moduleTitle: moduleTitle || undefined,
          trilhaId: trilhaId || undefined,
          trilhaTitle: trilhaTitle || undefined,
          watchUrl: currentWatchUrl,
          position_seconds: vid.currentTime,
          duration_seconds: vid.duration,
          percentage: Math.min(100, Math.round((vid.currentTime / vid.duration) * 100)),
          completed
        });
        lastSave = Date.now();
        window.dispatchEvent(new CustomEvent('mindflix:progress-updated', {
          detail: { courseId, lessonId, completed }
        }));
        if (savePill) {
          savePill.style.display = 'flex';
          setTimeout(() => { if (savePill) savePill.style.display = 'none'; }, 1500);
        }
      };

      vid.addEventListener('seeked', () => saveCurrentProgress(false));
      vid.addEventListener('pause', () => {
        if (!hasCompleted) saveCurrentProgress(false);
      });

      // Unload safety
      const handleUnload = () => {
        if (vid && !isNaN(vid.currentTime) && vid.duration) {
          saveLessonProgress(courseId, lessonId, vid.currentTime, vid.duration, hasCompleted || vid.currentTime / vid.duration >= 0.85);
        }
      };
      window.addEventListener('beforeunload', handleUnload);
      window.addEventListener('pagehide', handleUnload);

      // 3. Auto Completion & Advance to Next Lesson
      let hasCompleted = false;
      const triggerCompletionAndNext = async () => {
        if (hasCompleted) return;
        hasCompleted = true;

        const dur = (vid.duration && !isNaN(vid.duration) && vid.duration > 0) ? vid.duration : 600;
        await saveLessonProgress(courseId, lessonId, dur, dur, true);
        updateCompleteUI(true);
        window.dispatchEvent(new CustomEvent('mindflix:progress-updated', {
          detail: { courseId, lessonId, completed: true }
        }));

        if (nextHref) {
          showToast('Aula concluída! Passando para a próxima...', 'success', 3000);
          if (overlay) {
            overlay.style.display = 'flex';
            let count = 3;
            if (countdownSecs) countdownSecs.textContent = count.toString();
            if (countdownText) countdownText.innerHTML = `Iniciando em <span id="countdown-secs">${count}</span>s...`;

            clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
              count--;
              const curSecs = document.getElementById('countdown-secs');
              if (curSecs) curSecs.textContent = count.toString();
              if (count <= 0) {
                clearInterval(countdownInterval);
                window.location.href = nextHref;
              }
            }, 1000);
          } else {
            setTimeout(() => { window.location.href = nextHref; }, 1000);
          }
        } else {
          showToast('Parabéns! Você concluiu a última aula deste módulo!', 'success', 4000);
        }
      };

      vid.addEventListener('ended', () => {
        triggerCompletionAndNext();
      });

      // Update Time & Progress Scrubber
      vid.addEventListener('timeupdate', () => {
        if (currentTimeEl) currentTimeEl.textContent = formatTime(vid.currentTime);
        if (durationEl && !isNaN(vid.duration) && vid.duration > 0) {
          durationEl.textContent = formatTime(vid.duration);
        }
        if (progressBar && vid.duration && !isNaN(vid.duration)) {
          const pct = Math.min(100, (vid.currentTime / vid.duration) * 100);
          progressBar.style.width = `${pct}%`;
        }
        // Update loaded buffer bar
        if (bufferedBar && vid.duration && vid.buffered.length > 0) {
          try {
            const bufEnd = vid.buffered.end(vid.buffered.length - 1);
            const bufPct = Math.min(100, (bufEnd / vid.duration) * 100);
            bufferedBar.style.width = `${bufPct}%`;
          } catch {}
        }

        const now = Date.now();
        if (now - lastSave > 8000) {
          saveCurrentProgress(false);
        }

        if (vid.duration && vid.duration > 2 && vid.currentTime >= vid.duration - 0.3) {
          triggerCompletionAndNext();
        }
      });

      // Auto-recovery error listener
      vid.addEventListener('error', async () => {
        if (vid && vid.error) {
          console.warn('[MindFlix Cinema Player] Media error code:', vid.error.code, vid.error.message);
          if (!retriedWithSync) {
            retriedWithSync = true;
            try {
              const cloudUrl = await syncMediaServerUrlWithCloud();
              const newStream = buildServerStreamUrl(relPath, cloudUrl);
              if (newStream && newStream !== vid.getAttribute('data-src')) {
                console.log('[MindFlix Cinema Player] Reconnecting with active cloud tunnel:', cloudUrl);
                vid.setAttribute('data-src', newStream);
                vid.src = newStream;
                if (errorOverlay) errorOverlay.style.display = 'none';
                vid.load();
                vid.play().catch(() => {});
                return;
              }
            } catch {}
          }
          if (errorOverlay) errorOverlay.style.display = 'flex';
        }
      });
    }

    async function initPlayerSource(forceReload = false) {
      if (!relPath) return;
      const serverStreamUrl = buildServerStreamUrl(relPath);
      let vid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      const pdfFrame = document.getElementById('pdf-viewer-frame') as HTMLIFrameElement | null;

      if (pdfFrame) {
        if (forceReload || pdfFrame.getAttribute('data-src') !== serverStreamUrl) {
          pdfFrame.setAttribute('data-src', serverStreamUrl);
          pdfFrame.src = serverStreamUrl;
        }
      }

      if (vid) {
        if (forceReload || vid.getAttribute('data-src') !== serverStreamUrl) {
          vid.setAttribute('data-src', serverStreamUrl);
          vid.src = serverStreamUrl;
          if (errorOverlay && forceReload) errorOverlay.style.display = 'none';
          vid.load();
        }
        setupHtml5Video(vid);
      }
    }

    // Interactive Controls Setup
    function setupControls() {
      const vid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      if (!vid) return;

      // Click video container to play/pause
      cinemaContainer?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.cinema-bottom-overlay') || target.closest('.cinema-top-overlay') || target.closest('.speed-menu') || target.closest('.next-lesson-overlay') || target.closest('.video-error-overlay')) {
          return;
        }
        if (vid.paused) {
          vid.play().catch(() => {});
          triggerPlayFeedback(true);
        } else {
          vid.pause();
          triggerPlayFeedback(false);
        }
      });

      // Double-click left/right for +/- 10s skip
      let lastTapTime = 0;
      let lastTapX = 0;
      cinemaContainer?.addEventListener('pointerdown', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.cinema-bottom-overlay') || target.closest('.cinema-top-overlay')) return;

        const now = Date.now();
        const rect = cinemaContainer.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const isLeft = clickX < rect.width * 0.4;
        const isRight = clickX > rect.width * 0.6;

        if (now - lastTapTime < 320 && Math.abs(clickX - lastTapX) < 120) {
          if (isLeft) {
            e.preventDefault();
            vid.currentTime = Math.max(0, vid.currentTime - 10);
            triggerSkipRipple(false);
          } else if (isRight) {
            e.preventDefault();
            vid.currentTime = Math.min(vid.duration || 0, vid.currentTime + 10);
            triggerSkipRipple(true);
          }
        }
        lastTapTime = now;
        lastTapX = clickX;
      });

      // Mouse move shows controls
      cinemaContainer?.addEventListener('mousemove', showControls);
      cinemaContainer?.addEventListener('touchstart', showControls, { passive: true });

      // Play/Pause button
      btnPlay?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (vid.paused) {
          vid.play().catch(() => {});
        } else {
          vid.pause();
        }
      });

      // Skip Buttons
      btnBackward?.addEventListener('click', (e) => {
        e.stopPropagation();
        vid.currentTime = Math.max(0, vid.currentTime - 10);
        triggerSkipRipple(false);
      });

      btnForward?.addEventListener('click', (e) => {
        e.stopPropagation();
        vid.currentTime = Math.min(vid.duration || 0, vid.currentTime + 10);
        triggerSkipRipple(true);
      });

      // Volume Toggle & Slider
      btnVolume?.addEventListener('click', (e) => {
        e.stopPropagation();
        vid.muted = !vid.muted;
      });

      volumeSlider?.addEventListener('input', (e) => {
        e.stopPropagation();
        const val = parseFloat(volumeSlider.value);
        vid.volume = val;
        vid.muted = (val === 0);
      });

      // Scrubber interaction
      if (scrubberContainer) {
        let isScrubbing = false;

        const updateScrub = (clientX: number) => {
          const rect = scrubberContainer.getBoundingClientRect();
          const pos = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
          if (!isNaN(vid.duration) && vid.duration > 0) {
            vid.currentTime = pos * vid.duration;
            if (progressBar) progressBar.style.width = `${pos * 100}%`;
          }
        };

        scrubberContainer.addEventListener('mousedown', (e) => {
          isScrubbing = true;
          updateScrub(e.clientX);
        });

        scrubberContainer.addEventListener('mousemove', (e) => {
          const rect = scrubberContainer.getBoundingClientRect();
          const pos = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
          if (hoverTooltip && !isNaN(vid.duration) && vid.duration > 0) {
            hoverTooltip.style.display = 'block';
            hoverTooltip.style.left = `${pos * 100}%`;
            hoverTooltip.textContent = formatTime(pos * vid.duration);
          }
          if (isScrubbing) updateScrub(e.clientX);
        });

        scrubberContainer.addEventListener('mouseleave', () => {
          if (hoverTooltip) hoverTooltip.style.display = 'none';
        });

        window.addEventListener('mousemove', (e) => {
          if (isScrubbing) updateScrub(e.clientX);
        });

        window.addEventListener('mouseup', () => {
          if (isScrubbing) isScrubbing = false;
        });

        // Touch scrubbing
        scrubberContainer.addEventListener('touchmove', (e) => {
          if (e.touches.length > 0) {
            updateScrub(e.touches[0].clientX);
          }
        }, { passive: true });
      }

      // Speed popover
      btnSpeed?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (speedMenu) {
          speedMenu.style.display = speedMenu.style.display === 'none' ? 'flex' : 'none';
        }
      });

      speedMenu?.querySelectorAll<HTMLButtonElement>('.speed-option').forEach(opt => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const spd = parseFloat(opt.getAttribute('data-speed') || '1');
          applyPlaybackSpeed(spd);
          if (speedMenu) speedMenu.style.display = 'none';
          showToast(`Velocidade: ${spd}x`, 'info', 1500);
        });
      });

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!speedContainer?.contains(target)) {
          if (speedMenu) speedMenu.style.display = 'none';
        }
      });

      // Fullscreen
      const updateFullscreenUI = () => {
        const isFS = !!document.fullscreenElement;
        const iconEnter = btnFullscreen?.querySelector('.icon-enter-fullscreen') as HTMLElement | null;
        const iconExit = btnFullscreen?.querySelector('.icon-exit-fullscreen') as HTMLElement | null;
        if (iconEnter) iconEnter.style.display = isFS ? 'none' : 'block';
        if (iconExit) iconExit.style.display = isFS ? 'block' : 'none';
      };

      btnFullscreen?.addEventListener('click', () => {
        if (document.fullscreenElement) {
          document.exitFullscreen().catch(() => {});
        } else {
          if (cinemaContainer?.requestFullscreen) {
            cinemaContainer.requestFullscreen().catch(() => {});
          } else if (wrapper?.requestFullscreen) {
            wrapper.requestFullscreen().catch(() => {});
          }
        }
      });
      document.addEventListener('fullscreenchange', updateFullscreenUI);

      // PiP
      btnPip?.addEventListener('click', async () => {
        if (document.pictureInPictureElement) {
          await document.exitPictureInPicture().catch(() => {});
        } else if (document.pictureInPictureEnabled && typeof vid.requestPictureInPicture === 'function') {
          await vid.requestPictureInPicture().catch(() => {});
        } else {
          showToast('Picture-in-Picture não suportado neste navegador', 'warning');
        }
      });

      // Focus Mode toggle
      btnFocus?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('mindflix:toggle-focus-mode'));
      });
    }

    // Retry reconnect button
    retryBtn?.addEventListener('click', async () => {
      if (errorOverlay) errorOverlay.style.display = 'none';
      showToast('Reconectando ao servidor de streaming...', 'info', 2000);
      retriedWithSync = false;
      await syncMediaServerUrlWithCloud();
      initPlayerSource(true);
    });

    btnCancelNext?.addEventListener('click', () => {
      clearInterval(countdownInterval);
      if (overlay) overlay.style.display = 'none';
    });

    btnPlayNextNow?.addEventListener('click', () => {
      clearInterval(countdownInterval);
    });

    // Mark completed toggle
    const saved = getLessonProgress(lessonId);
    const updateCompleteUI = (isComplete: boolean) => {
      if (!btnComplete || !completeText) return;
      if (isComplete) {
        btnComplete.classList.add('btn-completed');
        completeText.textContent = 'Concluída ✓';
      } else {
        btnComplete.classList.remove('btn-completed');
        completeText.textContent = 'Concluir';
      }
    };

    if (saved?.completed) updateCompleteUI(true);

    btnComplete?.addEventListener('click', async () => {
      const curVid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      const isComplete = !btnComplete.classList.contains('btn-completed');
      const currentPos = curVid ? curVid.currentTime : (isComplete ? 600 : 0);
      const totalDur = curVid && curVid.duration ? curVid.duration : 600;
      await saveLessonProgress(courseId, lessonId, currentPos, totalDur, isComplete);
      updateCompleteUI(isComplete);
      window.dispatchEvent(new CustomEvent('mindflix:progress-updated', { detail: { courseId, lessonId, completed: isComplete } }));
      showToast(isComplete ? 'Aula marcada como concluída!' : 'Aula reaberta', 'success');
    });

    // Manual Next link
    const manualNextBtn = document.getElementById('manual-next-link');
    manualNextBtn?.addEventListener('click', async (e) => {
      e.preventDefault();
      const curVid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      const currentPos = curVid && !isNaN(curVid.currentTime) ? curVid.currentTime : 600;
      const totalDur = curVid && !isNaN(curVid.duration) ? curVid.duration : 600;
      await saveLessonProgress(courseId, lessonId, currentPos, totalDur, true);
      updateCompleteUI(true);
      window.location.href = nextHref;
    });

    // Global Classroom Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes(target?.tagName) || target?.isContentEditable) return;
      if (document.getElementById('cmd-palette-backdrop')?.style.display === 'flex') return;

      const vid = document.getElementById('main-video-player') as HTMLVideoElement | null;
      if (vid) {
        if (e.key === ' ' || e.key === 'k' || e.key === 'K') {
          e.preventDefault();
          if (vid.paused) {
            vid.play().catch(() => {});
            triggerPlayFeedback(true);
          } else {
            vid.pause();
            triggerPlayFeedback(false);
          }
        } else if (e.key === 'ArrowLeft' || e.key === 'j' || e.key === 'J') {
          e.preventDefault();
          vid.currentTime = Math.max(0, vid.currentTime - 10);
          triggerSkipRipple(false);
        } else if (e.key === 'ArrowRight' || e.key === 'l' || e.key === 'L') {
          e.preventDefault();
          vid.currentTime = Math.min(vid.duration || 0, vid.currentTime + 10);
          triggerSkipRipple(true);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          vid.volume = Math.min(1, vid.volume + 0.1);
          vid.muted = false;
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          vid.volume = Math.max(0, vid.volume - 0.1);
        } else if (e.key === 'm' || e.key === 'M') {
          e.preventDefault();
          vid.muted = !vid.muted;
          showToast(vid.muted ? 'Áudio mutado' : 'Áudio ativado', 'info', 1500);
        } else if (e.key === 'f' || e.key === 'F') {
          e.preventDefault();
          btnFullscreen?.click();
        } else if (e.key === 'p' || e.key === 'P') {
          e.preventDefault();
          btnPip?.click();
        } else if (e.key >= '0' && e.key <= '9') {
          e.preventDefault();
          if (vid.duration) {
            const frac = parseInt(e.key) / 10;
            vid.currentTime = frac * vid.duration;
            showToast(`Saltou para ${parseInt(e.key) * 10}%`, 'info', 1200);
          }
        }
      }

      if (e.key === 'c' || e.key === 'C') {
        e.preventDefault();
        btnFocus?.click();
      }
    });

    // 1. Inicia o player com o endereço do servidor
    const clientServerUrl = getMediaServerUrl();
    const currentStream = buildServerStreamUrl(relPath, clientServerUrl);
    const initialVid = document.getElementById('main-video-player') as HTMLVideoElement | null;
    if (initialVid && currentStream && initialVid.getAttribute('data-src') !== currentStream) {
      initialVid.setAttribute('data-src', currentStream);
      initialVid.src = currentStream;
      initialVid.load();
    }
    initPlayerSource();
    setupControls();

    // 2. Sincroniza em segundo plano com a nuvem (Supabase)
    syncMediaServerUrlWithCloud().then((cloudUrl) => {
      if (cloudUrl) {
        const syncedStream = buildServerStreamUrl(relPath, cloudUrl);
        const curVid = document.getElementById('main-video-player') as HTMLVideoElement | null;
        if (curVid && syncedStream && curVid.getAttribute('data-src') !== syncedStream) {
          console.log('[MindFlix Cinema Player] Upgrading video src with active cloud tunnel:', cloudUrl);
          curVid.setAttribute('data-src', syncedStream);
          curVid.src = syncedStream;
          if (errorOverlay) errorOverlay.style.display = 'none';
          curVid.load();
        }
      }
    }).catch(() => {});

    // 3. Atualiza automaticamente se o link for alterado em outra aba
    window.addEventListener('mindflix:media-server-url-changed', () => {
      retriedWithSync = false;
      initPlayerSource(true);
    });
  }
</script>

<style>
  .video-player-component {
    position: relative;
    width: 100%;
    background: #000000;
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.7);
  }

  .video-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000000;
    overflow: hidden;
  }

  /* Cinema Container */
  .cinema-player-container {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000000;
    overflow: hidden;
    cursor: default;
    user-select: none;
  }

  .cinema-player-container.hide-cursor {
    cursor: none;
  }

  .html5-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000000;
    display: block;
  }

  /* Buffer Spinner */
  .cinema-buffer-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 20;
    background: rgba(0, 0, 0, 0.35);
  }

  .spinner-ring {
    width: 52px;
    height: 52px;
    border: 4px solid rgba(255, 255, 255, 0.15);
    border-top-color: #ef4444;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Center Play/Pause Feedback Ripple */
  .center-play-feedback {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.6);
    width: 74px;
    height: 74px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 25;
    opacity: 0;
  }

  .center-play-feedback.animate-ripple {
    animation: playRipple 0.5s ease-out forwards;
  }

  @keyframes playRipple {
    0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0; }
    50% { transform: translate(-50%, -50%) scale(1.1); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(1.3); opacity: 0; }
  }

  /* Double-Click Skip Ripples */
  .ripple-skip {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 35%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 700;
    pointer-events: none;
    z-index: 25;
    opacity: 0;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  }

  .ripple-left { left: 0; }
  .ripple-right { right: 0; }

  .ripple-skip.animate-skip {
    animation: skipRipple 0.5s ease-out forwards;
  }

