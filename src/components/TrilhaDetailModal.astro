    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  :global(.trilha-stage-top) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  :global(.trilha-stage-badge) {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
  }

  :global(.trilha-stage-title) {
    font-size: 0.925rem;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.trilha-stage-meta) {
    font-size: 0.775rem;
    color: var(--text-muted, #94a3b8);
  }

  :global(.trilha-stage-action) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--accent-cyan, #00f2fe);
    flex-shrink: 0;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-pill);
