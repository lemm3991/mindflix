---
// TrilhaDetailModal.astro - Glassmorphism Modal de Detalhes da Trilha com Sequência Completa de Cursos
import { getAllTrilhas, getTrilhaFullStructure } from '../lib/trilhas';

const trilhas = getAllTrilhas();
const trilhasWithStructure = trilhas.map(t => {
  const struct = getTrilhaFullStructure(t.id);
  return {
    ...t,
    allLessons: struct?.allLessons || []
  };
});
const trilhasJsonSafe = JSON.stringify(trilhasWithStructure).replace(/</g, '\\u003c');
---

<!-- JSON Payload for safe client script execution -->
<script is:inline type="application/json" id="mindflix-trilhas-json" set:html={trilhasJsonSafe}></script>

<!-- Global Trilha Detail Glassmorphism Modal -->
<div id="trilha-detail-modal-backdrop" class="trilha-modal-backdrop" style="display: none;" aria-hidden="true">
    <div class="trilha-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-trilha-title">
      
      <!-- Top Close Button -->
      <button type="button" class="modal-close-btn" id="trilha-modal-close-btn" aria-label="Fechar modal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Scrollable Modal Content -->
      <div class="modal-scroll-body" id="trilha-modal-scroll-body">
        
        <!-- Hero Header Section -->
        <div class="modal-hero">
          <div class="modal-hero-cover-wrap">
            <img id="modal-trilha-cover-img" class="modal-cover-img" src="" alt="" style="display: none;" />
            <div class="modal-cover-gradient" id="modal-trilha-cover-gradient"></div>
            <div class="modal-cover-overlay"></div>
          </div>

          <div class="modal-hero-content">
            <div class="modal-badges-row">
              <span class="provider-pill" id="modal-trilha-provider">AI LAB</span>
              <span class="badge badge-cyan">Trilha de Formação</span>
              <span class="badge" id="modal-trilha-courses-count">0 Cursos</span>
              <span class="badge" id="modal-trilha-lessons-count">0 Aulas</span>
              <span class="badge" id="modal-trilha-duration">0h</span>
              <button type="button" class="modal-fav-btn" id="modal-trilha-fav-btn" aria-label="Favoritar trilha">
                <svg class="heart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
            </div>

            <h2 class="modal-trilha-title" id="modal-trilha-title">Título da Trilha</h2>
            
            <p class="modal-trilha-desc" id="modal-trilha-desc">Descrição completa da trilha de formação...</p>

            <!-- Progress Bar Section -->
            <div class="modal-progress-card" id="modal-trilha-progress-card" style="display: none;">
              <div class="modal-progress-info">
                <span class="progress-label">Seu Progresso na Trilha:</span>
                <strong class="progress-pct" id="modal-trilha-progress-pct">0% concluído</strong>
              </div>
              <div class="modal-progress-track">
                <div class="modal-progress-fill" id="modal-trilha-progress-fill" style="width: 0%;"></div>
              </div>
            </div>

            <!-- CTA Watch Row -->
            <div class="modal-cta-row">
              <a href="#" class="btn btn-primary modal-play-btn" id="modal-trilha-play-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span id="modal-trilha-play-btn-text">Iniciar Trilha</span>
              </a>
              <span class="modal-next-lesson-hint" id="modal-trilha-next-hint"></span>
            </div>
          </div>
        </div>

        <!-- Curriculum / Sequência Completa de Cursos -->
        <div class="modal-curriculum-section">
          <div class="curriculum-header">
            <div class="curriculum-title-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
              </svg>
              <h3>Sequência Cronológica da Trilha</h3>
            </div>
            <span class="curriculum-meta" id="modal-trilha-meta">Etapas estruturadas do básico ao avançado</span>
          </div>

          <!-- Courses Sequence List -->
          <div class="trilha-courses-list" id="modal-trilha-courses-list"></div>
        </div>

      </div>
    </div>
  </div>

<style>
  /* --- Backdrop with background blur --- */
  .trilha-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(4, 6, 11, 0.78);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .trilha-modal-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* --- Glassmorphism Dialog --- */
  .trilha-modal-dialog {
    position: relative;
    width: 100%;
    max-width: 880px;
    max-height: 88vh;
    background: rgba(15, 20, 30, 0.9);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xl, 16px);
    box-shadow: 0 32px 64px -12px rgba(0, 0, 0, 0.85),
                0 0 40px rgba(0, 242, 254, 0.12),
                inset 0 1px 1px rgba(255, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.95) translateY(10px);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .trilha-modal-backdrop.active .trilha-modal-dialog {
    transform: scale(1) translateY(0);
  }

  /* --- Close Button --- */
  .modal-close-btn {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(8, 12, 20, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-secondary, #cbd5e1);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 20;
    transition: all 0.2s ease;
  }

  .modal-close-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    transform: scale(1.08);
  }

  /* --- Scroll Body --- */
  .modal-scroll-body {
    overflow-y: auto;
    padding-bottom: 2.5rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
  }

  /* --- Modal Hero --- */
  .modal-hero {
    position: relative;
    padding: 2rem 2rem 1.5rem 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .modal-hero-cover-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .modal-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
    filter: blur(2px);
    transform: scale(1.05);
  }

  .modal-cover-gradient {
    position: absolute;
    inset: 0;
    opacity: 0.22;
  }

  .modal-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 20, 30, 0.4) 0%, rgba(15, 20, 30, 0.95) 85%, rgba(15, 20, 30, 1) 100%);
  }

  .modal-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 720px;
  }

  .modal-badges-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .provider-pill {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill, 9999px);
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan, #00f2fe);
  }

  .badge {
    font-size: 0.725rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill, 9999px);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-secondary, #cbd5e1);
  }

  .badge-cyan {
    background: rgba(0, 242, 254, 0.1);
    color: var(--accent-cyan, #00f2fe);
    border-color: rgba(0, 242, 254, 0.25);
  }

  .modal-fav-btn {
    margin-left: auto;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-secondary, #cbd5e1);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .modal-fav-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    transform: scale(1.1);
  }

  .modal-fav-btn.active {
    color: #ff3366;
    border-color: rgba(255, 51, 102, 0.4);
    background: rgba(255, 51, 102, 0.15);
  }

  .modal-trilha-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .modal-trilha-desc {
    font-size: 0.925rem;
    color: var(--text-secondary, #cbd5e1);
    line-height: 1.6;
    margin: 0;
  }

  /* Progress Bar */
  .modal-progress-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md, 8px);
    padding: 0.85rem 1.15rem;
  }

  .modal-progress-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.825rem;
    margin-bottom: 0.5rem;
  }

  .progress-label {
    color: var(--text-muted, #94a3b8);
  }

  .progress-pct {
    color: var(--accent-cyan, #00f2fe);
    font-weight: 700;
  }

  .modal-progress-track {
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
  }

  .modal-progress-fill {
    height: 100%;
    background: var(--grad-primary, linear-gradient(135deg, #00f2fe 0%, #4facfe 100%));
    border-radius: 9999px;
    box-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
    transition: width 0.3s ease;
  }

  /* CTA Row */
  .modal-cta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .modal-play-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: var(--radius-md, 8px);
    background: var(--grad-primary, linear-gradient(135deg, #00f2fe 0%, #4facfe 100%));
    color: #0b0d13;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(0, 242, 254, 0.35);
    transition: all 0.2s ease;
  }

  .modal-play-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 242, 254, 0.5);
  }

  .modal-next-lesson-hint {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
  }

  /* Curriculum Section */
  .modal-curriculum-section {
    padding: 1.75rem 2rem 0 2rem;
  }

  .curriculum-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .curriculum-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent-cyan, #00f2fe);
  }

  .curriculum-title-wrap h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .curriculum-meta {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
  }

  /* Trilha Courses Sequence List */
  .trilha-courses-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.trilha-stage-item) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: rgba(18, 24, 38, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md, 10px);
    transition: all 0.2s ease;
    text-decoration: none;
    color: inherit;
  }

  :global(.trilha-stage-item:hover) {
    background: rgba(22, 29, 46, 0.85);
    border-color: rgba(0, 242, 254, 0.3);
    transform: translateX(4px);
  }

  :global(.trilha-stage-num) {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(0, 242, 254, 0.1);
    color: var(--accent-cyan, #00f2fe);
    font-size: 0.85rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  :global(.trilha-stage-thumb) {
    width: 68px;
    height: 38px;
    border-radius: 6px;
    object-fit: cover;
    background: #0f131c;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.trilha-stage-info) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  :global(.trilha-stage-top) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  :global(.trilha-stage-badge) {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
  }

  :global(.trilha-stage-title) {
    font-size: 0.925rem;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.trilha-stage-meta) {
    font-size: 0.775rem;
    color: var(--text-muted, #94a3b8);
  }

  :global(.trilha-stage-action) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--accent-cyan, #00f2fe);
    flex-shrink: 0;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-pill);
    background: rgba(0, 242, 254, 0.08);
    transition: all 0.2s ease;
  }

  :global(.trilha-stage-item:hover .trilha-stage-action) {
    background: var(--accent-cyan, #00f2fe);
    color: #0b0d13;
  }

  @media (max-width: 768px) {
    .modal-hero {
      padding: 1.5rem 1.25rem;
    }
    .modal-trilha-title {
      font-size: 1.4rem;
    }
    .modal-curriculum-section {
      padding: 1.25rem 1.25rem 0;
    }
    :global(.trilha-stage-thumb) {
      display: none;
    }
  }
</style>

<script is:inline>
  (function() {
    function getLoadedTrilhas() {
      try {
        var el = document.getElementById('mindflix-trilhas-json');
        if (el && el.textContent) {
          return JSON.parse(el.textContent);
        }
      } catch (e) {}
      return [];
    }

    var allTrilhas = [];

    function getAllProgress() {
      try {
        var user = localStorage.getItem('mindflix_user');
        var uId = user ? JSON.parse(user).id : null;
        var key = uId ? 'mindflix_progress_' + uId : 'mindflix_progress';
        var userProg = JSON.parse(localStorage.getItem(key) || '{}');
        var globalProg = JSON.parse(localStorage.getItem('mindflix_progress') || '{}');
        var permProg = JSON.parse(localStorage.getItem('mindflix_progress_permanent') || '{}');
        var merged = Object.assign({}, permProg, globalProg, userProg);
        for (var k in permProg) { if (permProg[k] && permProg[k].completed && merged[k]) merged[k].completed = true; }
        for (var g in globalProg) { if (globalProg[g] && globalProg[g].completed && merged[g]) merged[g].completed = true; }
        return merged;
      } catch (e) {
        return {};
      }
    }

    function getFavorites() {
      try {
        var user = localStorage.getItem('mindflix_user');
        var uId = user ? JSON.parse(user).id : null;
        var key = uId ? 'mindflix_favorites_' + uId : 'mindflix_favorites';
        var list = JSON.parse(localStorage.getItem(key) || localStorage.getItem('mindflix_favorites') || '[]');
        return Array.isArray(list) ? list : [];
      } catch (e) {
        return [];
      }
    }

    function saveFavorites(list) {
      try {
        var user = localStorage.getItem('mindflix_user');
        var uId = user ? JSON.parse(user).id : null;
        var key = uId ? 'mindflix_favorites_' + uId : 'mindflix_favorites';
        var json = JSON.stringify(list);
        localStorage.setItem(key, json);
        localStorage.setItem('mindflix_favorites', json);
      } catch (e) {}
    }

    var activeTrilhaId = null;

    var hues = [
      'linear-gradient(135deg, #0f2027, #203a43, #2c5364)',
      'linear-gradient(135deg, #1f1c2c, #4a475a)',
      'linear-gradient(135deg, #141e30, #243b55)',
      'linear-gradient(135deg, #0f0c29, #302b63, #24243e)',
      'linear-gradient(135deg, #16222f, #1a365d)',
      'linear-gradient(135deg, #1a1c29, #2d3748)',
      'linear-gradient(135deg, #1e1b4b, #312e81)',
      'linear-gradient(135deg, #064e3b, #047857)',
      'linear-gradient(135deg, #4a0e2e, #831843)'
    ];

    function openModal(trilhaId) {
      if (!allTrilhas || allTrilhas.length === 0) {
        allTrilhas = getLoadedTrilhas();
      }
      var trilha = allTrilhas.find(function(t) { return t.id === trilhaId || t.slug === trilhaId; });
      if (!trilha) {
        allTrilhas = getLoadedTrilhas();
        trilha = allTrilhas.find(function(t) { return t.id === trilhaId || t.slug === trilhaId; });
      }
      var backdrop = document.getElementById('trilha-detail-modal-backdrop');
      if (!trilha || !backdrop) return;

      activeTrilhaId = trilha.id;

      // 1. Metadata
      var titleEl = document.getElementById('modal-trilha-title');
      var descEl = document.getElementById('modal-trilha-desc');
      var providerEl = document.getElementById('modal-trilha-provider');
      var coursesCountEl = document.getElementById('modal-trilha-courses-count');
      var lessonsCountEl = document.getElementById('modal-trilha-lessons-count');
      var durationEl = document.getElementById('modal-trilha-duration');
      var coverImg = document.getElementById('modal-trilha-cover-img');
      var coverGrad = document.getElementById('modal-trilha-cover-gradient');
      var favBtn = document.getElementById('modal-trilha-fav-btn');
      var playBtn = document.getElementById('modal-trilha-play-btn');
      var playBtnText = document.getElementById('modal-trilha-play-btn-text');
      var nextHint = document.getElementById('modal-trilha-next-hint');
      var progressCard = document.getElementById('modal-trilha-progress-card');
      var progressPct = document.getElementById('modal-trilha-progress-pct');
      var progressFill = document.getElementById('modal-trilha-progress-fill');
      var coursesList = document.getElementById('modal-trilha-courses-list');

      if (titleEl) titleEl.textContent = trilha.title;
      if (descEl) descEl.textContent = trilha.description || '';
      if (providerEl) providerEl.textContent = trilha.provider || trilha.target_audience || 'AI LAB';
      if (coursesCountEl) coursesCountEl.textContent = (trilha.total_cursos || (trilha.courses ? trilha.courses.length : 0)) + ' Cursos';
      if (lessonsCountEl) lessonsCountEl.textContent = (trilha.total_lessons_count || trilha.total_lessons || (trilha.allLessons ? trilha.allLessons.length : 0)) + ' Aulas';
      if (durationEl) durationEl.textContent = trilha.total_duration_formatted || trilha.total_hours_formatted || (trilha.estimated_hours ? trilha.estimated_hours + 'h' : '10h');

      // 2. Cover / Gradient
      if (trilha.cover_image && coverImg) {
        coverImg.src = trilha.cover_image;
        coverImg.style.display = 'block';
        if (coverGrad) coverGrad.style.display = 'none';
      } else {
        if (coverImg) coverImg.style.display = 'none';
        if (coverGrad) {
          var hash = 0;
          for (var i = 0; i < trilha.id.length; i++) hash = trilha.id.charCodeAt(i) + ((hash << 5) - hash);
          coverGrad.style.background = hues[Math.abs(hash) % hues.length];
          coverGrad.style.display = 'block';
        }
      }

      // 3. Progress & Smart Resume
      var allProg = getAllProgress();
      var allLessons = trilha.allLessons || [];
      var completedCount = allLessons.filter(function(l) { return allProg[l.id] && allProg[l.id].completed; }).length;
      var hasStarted = allLessons.some(function(l) {
        var p = allProg[l.id];
        return p && (p.completed || p.percentage > 0 || p.position_seconds > 0);
      });

      var totalLessons = allLessons.length || trilha.total_lessons_count || trilha.total_lessons || 1;
      var pct = Math.min(100, Math.round((completedCount / totalLessons) * 100));

      if (pct > 0 && progressCard) {
        progressCard.style.display = 'block';
        if (progressPct) progressPct.textContent = pct + '% concluído (' + completedCount + '/' + totalLessons + ' aulas)';
        if (progressFill) progressFill.style.width = pct + '%';
      } else if (progressCard) {
        progressCard.style.display = 'none';
      }

      // Next uncompleted lesson
      var nextLesson = allLessons.find(function(l) { return !allProg[l.id] || !allProg[l.id].completed; }) || allLessons[0];
      if (playBtn && nextLesson) {
        playBtn.href = '/watch/' + nextLesson.course_id + '/' + nextLesson.id + '?trilha=' + trilha.id;
      }
      if (playBtnText) {
        playBtnText.textContent = hasStarted ? 'Continuar assistindo' : 'Iniciar Trilha';
      }
      if (nextHint) {
        nextHint.textContent = (hasStarted && nextLesson) ? ('Próximo: ' + (nextLesson.title || '')) : '';
      }

      // 4. Favorite State
      var favs = getFavorites();
      var isFav = favs.indexOf(trilha.id) !== -1;
      if (favBtn) {
        if (isFav) {
          favBtn.classList.add('active');
          favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
        } else {
          favBtn.classList.remove('active');
          favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'none');
        }
      }

      // 5. Render Courses List
      if (coursesList) {
        coursesList.innerHTML = '';
        var stages = trilha.courses || trilha.stages || [];
        // If stages not provided, create from course_ids or allLessons
        if (stages.length === 0 && trilha.course_ids) {
          stages = trilha.course_ids.map(function(cid, idx) {
            return {
              step: idx + 1,
              title: cid,
              course_id: cid
            };
          });
        }

        stages.forEach(function(stg, sIdx) {
          var stageCourseId = stg.course_id || stg.id || '';
          var stageTitle = stg.course_title || stg.title || stageCourseId;
          var stageLessons = allLessons.filter(function(l) { return l.course_id === stageCourseId; });
          var stageComp = stageLessons.filter(function(l) { return allProg[l.id] && allProg[l.id].completed; }).length;
          var nextStageLesson = stageLessons.find(function(l) { return !allProg[l.id] || !allProg[l.id].completed; }) || stageLessons[0];
          var stageUrl = nextStageLesson ? ('/watch/' + stageCourseId + '/' + nextStageLesson.id + '?trilha=' + trilha.id) : ('/courses#' + stageCourseId);
          var stageCover = stg.cover_image ? ('<img src="' + stg.cover_image + '" class="trilha-stage-thumb" alt="" />') : '';

          var item = document.createElement('a');
          item.href = stageUrl;
          item.className = 'trilha-stage-item';
          item.innerHTML = '<div class="trilha-stage-num">' + (stg.ordem || stg.step || (sIdx + 1)) + '</div>' +
            stageCover +
            '<div class="trilha-stage-info">' +
              '<div class="trilha-stage-top">' +
                '<span class="trilha-stage-badge">Etapa ' + (stg.ordem || stg.step || (sIdx + 1)) + '</span>' +
                (stg.tipo ? ('<span class="trilha-stage-badge">' + stg.tipo + '</span>') : '') +
                (stageComp > 0 ? ('<span class="trilha-stage-badge" style="color:var(--accent-emerald,#10b981);">' + stageComp + '/' + (stg.lessons_count || stageLessons.length) + ' concluídas</span>') : '') +
              '</div>' +
              '<div class="trilha-stage-title">' + stageTitle + '</div>' +
              '<div class="trilha-stage-meta">' + (stg.lessons_count || stageLessons.length) + ' aulas' + (stg.total_duration_formatted ? (' • ' + stg.total_duration_formatted) : '') + '</div>' +
            '</div>' +
            '<div class="trilha-stage-action">' +
              '<span>Acessar</span>' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>' +
            '</div>';

          coursesList.appendChild(item);
        });
      }

      // 6. Show modal
      backdrop.style.display = 'flex';
      requestAnimationFrame(function() {
        backdrop.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    }

    function closeModal() {
      var backdrop = document.getElementById('trilha-detail-modal-backdrop');
      if (!backdrop) return;
      backdrop.classList.remove('active');
      setTimeout(function() {
        backdrop.style.display = 'none';
        document.body.style.overflow = '';
        activeTrilhaId = null;
      }, 250);
    }

    window.openTrilhaModal = openModal;
    window.closeTrilhaModal = closeModal;

    document.addEventListener('open-trilha-modal', function(e) {
      if (e.detail && e.detail.trilhaId) openModal(e.detail.trilhaId);
    });

    function bindEvents() {
      var closeBtn = document.getElementById('trilha-modal-close-btn');
      var backdrop = document.getElementById('trilha-detail-modal-backdrop');
      var favBtn = document.getElementById('modal-trilha-fav-btn');

      if (closeBtn) {
        closeBtn.onclick = closeModal;
      }
      if (backdrop) {
        backdrop.onclick = function(e) {
          if (e.target === backdrop) closeModal();
        };
      }
      if (favBtn) {
        favBtn.onclick = function(e) {
          e.preventDefault();
          if (!activeTrilhaId) return;
          var favs = getFavorites();
          var idx = favs.indexOf(activeTrilhaId);
          var isFav = false;
          if (idx === -1) {
            favs.push(activeTrilhaId);
            isFav = true;
          } else {
            favs.splice(idx, 1);
            isFav = false;
          }
          saveFavorites(favs);
          if (isFav) {
            favBtn.classList.add('active');
            favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
          } else {
            favBtn.classList.remove('active');
            favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'none');
          }
          var pageFav = document.querySelector('[data-fav-id="' + activeTrilhaId + '"]');
          if (pageFav) {
            if (isFav) {
              pageFav.classList.add('active');
              pageFav.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
            } else {
              pageFav.classList.remove('active');
              pageFav.querySelector('.heart-icon')?.setAttribute('fill', 'none');
            }
          }
          window.dispatchEvent(new CustomEvent('mindflix:favorites-changed'));
        };
      }
    }

    document.addEventListener('keydown', function(e) {
      var backdrop = document.getElementById('trilha-detail-modal-backdrop');
      if (e.key === 'Escape' && backdrop && backdrop.classList.contains('active')) {
        closeModal();
      }
    });

    // Delegated click listener for trilha cards
    document.addEventListener('click', function(e) {
      var target = e.target;
      if (!target) return;
      if (target.closest('[data-action="favorite"]')) return;
      if (target.closest('.modal-close-btn') || target.closest('#trilha-modal-close-btn')) return;
      if (target.closest('.modal-scroll-body')) return;

      var card = target.closest('.trilha-card, .trilha-card-wrapper');
      if (card) {
        var trilhaId = card.getAttribute('data-trilha-id') || (card.closest('[data-trilha-id]') ? card.closest('[data-trilha-id]').getAttribute('data-trilha-id') : null);
        if (trilhaId) {
          e.preventDefault();
          openModal(trilhaId);
        }
      }
    });

    document.addEventListener('astro:page-load', bindEvents);
    bindEvents();
  })();
</script>
