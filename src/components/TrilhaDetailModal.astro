---
// TrilhaDetailModal.astro - Glassmorphism Modal de Detalhes da Trilha com Sequência Completa de Cursos
import { getAllTrilhas, getTrilhaFullStructure } from '../lib/trilhas';

const trilhas = getAllTrilhas();
const trilhasWithStructure = trilhas.map(t => {
  const struct = getTrilhaFullStructure(t.id);
  return {
    ...t,
    allLessons: struct?.allLessons || []
  };
});
---

<!-- JSON Payload for safe client script execution -->
<script type="application/json" id="mindflix-trilhas-json" set:html={JSON.stringify(trilhasWithStructure)}></script>

<!-- Global Trilha Detail Glassmorphism Modal -->
<div id="trilha-detail-modal-backdrop" class="trilha-modal-backdrop" style="display: none;" aria-hidden="true">
  <div class="trilha-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-trilha-title">
    
    <!-- Top Close Button -->
    <button type="button" class="modal-close-btn" id="trilha-modal-close-btn" aria-label="Fechar modal">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Scrollable Modal Content -->
    <div class="modal-scroll-body" id="trilha-modal-scroll-body">
      
      <!-- Hero Header Section -->
      <div class="modal-hero">
        <div class="modal-hero-cover-wrap">
          <img id="modal-trilha-cover-img" class="modal-cover-img" src="" alt="" style="display: none;" />
          <div class="modal-cover-gradient" id="modal-trilha-cover-gradient"></div>
          <div class="modal-cover-overlay"></div>
        </div>

        <div class="modal-hero-content">
          <div class="modal-badges-row">
            <span class="provider-pill" id="modal-trilha-provider">AI LAB</span>
            <span class="badge badge-cyan">Trilha de Formação</span>
            <span class="badge" id="modal-trilha-courses-count">0 Cursos</span>
            <span class="badge" id="modal-trilha-lessons-count">0 Aulas</span>
            <span class="badge" id="modal-trilha-duration">0h</span>
            <button type="button" class="modal-fav-btn" id="modal-trilha-fav-btn" aria-label="Favoritar trilha">
              <svg class="heart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
          </div>

          <h2 class="modal-trilha-title" id="modal-trilha-title">Título da Trilha</h2>
          
          <p class="modal-trilha-desc" id="modal-trilha-desc">Descrição completa da trilha de formação...</p>

          <!-- Progress Bar Section -->
          <div class="modal-progress-card" id="modal-trilha-progress-card" style="display: none;">
            <div class="modal-progress-info">
              <span class="progress-label">Seu Progresso na Trilha:</span>
              <strong class="progress-pct" id="modal-trilha-progress-pct">0% concluído</strong>
            </div>
            <div class="modal-progress-track">
              <div class="modal-progress-fill" id="modal-trilha-progress-fill" style="width: 0%;"></div>
            </div>
          </div>

          <!-- CTA Watch Row -->
          <div class="modal-cta-row">
            <a href="#" class="btn btn-primary modal-play-btn" id="modal-trilha-play-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span id="modal-trilha-play-btn-text">Iniciar Trilha</span>
            </a>
            <span class="modal-next-lesson-hint" id="modal-trilha-next-hint"></span>
          </div>
        </div>
      </div>

      <!-- Curriculum / Sequência Completa de Cursos -->
      <div class="modal-curriculum-section">
        <div class="curriculum-header">
          <div class="curriculum-title-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
            <h3>Sequência Cronológica da Trilha</h3>
          </div>
          <span class="curriculum-meta" id="modal-trilha-meta">Etapas estruturadas do básico ao avançado</span>
        </div>

        <!-- Courses Sequence List -->
        <div class="trilha-courses-list" id="modal-trilha-courses-list"></div>
      </div>

    </div>
  </div>
</div>

<style>
  /* --- Backdrop with background blur --- */
  .trilha-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(4, 6, 11, 0.78);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .trilha-modal-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* --- Glassmorphism Dialog --- */
  .trilha-modal-dialog {
    position: relative;
    width: 100%;
    max-width: 880px;
    max-height: 88vh;
    background: rgba(15, 20, 30, 0.9);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xl, 16px);
    box-shadow: 0 32px 64px -12px rgba(0, 0, 0, 0.85),
                0 0 40px rgba(0, 242, 254, 0.12),
                inset 0 1px 1px rgba(255, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.95) translateY(10px);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .trilha-modal-backdrop.active .trilha-modal-dialog {
    transform: scale(1) translateY(0);
  }

  /* --- Close Button --- */
  .modal-close-btn {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(8, 12, 20, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-secondary, #cbd5e1);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 20;
    transition: all 0.2s ease;
  }

  .modal-close-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    transform: scale(1.08);
  }

  /* --- Scroll Body --- */
  .modal-scroll-body {
    overflow-y: auto;
    padding-bottom: 2.5rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
  }

  /* --- Modal Hero --- */
  .modal-hero {
    position: relative;
    padding: 2rem 2rem 1.5rem 2rem;
