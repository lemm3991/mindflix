  }

  .modal-badges-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .provider-pill {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill, 9999px);
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan, #00f2fe);
  }

  .badge {
    font-size: 0.725rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill, 9999px);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-secondary, #cbd5e1);
  }

  .badge-cyan {
    background: rgba(0, 242, 254, 0.1);
    color: var(--accent-cyan, #00f2fe);
    border-color: rgba(0, 242, 254, 0.25);
  }

  .modal-fav-btn {
    margin-left: auto;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-secondary, #cbd5e1);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .modal-fav-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    transform: scale(1.1);
  }

  .modal-fav-btn.active {
    color: #ff3366;
    border-color: rgba(255, 51, 102, 0.4);
    background: rgba(255, 51, 102, 0.15);
  }

  .modal-trilha-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .modal-trilha-desc {
    font-size: 0.925rem;
    color: var(--text-secondary, #cbd5e1);
    line-height: 1.6;
    margin: 0;
  }

  /* Progress Bar */
  .modal-progress-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md, 8px);
    padding: 0.85rem 1.15rem;
  }

  .modal-progress-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.825rem;
    margin-bottom: 0.5rem;
  }

  .progress-label {
    color: var(--text-muted, #94a3b8);
  }

  .progress-pct {
    color: var(--accent-cyan, #00f2fe);
    font-weight: 700;
  }

  .modal-progress-track {
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
  }

  .modal-progress-fill {
    height: 100%;
    background: var(--grad-primary, linear-gradient(135deg, #00f2fe 0%, #4facfe 100%));
    border-radius: 9999px;
    box-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
    transition: width 0.3s ease;
  }

  /* CTA Row */
  .modal-cta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .modal-play-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: var(--radius-md, 8px);
    background: var(--grad-primary, linear-gradient(135deg, #00f2fe 0%, #4facfe 100%));
    color: #0b0d13;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(0, 242, 254, 0.35);
    transition: all 0.2s ease;
  }

  .modal-play-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 242, 254, 0.5);
  }

  .modal-next-lesson-hint {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
  }

  /* Curriculum Section */
  .modal-curriculum-section {
    padding: 1.75rem 2rem 0 2rem;
  }

  .curriculum-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .curriculum-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent-cyan, #00f2fe);
  }

  .curriculum-title-wrap h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .curriculum-meta {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
  }

  /* Trilha Courses Sequence List */
  .trilha-courses-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.trilha-stage-item) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: rgba(18, 24, 38, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md, 10px);
    transition: all 0.2s ease;
    text-decoration: none;
    color: inherit;
  }

  :global(.trilha-stage-item:hover) {
    background: rgba(22, 29, 46, 0.85);
    border-color: rgba(0, 242, 254, 0.3);
    transform: translateX(4px);
  }

  :global(.trilha-stage-num) {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(0, 242, 254, 0.1);
    color: var(--accent-cyan, #00f2fe);
    font-size: 0.85rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  :global(.trilha-stage-thumb) {
    width: 68px;
    height: 38px;
    border-radius: 6px;
    object-fit: cover;
    background: #0f131c;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.trilha-stage-info) {
