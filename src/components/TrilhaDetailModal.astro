  }

  .modal-hero-cover-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .modal-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
    filter: blur(2px);
    transform: scale(1.05);
  }

  .modal-cover-gradient {
    position: absolute;
    inset: 0;
