---
// CourseCard.astro - Clean, Uniform Cinematic Widescreen Card (16:9) com Modal de Detalhes & Grade
import type { Course } from '../types/catalog';
import { getFirstPlayableLesson, isPlayableVideoLesson } from '../lib/catalog';
import { getCourseSourceId } from '../lib/sources';

interface Props {
  course: Course;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto' | 'low';
}

const { course, loading = 'lazy', fetchpriority = 'auto' } = Astro.props;

// Deterministic gradient fallback if course has no cover
let hash = 0;
for (let i = 0; i < course.id.length; i++) {
  hash = course.id.charCodeAt(i) + ((hash << 5) - hash);
}
const hues = [
  'linear-gradient(135deg, #0f2027, #203a43, #2c5364)',
  'linear-gradient(135deg, #1f1c2c, #4a475a)',
  'linear-gradient(135deg, #141e30, #243b55)',
  'linear-gradient(135deg, #0f0c29, #302b63, #24243e)',
  'linear-gradient(135deg, #16222f, #1a365d)',
  'linear-gradient(135deg, #1a1c29, #2d3748)',
  'linear-gradient(135deg, #1e1b4b, #312e81)',
  'linear-gradient(135deg, #064e3b, #047857)',
  'linear-gradient(135deg, #4a0e2e, #831843)'
];
const coverGradient = hues[Math.abs(hash) % hues.length];
const sourceId = getCourseSourceId(course);
---

<div class="course-card-wrapper" data-course-id={course.id} data-source={sourceId}>
  <div 
    class="course-card clean-card" 
    id={`card-${course.id}`} 
    tabindex="0" 
    role="button" 
    aria-label={`Ver detalhes e grade do curso ${course.display_title}`}
  >
    <!-- 16:9 Thumbnail Frame -->
    <div class="card-thumb-frame">
      {course.cover_image && (
        <img 
          src={course.cover_image} 
          alt={course.display_title} 
          class="card-thumb-img" 
          loading={loading} 
          fetchpriority={fetchpriority}
          decoding={loading === 'eager' ? 'sync' : 'async'} 
          onerror="this.style.display='none'; const fb = this.parentElement.querySelector('.thumb-fallback'); if(fb) fb.style.display='flex';"
        />
      )}
      
      <!-- Fallback visual when no image exists -->
      <div class="thumb-fallback" style={course.cover_image ? "display: none;" : `background: ${coverGradient};`}>
        <div class="fallback-glyph">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
        <span class="fallback-text">{course.display_title}</span>
      </div>

      <!-- Top Overlay Bar (Provider badge + Favorite button) -->
      <div class="thumb-top-bar">
        <span class="thumb-provider-badge">{course.provider}</span>
        <button 
          type="button" 
          class="card-fav-btn" 
          data-fav-id={course.id} 
          aria-label="Favoritar curso" 
          data-action="favorite"
        >
          <svg class="heart-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </button>
      </div>

      <!-- Hover Play Overlay -->
      <div class="thumb-hover-action">
        <div class="play-circle-glow">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="6 4 20 12 6 20 6 4"></polygon>
          </svg>
        </div>
        <span class="hover-info-hint">Ver Detalhes & Grade</span>
      </div>

      <!-- Subtle Progress Bar (active if started) -->
      <div class="card-progress-bar" data-progress-bar-for={course.id}>
        <div class="progress-fill" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Course Title (Clean, 2-line uniform typography) -->
    <div class="card-caption">
      <h3 class="card-title" title={course.display_title}>
        {course.display_title}
      </h3>
      <span class="card-meta-line">
        {course.modules_count} {course.modules_count === 1 ? 'módulo' : 'módulos'} • {course.lessons_count} aulas
      </span>
    </div>
  </div>
</div>

<style>
  .course-card-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .course-card.clean-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    outline: none;
    border: none;
    padding: 0;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 16:9 Widescreen Thumbnail Frame */
  .card-thumb-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgba(18, 24, 38, 0.8);
    border-radius: var(--radius-md, 10px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .course-card.clean-card:hover .card-thumb-frame,
  .course-card.clean-card:focus-visible .card-thumb-frame {
    border-color: rgba(0, 242, 254, 0.5);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.55), 0 0 20px rgba(0, 242, 254, 0.22);
    transform: translateY(-4px) scale(1.02);
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .course-card.clean-card:hover .card-thumb-img {
    transform: scale(1.06);
  }

  /* Fallback Artwork */
  .thumb-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    gap: 0.5rem;
  }

  .fallback-glyph {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan, #00f2fe);
  }

  .fallback-text {
    font-size: 0.8rem;
    font-weight: 600;
    color: #ffffff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Top Overlay Bar */
  .thumb-top-bar {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 3;
    pointer-events: none;
  }

  .thumb-provider-badge {
    pointer-events: auto;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill, 9999px);
    background: rgba(8, 12, 20, 0.72);
    backdrop-filter: blur(8px);
    color: var(--text-secondary, #cbd5e1);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Favorite Button */
  .card-fav-btn {
    pointer-events: auto;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(8, 12, 20, 0.72);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted, #94a3b8);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .card-fav-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transform: scale(1.1);
  }

  .card-fav-btn.active {
    color: #ff3366;
    border-color: rgba(255, 51, 102, 0.4);
    background: rgba(255, 51, 102, 0.15);
  }

  /* Hover Play Overlay */
  .thumb-hover-action {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(4, 8, 16, 0.2) 0%, rgba(4, 8, 16, 0.8) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 2;
  }

  .course-card.clean-card:hover .thumb-hover-action {
    opacity: 1;
  }

  .play-circle-glow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--grad-primary, linear-gradient(135deg, #00f2fe 0%, #4facfe 100%));
    color: #0b0d13;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 242, 254, 0.5);
    transform: scale(0.9);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .course-card.clean-card:hover .play-circle-glow {
    transform: scale(1);
  }

  .hover-info-hint {
    font-size: 0.725rem;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
  }

  /* Progress Bar on Bottom of Image */
  .card-progress-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.18);
    display: none;
    z-index: 4;
  }

  .card-progress-bar.visible {
    display: block;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent-cyan, #00f2fe);
    box-shadow: 0 0 6px var(--accent-cyan, #00f2fe);
    transition: width 0.3s ease;
  }

  /* Card Caption / Title */
  .card-caption {
    margin-top: 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0 0.15rem;
  }

  .card-title {
    font-size: 0.925rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary, #ffffff);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 2.5rem; /* Exactly 2 lines height for perfect horizontal alignment */
    transition: color 0.2s ease;
  }

  .course-card.clean-card:hover .card-title {
    color: var(--accent-cyan, #00f2fe);
  }

  .card-meta-line {
    font-size: 0.75rem;
    color: var(--text-muted, #94a3b8);
    font-weight: 500;
  }
</style>

<script>
  import { isCourseFavorite, toggleFavorite, getCourseCompletionStats } from '../lib/progress';
  import { showToast } from '../lib/toast';

  function setupCleanCard(wrapper: HTMLElement) {
    if (wrapper.dataset.cleanCardInit === 'true') return;
    wrapper.dataset.cleanCardInit = 'true';

    const courseId = wrapper.getAttribute('data-course-id');
    const card = wrapper.querySelector<HTMLElement>('.course-card');
    const favBtn = wrapper.querySelector<HTMLButtonElement>('.card-fav-btn');
    const progressBar = wrapper.querySelector<HTMLElement>(`[data-progress-bar-for="${courseId}"]`);

    if (!courseId || !card) return;

    // 1. Sync Progress Bar
    const stats = getCourseCompletionStats(courseId, 100);
    if (stats.percentage > 0 && progressBar) {
      const fill = progressBar.querySelector<HTMLElement>('.progress-fill');
      if (fill) fill.style.width = `${stats.percentage}%`;
      progressBar.classList.add('visible');
    }

    // 2. Sync Favorite Button
    if (favBtn) {
      if (isCourseFavorite(courseId)) {
        favBtn.classList.add('active');
        favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
      }

      favBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isFav = await toggleFavorite(courseId);
        if (isFav) {
          favBtn.classList.add('active');
          favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
          showToast('Curso adicionado à Minha Lista', 'success');
        } else {
          favBtn.classList.remove('active');
          favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'none');
          showToast('Curso removido da Minha Lista', 'info');
        }
      });
    }

    // 3. Click anywhere on card (except favorite button) -> Open Modal
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-action="favorite"]')) return;

      e.preventDefault();
      e.stopPropagation();

      if ((window as any).openCourseModal) {
        (window as any).openCourseModal(courseId);
      } else {
        document.dispatchEvent(new CustomEvent('open-course-modal', { detail: { courseId } }));
      }
    });

    // Keyboard accessibility: Enter or Space opens modal
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if ((window as any).openCourseModal) {
          (window as any).openCourseModal(courseId);
        } else {
          document.dispatchEvent(new CustomEvent('open-course-modal', { detail: { courseId } }));
        }
      }
    });
  }

  // Register cards on page load and dynamic changes
  function initAllCards() {
    document.querySelectorAll<HTMLElement>('.course-card-wrapper').forEach(setupCleanCard);
  }

  document.addEventListener('astro:page-load', initAllCards);
  window.addEventListener('mindflix:favorites-changed', initAllCards);

  initAllCards();
</script>
