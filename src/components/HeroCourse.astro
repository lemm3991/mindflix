---
// HeroCourse.astro - Rotating editorial showcase with mouse parallax and smooth crossfade
import type { Course } from '../types/catalog';
import { getFirstPlayableLesson, isPlayableVideoLesson } from '../lib/catalog';
import { getLessonDriveId } from '../lib/drive';
import { getCourseSourceId } from '../lib/sources';
import ProgressBar from './ProgressBar.astro';

interface Props {
  featuredCourses: Course[];
}

const { featuredCourses } = Astro.props;
const courses = featuredCourses.length > 0 ? featuredCourses : [];
---

<section class="hero-section" id="home-hero-section">
  <!-- Parallax Background Layer (Plano 1) -->
  <div class="hero-parallax-bg" id="hero-parallax-bg">
    <div class="backdrop-gradient"></div>
    <div class="backdrop-pattern"></div>
    <div class="hero-ambient-glow" id="hero-glow"></div>
  </div>

  <!-- Video Backdrop Layer with Feathered Gradient Edges & Dark Overlay -->
  <div class="hero-video-backdrop" id="hero-video-backdrop">
    {courses.map((course, idx) => {
      const firstLesson = getFirstPlayableLesson(course);
      const isVideo = isPlayableVideoLesson(firstLesson);
      const videoPath = isVideo ? (firstLesson?.relative_path || '') : '';
      const sourceId = getCourseSourceId(course);
      const driveId = getLessonDriveId(firstLesson);
      const drivePreviewUrl = driveId ? `https://drive.google.com/file/d/${driveId}/preview` : null;
      const localVideoSrc = (!driveId && videoPath) ? `/api/video?path=${encodeURIComponent(videoPath)}` : null;

      return (
        <div
          class={`hero-video-item ${idx === 0 ? 'active' : ''}`}
          data-video-index={idx}
          data-source={sourceId}
        >
          {course.cover_image && (
            <img
              class="hero-poster-fallback"
              src={course.cover_image}
              alt={course.display_title}
              loading={idx === 0 ? 'eager' : 'lazy'}
              fetchpriority={idx === 0 ? 'high' : 'auto'}
              decoding={idx === 0 ? 'sync' : 'async'}
            />
          )}
          {drivePreviewUrl ? (
            <iframe
              class="hero-bg-iframe"
              src={idx === 0 ? drivePreviewUrl : undefined}
              data-src={drivePreviewUrl}
              allow="autoplay; encrypted-media; picture-in-picture"
              title={course.display_title}
            ></iframe>
          ) : localVideoSrc ? (
            <video
              class="hero-bg-video"
              muted
              loop
              playsinline
              preload={idx === 0 ? 'auto' : 'none'}
              src={idx === 0 ? localVideoSrc : undefined}
              data-src={localVideoSrc}
            ></video>
          ) : null}
        </div>
      );
    })}

    <!-- Multi-directional dark gradient overlays & feathered edges to protect text readability -->
    <div class="hero-video-veil"></div>
  </div>

  <div class="container hero-content-wrapper">
    {courses.map((course, idx) => {
      const firstLesson = getFirstPlayableLesson(course);
      const watchUrl = firstLesson ? `/watch/${course.id}/${firstLesson.id}` : '/courses';
      const sourceId = getCourseSourceId(course);
      return (
        <div
          class={`hero-slide ${idx === 0 ? 'active' : ''}`}
          data-slide-index={idx}
          data-course-id={course.id}
          data-source={sourceId}
        >
          <div class="hero-meta">
            <div class="badges-row">
              <span class="badge badge-cyan">{course.provider}</span>
              <span class="badge badge-purple">{course.modules_count} Módulos</span>
              <span class="badge">{course.lessons_count} Aulas</span>
            </div>

            <h1 class="hero-title">{course.display_title}</h1>
            
            <p class="hero-description">{course.description}</p>

            <div class="hero-tags">
              {course.tags.slice(0, 4).map(tag => (
                <span class="tag-pill">#{tag}</span>
              ))}
            </div>

            <!-- Dynamic Progress bar if course has been started -->
            <div class="hero-progress-box" data-progress-course-id={course.id} style="display: none;">
              <div class="hero-progress-info">
                <span class="hero-progress-text">Continuar de onde parou</span>
                <span class="hero-progress-percent">0%</span>
              </div>
              <ProgressBar percentage={0} height="5px" />
            </div>

            <div class="hero-actions">
              <a href={watchUrl} class="btn btn-primary btn-hero">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>Continuar Assistindo</span>
              </a>

              <button type="button" class="btn btn-secondary btn-hero btn-hero-info" data-course-id={course.id}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span>Mais Informações</span>
              </button>

              <button class="btn btn-secondary btn-icon hero-fav-btn" data-fav-id={course.id} aria-label="Favoritar">
                <svg class="heart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      );
    })}

    <!-- Hero Footer Controls (Indicators + Sound Toggle) -->
    <div class="hero-footer-controls">
      {courses.length > 1 && (
        <div class="hero-indicators">
          {courses.map((_, idx) => (
            <button
              type="button"
              class={`indicator-dot ${idx === 0 ? 'active' : ''}`}
              data-dot-index={idx}
              aria-label={`Ir para destaque ${idx + 1}`}
            ></button>
          ))}
        </div>
      )}

      <button
        type="button"
        class="hero-sound-btn"
        id="hero-sound-toggle"
        aria-label="Ativar/Desativar som do trailer"
        title="Clique para ativar som"
      >
        <span class="sound-icon sound-icon-muted">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </span>
        <span class="sound-icon sound-icon-unmuted" style="display: none;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
        </span>
        <span class="sound-label">Mudo</span>
      </button>
    </div>
  </div>
</section>

<script>
  import { getAllCourses } from '../lib/catalog';
  import { getActiveSource } from '../lib/sources';
  import { getCourseCompletionStats, isCourseFavorite, toggleFavorite, getUserPreferences, getNextLessonToWatch } from '../lib/progress';
  import { showToast } from '../lib/toast';

  const heroSection = document.getElementById('home-hero-section');
  const parallaxBg = document.getElementById('hero-parallax-bg');
  const glow = document.getElementById('hero-glow');
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  const dots = document.querySelectorAll<HTMLElement>('.indicator-dot');
  const allCourses = getAllCourses();
  const videoItems = document.querySelectorAll<HTMLElement>('.hero-video-item');
  const soundBtn = document.getElementById('hero-sound-toggle');

  let currentSlide = 0;
  let rotationTimer: any;
  let isHeroMuted = true;

  function updateSoundUI() {
    if (!soundBtn) return;
    const mutedIcon = soundBtn.querySelector<HTMLElement>('.sound-icon-muted');
    const unmutedIcon = soundBtn.querySelector<HTMLElement>('.sound-icon-unmuted');
    const soundLabel = soundBtn.querySelector<HTMLElement>('.sound-label');

    if (isHeroMuted) {
      if (mutedIcon) mutedIcon.style.display = 'inline-flex';
      if (unmutedIcon) unmutedIcon.style.display = 'none';
      if (soundLabel) soundLabel.textContent = 'Mudo';
      soundBtn.classList.remove('unmuted');
      soundBtn.title = 'Clique para ativar som';
    } else {
      if (mutedIcon) mutedIcon.style.display = 'none';
      if (unmutedIcon) unmutedIcon.style.display = 'inline-flex';
      if (soundLabel) soundLabel.textContent = 'Som Ativo';
      soundBtn.classList.add('unmuted');
      soundBtn.title = 'Clique para mutar';
    }
  }

  function setHeroMuted(muted: boolean) {
    isHeroMuted = muted;
    videoItems.forEach((item) => {
      const vid = item.querySelector<HTMLVideoElement>('.hero-bg-video');
      if (vid) {
        vid.muted = isHeroMuted;
        if (!isHeroMuted) {
          vid.volume = 0.8;
          vid.play().catch(() => {});
        }
      }
    });
    updateSoundUI();
  }

  if (soundBtn) {
    soundBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      setHeroMuted(!isHeroMuted);
    });
  }

  function updateVideoBackdrop(index: number) {
    videoItems.forEach((item, idx) => {
      const vid = item.querySelector<HTMLVideoElement>('.hero-bg-video');
      const iframe = item.querySelector<HTMLIFrameElement>('.hero-bg-iframe');

      if (idx === index) {
        item.classList.add('active');
        if (vid) {
          vid.muted = isHeroMuted;
          if (!vid.src && vid.dataset.src) {
            vid.src = vid.dataset.src;
          }
          vid.play().catch(() => {});
        }
        if (iframe) {
          if (!iframe.src && iframe.dataset.src) {
            iframe.src = iframe.dataset.src;
          }
        }
      } else {
        item.classList.remove('active');
        if (vid && !vid.paused) {
          vid.pause();
        }
      }
    });
  }

  // Attach error listeners for smooth fallback
  videoItems.forEach(item => {
    const vid = item.querySelector<HTMLVideoElement>('.hero-bg-video');
    if (vid) {
      vid.addEventListener('error', () => {
        vid.style.display = 'none';
      });
    }
  });

  function setSlide(index: number) {
    slides[currentSlide]?.classList.remove('active');
    dots[currentSlide]?.classList.remove('active');

    currentSlide = index;

    slides[currentSlide]?.classList.add('active');
    dots[currentSlide]?.classList.add('active');
    updateVideoBackdrop(currentSlide);
  }

  function setupHeroRotation() {
    clearInterval(rotationTimer);
    const activeSource = getActiveSource();

    // Find eligible slide indices for the current source
    const eligibleIndices: number[] = [];
    slides.forEach((slide, idx) => {
      const s = slide.getAttribute('data-source') || 'outros';
      if (activeSource === 'all' || s === activeSource) {
        eligibleIndices.push(idx);
      }
    });

    if (eligibleIndices.length > 0) {
      // Activate the first matching slide
      setSlide(eligibleIndices[0]);

      if (eligibleIndices.length > 1) {
        let eligiblePos = 0;
        rotationTimer = setInterval(() => {
          eligiblePos = (eligiblePos + 1) % eligibleIndices.length;
          setSlide(eligibleIndices[eligiblePos]);
        }, 12000);
      }
    } else {
      // Fallback to slide 0 if no match
      setSlide(0);
    }
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      clearInterval(rotationTimer);
      const idx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
      setSlide(idx);
    });
  });

  // Listen to source changes
  window.addEventListener('mindflix:source-changed', () => {
    setupHeroRotation();
  });

  setupHeroRotation();

  // Mouse Parallax on Hero
  const prefs = getUserPreferences();
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced && prefs.parallax_enabled && heroSection) {
    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      if (parallaxBg) {
        parallaxBg.style.transform = `translate(${x * 6}px, ${y * 4}px)`;
      }
      if (glow) {
        glow.style.transform = `translate(${x * 16}px, ${y * 12}px)`;
      }
    }, { passive: true });

    heroSection.addEventListener('mouseleave', () => {
      if (parallaxBg) parallaxBg.style.transform = 'translate(0, 0)';
      if (glow) glow.style.transform = 'translate(0, 0)';
    });
  }

  // Progress and Favorites initialization
  slides.forEach(slide => {
    const courseId = slide.getAttribute('data-course-id');
    if (!courseId) return;

    const courseObj = allCourses.find(c => c.id === courseId);
    if (courseObj) {
      const heroWatchBtn = slide.querySelector<HTMLAnchorElement>('.btn-primary.btn-hero');
      if (heroWatchBtn) {
        const nextWatch = getNextLessonToWatch(courseObj);
        heroWatchBtn.href = nextWatch.watchUrl;
        const btnSpan = heroWatchBtn.querySelector('span');
        if (btnSpan) btnSpan.textContent = nextWatch.isResume ? 'Continuar Assistindo' : 'Assistir Agora';
      }
    }

    // Progress
    const stats = getCourseCompletionStats(courseId, 100);
    const progressBox = slide.querySelector<HTMLElement>(`[data-progress-course-id="${courseId}"]`);
    if (stats.percentage > 0 && progressBox) {
      progressBox.style.display = 'block';
      const pctEl = progressBox.querySelector('.hero-progress-percent');
      const fill = progressBox.querySelector('.progress-fill') as HTMLElement;
      if (pctEl) pctEl.textContent = `${stats.percentage}%`;
      if (fill) fill.style.width = `${stats.percentage}%`;
    }

    // Favorite
    const favBtn = slide.querySelector<HTMLButtonElement>(`[data-fav-id="${courseId}"]`);
    if (favBtn) {
      if (isCourseFavorite(courseId)) {
        favBtn.classList.add('active');
        favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
      }

      favBtn.addEventListener('click', async () => {
        const isFav = await toggleFavorite(courseId);
        if (isFav) {
          favBtn.classList.add('active');
          favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
          showToast('Curso adicionado à Minha Lista', 'success');
        } else {
          favBtn.classList.remove('active');
          favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'none');
          showToast('Curso removido da Minha Lista', 'info');
        }
      });
    }

    // Info / Modal Trigger
    const infoBtn = slide.querySelector<HTMLButtonElement>('.btn-hero-info');
    if (infoBtn) {
      infoBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if ((window as any).openCourseModal) {
          (window as any).openCourseModal(courseId);
        } else {
          document.dispatchEvent(new CustomEvent('open-course-modal', { detail: { courseId } }));
        }
      });
    }
  });
</script>

<style>
  .hero-section {
    position: relative;
    min-height: 540px;
    display: flex;
    align-items: center;
    padding-top: 105px;
    padding-bottom: 50px;
    margin-bottom: 2rem;
    overflow: hidden;
  }

  .hero-parallax-bg {
    position: absolute;
    inset: -20px;
    z-index: 0;
    pointer-events: none;
    transition: transform var(--motion-normal) var(--ease-out);
    will-change: transform;
  }

  .backdrop-gradient {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 90% 80% at 75% 20%, rgba(0, 242, 254, 0.14) 0%, transparent 60%),
      radial-gradient(ellipse 70% 60% at 20% 40%, rgba(99, 102, 241, 0.12) 0%, transparent 60%),
      linear-gradient(180deg, rgba(7, 9, 14, 0.15) 0%, rgba(11, 13, 19, 0.65) 75%, transparent 100%);
  }

  .backdrop-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.5;
  }

  .hero-ambient-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    top: 10%;
    right: 15%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.15) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    transition: transform 0.4s var(--ease-out);
  }

  /* Video Backdrop Layer with Feathered Gradient Edges */
  .hero-video-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .hero-video-item {
    position: absolute;
    top: 0;
    right: 0;
    width: 75%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
    will-change: opacity;
    /* Soft feathered edges with radial gradient mask */
    mask-image: radial-gradient(ellipse 85% 85% at 70% 50%, black 45%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 70% 50%, black 45%, transparent 95%);
  }

  .hero-video-item.active {
    opacity: 0.85;
  }

  .hero-poster-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: saturate(1.1) brightness(0.92) contrast(1.04);
    z-index: 0;
  }

  .hero-bg-video {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: saturate(1.12) brightness(0.96) contrast(1.04);
  }

  .hero-bg-iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120%;
    height: 120%;
    transform: translate(-50%, -50%);
    border: none;
    pointer-events: none;
    z-index: 1;
    filter: saturate(1.1) brightness(0.92) contrast(1.04);
  }

  /* Softened Dark Overlay & Gradient Veils so the video is clearly visible while text remains legible */
  .hero-video-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: 
      /* Solid protection on the far left for text readability, fading completely into the video */
      linear-gradient(to right, rgba(7, 9, 14, 0.92) 0%, rgba(7, 9, 14, 0.72) 32%, rgba(7, 9, 14, 0.25) 55%, transparent 75%),
      /* Soft bottom gradient to merge into the content rows */
      linear-gradient(to top, rgba(7, 9, 14, 0.85) 0%, rgba(7, 9, 14, 0.2) 15%, transparent 35%);
  }

  .hero-content-wrapper {
    position: relative;
    z-index: 5;
    width: 100%;
  }

  .hero-slide {
    display: none;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--motion-slow) var(--ease-out), transform var(--motion-slow) var(--ease-out);
  }

  .hero-slide.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .hero-meta {
    max-width: 740px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: #ffffff;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.95), 0 2px 8px rgba(0, 0, 0, 0.9);
  }

  .hero-description {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(241, 245, 249, 0.95);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.9);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    font-size: 0.8125rem;
    font-family: var(--font-display);
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hero-progress-box {
    max-width: 440px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-top: 0.35rem;
  }

  .hero-progress-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }

  .hero-progress-percent {
    color: var(--accent-cyan);
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .btn-hero {
    padding: 0.85rem 1.65rem;
    font-size: 1rem;
  }

  .hero-fav-btn.active {
    color: var(--accent-rose);
    border-color: rgba(244, 63, 94, 0.4);
    background: rgba(244, 63, 94, 0.1);
  }

  /* Hero Footer Controls (Indicators + Sound Toggle) */
  .hero-footer-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    max-width: 740px;
  }

  /* Slide Indicators */
  .hero-indicators {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .indicator-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.2);
    border: none;
    cursor: pointer;
    transition: all var(--motion-normal) var(--ease-out);
    padding: 0;
  }

  .indicator-dot.active {
    width: 24px;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
  }

  /* Hero Sound Toggle Button */
  .hero-sound-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all var(--motion-fast) var(--ease-out);
    user-select: none;
  }

  .hero-sound-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .hero-sound-btn.unmuted {
    background: rgba(0, 242, 254, 0.12);
    border-color: rgba(0, 242, 254, 0.4);
    color: var(--accent-cyan);
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.2);
  }

  .sound-icon {
    display: inline-flex;
    align-items: center;
