---
// HeroCourse.astro - Rotating editorial showcase with mouse parallax and smooth crossfade
import type { Course } from '../types/catalog';
import { getAllCourses, getFirstPlayableLesson, isPlayableVideoLesson, isComecePorAqui, isProjectCourse } from '../lib/catalog';
import { buildServerStreamUrl } from '../lib/mediaProvider';
import { getCourseSourceId } from '../lib/sources';
import ProgressBar from './ProgressBar.astro';

interface Props {
  featuredCourses?: Course[];
  limit?: number;
}

const { featuredCourses, limit = 5 } = Astro.props;

let courses: Course[] = [];

if (featuredCourses && featuredCourses.length > 0) {
  courses = featuredCourses;
} else {
  const allCourses = getAllCourses();
  const eligibleHeroCourses = allCourses.filter(c => {
    if (c.is_hidden || (c as any).missing || isComecePorAqui(c) || isProjectCourse(c)) return false;
    const firstVideo = getFirstPlayableLesson(c);
    return Boolean(firstVideo && isPlayableVideoLesson(firstVideo));
  });

  const poolToSample = eligibleHeroCourses.length >= limit 
    ? eligibleHeroCourses 
    : (eligibleHeroCourses.length > 0 ? eligibleHeroCourses : allCourses.filter(c => !isComecePorAqui(c) && !isProjectCourse(c)));

  const pool = [...poolToSample];
  for (let i = pool.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [pool[i], pool[j]] = [pool[j], pool[i]];
  }
  courses = pool.slice(0, Math.min(limit, pool.length));
  if (courses.length === 0) {
    courses = allCourses.slice(0, Math.min(limit, allCourses.length));
  }
}
---

<section class="hero-section" id="home-hero-section">
  <!-- Parallax Background Layer (Plano 1) -->
  <div class="hero-parallax-bg" id="hero-parallax-bg">
    <div class="backdrop-gradient"></div>
    <div class="backdrop-pattern"></div>
    <div class="hero-ambient-glow" id="hero-glow"></div>
  </div>

  <!-- Video Backdrop Layer with Feathered Gradient Edges & Dark Overlay -->
  <div class="hero-video-backdrop" id="hero-video-backdrop">
    {courses.map((course, idx) => {
      const firstLesson = getFirstPlayableLesson(course);
      const isVideo = isPlayableVideoLesson(firstLesson);
      const videoPath = isVideo ? (firstLesson?.relative_path || '') : '';
      const sourceId = getCourseSourceId(course);
      const videoSrc = videoPath ? buildServerStreamUrl(videoPath) : '';

      return (
        <div
          class={`hero-video-item ${idx === 0 ? 'active' : ''}`}
          data-video-index={idx}
          data-source={sourceId}
        >
          {course.cover_image && (
            <img
              class="hero-poster-fallback"
              src={course.cover_image}
              alt={course.display_title}
              loading={idx === 0 ? 'eager' : 'lazy'}
              fetchpriority={idx === 0 ? 'high' : 'auto'}
              decoding={idx === 0 ? 'sync' : 'async'}
              onerror="this.style.display='none'"
            />
          )}
          {videoSrc ? (
            <video
              class="hero-bg-video"
              autoplay
              muted
              loop
              playsinline
              preload={idx === 0 ? 'auto' : 'none'}
              src={idx === 0 ? videoSrc : undefined}
              data-src={videoSrc}
            ></video>
          ) : null}
        </div>
      );
    })}

    <!-- Multi-directional dark gradient overlays & feathered edges to protect text readability -->
    <div class="hero-video-veil"></div>
  </div>

  <div class="container hero-content-wrapper">
    {courses.map((course, idx) => {
      const firstLesson = getFirstPlayableLesson(course);
      const watchUrl = firstLesson ? `/watch/${course.id}/${firstLesson.id}` : '/courses';
      const sourceId = getCourseSourceId(course);
      return (
        <div
          class={`hero-slide ${idx === 0 ? 'active' : ''}`}
          data-slide-index={idx}
          data-course-id={course.id}
          data-categories={(course.categories || []).join(',')}
          data-source={sourceId}
        >
          <div class="hero-meta">
            <div class="badges-row">
              <span class="badge badge-cyan">{course.provider}</span>
              <span class="badge badge-purple">{course.modules_count} Módulos</span>
              <span class="badge">{course.lessons_count} Aulas</span>
            </div>

            <h1 class="hero-title">{course.display_title}</h1>
            
            <p class="hero-description">{course.description}</p>

            <div class="hero-tags">
              {course.tags.slice(0, 4).map(tag => (
                <span class="tag-pill">#{tag}</span>
              ))}
            </div>

            <!-- Dynamic Progress bar if course has been started -->
            <div class="hero-progress-box" data-progress-course-id={course.id} style="display: none;">
              <div class="hero-progress-info">
                <span class="hero-progress-text">Continuar de onde parou</span>
                <span class="hero-progress-percent">0%</span>
              </div>
              <ProgressBar percentage={0} height="5px" />
            </div>

            <div class="hero-actions">
              <a href={watchUrl} class="btn btn-primary btn-hero">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>Continuar Assistindo</span>
              </a>

              <button type="button" class="btn btn-secondary btn-hero btn-hero-info" data-course-id={course.id}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span>Mais Informações</span>
              </button>

              <button class="btn btn-secondary btn-icon hero-fav-btn" data-fav-id={course.id} aria-label="Favoritar">
                <svg class="heart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      );
    })}

    <!-- Hero Footer Controls (Indicators + Sound Toggle) -->
    <div class="hero-footer-controls">
      {courses.length > 1 && (
        <div class="hero-indicators">
          {courses.map((_, idx) => (
            <button
              type="button"
              class={`indicator-dot ${idx === 0 ? 'active' : ''}`}
              data-dot-index={idx}
              aria-label={`Ir para destaque ${idx + 1}`}
            ></button>
          ))}
        </div>
      )}

      <button
        type="button"
        class="hero-sound-btn"
        id="hero-sound-toggle"
        aria-label="Ativar/Desativar som do trailer"
        title="Clique para ativar som"
      >
        <span class="sound-icon sound-icon-muted">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </span>
        <span class="sound-icon sound-icon-unmuted" style="display: none;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
        </span>
        <span class="sound-label">Mudo</span>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    function initHero() {
      var heroSection = document.getElementById('home-hero-section');
      if (!heroSection) return;

      var slides = Array.from(heroSection.querySelectorAll('.hero-slide'));
      var dots = Array.from(heroSection.querySelectorAll('.indicator-dot'));
      var videoItems = Array.from(heroSection.querySelectorAll('.hero-video-item'));
      var soundBtn = document.getElementById('hero-sound-toggle');
      var parallaxBg = document.getElementById('hero-parallax-bg');
      var glow = document.getElementById('hero-glow');

      if (slides.length === 0) return;

      var currentSlide = 0;
      var rotationTimer = null;
      var isHeroMuted = true;

      function updateSoundUI() {
        if (!soundBtn) return;
        var mutedIcon = soundBtn.querySelector('.sound-icon-muted');
        var unmutedIcon = soundBtn.querySelector('.sound-icon-unmuted');
        var soundLabel = soundBtn.querySelector('.sound-label');

        if (isHeroMuted) {
          if (mutedIcon) mutedIcon.style.display = 'inline-flex';
          if (unmutedIcon) unmutedIcon.style.display = 'none';
          if (soundLabel) soundLabel.textContent = 'Mudo';
          soundBtn.classList.remove('unmuted');
          soundBtn.title = 'Clique para ativar som';
        } else {
          if (mutedIcon) mutedIcon.style.display = 'none';
          if (unmutedIcon) unmutedIcon.style.display = 'inline-flex';
          if (soundLabel) soundLabel.textContent = 'Som Ativo';
          soundBtn.classList.add('unmuted');
          soundBtn.title = 'Clique para mutar';
        }
      }

      function setHeroMuted(muted) {
        isHeroMuted = muted;
        videoItems.forEach(function(item, idx) {
          var vid = item.querySelector('.hero-bg-video');
          if (vid) {
            if (idx === currentSlide) {
              vid.muted = isHeroMuted;
              if (!isHeroMuted) {
                vid.volume = 0.8;
                vid.play().catch(function() {});
              }
            } else {
              vid.muted = true;
              if (!vid.paused) vid.pause();
            }
          }
        });
        updateSoundUI();
      }

      function updateVideoBackdrop(index) {
        videoItems.forEach(function(item, idx) {
          var vid = item.querySelector('.hero-bg-video');
          if (idx === index) {
            item.classList.add('active');
            if (vid) {
              vid.muted = isHeroMuted;
              if (!vid.src && vid.dataset.src) {
                vid.src = vid.dataset.src;
              }
              if (!isHeroMuted) {
                vid.volume = 0.8;
              }
              vid.play().catch(function() {});
            }
          } else {
            item.classList.remove('active');
            if (vid) {
              vid.muted = true;
              if (!vid.paused) vid.pause();
            }
          }
        });
      }

      function setSlide(index) {
        if (index < 0 || index >= slides.length) index = 0;
        slides.forEach(function(s, idx) {
          if (idx === index) s.classList.add('active');
          else s.classList.remove('active');
        });

        dots.forEach(function(d, idx) {
          if (idx === index) d.classList.add('active');
          else d.classList.remove('active');
        });

        currentSlide = index;
        updateVideoBackdrop(currentSlide);
      }

      function startRotation() {
        if (rotationTimer) clearInterval(rotationTimer);
        if (slides.length <= 1) return;
        rotationTimer = setInterval(function() {
          var nextIndex = (currentSlide + 1) % slides.length;
          setSlide(nextIndex);
        }, 10000);
      }

      // Attach click listeners to indicator dots
      dots.forEach(function(dot) {
        dot.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          var idx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
          setSlide(idx);
          startRotation();
        };
      });

      // Sound button listener
      if (soundBtn) {
        soundBtn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          setHeroMuted(!isHeroMuted);
        };
      }

      // Ensure initial video is muted and playing
      setHeroMuted(true);
      setSlide(0);
      startRotation();

      // Parallax effect
      heroSection.addEventListener('mousemove', function(e) {
        var rect = heroSection.getBoundingClientRect();
        var x = (e.clientX - rect.left) / rect.width - 0.5;
        var y = (e.clientY - rect.top) / rect.height - 0.5;

        if (parallaxBg) {
          parallaxBg.style.transform = 'translate(' + (x * 6) + 'px, ' + (y * 4) + 'px)';
        }
        if (glow) {
          glow.style.transform = 'translate(' + (x * 16) + 'px, ' + (y * 12) + 'px)';
        }
      }, { passive: true });

      heroSection.addEventListener('mouseleave', function() {
        if (parallaxBg) parallaxBg.style.transform = 'translate(0, 0)';
        if (glow) glow.style.transform = 'translate(0, 0)';
      });

      // Favorites, Progress and modal hooks
      slides.forEach(function(slide) {
        var courseId = slide.getAttribute('data-course-id');
        if (!courseId) return;

        // Progress check
        try {
          var userStr = localStorage.getItem('mindflix_user');
          var uId = userStr ? JSON.parse(userStr).id : null;
          var progKey = uId ? ('mindflix_progress_' + uId) : 'mindflix_progress';
          var prog = JSON.parse(localStorage.getItem(progKey) || localStorage.getItem('mindflix_progress') || '{}');
          var permProg = JSON.parse(localStorage.getItem('mindflix_progress_permanent') || '{}');
          var mergedProg = Object.assign({}, permProg, prog);

          var hasProg = Object.keys(mergedProg).some(function(k) {
            return mergedProg[k] && (mergedProg[k].course_id === courseId || k.indexOf(courseId) !== -1);
          });

          var watchBtn = slide.querySelector('.btn-primary.btn-hero');
          if (watchBtn && hasProg) {
            var span = watchBtn.querySelector('span');
            if (span) span.textContent = 'Continuar Assistindo';
          }
        } catch (e) {}

        // Info button
        var infoBtn = slide.querySelector('.btn-hero-info');
        if (infoBtn) {
          infoBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (window.openCourseModal) {
              window.openCourseModal(courseId);
            } else {
              document.dispatchEvent(new CustomEvent('open-course-modal', { detail: { courseId: courseId } }));
            }
          });
        }

        // Fav button
        var favBtn = slide.querySelector('.hero-fav-btn');
        if (favBtn) {
          var userStr = localStorage.getItem('mindflix_user');
          var uId = userStr ? JSON.parse(userStr).id : null;
          var favKey = uId ? ('mindflix_favorites_' + uId) : 'mindflix_favorites';
          var favs = JSON.parse(localStorage.getItem(favKey) || localStorage.getItem('mindflix_favorites') || '[]');
          if (Array.isArray(favs) && favs.indexOf(courseId) !== -1) {
            favBtn.classList.add('active');
            favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
          }

          favBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var curFavs = JSON.parse(localStorage.getItem(favKey) || localStorage.getItem('mindflix_favorites') || '[]');
            if (!Array.isArray(curFavs)) curFavs = [];
            var pos = curFavs.indexOf(courseId);
            var isFav = false;
            if (pos === -1) {
              curFavs.push(courseId);
              isFav = true;
            } else {
              curFavs.splice(pos, 1);
              isFav = false;
            }
            localStorage.setItem(favKey, JSON.stringify(curFavs));
            localStorage.setItem('mindflix_favorites', JSON.stringify(curFavs));

            if (isFav) {
              favBtn.classList.add('active');
              favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'currentColor');
            } else {
              favBtn.classList.remove('active');
              favBtn.querySelector('.heart-icon')?.setAttribute('fill', 'none');
            }
            window.dispatchEvent(new CustomEvent('mindflix:favorites-changed'));
          });
        }
      });
    }

    document.addEventListener('astro:page-load', initHero);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHero);
    } else {
      initHero();
    }
  })();
</script>

<style>
  .hero-section {
    position: relative;
    min-height: 540px;
    display: flex;
    align-items: center;
    padding-top: 105px;
    padding-bottom: 50px;
    margin-bottom: 2rem;
    overflow: hidden;
  }

  .hero-parallax-bg {
    position: absolute;
    inset: -20px;
    z-index: 0;
    pointer-events: none;
    transition: transform var(--motion-normal) var(--ease-out);
    will-change: transform;
  }

  .backdrop-gradient {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 90% 80% at 75% 20%, rgba(0, 242, 254, 0.14) 0%, transparent 60%),
      radial-gradient(ellipse 70% 60% at 20% 40%, rgba(99, 102, 241, 0.12) 0%, transparent 60%),
      linear-gradient(180deg, rgba(7, 9, 14, 0.15) 0%, rgba(11, 13, 19, 0.65) 75%, transparent 100%);
  }

  .backdrop-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.5;
  }

  .hero-ambient-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    top: 10%;
    right: 15%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.15) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    transition: transform 0.4s var(--ease-out);
  }

  /* Video Backdrop Layer with Feathered Gradient Edges */
  .hero-video-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .hero-video-item {
    position: absolute;
    top: 0;
    right: 0;
    width: 75%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
    will-change: opacity;
    /* Soft feathered edges with radial gradient mask */
    mask-image: radial-gradient(ellipse 85% 85% at 70% 50%, black 45%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 70% 50%, black 45%, transparent 95%);
  }

  .hero-video-item.active {
    opacity: 0.85;
  }

  .hero-poster-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: saturate(1.1) brightness(0.92) contrast(1.04);
    z-index: 0;
  }

  .hero-bg-video {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: saturate(1.12) brightness(0.96) contrast(1.04);
  }

  /* Softened Dark Overlay & Gradient Veils so the video is clearly visible while text remains legible */
  .hero-video-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: 
      /* Solid protection on the far left for text readability, fading completely into the video */
      linear-gradient(to right, rgba(7, 9, 14, 0.92) 0%, rgba(7, 9, 14, 0.72) 32%, rgba(7, 9, 14, 0.25) 55%, transparent 75%),
      /* Soft bottom gradient to merge into the content rows */
      linear-gradient(to top, rgba(7, 9, 14, 0.85) 0%, rgba(7, 9, 14, 0.2) 15%, transparent 35%);
  }

  .hero-content-wrapper {
    position: relative;
    z-index: 5;
    width: 100%;
  }

  .hero-slide {
    display: none;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--motion-slow) var(--ease-out), transform var(--motion-slow) var(--ease-out);
  }

  .hero-slide.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .hero-meta {
    max-width: 740px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: #ffffff;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.95), 0 2px 8px rgba(0, 0, 0, 0.9);
  }

  .hero-description {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(241, 245, 249, 0.95);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.9);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    font-size: 0.8125rem;
    font-family: var(--font-display);
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hero-progress-box {
    max-width: 440px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-top: 0.35rem;
  }

  .hero-progress-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }

  .hero-progress-percent {
    color: var(--accent-cyan);
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .btn-hero {
    padding: 0.85rem 1.65rem;
    font-size: 1rem;
  }

  .hero-fav-btn.active {
    color: var(--accent-rose);
    border-color: rgba(244, 63, 94, 0.4);
    background: rgba(244, 63, 94, 0.1);
  }

  /* Hero Footer Controls (Indicators + Sound Toggle) */
  .hero-footer-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    max-width: 740px;
    position: relative;
    z-index: 20;
  }

  /* Slide Indicators */
  .hero-indicators {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    position: relative;
    z-index: 20;
  }

  .indicator-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.15);
    cursor: pointer;
    transition: all var(--motion-normal) var(--ease-out);
    padding: 0;
    position: relative;
  }

  .indicator-dot::before {
    content: '';
    position: absolute;
    inset: -8px -6px;
  }

  .indicator-dot:hover {
    background: rgba(255, 255, 255, 0.6);
    transform: scale(1.2);
  }

  .indicator-dot.active {
    width: 28px;
    background: var(--accent-cyan, #00f2fe);
    border-color: rgba(0, 242, 254, 0.6);
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.6);
    transform: none;
  }

  /* Hero Sound Toggle Button */
  .hero-sound-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
