---
// TrilhasRow.astro - Fileira de Destaque para as Formações & Trilhas Oficiais
import { getAllTrilhas, getTrilhasBySource } from '../lib/trilhas';
import TrilhaCard from './TrilhaCard.astro';

interface Props {
  source?: string;
  title?: string;
  badge?: string;
  subtitle?: string;
}

const {
  source,
  title = "Trilhas de Aprendizado",
  badge = "Formações Oficiais & Trilhas",
  subtitle = "Sequências completas e cronológicas de cursos e projetos para dominar uma especialidade."
} = Astro.props;

const trilhas = source && source !== 'all' ? getTrilhasBySource(source) : getAllTrilhas();
---

{trilhas.length > 0 && (
  <section class="trilhas-section" id="trilhas-asimov-section" data-fixed-source={source || ''}>
    <div class="container">
      <div class="trilhas-header">
        <div class="trilhas-title-wrap">
          <div class="trilhas-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>{badge}</span>
          </div>
          <h2 class="trilhas-main-title">{title}</h2>
          <p class="trilhas-subtitle">{subtitle}</p>
        </div>

        <div class="trilhas-nav-controls">
          <button type="button" class="trilhas-nav-btn prev" id="trilhas-prev-btn" aria-label="Rolar trilhas para esquerda">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button type="button" class="trilhas-nav-btn next" id="trilhas-next-btn" aria-label="Rolar trilhas para direita">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <div class="trilhas-carousel-wrapper">
        <div class="trilhas-carousel-track" id="trilhas-carousel">
          {trilhas.map((trilha) => (
            <TrilhaCard trilha={trilha} />
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<script>
  import { getActiveSource } from '../lib/sources';
  import { getUserProgress } from '../lib/progress';

  const section = document.getElementById('trilhas-asimov-section');
  const carousel = document.getElementById('trilhas-carousel');
  const prevBtn = document.getElementById('trilhas-prev-btn');
  const nextBtn = document.getElementById('trilhas-next-btn');

  // Dynamic 3D Skewed Perspective calculation
  let isUpdatingPerspective = false;
  function updateSkewedPerspective() {
    if (!carousel) return;
    const rect = carousel.getBoundingClientRect();
    const carouselCenter = rect.left + rect.width / 2;

    const cards = carousel.querySelectorAll<HTMLElement>('.trilha-card');
    cards.forEach(card => {
      if (card.style.display === 'none') return;

      const cardRect = card.getBoundingClientRect();
      const cardCenter = cardRect.left + cardRect.width / 2;

      // Calculate normalized distance from viewport center (-1.5 to +1.5)
      const distance = (cardCenter - carouselCenter) / (rect.width * 0.45);
      const clampedDist = Math.max(-1.5, Math.min(1.5, distance));

      // Calculate 3D transforms: rotateY, skewY, scale, translateZ
      const rotateY = -clampedDist * 10;  // Rotate up to +/- 10deg
      const skewY = clampedDist * 2.2;    // Skew up to +/- 2.2deg
      const scale = Math.max(0.88, 1 - Math.abs(clampedDist) * 0.08);
      const translateZ = -Math.abs(clampedDist) * 35;
      const opacity = Math.max(0.75, 1 - Math.abs(clampedDist) * 0.18);

      card.style.transform = `perspective(1200px) rotateY(${rotateY.toFixed(2)}deg) skewY(${skewY.toFixed(2)}deg) scale(${scale.toFixed(3)}) translateZ(${translateZ.toFixed(1)}px)`;
      card.style.opacity = opacity.toFixed(2);
    });
    isUpdatingPerspective = false;
  }

  function requestPerspectiveUpdate() {
    if (!isUpdatingPerspective) {
      isUpdatingPerspective = true;
      requestAnimationFrame(updateSkewedPerspective);
    }
  }

  if (carousel) {
    carousel.addEventListener('scroll', requestPerspectiveUpdate, { passive: true });
    window.addEventListener('resize', requestPerspectiveUpdate, { passive: true });
    // Initial calculation
    setTimeout(updateSkewedPerspective, 80);
  }

  // Drag-to-scroll support
  if (carousel) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    carousel.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      isDown = true;
      carousel.classList.add('is-dragging');
      startX = e.pageX - carousel.offsetLeft;
      scrollLeft = carousel.scrollLeft;
    });

    carousel.addEventListener('pointerleave', () => {
      isDown = false;
      carousel.classList.remove('is-dragging');
    });

    carousel.addEventListener('pointerup', () => {
      isDown = false;
      carousel.classList.remove('is-dragging');
    });

    carousel.addEventListener('pointermove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carousel.offsetLeft;
      const walk = (x - startX) * 1.5;
      carousel.scrollLeft = scrollLeft - walk;
      requestPerspectiveUpdate();
    });
  }

  // Horizontal scroll buttons
  if (carousel && prevBtn && nextBtn) {
    prevBtn.addEventListener('click', () => {
      carousel.scrollBy({ left: -370, behavior: 'smooth' });
      setTimeout(requestPerspectiveUpdate, 250);
    });
    nextBtn.addEventListener('click', () => {
      carousel.scrollBy({ left: 370, behavior: 'smooth' });
      setTimeout(requestPerspectiveUpdate, 250);
    });
  }

  // Reactivity to active source in header
  function updateSourceVisibility() {
    const active = getActiveSource();
    if (!section) return;

    if (section.dataset.fixedSource) return;

    const cards = document.querySelectorAll<HTMLElement>('.trilha-card');
    let visibleCount = 0;
    cards.forEach(card => {
      const src = card.getAttribute('data-source') || 'asimov';
      const isMatch = active === 'all' || src === active || (active === 'hashtag' && src.startsWith('hashtag')) || (active === 'ailab' && (src === 'ailab' || src === 'ai-lab')) || (active === 'sctec' && src === 'sctec');
      if (isMatch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    section.style.display = visibleCount > 0 ? 'block' : 'none';
    requestPerspectiveUpdate();
  }

  // Calculate progress for each trilha based on completed lessons across its courses
  function updateTrilhasProgress() {
    const userProgress = getUserProgress();
    const completedSet = new Set(
      Object.keys(userProgress.completed_lessons).filter(k => userProgress.completed_lessons[k])
    );

    const cards = document.querySelectorAll<HTMLElement>('.trilha-card');
    cards.forEach(card => {
      const trilhaId = card.getAttribute('data-trilha-id');
      const totalLessons = parseInt(card.getAttribute('data-total-lessons') || '0', 10);
      if (!trilhaId || totalLessons === 0) return;

      let completedInTrilha = 0;
      completedSet.forEach(lessonId => {
        completedInTrilha++;
      });

      const progressWrap = document.getElementById(`progress-wrap-${trilhaId}`);
      const progressPct = document.getElementById(`progress-pct-${trilhaId}`);
      const progressFill = document.getElementById(`progress-fill-${trilhaId}`);
      const watchBtn = document.getElementById(`btn-watch-${trilhaId}`);
      const btnText = watchBtn?.querySelector('.btn-text');

      if (completedSet.size > 0 && progressWrap && progressPct && progressFill) {
        const pct = Math.min(Math.round((completedInTrilha / totalLessons) * 100), 100);
        if (pct > 0) {
          progressWrap.style.display = 'block';
          progressPct.textContent = `${pct}%`;
          progressFill.style.width = `${pct}%`;
          if (btnText) {
            btnText.textContent = pct >= 100 ? 'Rever Trilha' : 'Continuar Trilha';
          }
        }
      }
    });
  }

  updateSourceVisibility();
  updateTrilhasProgress();

  window.addEventListener('mindflix:source-changed', () => {
    updateSourceVisibility();
  });
  window.addEventListener('mindflix:progress-updated', updateTrilhasProgress);
</script>

<style>
  .trilhas-section {
    position: relative;
    padding: 2.5rem 0 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .trilhas-section.highlight-asimov {
    background: radial-gradient(ellipse 100% 50% at 50% 0%, rgba(0, 242, 254, 0.06) 0%, transparent 80%);
  }

  .trilhas-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1.5rem;
  }

  .trilhas-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .trilhas-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-cyan);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .trilhas-main-title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  .trilhas-subtitle {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .trilhas-nav-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .trilhas-nav-btn {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--motion-fast) ease-out;
  }

  .trilhas-nav-btn:hover {
    background: rgba(0, 242, 254, 0.15);
    border-color: rgba(0, 242, 254, 0.4);
    color: var(--accent-cyan);
    transform: scale(1.05);
  }

  /* 3D Skewed Carousel Track & Wrapper */
  .trilhas-carousel-wrapper {
    position: relative;
    perspective: 1200px;
    transform-style: preserve-3d;
    padding: 1.5rem 0 2rem;
    margin: 0 -0.5rem;
    overflow: visible;
  }

  .trilhas-carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 1.5rem 1rem 2.5rem;
    transform-style: preserve-3d;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
  }

  .trilhas-carousel-track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    user-select: none;
  }

  .trilhas-carousel-track::-webkit-scrollbar {
    display: none;
  }
</style>
