---
// CourseFilters.astro
import type { Category } from '../types/catalog';

interface Props {
  categories: Category[];
  providers: string[];
  selectedCategory?: string;
  selectedProvider?: string;
}

const { categories, providers, selectedCategory = '', selectedProvider = '' } = Astro.props;
---

<div class="filters-bar" id="course-filters-bar">
  <div class="filters-group">
    <!-- Content Type Filter -->
    <div class="filter-item">
      <label for="filter-type" class="filter-label">Tipo</label>
      <select id="filter-type" class="filter-select">
        <option value="">Todos (Cursos & Trilhas)</option>
        <option value="course">Apenas Cursos</option>
        <option value="trilha">Apenas Trilhas</option>
      </select>
    </div>

    <!-- Category Filter -->
    <div class="filter-item">
      <label for="filter-category" class="filter-label">Categoria</label>
      <select id="filter-category" class="filter-select">
        <option value="">Todas as Categorias</option>
        {categories.map(cat => (
          <option value={cat.id} selected={selectedCategory === cat.id}>{cat.name}</option>
        ))}
      </select>
    </div>

    <!-- Provider Filter -->
    <div class="filter-item">
      <label for="filter-provider" class="filter-label">Fornecedor</label>
      <select id="filter-provider" class="filter-select">
        <option value="">Todos os Fornecedores</option>
        {providers.map(prov => (
          <option value={prov} selected={selectedProvider === prov}>{prov}</option>
        ))}
      </select>
    </div>

    <!-- Status Filter -->
    <div class="filter-item">
      <label for="filter-status" class="filter-label">Status</label>
      <select id="filter-status" class="filter-select">
        <option value="">Todos os Status</option>
        <option value="not_started">Não iniciado</option>
        <option value="in_progress">Em andamento</option>
        <option value="completed">Concluído</option>
        <option value="favorited">Favoritos</option>
      </select>
    </div>

    <!-- Sorting -->
    <div class="filter-item">
      <label for="filter-sort" class="filter-label">Ordenar por</label>
      <select id="filter-sort" class="filter-select">
        <option value="recent">Relevância / Destaques</option>
        <option value="az">Nome (A - Z)</option>
        <option value="za">Nome (Z - A)</option>
        <option value="lessons_desc">Mais Aulas</option>
        <option value="progress_desc">Maior Progresso</option>
      </select>
    </div>
  </div>

  <button type="button" id="reset-filters-btn" class="btn btn-ghost btn-reset" style="display: none;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="1 4 1 10 7 10"></polyline>
      <polyline points="23 20 23 14 17 14"></polyline>
      <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
    </svg>
    <span>Limpar Filtros</span>
  </button>
</div>

<style>
  .filters-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 2rem;
  }

  .filters-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    flex: 1;
  }

  .filter-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 170px;
    flex: 1;
  }

  .filter-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .filter-select {
    height: 40px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    padding: 0 0.75rem;
    font-size: 0.875rem;
    outline: none;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .filter-select:focus {
    border-color: var(--accent-cyan);
  }

  .btn-reset {
    height: 40px;
    font-size: 0.8125rem;
  }
</style>
