# ==============================================================================
# MINDFLIX - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# Caminho raiz da biblioteca de cursos (opcional, padrão: pasta pai do projeto)
# Exemplo: D:/Meus Cursos ou /home/usuario/cursos
COURSES_ROOT=..

# Porta do servidor HTTP
PORT=4321

# Credenciais do Supabase (opcional para modo offline/local; obrigatório para sincronização multi-dispositivo)
PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
