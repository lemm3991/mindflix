# ==============================================================================
# MINDFLIX - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# IMPORTANTE: Copie este arquivo para .env em produção e defina seus segredos.
# Nenhuma chave privada ou segredo deve ser commitada no repositório.
# ==============================================================================

# 1. SERVIDOR & CAMINHO DA BIBLIOTECA
PORT=4321
COURSES_ROOT=..

# 2. SEGREDOS DE AUTENTICAÇÃO E CRIPTOGRAFIA (Backend Only)
# Chave secreta de 64 caracteres recomendada para assinatura HMAC-SHA256 de cookies de sessão
AUTH_SECRET=defina_um_segredo_criptografico_aleatorio_e_longo_aqui

# Chave mestra para criptografia de dados sensíveis em repouso (AES-256-GCM)
ENCRYPTION_SECRET=defina_uma_chave_mestra_de_criptografia_aqui

# 3. INTELIGÊNCIA ARTIFICIAL (Google Gemini API - Backend Only, Opcional)
# Se definida no servidor, os usuários não precisam inserir suas próprias chaves
GEMINI_API_KEY=

# 4. RATE LIMITING DISTRIBUÍDO (Upstash Redis REST - Opcional)
# Se configurado, habilita rate limiting distribuído serverless no Vercel/Cloudflare
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 5. SUPABASE (Opcional para modo offline/local; necessário para sincronização em nuvem)
# Apenas a chave pública anônima deve usar o prefixo PUBLIC_
PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
