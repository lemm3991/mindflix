{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/library/backup/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/library/scan/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/library/update-course/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/search/ai/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/video/?$",
			"dest": "_render"
		},
		{
			"src": "^/categories/?$",
			"dest": "_render"
		},
		{
			"src": "^/category/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/course/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/courses/?$",
			"dest": "_render"
		},
		{
			"src": "^/library/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/my-list/?$",
			"dest": "_render"
		},
		{
			"src": "^/profile/?$",
			"dest": "_render"
		},
		{
			"src": "^/register/?$",
			"dest": "_render"
		},
		{
			"src": "^/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/watch/([^/]+?)/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}